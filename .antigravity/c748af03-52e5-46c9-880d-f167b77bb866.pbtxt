    content: "              >\n                <svg\n                  width=\"100%\"\n                  height=\"100%\"\n                  viewBox=\"0 0 500 482\"\n                  fill=\"none\"\n                  className=\"absolute inset-0 w-full h-full\"\n                >\n                  <path\n                    d={REA_CONSTANTS.introHexagonSvgPath}\n                    fill=\"none\"\n                    stroke=\"rgba(255, 255, 255, 0.55)\"\n                    strokeWidth=\"3.5\"\n                  />\n                  <path\n                    d={REA_CONSTANTS.introHexagonSvgPath}\n                    fill=\"none\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"2\"\n                    strokeDasharray=\"10 6\"\n                  />\n                </svg>\n\n                <button\n                  type=\"button\"\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    handleToggleAudio();\n                  }}\n                  aria-label={isMuted ? \'Suara Mati\' : \'Suara Aktif\'}\n                  className=\"pointer-events-auto absolute top-3 right-6 w-14 h-14 flex items-center justify-center bg-white hover:bg-[#fec83e] text-[#11121a] font-black text-xs border-4 border-[#11121a] ring-2 ring-white rounded-2xl rotate-6 comic-sticker-shadow transition-transform hover:scale-105 active:scale-95 cursor-pointer\"\n                >\n                  {isMuted ? \'MUTE\' : \'SUARA\'}\n                </button>\n\n                <button\n                  type=\"button\"\n                  data-start=\"true\"\n                  onClick={() => handleStartGame(false)}\n                  aria-label=\"LET\'S GO\"\n                  className=\"pointer-events-auto absolute -bottom-3 left-1/2 -translate-x-1/2 -rotate-3 hover:-rotate-6 hover:scale-108 active:scale-95 px-9 py-4 bg-[#b4ff39] hover:bg-[#c7ff72] text-[#11121a] font-black text-2xl sm:text-3xl tracking-wider rounded-2xl border-4 border-[#11121a] ring-4 ring-white comic-sticker-shadow-lg transition-all duration-150 cursor-pointer whitespace-nowrap\"\n                >\n                  LET&apos;S GO\n                </button>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"relative z-10 pb-5 px-6 text-center text-xs sm:text-sm font-bold tracking-wide text-[#dfdfe2]/85\">\n            WASD Lari &nbsp;\302\267&nbsp; [E] Ambil/Lempar Peti &nbsp;\302\267&nbsp; [Q] Pola Ghost Pad &nbsp;\302\267&nbsp; [F] Rakit &nbsp;\302\267&nbsp; [V] Teropong AI\n          </div>\n        </section>\n      )}\n\n      {/* =====================================================================\n          3. PLAYING HUD: UNIFIED TOP NAVIGATION BAR + COLLAPSIBLE DRAWERS\n         ===================================================================== */}\n      {gameState === \'playing\' && (\n        <div className=\"fixed inset-0 z-20 pointer-events-none flex flex-col justify-between\">\n          {/* =================================================================\n              3A. SINGLE UNIFIED TOP HEADER BAR (NO OVERLAPS)\n             ================================================================= */}\n          <header\n            aria-label=\"Top Navigation Bar\"\n            className=\"pointer-events-auto w-full bg-[#191b24]/95 border-b-3 border-[#11121a] px-3 py-1.5 shadow-[0_3px_0_#11121a] flex flex-wrap items-center justify-between gap-2\"\n          >\n            {/* Left Cluster: Blue HQ vs Red HQ + Player / Pad Status */}\n            <div className=\"flex flex-wrap items-center gap-2.5\">\n              {/* Blue HQ vs Red HQ HP Pill */}\n              <div className=\"flex items-center gap-1.5 bg-[#272935] px-2.5 py-1 rounded-xl border-2 border-[#11121a] text-xs font-black font-mono-tabular\">\n                <span className=\"text-[#00d2ff]\">BLUE {hud.blueBaseHp}</span>\n                <span className=\"text-[#8f93a5]\">vs</span>\n                <span className=\"text-[#ff3b30]\">RED {hud.redBaseHp}</span>\n              </div>\n\n              {/* Player / Vehicle HP & Active Weapon Pill */}\n              <div className=\"hidden sm:flex items-center gap-1.5 bg-[#272935] px-2.5 py-1 rounded-xl border-2 border-[#11121a]\">\n                <span className=\"text-[10px] font-black uppercase text-[#b8ff3c]\">\n                  {hud.controlMode === \'tank\'\n                    ? `${hud.grabbedPropName || \'TANK\'} (${hud.tankStoredCrates}/4)`\n                    : hud.activeClass.toUpperCase()}\n                </span>\n                <div className=\"flex items-center gap-0.5\">\n                  {Array.from({ length: 5 }).map((_, idx) => {\n                    const full = hud.hp >= ((idx + 1) * hud.maxHp) / 5;\n                    return (\n                      <span\n                        key={idx}\n                        className={`w-2 h-2.5 rounded-xs border border-[#11121a] ${\n                          full ? \'bg-[#b8ff3c]\' : \'bg-[#191b24]\'\n                        }`}\n                      />\n                    );\n                  })}\n                </div>\n                <span className=\"text-[11px] font-black font-mono-tabular text-white\">\n                  {hud.equippedWeapon}\n                </span>\n              </div>\n\n              {/* Compact Stacking Pad [Q] Status Pill */}\n              <div className=\"hidden md:flex items-center gap-1.5 bg-[#272935] px-2.5 py-1 rounded-xl border-2 border-[#11121a]\">\n                <span className=\"text-[10px] font-black text-[#8f93a5]\">\n                  PAD [{hud.buildOrder}]:\n                </span>\n                <div className=\"flex items-center gap-0.5\">\n                  {hud.padSlots.map((slot, idx) => {\n                    const isGhostAllowed = getBuildOrderAllowedSlots(hud.buildOrder).includes(idx);\n                    return (\n                      <span\n                        key={idx}\n                        className={`w-2.5 h-2.5 rounded-xs border ${\n                          slot === \'super\'\n                            ? \'bg-[#00d2ff] border-[#11121a]\'\n                            : slot === \'red\'\n                            ? \'bg-[#ff3b30] border-[#11121a]\'\n                            : isGhostAllowed\n                            ? \'bg-[#191b24] border-[#00d2ff] border-dashed\'\n                            : \'bg-[#191b24]/60 border-[#11121a]\'\n                        }`}\n                      />\n                    );\n                  })}\n                </div>\n                <span\n                  className={`text-[11px] font-black ${\n                    hud.padIsSuper ? \'text-[#00d2ff]\' : \'text-[#fec83e]\'\n                  }`}\n                >\n                  {hud.padOutputName}\n                </span>\n              </div>\n            </div>\n\n            {/* Center Cluster: 3-Mode Selector (Sandbox / Map Editor / Run Match) */}\n            <div\n              role=\"tablist\"\n              aria-label=\"Mode Permainan\"\n              className=\"flex items-center gap-1 bg-[#11121a] p-1 rounded-xl border-2 border-[#272935]\"\n            >\n              <button\n                type=\"button\"\n                role=\"tab\"\n                aria-selected={playMode === \'sandbox\'}\n                data-mode-btn=\"sandbox\"\n                onClick={() => handleSwitchPlayMode(\'sandbox\')}\n                className={`px-2.5 py-1 rounded-lg font-black text-[11px] border transition-all cursor-pointer whitespace-nowrap ${\n                  playMode === \'sandbox\'\n                    ? \'bg-[#b8ff3c] text-[#11121a] border-[#11121a]\'\n                    : \'bg-[#272935] text-white/85 border-transparent hover:bg-[#393b49]\'\n                }`}"
    num_lines: 1515
    num_bytes: 69834
    line_range_bytes: 7522
  }
}
