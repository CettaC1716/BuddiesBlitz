    content: "      [1, 1, 1],\n      0,\n    );\n  }\n  for (let cy = 2.2; cy <= 5.4; cy += 0.8) {\n    const cageHoop = new THREE.Mesh(\n      new THREE.TorusGeometry(0.34, 0.025, 6, 12),\n      new THREE.MeshBasicMaterial({ color: 0x363b48 }),\n    );\n    cageHoop.rotation.x = Math.PI / 2;\n    cageHoop.position.set(-1.56, cy, 0);\n    checkpointGroup.add(cageHoop);\n  }\n\n  // Watchtower Observation Deck Platform & Catwalk Railings (y = 5.65m)\n  addBasePart(checkpointGroup, new THREE.BoxGeometry(3.2, 0.24, 3.2), COL_CONCRETE_DARK, [0, towerH + 0.08, 0]);\n  for (const rSide of [-1.48, 1.48]) {\n    addBasePart(checkpointGroup, new THREE.BoxGeometry(3.0, 0.07, 0.07), COL_STEEL, [0, towerH + 0.68, rSide], [0, 0, 0], [1, 1, 1], 0.01);\n    addBasePart(checkpointGroup, new THREE.BoxGeometry(0.07, 0.07, 3.0), COL_STEEL, [rSide, towerH + 0.68, 0], [0, 0, 0], [1, 1, 1], 0.01);\n  }\n\n  // 360-Degree Glass-Enclosed Guard Cabin (y = 5.8m to 7.7m)\n  addBasePart(checkpointGroup, new THREE.BoxGeometry(2.25, 0.78, 2.25), COL_OLIVE_WALL, [0, towerH + 0.56, 0]);\n  addBasePart(checkpointGroup, new THREE.BoxGeometry(2.05, 0.92, 2.05), COL_GLASS, [0, towerH + 1.38, 0], [0, 0, 0], [1, 1, 1], 0.016);\n  // 4 Corner Cabin Mullions\n  for (const cx of [-0.98, 0.98]) {\n    for (const cz of [-0.98, 0.98]) {\n      addBasePart(checkpointGroup, new THREE.BoxGeometry(0.18, 1.0, 0.18), COL_OLIVE_UPPER, [cx, towerH + 1.38, cz], [0, 0, 0], [1, 1, 1], 0.012);\n    }\n  }\n  // Guard Silhouette inside Watchtower Cabin\n  addBasePart(checkpointGroup, new THREE.CylinderGeometry(0.22, 0.26, 0.65, 8), COL_STEEL, [0, towerH + 1.22, 0], [0, 0, 0], [1, 1, 1], 0);\n  addBasePart(checkpointGroup, new THREE.SphereGeometry(0.18, 8, 8), COL_STEEL, [0, towerH + 1.66, 0], [0, 0, 0], [1, 1, 1], 0);\n\n  // Pyramidal Hip Roof over Watchtower Cabin + Team Trim + Lightning Rod\n  const towerRoofGeo = new THREE.ConeGeometry(2.05, 1.05, 4);\n  towerRoofGeo.rotateY(Math.PI / 4);\n  addBasePart(checkpointGroup, towerRoofGeo, COL_OLIVE_ROOF, [0, towerH + 2.34, 0], [0, 0, 0], [1, 1, 1], 0.024);\n  addBasePart(checkpointGroup, new THREE.BoxGeometry(2.55, 0.14, 2.55), COL_TEAM, [0, towerH + 1.86, 0]);\n  addBasePart(checkpointGroup, new THREE.CylinderGeometry(0.02, 0.03, 1.1, 6), COL_STEEL, [0, towerH + 3.2, 0], [0, 0, 0], [1, 1, 1], 0);\n\n  // Panning Searchlight on Watchtower Roof Corner (searchlightPivotGroup)\n  const searchlightPivotGroup = new THREE.Group();\n  searchlightPivotGroup.name = \'Watchtower_Searchlight\';\n  searchlightPivotGroup.position.set(0.88, towerH + 2.38, 0.88);\n  checkpointGroup.add(searchlightPivotGroup);\n\n  addBasePart(\n    searchlightPivotGroup,\n    new THREE.CylinderGeometry(0.24, 0.18, 0.38, 10),\n    COL_STEEL,\n    [0, 0.18, 0],\n    [0.35, 0, -Math.PI / 2],\n    [1, 1, 1],\n    0.014,\n  );\n  const lensGlow = new THREE.Mesh(\n    new THREE.CircleGeometry(0.21, 12),\n    new THREE.MeshBasicMaterial({ color: 0xfff7c2, side: THREE.DoubleSide }),\n  );\n  lensGlow.rotation.y = Math.PI / 2;\n  lensGlow.position.set(0.20, 0.12, 0);\n  searchlightPivotGroup.add(lensGlow);\n\n  // Translucent Volumetric Searchlight Cone\n  const beamConeGeo = new THREE.ConeGeometry(1.15, 4.8, 14, 1, true);\n  beamConeGeo.rotateZ(Math.PI / 2);\n  beamConeGeo.translate(2.55, -0.85, 0);\n  const beamConeMesh = new THREE.Mesh(\n    beamConeGeo,\n    new THREE.MeshBasicMaterial({\n      color: 0xfff4b8,\n      transparent: true,\n      opacity: 0.22,\n      side: THREE.DoubleSide,\n      depthWrite: false,\n    }),\n  );\n  searchlightPivotGroup.add(beamConeMesh);\n\n  // B. Ground-Level Checkpoint Guardhouse Booth & Sandbag Defensive Bunker"
