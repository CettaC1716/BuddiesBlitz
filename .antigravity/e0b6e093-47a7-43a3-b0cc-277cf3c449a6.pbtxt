            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Single 180\302\260-Rotationally Symmetric Base Quadrant Generator (`buildTeamBaseQuadrant`):"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - `sign = +1` (\'blue\'): Bottom-Left Quadrant `(x < 0, z > 0)`"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * - `sign = -1` (\'red\') : Top-Right Quadrant `(x > 0, z < 0)` with exact `(-x, -z)` and `rotY + Math.PI`"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: " * Guarantees 100% 1:1 identical coordinates, distances, and orientations between Blue and Red bases."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
