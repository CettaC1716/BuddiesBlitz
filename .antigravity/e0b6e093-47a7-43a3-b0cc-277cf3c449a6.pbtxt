  view_file {
    absolute_path_uri: "file:///src/game/FactoryPlaygroundCanvas.tsx"
    start_line: 929
    end_line: 974
    content: "    scene.add(editorCursorGroup);\n\n    // =========================================================================\n    // 5. TWO 1:1 SYMMETRIC TEAM BASES (BLUE BOTTOM-LEFT vs RED TOP-RIGHT)\n    //    + FORTIFIED HQ, AMMO DEPOT, HELIPAD (H), & 2x2x2 STACKING PADS\n    // =========================================================================\n    const buildBaseHqAndPad = (team: \'blue\' | \'red\', hqX: number, hqZ: number, padX: number, padZ: number) => {\n      const teamMat = team === \'blue\' ? matBlueTeam : matRedTeam;\n      const baseYaw = team === \'blue\' ? 0 : Math.PI;\n      const baseGroup = new THREE.Group();\n      baseGroup.position.set(hqX, 0, hqZ);\n      baseGroup.rotation.y = baseYaw;\n      scene.add(baseGroup);\n\n      // Build the Full Completed Military Base Masterplan (5 Technical Blueprints:\n      // 1. Site Layout Plan + Internal Loop Road + 4 Corner Bastions + Helipad \'H\' + Reinforced Storage Bunker\n      // 2. Central Command & Comms HQ Building with Rotating Radar Dish & Lattice Radio Mast\n      // 3. Heavy Vehicle Depot & Armored Motor Pool Maintenance Hangar with Corrugated Arch Roof & Hazard Stripes\n      // 4. Troop Quarters & Field Barracks with Spinning Roof Ventilation Turbine\n      // 5. Perimeter Checkpoint, X-Truss Guard Watchtower with Panning Searchlight & Animated Boom Barrier)\n      buildMilitaryBaseMasterplan(baseGroup, team, windUniforms, isSoftwareGl);\n\n      const hpSign = createBillboardSign(5.5, 1.35);\n      hpSign.sprite.position.set(-1.8, 8.8, -1.2);\n      baseGroup.add(hpSign.sprite);\n\n      // Physical 3D 2x2x2 Stacking Pad (4 floor tiles + Merged Glow Frame + Stacked 3D Crate Meshes)\n      const padGroup = new THREE.Group();\n      padGroup.position.set(padX, 0.04, padZ);\n      padGroup.rotation.y = baseYaw;\n      scene.add(padGroup);\n\n      addOutlinedPart(padGroup, new THREE.BoxGeometry(4.4, 0.18, 4.4), matDarkSteel, [0, 0.09, 0], [0, 0, 0], 1.05, false);\n\n      const tileOffsets: [number, number][] = [\n        [-0.95, -0.95],\n        [0.95, -0.95],\n        [-0.95, 0.95],\n        [0.95, 0.95],\n      ];\n      tileOffsets.forEach(([tx, tz]) => {\n        const tile = new THREE.Mesh(new THREE.BoxGeometry(1.7, 0.06, 1.7), teamMat);\n        tile.position.set(tx, 0.2, tz);\n        padGroup.add(tile);\n        const arrow = new THREE.Mesh(new THREE.BoxGeometry(0.45, 0.08, 0.85), matWhite);\n        arrow.position.set(tx, 0.22, tz);"
    num_lines: 6177
    num_bytes: 239908
    line_range_bytes: 2403
  }
}
