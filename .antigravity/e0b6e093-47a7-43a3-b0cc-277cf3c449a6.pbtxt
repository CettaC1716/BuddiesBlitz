        replacement_chunks {
          target_content: "  return [\n    // a. Rectangular Fortified Perimeter Wall (`concrete-fence-1a.glb` with Main Security Gate opening)\n    //    Surrounding the Full Completed Military Base Masterplan in [-56.5..-27.5] x [22.5..55.5]\n    //    North Perimeter Wall (z = 22.5)\n    place(\'concrete_fence\', -52.5, 22.5, 0, 1.08),\n    place(\'concrete_fence\', -46.5, 22.5, 0, 1.08),\n    place(\'concrete_fence\', -40.5, 22.5, 0, 1.08),\n    place(\'concrete_fence\', -34.5, 22.5, 0, 1.08),\n    place(\'concrete_fence\', -30.5, 22.5, 0, 1.08),\n    //    South Perimeter Wall (z = 55.5)\n    place(\'concrete_fence\', -52.5, 55.5, 0, 1.08),\n    place(\'concrete_fence\', -46.5, 55.5, 0, 1.08),\n    place(\'concrete_fence\', -40.5, 55.5, 0, 1.08),\n    place(\'concrete_fence\', -34.5, 55.5, 0, 1.08),\n    place(\'concrete_fence\', -30.5, 55.5, 0, 1.08),\n    //    West Perimeter Wall (x = -56.5)\n    place(\'concrete_fence\', -56.5, 27.0, Math.PI / 2, 1.08),\n    place(\'concrete_fence\', -56.5, 33.0, Math.PI / 2, 1.08),\n    place(\'concrete_fence\', -56.5, 39.0, Math.PI / 2, 1.08),\n    place(\'concrete_fence\', -56.5, 45.0, Math.PI / 2, 1.08),\n    place(\'concrete_fence\', -56.5, 51.0, Math.PI / 2, 1.08),\n    //    East Perimeter Wall (x = -27.5) with Main Security Gate opening at z = 39.0\n    place(\'concrete_fence\', -27.5, 26.5, Math.PI / 2, 1.08),\n    place(\'concrete_fence\', -27.5, 31.5, Math.PI / 2, 1.08),\n    place(\'concrete_fence\', -27.5, 46.5, Math.PI / 2, 1.08),\n    place(\'concrete_fence\', -27.5, 51.5, Math.PI / 2, 1.08),\n\n    // b. Real Extracted Lyo .GLB Props Integrated into Masterplan Buildings:\n    //    - Rear Utility Pipe Cluster (`pipe-cluster-1a.glb`) on Central Command HQ rear wall\n    place(\'pipe_cluster\', -52.2, 37.8, Math.PI / 2, 1.06),\n    //    - Heavy Vehicle Hangar Exhausts (`giant-pipe-1a.glb` & `chimney.glb`) + Fuel Storage Depot (`tank-1a.glb` & `explosive_barrel`)\n    place(\'giant_pipe\', -48.5, 53.8, 0.0, 1.06),\n    place(\'chimney\', -53.5, 50.5, 0.0, 0.92),\n    place(\'tank_1a\', -53.5, 45.2, Math.PI / 2, 1.08),\n    place(\'explosive_barrel\', -52.5, 43.2, 0.2, 1.04),\n    place(\'explosive_barrel\', -54.2, 43.2, -0.3, 1.04),\n    //    - Troop Quarters & Field Barracks Yard Props (`wheelbarrow.glb`, `hydrant.glb`)\n    place(\'wheelbarrow\', -35.3, 31.2, 0.45, 1.08),\n    place(\'hydrant\', -30.5, 29.8, 0.0, 1.02),\n    //    - Perimeter Checkpoint & Boom Barrier Gate (`barricade-1a.glb`, `lamppost-1a.glb`)\n    place(\'barricade\', -26.2, 34.8, -0.25, 1.05),\n    place(\'barricade\', -26.2, 43.2, 0.25, 1.05),"
          replacement_content: "  return [\n    // a. Rectangular Fortified Perimeter Wall (`concrete-fence-1a.glb` with Main Security Gate opening)\n    //    Surrounding the Full Completed Military Base Masterplan in [-56.5..-27.5] x [22.5..55.5]\n    //    Arranged tightly edge-to-edge (2.0m spacing) connecting bastions seamlessly:\n    //    North Perimeter Wall (z = 22.5, spanning x from -54.0 to -30.0)\n    place(\'concrete_fence\', -54.0, 22.5, 0, 1.0),\n    place(\'concrete_fence\', -52.0, 22.5, 0, 1.0),\n    place(\'concrete_fence\', -50.0, 22.5, 0, 1.0),\n    place(\'concrete_fence\', -48.0, 22.5, 0, 1.0),\n    place(\'concrete_fence\', -46.0, 22.5, 0, 1.0),\n    place(\'concrete_fence\', -44.0, 22.5, 0, 1.0),\n    place(\'concrete_fence\', -42.0, 22.5, 0, 1.0),\n    place(\'concrete_fence\', -40.0, 22.5, 0, 1.0),\n    place(\'concrete_fence\', -38.0, 22.5, 0, 1.0),\n    place(\'concrete_fence\', -36.0, 22.5, 0, 1.0),\n    place(\'concrete_fence\', -34.0, 22.5, 0, 1.0),\n    place(\'concrete_fence\', -32.0, 22.5, 0, 1.0),\n    place(\'concrete_fence\', -30.0, 22.5, 0, 1.0),\n\n    //    South Perimeter Wall (z = 55.5, spanning x from -54.0 to -30.0)\n    place(\'concrete_fence\', -54.0, 55.5, 0, 1.0),\n    place(\'concrete_fence\', -52.0, 55.5, 0, 1.0),\n    place(\'concrete_fence\', -50.0, 55.5, 0, 1.0),\n    place(\'concrete_fence\', -48.0, 55.5, 0, 1.0),\n    place(\'concrete_fence\', -46.0, 55.5, 0, 1.0),\n    place(\'concrete_fence\', -44.0, 55.5, 0, 1.0),\n    place(\'concrete_fence\', -42.0, 55.5, 0, 1.0),\n    place(\'concrete_fence\', -40.0, 55.5, 0, 1.0),\n    place(\'concrete_fence\', -38.0, 55.5, 0, 1.0),\n    place(\'concrete_fence\', -36.0, 55.5, 0, 1.0),\n    place(\'concrete_fence\', -34.0, 55.5, 0, 1.0),\n    place(\'concrete_fence\', -32.0, 55.5, 0, 1.0),\n    place(\'concrete_fence\', -30.0, 55.5, 0, 1.0),\n\n    //    West Perimeter Wall (x = -56.5, spanning z from 25.0 to 53.0)\n    place(\'concrete_fence\', -56.5, 25.0, Math.PI / 2, 1