    content: "        const collarGeo = new THREE.CylinderGeometry(collarRadius, collarRadius * 1.02, bandHeight, 20);\n        const collarMesh = new THREE.Mesh(\n          collarGeo,\n          new THREE.MeshStandardMaterial({ color: \'#181920\' }),\n        );\n        collarMesh.name = `WindTurbine_Collar_${collarZ}`;\n        collarMesh.position.set(0, -1.73209, collarZ);\n        collarMesh.rotation.x = Math.PI / 2;\n        collarMesh.frustumCulled = false;\n        collarMesh.castShadow = true;\n        collarMesh.receiveShadow = true;\n        upgradeMeshToLyoWorldMaterial(collarMesh, windUniforms, \'#181920\');\n        const collarStroke = createLyoStrokeMesh(collarGeo, 0.024);\n        if (collarStroke) {\n          collarStroke.frustumCulled = false;\n          collarMesh.add(collarStroke);\n        }\n        orientedRoot.add(collarMesh);\n      }\n    }\n\n    if (orientedRoot.children.length > 0) {\n      propGroup.add(orientedRoot);\n    }\n  }\n\n  if (propGroup.children.length === 0) return null;\n\n  propGroup.updateMatrixWorld(true);\n  const box = new THREE.Box3().setFromObject(propGroup);\n  const size = box.getSize(new THREE.Vector3());\n  const center = box.getCenter(new THREE.Vector3());\n  const maxSpan = Math.max(size.y, size.x * 0.55, size.z * 0.55);\n  const scale = maxSpan > 0.05 ? targetHeight / maxSpan : 1.0;\n\n  const wrapper = new THREE.Group();\n  wrapper.frustumCulled = false;\n  propGroup.position.set(-center.x * scale, -box.min.y * scale, -center.z * scale);\n  propGroup.scale.setScalar(scale);\n  wrapper.add(propGroup);\n  wrapper.position.set(x, 0, z);\n  wrapper.rotation.y = rotY;\n  wrapper.userData.windFanNodes = windFanNodes;\n  wrapper.userData.spinYNodes = spinYNodes;\n  wrapper.userData.animPhase = (Math.abs(x * 1.37 + z * 2.13) % 6.283);\n  parent.add(wrapper);\n  return wrapper;\n}\n\n/**\n * Populates a Crate / Box drop group with the real extracted Long Hoang box .glb model:\n * - \'red\' (Standard Crate): uses WoddenBox.REF from wooden-box.glb\n * - \'super\' (Super Crate): uses MetalBox_1A.REF from metal-box-1a.glb\n * Centers the box mesh at local (0, 0, 0) and scales it to `targetSize` so it drops,\n * gets carried overhead, and stacks 2x2x2 on the Stacking Pad with exact alignment.\n */\nexport function populateRealLyoCrateBoxFromGlb(\n  targetGroup: THREE.Group,\n  kind: \'red\' | \'super\',\n  assets: LoadedLyoAssets,\n  windUniforms: LyoWindUniforms,"
