        replacement_content: "  // 3. Unit leaves (14m > 8m): barrier smoothly lowers back toward 0 rad\n  const lowering = stepMilitaryBaseBoomBarrier(angle, 14.0, 0.1);\n  assert.equal(lowering.isOpen, false);\n  assert.ok(lowering.angleRad < angle, \'Boom barrier should lower when no unit is within 8m\');\n});\n\ntest(\'buildTeamBaseQuadrant replaces barricades with concrete_fence arranged edge-to-edge around base\', async () => {\n  const { buildTeamBaseQuadrant } = await import(\'./FactoryPlaygroundCanvas\');\n  const blueProps = buildTeamBaseQuadrant(\'blue\');\n  const redProps = buildTeamBaseQuadrant(\'red\');\n\n  // Assert all barricades around the bases have been replaced by concrete_fence\n  assert.equal(blueProps.filter((p) => p.kind === \'barricade\').length, 0);\n  assert.equal(redProps.filter((p) => p.kind === \'barricade\').length, 0);\n\n  const blueFences = blueProps.filter((p) => p.kind === \'concrete_fence\');\n  const redFences = redProps.filter((p) => p.kind === \'concrete_fence\');\n  assert.equal(blueFences.length, 55);\n  assert.equal(redFences.length, 55);\n\n  // Assert edge-to-edge spacing along the North perimeter wall (z = 22.5)\n  const northFences = blueFences.filter((p) => Math.abs(p.z - 22.5) < 0.1).sort((a, b) => a.x - b.x);\n  assert.equal(northFences.length, 13);\n  for (let i = 1; i < northFences.length; i++) {\n    const dx = northFences[i].x - northFences[i - 1].x;\n    assert.ok(Math.abs(dx - 2.0) < 0.05, `North wall fences should be placed edge-to-edge at 2.0m spacing, got ${dx}`);\n  }\n\n  // Assert edge-to-edge spacing along the South perimeter wall (z = 55.5)\n  const southFences = blueFences.filter((p) => Math.abs(p.z - 55.5) < 0.1).sort((a, b) => a.x - b.x);\n  assert.equal(southFences.length, 13);\n  for (let i = 1; i < southFences.length; i++) {\n    const dx = southFences[i].x - southFences[i - 1].x;\n    assert.ok(Math.abs(dx - 2.0) < 0.05, `South wall fences should be placed edge-to-edge at 2.0m spacing, got ${dx}`);\n  }\n\n  // Assert edge-to-edge spacing along the West perimeter wall (x = -56.5)\n  const westFences = blueFences.filter((p) => Math.abs(p.x - (-56.5)) < 0.1).sort((a, b) => a.z - b.z);\n  assert.equal(westFences.length, 15);\n  for (let i = 1; i < westFences.length; i++) {\n    const dz = westFences[i].z - westFences[i - 1].z;\n    assert.ok(Math.abs(dz - 2.0) < 0.05, `West wall fences should be placed edge-to-edge at 2.0m spacing, got ${dz}`);\n  }\n});\n"
