old\', -60.5, 24.5, 0.4, 1.08),\n    place(\'tree_purple\', -60.5, 52.5, -0.6, 1.08),\n    place(\'tree_gold\', -20.5, 50.5, 0.8, 1.06),\n    place(\'tree_purple\', -36.5, 59.5, -0.4, 1.06),\n  ];\n}\n\nexport const DEFAULT_ARENA_MAP_LAYOUT: ArenaMapLayout = {\n  // 100% 1:1 Rotationally Symmetric Team Bases:\n  // - Bottom-Left (Blue Team Base, sign = +1): HQ (-46.5, +39.0), Stacking Pad (-36.5, +39.0)\n  // - Top-Right   (Red Team Base,  sign = -1): HQ (+46.5, -39.0), Stacking Pad (+36.5, -39.0)\n  blueHq: { x: -46.5, z: 39.0 },\n  bluePad: { x: -36.5, z: 39.0 },\n  redHq: { x: 46.5, z: -39.0 },\n  redPad: { x: 36.5, z: -39.0 },\n  centerDropZone: { x: 0, z: 3.2 },\n  props: [\n    // =========================================================================\n    // 1. KUADRAN KIRI BAWAH (BLUE TEAM BASE, sign = +1) &\n    //    KUADRAN KANAN ATAS (RED TEAM BASE,  sign = -1) \342\200\224 100% IDENTIK 1:1\n    // =========================================================================\n    ...buildTeamBaseQuadrant(\'blue\', 1, 100),\n    ...buildTeamBaseQuadrant(\'red\', -1, 200),\n\n    // =========================================================================\n    // 2. PULAU TENGAH (CENTRAL POWER CORE ISLAND AT (0,0)) & ROADSIDE PIPES\n    //    (Placed cleanly on the island / roadside banks, NEVER blocking the road)\n    // =========================================================================\n    { id: 501, kind: \'power_core\', x: 0.0, z: -2.2, rotY: 0.0, scale: 1.25 },\n    { id: 502, kind: \'giant_pipe\', x: -38.5, z: -21.5, rotY: 0.0, scale: 1.12 },\n    { id: 503, kind: \'giant_pipe\', x: 38.5, z: 21.5, rotY: Math.PI, scale: 1.12 },\n    { id: 504, kind: \'pipe_cluster\', x: -4.8, z: -8.5, rotY: 0.0, scale: 1.08 },\n    { id: 505, kind: \'pipe_cluster\', x: 4.8, z: 8.5, rotY: Math.PI, scale: 1.08 },\n    { id: 506, kind: \'tree_purple\', x: -20.5, z: 6.0, rotY: 0.35, scale: 1.08 },\n    { id: 507, kind: \'tree_purple\', x: 20.5, z: -6.0, rotY: -2.79,