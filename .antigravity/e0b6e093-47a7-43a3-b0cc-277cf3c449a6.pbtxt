    content: "import React, { useState, useEffect, useCallback, useRef } from \'react\';\nimport {\n  FactoryPlaygroundCanvas,\n  GameState,\n  PlayMode,\n  EditorToolId,\n  HudSnapshot,\n} from \'./game/FactoryPlaygroundCanvas\';\nimport {\n  REA_CONSTANTS,\n  LIGHTING_PRESETS,\n  LightingPresetKey,\n  getBuildOrderAllowedSlots,\n} from \'./game/rules\';\nimport { soundEngine } from \'./game/audio\';\nimport { ReaLuauModal } from \'./components/ReaLuauModal\';\n\nconst INITIAL_HUD: HudSnapshot = {\n  hp: 30,\n  maxHp: 30,\n  score: 0,\n  bestScore: 0,\n  speedKmh: 0,\n  isBoosting: false,\n  isGrabMode: false,\n  grabbedPropName: null,\n  collectedItems: [],\n  powerCoreActivated: false,\n  enemiesDefeated: 0,\n  totalEnemies: 4,\n  lightingPreset: \'day\',\n  cameraFovMode: \'webgl35\',\n  outcome: null,\n  clearTimeSec: 0,\n  controlMode: \'buddy\',\n  activeClass: \'Infuntry\',\n  equippedWeapon: \'Uzi\',\n  ammo: 120,\n  carryingCrate: \'none\',\n  tankStoredCrates: 0,\n  padSlots: [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'],\n  padShape: \'Empty\',\n  padOutputName: \'Pad Kosong\',\n  padIsMerged: false,\n  padIsSuper: false,\n  buildOrder: \'1x1x2\',\n  buildOrderLabel: \'Buddy T1\',\n  buildOrderTargetCrates: 2,\n  teamCommand: \'HARVEST\',\n  alliedBuddiesCount: 1,\n  blueBaseHp: 2000,\n  redBaseHp: 2000,\n  contextHint: \'WASD Lari \302\267 [E] Ambil Peti \302\267 [Q] Pola 1x1x2 \302\267 [F] Rakit\',\n  radarDots: [],\n  editorObjectCount: 19,\n  editorCursorX: 0,\n  editorCursorZ: 0,\n  editorRotDeg: 0,\n  editorScale: 1.0,\n};\n\nconst PRESET_ORDER: LightingPresetKey[] = [\'day\', \'dusk\', \'night\', \'dawn\'];\n\ninterface EditorToolOption {\n  id: EditorToolId;\n  label: string;\n  sub: string;\n  accentHex: string;\n}\n\nconst EDITOR_TERRAIN_BRUSH_TOOLS: EditorToolOption[] = [\n  { id: \'sculpt_raise\', label: \'Sculpt Bukit +\', sub: \'Naikkan Elevasi Bukit\', accentHex: \'#b8ff3c\' },\n  { id: \'sculpt_l