    content: "export function buildMilitaryBaseMasterplan(\n  baseGroup: THREE.Group,\n  team: \'blue\' | \'red\',\n  windUniforms: LyoWindUniforms,\n  isSoftwareGl: boolean,\n): void {\n  // Clear previous children except HP sign if any\n  for (let i = baseGroup.children.length - 1; i >= 0; i--) {\n    baseGroup.remove(baseGroup.children[i]);\n  }\n\n  const masterRoot = new THREE.Group();\n  masterRoot.name = `MilitaryBaseMasterplan_${team}`;\n  baseGroup.add(masterRoot);\n\n  const COL_TEAM = team === \'blue\' ? \'#2563eb\' : \'#dc2626\';\n  const COL_OLIVE_WALL = \'#9a9676\';\n  const COL_OLIVE_UPPER = \'#a6a182\';\n  const COL_OLIVE_DARK = \'#706e54\';\n  const COL_OLIVE_ROOF = \'#626652\';\n  const COL_CONCRETE = \'#8b887a\';\n  const COL_CONCRETE_DARK = \'#6d6b5f\';\n  const COL_SANDBAG_A = \'#bd9f68\';\n  const COL_SANDBAG_B = \'#a38752\';\n  const COL_STEEL = \'#363b48\';\n  const COL_STEEL_LIGHT = \'#697080\';\n  const COL_GLASS = \'#22303f\';\n  const COL_GOLD = \'#eab308\';\n  const COL_WHITE = \'#f4f4f0\';\n  const COL_RED_GATE = \'#dc2626\';\n\n  const hazardTex = createHazardStripeTexture();\n  const baseMatCache = new Map<string, THREE.Material>();\n\n  const addBasePart = (\n    parent: THREE.Object3D,\n    geo: THREE.BufferGeometry,\n    colorHex: string,\n    pos: [number, number, number],\n    rot: [number, number, number] = [0, 0, 0],\n    scale: [number, number, number] = [1, 1, 1],\n    strokeWidth = 0.028,\n    customMap?: THREE.Texture,\n    castShadow = true,\n  ): THREE.Mesh => {\n    const cacheKey = `${colorHex}_${customMap ? customMap.uuid : \'nomap\'}`;\n    let cachedMat = baseMatCache.get(cacheKey);\n    const m = new THREE.Mesh(\n      geo,\n      cachedMat ||\n        new THREE.MeshStandardMaterial({\n          color: new THREE.Color(colorHex),\n          map: customMap || null,\n        }),\n    );\n    if (!cachedMat) {\n      upgradeMeshToLyoWorldMaterial(m, windUniforms, customMap ? \'#ffffff\' : colorHex);\n      baseMatCache.set(cacheKey, m.material as THREE.Material);\n    }\n    m.position.set(pos[0], pos[1], pos[2]);\n    m.rotation.set(rot[0], rot[1], rot[2]);\n    m.scale.set(scale[0], scale[1], scale[2]);\n    m.frustumCulled = false;\n    m.castShadow = castShadow && !isSoftwareGl;\n    m.receiveShadow = !isSoftwareGl;\n    if (strokeWidth > 0) {\n      const stroke = createLyoStrokeMesh(geo, strokeWidth);\n      if (stroke) {\n        stroke.frustumCulled = false;\n        m.add(stroke);\n      }\n    }\n    parent.add(m);\n    return m;\n  };\n\n  // Shared helper: Build a staggered 3-high sandbag defensive wall segment\n  const sharedSandbagGeo = new THREE.CapsuleGeometry(0.18, 0.44, 4, 8);\n  sharedSandbagGeo.rotateZ(Math.PI / 2);\n  sharedSandbagGeo.scale(1.0, 0.68, 0.88);\n\n  const addSandbagWallSegment = (\n    parent: THREE.Object3D,\n    x: number,\n    z: number,\n    rotY: number,\n    columns = 4,\n    rows = 3,\n  ) => {\n    const sbGroup = new THREE.Group();\n    sbGroup.position.set(x, 0, z);\n    sbGroup.rotation.y = rotY;\n    parent.add(sbGroup);\n\n    const bagSpacing = 0.68;\n    const rowHeight = 0.22;\n    for (let r = 0; r < rows; r++) {\n      const countInRow = r === rows - 1 ? Math.max(1, columns - 1) : columns;\n      const startX = -((countInRow - 1) * bagSpacing) * 0.5;\n      for (let c = 0; c < countInRow; c++) {\n        const bx = startX + c * bagSpacing;\n        const by = 0.12 + r * rowHeight;\n        const bz = ((r + c) % 2 === 0 ? 1 : -1) * 0.025;\n        const col = (r + c) % 2 === 0 ? COL_SANDBAG_A : COL_SANDBAG_B;\n        addBasePart(\n          sbGroup,\n          sharedSandbagGeo,\n          col,\n          [bx, by, bz],\n          [0, ((r * 3 + c) % 3 - 1) * 0.05, 0],\n          [1, 1, 1],\n          0.016,\n          undefined,\n          false,\n        );\n      }\n    }\n  };\n\n  // =========================================================================\n  // 1. INTERNAL BASE PAVED ASPHALT ROAD LOOP & MOTOR POOL APRON\n  //    (Connects Main Gate at (+19, 0) around Stacking Pad (+10, 0) & Helipad (+4.2, -6.8)\n  //     to the Armored Vehicle Motor Pool (+9.0, +10.2))\n  // =========================================================================\n  const roadAsphaltMat = new THREE.MeshBasicMaterial({\n    color: 0x2f343f,\n    polygonOffset: true,\n    polygonOffsetFactor: -1,\n    polygonOffsetUnits: -1,\n  });\n  const roadCurbMat = new THREE.MeshBasicMaterial({\n    color: 0x5c6270,\n    polygonOffset: true,\n    polygonOffsetFactor: -1,\n    polygonOffsetUnits: -1,\n  });\n  const roadDashMat = new THREE.MeshBasicMaterial({\n    color: 0xeab308,\n    polygonOffset: true,\n    polygonOffsetFactor: -2,\n    polygonOffsetUnits: -2,\n  });\n\n  const addFlatRoadSlab = (cx: number, cz: number, w: number, d: number) => {\n    const curb = new THREE.Mesh(new THREE.PlaneGeometry(w + 0.5, d + 0.5), roadCurbMat);\n    curb.rotation.x = -Math.PI / 2;\n    curb.position.set(cx, 0.015, cz);\n    masterRoot.add(curb);\n\n    const slab = new THREE.Mesh(new THREE.PlaneGeometry(w, d), roadAsphaltMat);\n    slab.rotation.x = -Math.PI / 2;\n    slab.position.set(cx, 0.02, cz);\n    masterRoot.add(slab);\n  };\n\n  // Main Gate Entrance Spur (from outside gate lx = +22.5 to inner loop lx = +14.0 along lz = 0)\n  addFlatRoadSlab(18.0, 0.0, 9.5, 5.2);\n  // Inner Ring Loop around the Central Transition Zone (Helipad & Stacking Pad)\n  addFlatRoadSlab(14.5, -0.8, 3.4, 15.2); // East loop leg\n  addFlatRoadSlab(3.2, -0.8, 3.2, 15.2);  // West loop leg (in front of HQ)\n  addFlatRoadSlab(8.8, -6.8, 12.0, 3.2);  // North loop leg (in front of Barracks)\n  addFlatRoadSlab(8.8, 5.2, 12.0, 3.4);   // South loop leg (leading to Motor Pool)\n  // Armored Vehicle Motor Pool Paved Apron (in front of Heavy Vehicle Hangar)\n  addFlatRoadSlab(9.2, 10.2, 11.6, 8.2);\n\n  // Dashed yellow road centerlines & Motor Pool parking bay lines\n  for (let gx = 15.2; gx <= 21.8; gx += 2.2) {\n    const dash = new THREE.Mesh(new THREE.PlaneGeometry(1.1, 0.22), roadDashMat);\n    dash.rotation.x = -Math.PI / 2;\n    dash.position.set(gx, 0.026, 0.0);\n    masterRoot.add(dash);\n  }\n  for (const bayX of [6.2, 9.8, 13.2]) {\n    const bayLine = new THREE.Mesh(new THREE.PlaneGeometry(0.18, 4.8), roadDashMat);\n    bayLine.rotation.x = -Math.PI / 2;\n    bayLine.position.set(bayX, 0.026, 11.4);\n    masterRoot.add(bayLine);\n  }\n\n  // =========================================================================\n  // 2. 4 CORNER FORTIFIED BASTIONS (Octagonal Concrete Bunker Turrets)\n  //    Placed at (-10.0, \302\26116.5) and (+19.0, \302\26116.5)\n  // =========================================================================\n  const bastionBaseGeo = new THREE.CylinderGeometry(1.65, 1.85, 2.8, 8);\n  const bastionCapGeo = new THREE.CylinderGeometry(1.82, 1.72, 0.42, 8);\n  const bastionBandGeo = new THREE.CylinderGeometry(1.70, 1.70, 0.26, 8);"
    num_lines: 7024
    num_bytes: 259603
    line_range_bytes: 6678
  }
}
