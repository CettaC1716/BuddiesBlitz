            lines {
              text: "              const prevX = v.x;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const prevZ = v.z;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const prevYaw = v.hullYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const stepRes = stepDumpTruckWheeledPhysics("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  forwardSpeed: v.forwardSpeed ?? 0,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  steerAngle: v.steerAngle ?? 0,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  hullYaw: v.hullYaw,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                { throttle: 0, steer: 0, boost: false },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                dt,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              v.forwardSpeed = stepRes.forwardSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              v.steerAngle = stepRes.steerAngle;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              v.hullYaw = stepRes.hullYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              v.vx = stepRes.vx;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              v.vz = stepRes.vz;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              v.bodyPitchRad = stepRes.bodyPitchRad;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              v.bodyRollRad = stepRes.bodyRollRad;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              v.x = wrapPlanetCoord(v.x + v.vx * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              v.z = wrapPlanetCoord(v.z + v.vz * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              resolveMoverWorldCollisions(v, `truck_${v.id}`, true, 2.1, 12.5, timeSec, false);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              v.bodyGroup.rotation.y = v.hullYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const fwdX = Math.cos(v.hullYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const fwdZ = -Math.sin(v.hullYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const fwdMove ="
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                getPlanetShortestDelta(v.x, prevX) * fwdX +"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                getPlanetShortestDelta(v.z, prevZ) * fwdZ;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              stepLyoDumpTruckAnimation("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                v.bodyGroup,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                fwdMove,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                v.steerAngle,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                evaluateDumpTruckHydraulicCycle(v.dumpAnimTimer ?? 0),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                v.bodyPitchRad,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                v.bodyRollRad,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              recordTankMovementAndTracks(v, prevX, prevZ, prevYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          if (mountedTank) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // ================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // A. DRIVING LYO TANK / DUMP TRUCK OR FLYING LYO PLANE MODE"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // ================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            const isPlane = mountedTank.vehicleKind === \'plane\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            const isTruck = mountedTank.vehicleKind === \'truck\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            const prevTankX = mountedTank.x;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            const prevTankZ = mountedTank.z;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            const prevTankYaw = mountedTank.hullYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            if (isPlane) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              // ---------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              // LYO PLANE FLIGHT & TAKE-OFF PHYSICS (NO REVERSE / BACKWARD!)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              // - Starts on ground (altitude = 0)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              // - [W]: Forward thrust (accelerates forward, auto-takes off from runway, NEVER reverses!)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              // - [Space] / [E] / [ArrowUp]: Take-Off & Climb UP up to 14.5m (higher than 8-10m trees!)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              // - [C] / [Ctrl] / [ArrowDown] / [S]: Descend & Land to ground (0m); [S] also brakes forward speed to 0"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              // ---------------------------------------------------------------"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const MAX_PLANE_ALT = 14.5;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const isForwardThrust = Boolean(keys[\'KeyW\']);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const isAirbrake = Boolean(keys[\'KeyS\']);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const isClimbInput = Boolean("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                keys[\'Space\'] || keys[\'KeyE\'] || keys[\'ArrowUp\'] || keys[\'PageUp\'],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const isDescendInput = Boolean("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                keys[\'KeyC\'] ||"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  keys[\'ControlLeft\'] ||"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  keys[\'ControlRight\'] ||"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  keys[\'ArrowDown\'] ||"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  keys[\'PageDown\'] ||"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  keys[\'KeyS\'],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              );"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              let turn = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              if (keys[\'KeyA\'] || keys[\'ArrowLeft\']) turn += 1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              if (keys[\'KeyD\'] || keys[\'ArrowRight\']) turn -= 1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              let alt = mountedTank.altitude ?? 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              let targetAlt = mountedTank.targetAltitude ?? alt;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              let vSpd = mountedTank.verticalSpeed ?? 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              let fSpd = mountedTank.forwardSpeed ?? 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              // 1. Vertical Altitude & Take-Off Control (0m Ground -> 14.5m Above Trees!)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              if (isClimbInput) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                targetAlt = Math.min(MAX_PLANE_ALT, Math.max(targetAlt + 11.0 * dt, 12.2));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                if (fSpd < 7.0) fSpd = Math.min(7.0, fSpd + 18.0 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              } else if (isDescendInput) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                targetAlt = Math.max(0, targetAlt - 12.0 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                if (keys[\'KeyC\'] || keys[\'ControlLeft\'] || keys[\'ControlRight\']) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  targetAlt = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              } else if (isForwardThrust && alt < 1.5 && fSpd >= 4.2) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                // Automatic runway take-off climb above the trees when accelerating on the ground!"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                targetAlt = Math.max(targetAlt, 11.8);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const altError = targetAlt - alt;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const desiredVy = clamp(altError * 3.8, -11.0, 12.5);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              vSpd += (desiredVy - vSpd) * Math.min(1, 10.0 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              alt = clamp(alt + vSpd * dt, 0, MAX_PLANE_ALT);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              if (alt <= 0.02 && targetAlt <= 0.05) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                alt = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                targetAlt = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                vSpd = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              } else if (alt >= MAX_PLANE_ALT - 0.02 && targetAlt >= MAX_PLANE_ALT - 0.05) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                alt = MAX_PLANE_ALT;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                vSpd = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              // 2. Forward Airspeed Control (Strictly >= 0 \342\200\224 Plane NEVER moves backwards!)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const maxFwdSpeed = isBoosting ? 24.5 : 18.2;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              if (isForwardThrust) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                fSpd = Math.min(maxFwdSpeed, fSpd + (isBoosting ? 22.0 : 16.5) * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              } else if (isAirbrake) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                // Airbrake / Wheel Brake: decelerates forward speed down to 0, NEVER negative!"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                fSpd = Math.max(0, fSpd - 22.0 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              } else {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                // Coasting: maintain smooth forward glide when airborne, stop on ground"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                const minGlideSpeed = alt > 0.35 ? 5.2 : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                if (fSpd > minGlideSpeed) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  fSpd = Math.max(minGlideSpeed, fSpd - 6.0 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                } else if (alt > 0.35 && fSpd < minGlideSpeed) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                  fSpd = Math.min(minGlideSpeed, fSpd + 6.0 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              // 3. Yaw Steering (only turns on the ground if rolling forward, or anytime in the air)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              if (turn !== 0 && (alt > 0.2 || fSpd > 0.4)) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                const turnRate = REA_CONSTANTS.physics.drive.rotationSpeed * (alt > 0.2 ? 1.28 : 0.95);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                mountedTank.hullYaw += turn * turnRate * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const fwdX = Math.cos(mountedTank.hullYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const fwdZ = -Math.sin(mountedTank.hullYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              mountedTank.vx = fwdX * fSpd;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              mountedTank.vz = fwdZ * fSpd;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              // Seamless 360\302\260 Spherical Loop Wrapping!"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              mountedTank.x = wrapPlanetCoord(mountedTank.x + mountedTank.vx * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              mountedTank.z = wrapPlanetCoord(mountedTank.z + mountedTank.vz * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              // Low-altitude collision resolution when plane is taxiing or flying below tree/building height (alt < 3.5m)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              if (alt < 3.5) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                resolveMoverWorldCollisions(mountedTank, \'player_plane\', true, 1.95, 7.0, timeSec, true);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                mountedTank.forwardSpeed = Math.hypot(mountedTank.vx, mountedTank.vz);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                fSpd = mountedTank.forwardSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              mountedTank.altitude = alt;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              mountedTank.targetAltitude = targetAlt;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              mountedTank.verticalSpeed = vSpd;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              mountedTank.forwardSpeed = fSpd;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              mountedTank.root.position.set(mountedTank.x, getTerrainElevation(mountedTank.x, mountedTank.z), mountedTank.z);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              mountedTank.bodyGroup.rotation.y = mountedTank.hullYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              activeSpeed = fSpd;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              soundEngine.updateVehicleMovementLoop(activeSpeed, isBoosting && isForwardThrust, alt < 1.2);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const sh = mountedTank.root.getObjectByName(\'ContactShadowDisc\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              if (sh) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                const sc = Math.max(1.5, 3.6 - alt * 0.13);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                sh.scale.set(sc, sc * 0.88, 1);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              const isPlaneFiring = Boolean(isPointerDown);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              stepLyoPlaneAnimation("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                mountedTank.bodyGroup,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                dt,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                turn,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                isForwardThrust ? 1 : 0,"
