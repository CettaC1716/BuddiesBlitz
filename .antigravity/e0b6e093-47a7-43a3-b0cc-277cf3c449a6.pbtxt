  view_file {
    absolute_path_uri: "file:///src/game/lyoAssetsAndShaders.ts"
    end_line: 119
    content: "import * as THREE from \'three\';\nimport { GLTFLoader, GLTF } from \'three/addons/loaders/GLTFLoader.js\';\nimport { DRACOLoader } from \'three/addons/loaders/DRACOLoader.js\';\nimport { KTX2Loader } from \'three/addons/loaders/KTX2Loader.js\';\nimport { mergeGeometries, mergeVertices } from \'three/addons/utils/BufferGeometryUtils.js\';\nimport {\n  classifyDumpTruckMeshIsland,\n  evaluateDumpTruckHydraulicCycle,\n  stepMilitaryBaseBoomBarrier,\n  DumpTruckIslandRole,\n  DumpTruckHydraulicState,\n} from \'./rules\';\nimport {\n  PLANET_CURVATURE_STRENGTH,\n  PLANET_HALF_EXTENT,\n  PLANET_WORLD_PERIOD,\n  PLANET_RIVERBED_DEPTH,\n  PLANET_WATER_SURFACE_Y,\n  PLANET_BRIDGES,\n  PlanetBridgeSpec,\n  SCULPT_GRID_SIZE,\n  terrainSculptRgbaData,\n  terrainSculptVersion,\n  applyTerrainSculptBrush,\n  resetTerrainSculptGrid,\n  serializeTerrainSculptGrid,\n  restoreTerrainSculptGrid,\n  getSingleRiverCenterZ,\n  wrapPlanetCoord,\n  getPlanetShortestDelta,\n  getPlanetShortestDistance,\n  getTolanWaterSdf,\n  evaluateRoadNetworkSdf,\n  evaluateNwLakeSdf,\n  evaluateSeHarborSdf,\n  samplePlanetMultiOctaveNoise,\n  evaluateLyoGrassMask,\n  getRawGroundElevation,\n  getBridgeDeckElevation,\n  getTerrainElevation,\n  samplePlanetCurvature,\n  computePlanetYOffset,\n  computePlanetSurfaceNormal,\n  applyPlanetCurvatureToObject,\n  evaluateTolanWaterField,\n} from \'./planetCurvature\';\n\nexport {\n  PLANET_CURVATURE_STRENGTH,\n  PLANET_HALF_EXTENT,\n  PLANET_WORLD_PERIOD,\n  PLANET_RIVERBED_DEPTH,\n  PLANET_WATER_SURFACE_Y,\n  PLANET_BRIDGES,\n  SCULPT_GRID_SIZE,\n  terrainSculptRgbaData,\n  terrainSculptVersion,\n  applyTerrainSculptBrush,\n  resetTerrainSculptGrid,\n  serializeTerrainSculptGrid,\n  restoreTerrainSculptGrid,\n  getSingleRiverCenterZ,\n  wrapPlanetCoord,\n  getPlanetShortestDelta,\n  getPlanetShortestDistance,\n  getTolanWaterSdf,\n  evaluateRoadNetworkSdf,\n  evaluateNwLakeSdf,\n  evaluateSeHarborSdf,\n  samplePlanetMultiOctaveNoise,\n  evaluateLyoGrassMask,\n  getRawGroundElevation,\n  getBridgeDeckElevation,\n  getTerrainElevation,\n  samplePlanetCurvature,\n  computePlanetYOffset,\n  computePlanetSurfaceNormal,\n  applyPlanetCurvatureToObject,\n  evaluateTolanWaterField,\n};\nexport type { PlanetBridgeSpec };\n\n/**\n * Shared GLSL functions for the Original Long Hoang (Lyo) Flat Ground Map (elevation = 0, curvature = 0):\n * - evaluateLyoGrassMask(vec2 p): soft organic splatmap mask between warm sandy-brown dirt (#d6a868)\n *   and lush green grass (#4ea832 -> #9be15d), matching planetCurvature.ts 1:1 on CPU and GPU.\n * - getRawGroundElevation(vec2 p): 0.0 everywhere by default (+ optional Map Editor sculpt offset).\n */\nconst PLANET_TERRAIN_GLSL_SNIPPET = /* glsl */ `\n  uniform sampler2D uSculptMap;\n\n  vec2 wrapPlanetVec2(vec2 p) {\n    return clamp(p, vec2(-80.0), vec2(80.0));\n  }\n\n  float samplePlanetMultiOctaveNoise(vec2 p) {\n    float k1 = 0.07853981633974483;\n    float k2 = 0.15707963267948966;\n    float k3 = 0.3141592653589793;\n\n    float octave1 = sin(p.x * k1 + cos(p.y * k1) * 1.15) * cos(p.y * k1 - sin(p.x * k1) * 0.95);\n    float octave2 = sin(p.x * k2 - p.y * k1 * 1.5 + 1.3) * 0.55 + cos(p.y * k2 + p.x * k1 - 0.8) * 0.45;\n    float octave3 = sin(p.x * k3 + p.y * k2) * cos(p.y * k3 - p.x * k2);\n\n    return octave1 * 0.58 + octave2 * 0.28 + octave3 * 0.14;\n  }\n\n  float sdSegment2D(vec2 p, vec2 a, vec2 b) {\n    vec2 pa = p - a;\n    vec2 ba = b - a;\n    float h = clamp(dot(pa, ba) / (dot(ba, ba) + 1e-6), 0.0, 1.0);\n    return length(pa - ba * h);\n  }\n\n  float sdRoundedBox2D(vec2 p, vec2 c, vec2 h, float r) {\n    vec2 q = abs(p - c) - h + r;\n    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;\n  }\n\n  float lyoSmin(float a, float b, float k) {"
