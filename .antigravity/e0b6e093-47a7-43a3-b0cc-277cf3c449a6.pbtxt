    command_line: "node -e \"\nconst fs = require(\'fs\');\n// Let\'s inspect ConcreteFence_1A.REF\n// translation: [3.1696, 0.8349, -0.0703], scale: [0.5922, 0.5922, 0.5922]\n// mesh vertices: min=[-1.4716, -1.4099, -0.5228], max=[1.4712, 1.7995, 0.5219]\nconst min = [-1.471612, -1.409928, -0.522794];\nconst max = [1.471196, 1.799501, 0.521940];\nconst rawSx = max[0] - min[0];\nconst rawSy = max[1] - min[1];\nconst rawSz = max[2] - min[2];\nconsole.log(\'Raw mesh dimensions:\', { rawSx, rawSy, rawSz });\n// after node scale (0.59220665)\nconst scaledSx = rawSx * 0.59220665;\nconst scaledSy = rawSy * 0.59220665;\nconst scaledSz = rawSz * 0.59220665;\nconsole.log(\'Oriented root dimensions:\', { scaledSx, scaledSy, scaledSz });\n// maxSpan = Math.max(size.y, size.x * 0.55, size.z * 0.55)\nconst maxSpan = Math.max(scaledSy, scaledSx * 0.55, scaledSz * 0.55);\nconst targetHeight = 2.2;\nconst scale = targetHeight / maxSpan;\nconsole.log(\'Final scale factor in spawnRealLyoPropFromGlb:\', scale);\nconsole.log(\'Final prop width (X):\', scaledSx * scale);\nconsole.log(\'Final prop height (Y):\', scaledSy * scale);\nconsole.log(\'Final prop depth (Z):\', scaledSz * scale);\n\""
