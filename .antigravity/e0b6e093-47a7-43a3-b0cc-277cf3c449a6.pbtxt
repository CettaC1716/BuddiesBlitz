  view_file {
    absolute_path_uri: "file:///src/game/lyoAssetsAndShaders.ts"
    start_line: 2119
    end_line: 2169
    content: " * (such as turbine.glb, power-core.glb, crane.glb, dump-truck.glb, chimney.glb, lamppost-1a.glb),\n * preserves the upright .REF orientation so Blender Z-up exports (like WindTurbine.REF) stand\n * vertically upright, hooks up spinning WindFan / PowerCore_Fan child nodes, applies Lyo\'s\n * WorldMaterial + Stroke Outline, and grounds it cleanly at (x, 0, z).\n */\nexport function spawnRealLyoPropFromGlb(\n  parent: THREE.Object3D,\n  gltf: GLTF | null,\n  x: number,\n  z: number,\n  rotY: number,\n  targetHeight: number,\n  windUniforms: LyoWindUniforms,\n  isSoftwareGl: boolean,\n): THREE.Group | null {\n  if (!gltf || !gltf.scene) return null;\n  gltf.scene.updateMatrixWorld(true);\n\n  const refNodes: THREE.Object3D[] = [];\n  gltf.scene.traverse((obj) => {\n    const n = (obj.name || \'\').toLowerCase();\n    if (!n.includes(\'pc_monitor\') && n.endsWith(\'ref\')) {\n      refNodes.push(obj);\n    }\n  });\n\n  let selectedSources: THREE.Object3D[] = [];\n  if (refNodes.length > 0) {\n    // Pick the primary .REF node (prefer *_base.ref if present, e.g. Crane_Base.REF + Crane_Top.REF)\n    const primaryRef =\n      refNodes.find((r) => r.name.toLowerCase().includes(\'base\')) || refNodes[0];\n    // Include any sibling .REF nodes that share the same X/Z footprint (e.g. Crane_Top.REF above Crane_Base.REF)\n    selectedSources = refNodes.filter(\n      (r) =>\n        Math.hypot(r.position.x - primaryRef.position.x, r.position.z - primaryRef.position.z) < 0.6,\n    );\n  } else {\n    for (const ch of gltf.scene.children) {\n      let hasMesh = false;\n      ch.traverse((m) => {\n        if ((m as THREE.Mesh).isMesh && !isLyoColliderOrHelperNode(m)) hasMesh = true;\n      });\n      if (hasMesh) {\n        selectedSources = [ch];\n        break;\n      }\n    }\n  }\n\n  if (selectedSources.length === 0) {\n    selectedSources = [gltf.scene];"
    num_lines: 7024
    num_bytes: 259603
    line_range_bytes: 1818
  }
}
