  view_file {
    absolute_path_uri: "file:///src/game/lyoAssetsAndShaders.ts"
    start_line: 2169
    end_line: 2249
    content: "    selectedSources = [gltf.scene];\n  }\n\n  const anchorPos = selectedSources[0].position.clone();\n  const propGroup = new THREE.Group();\n  const windFanNodes: { mesh: THREE.Object3D; baseQuat: THREE.Quaternion }[] = [];\n  const spinYNodes: { mesh: THREE.Object3D; baseQuat: THREE.Quaternion; speed: number }[] = [];\n\n  for (const source of selectedSources) {\n    source.updateMatrixWorld(true);\n    const invSourceMat = source.matrixWorld.clone().invert();\n\n    // Preserve source\'s upright quaternion & scale (critical for WindTurbine.REF, Barricade.REF, PipeCluster.REF!)\n    const orientedRoot = new THREE.Group();\n    orientedRoot.name = source.name || \'OrientedRefRoot\';\n    orientedRoot.position.subVectors(source.position, anchorPos);\n    orientedRoot.quaternion.copy(source.quaternion);\n    orientedRoot.scale.copy(source.scale);\n\n    source.traverse((child) => {\n      if ((child as THREE.Mesh).isMesh && !isLyoColliderOrHelperNode(child)) {\n        const srcMesh = child as THREE.Mesh;\n        const isDumpTruckRef =\n          (source.name || \'\').toLowerCase().includes(\'dumptruck\') ||\n          (srcMesh.name || \'\').toLowerCase().includes(\'cube.389\');\n        const cleanGeo = isDumpTruckRef\n          ? buildDumpTruckGeometryWithoutPipes(srcMesh.geometry)\n          : srcMesh.geometry;\n        const cloned = new THREE.Mesh(cleanGeo, srcMesh.material);\n        cloned.name = srcMesh.name;\n        child.updateMatrixWorld(true);\n        const rel = new THREE.Matrix4().multiplyMatrices(invSourceMat, child.matrixWorld);\n        rel.decompose(cloned.position, cloned.quaternion, cloned.scale);\n        cloned.frustumCulled = false;\n        cloned.castShadow = true;\n        cloned.receiveShadow = true;\n        upgradeMeshToLyoWorldMaterial(cloned, windUniforms);\n        const stroke = createLyoStrokeMesh(cleanGeo, 0.026);\n        if (stroke) {\n          stroke.frustumCulled = false;\n          cloned.add(stroke);\n        }\n        orientedRoot.add(cloned);\n\n        const lowerName = (child.name || \'\').toLowerCase();\n        if (lowerName.includes(\'windfan\')) {\n          windFanNodes.push({\n            mesh: cloned,\n            baseQuat: cloned.quaternion.clone(),\n          });\n        } else if (lowerName.includes(\'powercore_fan\')) {\n          spinYNodes.push({\n            mesh: cloned,\n            baseQuat: cloned.quaternion.clone(),\n            speed: 4.2,\n          });\n        }\n      }\n    });\n\n    // WindTurbine.REF (turbine.glb):\n    // Bridge bottom base (pangkal) and top nacelle (turbin atas) with a crisp white tower pole (#f4f3ee)\n    // and black horizontal stripe bands (#181920), casting tall spinning rotor shadows onto the grass!\n    if (windFanNodes.length > 0) {\n      const towerMastGeo = new THREE.CylinderGeometry(0.84, 0.56, 18.0, 20);\n      const towerMastMesh = new THREE.Mesh(\n        towerMastGeo,\n        new THREE.MeshStandardMaterial({ color: \'#f4f3ee\' }),\n      );\n      towerMastMesh.name = \'WindTurbine_TowerMastConnector\';\n      towerMastMesh.position.set(0, -1.73209, 9.5);\n      towerMastMesh.rotation.x = Math.PI / 2;\n      towerMastMesh.frustumCulled = false;\n      towerMastMesh.castShadow = true;\n      towerMastMesh.receiveShadow = true;\n      upgradeMeshToLyoWorldMaterial(towerMastMesh, windUniforms, \'#f4f3ee\');\n      const mastStroke = createLyoStrokeMesh(towerMastGeo, 0.026);\n      if (mastStroke) {\n        mastStroke.frustumCulled = false;\n        towerMastMesh.add(mastStroke);\n      }"
    num_lines: 7024
    num_bytes: 259603
    line_range_bytes: 3458
  }
}
