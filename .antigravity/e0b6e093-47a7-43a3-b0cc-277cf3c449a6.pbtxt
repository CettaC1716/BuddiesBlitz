    end_line: 149
    content: "import React, { useEffect, useRef } from \'react\';\nimport * as THREE from \'three\';\nimport {\n  REA_CONSTANTS,\n  LIGHTING_PRESETS,\n  LightingPresetKey,\n  stepCriticalDampedSpring3D,\n  computeTankSpeedStep,\n  stepTurretYaw,\n  clamp,\n  Vec3,\n  CrateSlotType,\n  evaluateStackingPadRecipe,\n  chooseNextPadSlotIndex,\n  BuildOrderTarget,\n  BUILD_ORDER_SPECS,\n  resolveCursorCommandTarget,\n  BUDDY_CLASSES,\n  BuddyClassId,\n  TeamCommandMode,\n  ColliderCategory,\n  CollisionMaterialTag,\n  getPropCollisionSpec,\n  resolveSolidCollision2D,\n  computePushableImpulse2D,\n  shouldShatterBreakableProp,\n  canTriggerCollisionCooldown,\n  DUMP_TRUCK_MAX_CRATES,\n  canLoadCrateIntoDumpTruck,\n  evaluateDumpTruckHydraulicCycle,\n  stepDumpTruckWheeledPhysics,\n} from \'./rules\';\nimport {\n  evaluateRoadNetworkSdf,\n  evaluateNwLakeSdf,\n  evaluateSeHarborSdf,\n} from \'./planetCurvature\';\nimport { soundEngine } from \'./audio\';\nimport {\n  loadAllRealLyoAssets,\n  createLyoInfiniteGrassSystem,\n  createTolanCurvedPlanetEnvironment,\n  applyPlanetCurvatureToObject,\n  computePlanetYOffset,\n  getTerrainElevation,\n  wrapPlanetCoord,\n  getPlanetShortestDelta,\n  getPlanetShortestDistance,\n  PLANET_CURVATURE_STRENGTH,\n  applyTerrainSculptBrush,\n  resetTerrainSculptGrid,\n  serializeTerrainSculptGrid,\n  restoreTerrainSculptGrid,\n  populateRealLyoTreeFromGlb,\n  populateRealLyoTankFromGlb,\n  populateRealLyoDumpTruckFromGlb,\n  stepLyoDumpTruckAnimation,\n  syncLyoDumpTruckCargoVisuals,\n  populateRealLyoCrateBoxFromGlb,\n  buildProceduralLyoPlane,\n  stepLyoPlaneAnimation,\n  buildProceduralRobloxBuddyAvatar,\n  updateCharacterWeaponStance,\n  RobloxBuddyRig,\n  LyoWeaponId,\n  stepLyoTankTracks,\n  spawnRealLyoPropFromGlb,\n  stepRealLyoPropsAnimation,\n  getLyoDefaultLightDirection,\n  LoadedLyoAssets,\n  LyoWindUniforms,\n  createLyoExplosionSystem,\n  buildMilitaryBaseMasterplan,\n  stepMilitaryBaseMasterplanAnimation,\n} from \'./lyoAssetsAndShaders\';\n\n\nexport type GameState = \'title\' | \'playing\' | \'paused\' | \'gameover\';\nexport type PlayMode = \'sandbox\' | \'editor\' | \'match\';\n\nexport type EditorToolId =\n  | \'sculpt_raise\'\n  | \'sculpt_lower\'\n  | \'sculpt_flatten\'\n  | \'move_blue_hq\'\n  | \'move_blue_pad\'\n  | \'move_red_hq\'\n  | \'move_red_pad\'\n  | \'move_drop_zone\'\n  | \'dump_truck\'\n  | \'crane\'\n  | \'chimney\'\n  | \'giant_tank\'\n  | \'tank_1a\'\n  | \'pipe_cluster\'\n  | \'giant_pipe\'\n  | \'power_core\'\n  | \'concrete_fence\'\n  | \'barricade\'\n  | \'lamppost_1a\'\n  | \'explosive_barrel\'\n  | \'hydrant\'\n  | \'tree_gold\'\n  | \'tree_purple\'\n  | \'turbine\'\n  | \'bench\'\n  | \'wheelbarrow\'\n  | \'river_rock\'\n  | \'flower_cluster\';\n\nexport interface PlacedMapProp {\n  id: number;\n  kind:\n    | \'tree_purple\'\n    | \'tree_gold\'\n    | \'turbine\'\n    | \'power_core\'\n    | \'concrete_fence\'\n    | \'barricade\'\n    | \'explosive_barrel\'\n    | \'hydrant\'\n    | \'lamppost_1a\'\n    | \'lamppost_1b\'\n    | \'bench\'\n    | \'chimney\'\n    | \'giant_tank\'\n    | \'dump_truck\'\n    | \'crane\'\n    | \'recycle_bin\'\n    | \'traffic_cone\'\n    | \'wheelbarrow\'\n    | \'tank_1a\'\n    | \'pipe_cluster\'\n    | \'giant_pipe\'\n    | \'river_rock\'\n    | \'flower_cluster\';\n  x: number;\n  z: number;\n  rotY: number;\n  scale: number;\n}\n\nexport interface ArenaMapLayout {\n  blueHq: { x: number; z: number };\n  bluePad: { x: number; z: number };\n  redHq: { x: number; z: number };\n  redPad: { x: number; z: number };\n  centerDropZone: { x: number; z: number };\n  props: PlacedMapProp[];\n  sculptData?: number[];"
