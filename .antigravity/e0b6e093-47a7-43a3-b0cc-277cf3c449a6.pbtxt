eside Wildflower & Shrub Clusters (flower_cluster)\n    { id: 320, kind: \'flower_cluster\', x: -55.0, z: -52.5, rotY: 0.0, scale: 1.35 },\n    { id: 321, kind: \'flower_cluster\', x: -38.0, z: -50.5, rotY: 0.8, scale: 1.30 },\n    { id: 322, kind: \'flower_cluster\', x: -36.5, z: -33.5, rotY: 1.5, scale: 1.35 },\n    { id: 323, kind: \'flower_cluster\', x: -53.5, z: -30.5, rotY: 2.1, scale: 1.30 },\n    { id: 324, kind: \'flower_cluster\', x: -59.5, z: -45.5, rotY: 0.4, scale: 1.35 },\n    { id: 325, kind: \'flower_cluster\', x: -44.5, z: -54.5, rotY: 1.2, scale: 1.30 },\n\n    // Lakeside Trees (tree-1a.glb & tree-1b.glb)\n    { id: 330, kind: \'tree_gold\', x: -58.0, z: -53.5, rotY: 0.3, scale: 1.12 },\n    { id: 331, kind: \'tree_purple\', x: -38.5, z: -54.5, rotY: -0.5, scale: 1.10 },\n    { id: 332, kind: \'tree_gold\', x: -33.5, z: -41.5, rotY: 0.7, scale: 1.12 },\n    { id: 333, kind: \'tree_purple\', x: -37.5, z: -26.5, rotY: -0.4, scale: 1.08 },\n    { id: 334, kind: \'tree_gold\', x: -51.5, z: -25.5, rotY: 0.6, scale: 1.10 },\n    { id: 335, kind: \'tree_purple\', x: -61.5, z: -31.5, rotY: -0.8, scale: 1.12 },\n\n    // =========================================================================\n    // 4. KUADRAN KANAN BAWAH (x > +26, z > +14): DERMAGA PELABUHAN CRANE\n    //    - Concrete harbor apron, sea basin in SE corner, yellow crane.glb on pier\n    // =========================================================================\n    { id: 401, kind: \'crane\', x: 50.5, z: 50.5, rotY: Math.PI / 4, scale: 1.24 },\n    { id: 402, kind: \'giant_tank\', x: 58.5, z: 33.5, rotY: 0.0, scale: 1.16 },\n    { id: 403, kind: \'chimney\', x: 61.0, z: 42.5, rotY: -0.3, scale: 1.18 },\n    { id: 404, kind: \'tank_1a\', x: 45.5, z: 24.5, rotY: 0.0, scale: 1.12 },\n    { id: 405, kind: \'pipe_cluster\', x: 44.5, z: 42.5, rotY: Math.PI / 4, scale: 1.12 },\n    { id: 406, kind: \'giant_pipe\', x: 39.5, z: 56.5, rotY: 0.2, scale: 1.10 },\n    { id: 407, kind: \'wheelbarrow\', x: 46.5, z: 34.5, rotY: -0.5, scale: 1.12 },\n    { id: 408, kind: \'barricade\', x: 33.0, z: 26.5, rotY: Math.PI / 2, scale: 1.08 },\n    { id: 409, kind: \'barricade\', x: 33.0, z: 48.5, rotY: Math.PI / 2, scale: 1.08 },\n    { id: 410, kind: \'explosive_barrel\', x: 41.5, z: 36.5, rotY: 0.3, scale: 1.06 },\n    { id: 411, kind: \'explosive_barrel\', x: 48.5, z: 45.5, rotY: -0.4, scale: 1.06 },\n    { id: 412, kind: \'lamppost_1b\', x: 32.5, z: 22.0, rotY: Math.PI / 2, scale: 1.0 },\n    { id: 413, kind: \'lamppost_1b\', x: 32.5, z: 54.0, rotY: Math.PI / 2, scale: 1.0 },\n  ],\n};\n\nexport interface RadarDot {\n  id: string;\n  kind: \'player\' | \'ally\' | \'enemy\' | \'crate_red\' | \'crate_super\' | \'tank_blue\' | \'tank_red\';\n  x: number;\n  z: number;\n}\n\nexport interface HudSnapshot {\n  hp: number;\n  maxHp: number;\n  score: number;\n  bestScore: number;\n  speedKmh: number;\n  isBoosting: boolean;\n  isGrabMode: boolean;\n  grabbedPropName: string | null;\n  collectedItems: string[];\n  powerCoreActivated: boolean;\n  enemiesDefeated: number;\n  totalEnemies: number;\n  lightingPreset: LightingPresetKey;\n  cameraFovMode: \'webgl35\' | \'roblox18\';\n  outcome: \'victory\' | \'defeat\' | null;\n  clearTimeSec: number;\n  // Team Buddies 3D World State\n  controlMode: \'buddy\' | \'tank\';\n  activeClass: BuddyClassId;\n  equippedWeapon: string;\n  ammo: number;\n  carryingCrate: \'none\' | \'red\' | \'super\';\n  tankStoredCrates: number;"
