    content: "  // B. Ground-Level Checkpoint Guardhouse Booth & Sandbag Defensive Bunker\n  addBasePart(checkpointGroup, new THREE.BoxGeometry(2.15, 2.15, 2.05), COL_OLIVE_WALL, [0.45, 1.08, 1.35]);\n  addBasePart(checkpointGroup, new THREE.BoxGeometry(2.4, 0.22, 2.3), COL_CONCRETE_DARK, [0.45, 2.24, 1.35]);\n  addBasePart(checkpointGroup, new THREE.BoxGeometry(0.22, 0.72, 1.25), COL_GLASS, [1.46, 1.32, 1.35], [0, 0, 0], [1, 1, 1], 0);\n  addSandbagWallSegment(checkpointGroup, 1.65, -0.45, Math.PI / 2, 3, 3);\n\n  // C. Animated Red-and-White Boom Barrier across Main Perimeter Gate (+19.0, 0)\n  // Gate spans lz in [-3.1 .. +3.1] at lx = +18.8\n  const gatePostGroup = new THREE.Group();\n  gatePostGroup.name = \'PerimeterGateBoomBarrier\';\n  gatePostGroup.position.set(18.8, 0, -3.1);\n  masterRoot.add(gatePostGroup);\n\n  // Red Hydraulic Boom Pedestal Housing + Security Intercom Kiosk\n  addBasePart(gatePostGroup, new THREE.BoxGeometry(0.58, 1.28, 0.58), COL_RED_GATE, [0, 0.64, 0]);\n  addBasePart(gatePostGroup, new THREE.BoxGeometry(0.64, 0.16, 0.64), COL_STEEL, [0, 1.32, 0]);\n  addBasePart(gatePostGroup, new THREE.BoxGeometry(0.42, 1.15, 0.42), COL_CONCRETE, [-0.65, 0.58, -0.55]);\n\n  // Opposite Gate Catch Post at lz = +3.1 (relative to gatePostGroup at -3.1 -> +6.2m along Z)\n  addBasePart(gatePostGroup, new THREE.BoxGeometry(0.48, 1.18, 0.48), COL_CONCRETE, [0, 0.59, 6.2]);\n  addBasePart(gatePostGroup, new THREE.BoxGeometry(0.56, 1.85, 0.56), COL_CONCRETE_DARK, [0.2, 0.92, 6.9]);\n  addBasePart(gatePostGroup, new THREE.BoxGeometry(0.56, 1.85, 0.56), COL_CONCRETE_DARK, [0.2, 0.92, -0.7]);\n\n  // Pivoting Red-and-White Striped Boom Barrier Arm (pivots around X axis at y = 1.05m)\n  const boomArmPivot = new THREE.Group();\n  boomArmPivot.name = \'BoomBarrier_ArmPivot\';\n  boomArmPivot.position.set(0, 1.05, 0.15);\n  gatePostGroup.add(boomArmPivot);\n\n  // 8 Alternating Red and White Segments totaling 5.76m length across the gate!\n  const segLen = 0.72;\n  for (let s = 0; s < 8; s++) {\n    const segColor = s % 2 === 0 ? COL_RED_GATE : COL_WHITE;\n    addBasePart(\n      boomArmPivot,\n      new THREE.BoxGeometry(0.16, 0.16, segLen),\n      segColor,\n      [0, 0, (s + 0.5) * segLen],\n      [0, 0, 0],\n      [1, 1, 1],\n      0.014,\n    );\n  }\n  // Counterweight block on the back of the boom arm\n  addBasePart(boomArmPivot, new THREE.BoxGeometry(0.28, 0.34, 0.55), COL_STEEL, [0, 0, -0.35], [0, 0, 0], [1, 1, 1], 0.015);\n\n  // Attach live per-frame animation controller to baseGroup\n  let animClock = team === \'blue\' ? 0 : Math.PI;\n  let currentBoomAngleRad = 0;\n\n  Object.defineProperty(baseGroup, \'__stepMilitaryBaseMasterplan\', {"
