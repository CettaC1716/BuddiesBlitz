  view_file {
    absolute_path_uri: "file:///src/game/lyoAssetsAndShaders.ts"
    start_line: 6779
    end_line: 6809
    content: "\n  // =========================================================================\n  // 7. BUILDING 4: PERIMETER CHECKPOINT, GUARD WATCHTOWER & ANIMATED BOOM BARRIER (screen_215b649a.png)\n  //    Located at Main Perimeter Gate: Local (+19.0, 0, 0.0)\n  // =========================================================================\n  const checkpointGroup = new THREE.Group();\n  checkpointGroup.name = \'PerimeterCheckpointWatchtower\';\n  checkpointGroup.position.set(17.2, 0, -5.2);\n  masterRoot.add(checkpointGroup);\n\n  // A. High-Elevation X-Truss Guard Watchtower (height ~ 8.8m)\n  const towerH = 5.6;\n  const legSpreadBot = 1.25;\n  const legSpreadTop = 0.98;\n  // 4 Tapered Corner Steel Legs\n  for (const sx of [-1, 1]) {\n    for (const sz of [-1, 1]) {\n      const midX = sx * ((legSpreadBot + legSpreadTop) * 0.5);\n      const midZ = sz * ((legSpreadBot + legSpreadTop) * 0.5);\n      const tilt = (legSpreadBot - legSpreadTop) / towerH;\n      addBasePart(\n        checkpointGroup,\n        new THREE.CylinderGeometry(0.085, 0.11, towerH, 8),\n        COL_OLIVE_DARK,\n        [midX, towerH * 0.5, midZ],\n        [-sz * tilt, 0, sx * tilt],\n        [1, 1, 1],\n        0.016,\n      );\n    }\n  }"
    num_lines: 7024
    num_bytes: 259603
    line_range_bytes: 1188
  }
}
