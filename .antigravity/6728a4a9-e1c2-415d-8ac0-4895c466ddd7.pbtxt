        replacement_chunks {
          target_content: "      // 4. Camera: Follow Camera (Sandbox/Match) vs High Top-Down Orbit Overview (Map Editor)\n      const focusTarget: Vec3 =\n        state === \'title\'\n          ? { x: 2.0, y: 0.9, z: 13.0 }\n          : currentPlayMode === \'editor\'\n          ? { x: editorPan.x, y: 0.5, z: editorPan.z }\n          : mountedTank\n          ? { x: mountedTank.x, y: 1.1, z: mountedTank.z }\n          : { x: playerUnit.x, y: 1.0, z: playerUnit.z };\n\n      const springStep = stepCriticalDampedSpring3D(\n        camFollowPos,\n        focusTarget,\n        camFollowVel,\n        currentPlayMode === \'editor\' ? 18 : Math.max(8, activeSpeed),\n        dt,\n      );\n      camFollowPos = springStep.position;\n      camFollowVel = springStep.velocity;\n\n      const panAlpha = 1 - Math.exp(-REA_CONSTANTS.camera.mousePan.dampSpeed * dt);\n      const panScale =\n        state === \'title\'\n          ? 0.3\n          : currentPlayMode === \'editor\'\n          ? 0.0\n          : REA_CONSTANTS.camera.mousePan.sensitivity;\n      mousePanCurrent.x += (mouseNdc.x * panScale - mousePanCurrent.x) * panAlpha;\n      mousePanCurrent.z += (-mouseNdc.y * panScale - mousePanCurrent.z) * panAlpha;\n\n      recoilOffset.x *= Math.exp(-10 * dt);\n      recoilOffset.z *= Math.exp(-10 * dt);\n      shakeTrauma = Math.max(0, shakeTrauma - dt * 2.5);\n      const shakeAmt = shakeTrauma * shakeTrauma * 0.35;\n      const shakeX = (Math.random() - 0.5) * shakeAmt;\n      const shakeZ = (Math.random() - 0.5) * shakeAmt;\n\n      const fovScale = cameraFovModeRef.current === \'roblox18\' ? 1.85 : 1.0;\n      const zoomMult = state === \'title\' ? 1.0 : cameraZoom;\n      const camOffset =\n        state === \'title\'\n          ? { x: -3.2, y: 11.2, z: 13.5 }\n          : currentPlayMode === \'editor\'\n          ? { x: 0, y: 54.0 * editorZoom, z: 22.0 * editorZoom }\n          : { x: 0, y: 16.5 * zoomMult, z: 13.8 * zoomMult };\n\n      const finalLookX = camFollowPos.x + mousePanCurrent.x + recoilOffset.x + shakeX;\n      const finalLookZ = camFollowPos.z + mousePanCurrent.z + recoilOffset.z + shakeZ;\n\n      camera.position.set(\n        finalLookX + camOffset.x * fovScale,\n        camFollowPos.y + camOffset.y * fovScale,\n        finalLookZ + camOffset.z * fovScale,\n      );\n      camera.lookAt(finalLookX, camFollowPos.y, finalLookZ);\n\n      dirLight.position.set(finalLookX + 14, 34, finalLookZ + 16);\n      dirLight.target.position.set(finalLookX, 0, finalLookZ);\n\n      renderer.render(scene, camera);"
          replacement_content: "      // 4. Camera: Low-Angle Horizon Chase Camera (Sandbox/Match/Title) vs High Top-Down Overview (Map Editor)\n      const focusTarget: Vec3 =\n        state === \'title\'\n          ? { x: 0.0, y: 0.0, z: 12.5 }\n          : currentPlayMode === \'editor\'\n          ? { x: editorPan.x, y: 0.5, z: editorPan.z }\n          : mountedTank\n          ? { x: mountedTank.x, y: 0.2, z: mountedTank.z }\n          : { x: playerUnit.x, y: 0.0, z: playerUnit.z };\n\n      const springStep = stepCriticalDampedSpring3D(\n        camFollowPos,\n        focusTarget,\n        camFollowVel,\n        currentPlayMode === \'editor\' ? 18 : Math.max(8, activeSpeed),\n        dt,\n      );\n      camFollowPos = springStep.position;\n      camFollowVel = springStep.velocity;\n\n      const panAlpha = 1 - Math.exp(-REA_CONSTANTS.camera.mousePan.dampSpeed * dt);\n      const panScale =\n        state === \'title\'\n          ? 0.35\n          : currentPlayMode === \'editor\'\n          ? 0.0\n          : REA_CONSTANTS.camera.mousePan.sensitivity;\n      mousePanCurrent.x += (mouseNdc.x * panScale - mousePanCurrent.x) * panAlpha;\n      mousePanCurrent.z += (-mouseNdc.y * panScale - mousePanCurrent.z) * panAlpha;\n\n      recoilOffset.x *= Math.exp(-10 * dt);\n      recoilOffset.z *= Math.exp(-10 * dt);\n      shakeTrauma = Math.max(0, shakeTrauma - dt * 2.5);\n      const shakeAmt = shakeTrauma * shakeTrauma * 0.35;\n      const shakeX = (Math.random() - 0.5) * shakeAmt;\n      const shakeZ = (Math.random() - 0.5) * shakeAmt;\n\n      const fovScale = cameraFovModeRef.current === \'roblox18\' ? 1.85 : 1.0;\n      const zoomMult = state === \'title\' ? 1.0 : cameraZoom;\n\n      if (currentPlayMode === \'editor\' && state !== \'title\') {\n        const editorLookX = camFollowPos.x + recoilOffset.x + shakeX;\n        const editorLookZ = camFollowPos.z + recoilOffset.z + shakeZ;\n        camera.position.set(\n          editorLookX,\n          camFollowPos.y + 54.0 * editorZoom * fovScale,\n          editorLookZ + 22.0 * editorZoom * fovScale,\n        );\n        camera.lookAt(editorLookX, camFollowPos.y, editorLookZ);\n      } else {\n        // Low-Angle Horizon Chase Camera:\n        // Height Y = +5.2, Back distance Z = +12.5, FOV = 42\302\260, lookAt Y = targetPos.y + 2.4\n        // Tilted slightly toward the mouse cursor so ~25%-30% of upper screen displays warm evening sky & purple tree canopies\n        const chaseOffset = REA_CONSTANTS.camera.chaseOffset;\n        const camX =\n          camFollowPos.x +\n          mousePanCurrent.x * 0.45 +\n          recoilOffset.x +\n          shakeX +\n          (state === \'title\' ? -1.4 : chaseOffset.x) * fovScale;\n        const camY = camFollowPos.y + chaseOffset.y * zoomMult * fovScale;\n        const camZ =\n          camFollowPos.z +\n          mousePanCurrent.z * 0.35 +\n          recoilOffset.z +\n          shakeZ +\n          chaseOffset.z * zoomMult * fovScale;\n\n        const lookAtX = camFollowPos.x + mousePanCurrent.x * 1.15 + recoilOffset.x + shakeX;\n        const lookAtY =\n          camFollowPos.y +\n          REA_CONSTANTS.camera.chaseLookAtYOffset +\n          (-mousePanCurrent.z) * 0.32;\n        const lookAtZ = camFollowPos.z + mousePanCurrent.z * 0.85 + recoilOffset.z + shakeZ;\n\n        camera.position.set(camX, camY, camZ);\n        camera.lookAt(lookAtX, lookAtY, lookAtZ);\n      }\n\n      skyDomeMesh.position.set(camera.position.x, 0, camera.position.z);\n      dirLight.position.set(camFollowPos.x + 14, 34, camFollowPos.z + 16);\n      dirLight.target.position.set(camFollowPos.x, 0, camFollowPos.z);\n\n      renderer.render(scene, camera);"
