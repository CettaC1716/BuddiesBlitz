              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Shoot Handler with Barrel & Turret Recoil Tween"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local function tryShoot()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif os.clock() - lastFireTime < TANK_STATS.FireRate then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\treturn"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal tank = getTank()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif not tank or not tank.PrimaryPart then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\treturn"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlastFireTime = os.clock()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal turret = tank:FindFirstChild(\"Player_Turret\") :: BasePart?"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal barrel = tank:FindFirstChild(\"Player_Barrel\") :: BasePart?"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal barrelMotor = turret and turret:FindFirstChild(\"BarrelMotor\") :: Motor6D?"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal muzzle = tank:FindFirstChild(\"MuzzleTip\") :: BasePart?"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal origin = muzzle and muzzle.Position or (tank.PrimaryPart.Position + Vector3.new(0, 3, 0))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal shootDir = barrel and barrel.CFrame.RightVector or tank.PrimaryPart.CFrame.RightVector"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tFireCannonRemote:FireServer(origin, shootDir)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tBulletShootEvent:Fire(shootDir)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif barrelMotor then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal baseC0 = CFrame.new(1.15 * METER_TO_STUDS, 0.05 * METER_TO_STUDS, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal recoilC0 = baseC0 * CFrame.new(-TANK_STATS.RecoilDistance, 0, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tTweenService:Create(barrelMotor, TweenInfo.new(TANK_STATS.RecoilPushDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = recoilC0 }):Play()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\ttask.delay(TANK_STATS.RecoilPushDuration, function()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tTweenService:Create(barrelMotor, TweenInfo.new(TANK_STATS.RecoilReturnDuration, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { C0 = baseC0 }):Play()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tend)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "UserInputService.InputBegan:Connect(function(input, gp)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif gp then return end"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif input.KeyCode == Enum.KeyCode.Space or input.UserInputType == Enum.UserInputType.MouseButton1 then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\ttryShoot()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\telseif input.KeyCode == Enum.KeyCode.G then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tisGrabMode = not isGrabMode"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tif not isGrabMode then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tgrabbedPart = nil"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\telseif Mouse.Target and not Mouse.Target.Anchored then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tgrabbedPart = Mouse.Target"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "RunService.Heartbeat:Connect(function(rawDt: number)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal dt = math.min(rawDt, 0.05)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal tank = getTank()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif not tank or not tank.PrimaryPart then return end"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal chassis = tank.PrimaryPart"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal driveVel = chassis:FindFirstChild(\"DriveVelocity\") :: LinearVelocity?"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal turnVel = chassis:FindFirstChild(\"TurnVelocity\") :: AngularVelocity?"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal turretMotor = chassis:FindFirstChild(\"TurretMotor\") :: Motor6D?"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal w = UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal s = UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal a = UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal d = UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal boost = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal maxBoostSpeed = TANK_STATS.BaseSpeed * TANK_STATS.BoostMultiplier"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal speedDelta = (maxBoostSpeed - TANK_STATS.BaseSpeed) * (boost and 1 or -10) * dt"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tcurrentSpeed = math.clamp(currentSpeed + speedDelta, TANK_STATS.BaseSpeed, maxBoostSpeed)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal forwardInput = (w and 1 or 0) - (s and 1 or 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal turnInput = (a and 1 or 0) - (d and 1 or 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal forwardDir = Vector3.new(chassis.CFrame.RightVector.X, 0, chassis.CFrame.RightVector.Z).Unit"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif driveVel then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal targetPlanar = forwardDir * (forwardInput * currentSpeed)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal currentPlanar = Vector3.new( driveVel.PlaneVelocity.X, 0, driveVel.PlaneVelocity.Y )"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal nextPlanar = currentPlanar:Lerp(targetPlanar, 1 - math.exp(-TANK_STATS.DriveLerpRate * dt))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tdriveVel.PlaneVelocity = Vector2.new(nextPlanar.X, nextPlanar.Z)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif turnVel then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tif math.abs(turnInput) > 0.01 then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tlocal boostMult = boost and TANK_STATS.BoostRotationMultiplier or 1.0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tlocal targetAng = turnInput * TANK_STATS.RotationSpeed * boostMult"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tcurrentYawVel = currentYawVel + (targetAng - currentYawVel) * (1 - math.exp(-TANK_STATS.RotationLerpRate * dt))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\telse"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tcurrentYawVel = currentYawVel * math.exp(-TANK_STATS.RotationDampingFactor * dt)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tturnVel.AngularVelocity = Vector3.new(0, currentYawVel, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- Turret Aiming toward Mouse Hit on Ground Plane"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif turretMotor and Mouse.Hit then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal aimVec = Mouse.Hit.Position - chassis.Position"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tif Vector3.new(aimVec.X, 0, aimVec.Z).Magnitude > 0.1 then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tlocal localAim = chassis.CFrame:VectorToObjectSpace(aimVec)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tlocal targetYaw = math.atan2(-localAim.Z, localAim.X)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tlocal diff = ((targetYaw - currentTurretYaw + math.pi) % (math.pi * 2)) - math.pi"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tcurrentTurretYaw = currentTurretYaw + diff * (1 - math.exp(-TANK_STATS.TurretDampingRate * dt))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tturretMotor.C0 = CFrame.new(-0.05 * METER_TO_STUDS, 0.95 * METER_TO_STUDS, 0) * CFrame.Angles(0, currentTurretYaw, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- Factory Playground [G] Telekinesis Spring Force (springStrength = 180, damping = 16)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif isGrabMode and grabbedPart and Mouse.Hit then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal holdPos = Vector3.new(Mouse.Hit.Position.X, chassis.Position.Y + 6, Mouse.Hit.Position.Z)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal displacement = holdPos - grabbedPart.Position"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal springVel = displacement * 12 - grabbedPart.AssemblyLinearVelocity * 0.35"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tgrabbedPart.AssemblyLinearVelocity = springVel"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "]]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
