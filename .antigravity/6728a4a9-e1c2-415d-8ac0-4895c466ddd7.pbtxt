            }
            lines {
              text: "          float cloudMask = smoothstep(0.05, 0.14, h) * (1.0 - smoothstep(0.24, 0.38, h));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          float cloudStep = step(0.32, cloudBand) * cloudMask * 0.18;"
