              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          if (turn !== 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            const rev = throttle < 0 ? -1 : 1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            mountedTank.hullYaw += turn * rev * REA_CONSTANTS.physics.drive.rotationSpeed * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const fwdX = Math.cos(mountedTank.hullYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const fwdZ = -Math.sin(mountedTank.hullYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const targetVx = fwdX * throttle * mountedTank.currentDriveSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const targetVz = fwdZ * throttle * mountedTank.currentDriveSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          mountedTank.vx += (targetVx - mountedTank.vx) * Math.min(1, 10 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          mountedTank.vz += (targetVz - mountedTank.vz) * Math.min(1, 10 * dt);"
