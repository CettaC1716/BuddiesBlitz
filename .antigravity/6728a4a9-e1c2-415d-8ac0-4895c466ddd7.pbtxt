              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\treturn ev"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local IntroCompleteEvent = getOrCreateBindable(\"GameIntroComplete\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local BulletShootEvent = getOrCreateBindable(\"BulletShoot\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local CameraShakeEvent = getOrCreateBindable(\"CameraShake\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Locate Player Tank PrimaryPart"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local function getTankRoot(): BasePart?"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal tankModel = workspace:FindFirstChild(\"PlayerTank_\" .. LocalPlayer.Name)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tor workspace:FindFirstChild(\"PlayerTank\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif tankModel and tankModel:IsA(\"Model\") and tankModel.PrimaryPart then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\treturn tankModel.PrimaryPart"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal char = LocalPlayer.Character"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif char and char.PrimaryPart then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\treturn char.PrimaryPart"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\treturn nil"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Exact port of CQl67Veh.js critically-damped spring follow"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local function stepCriticalDampedSpring("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tcurrent: Vector3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttarget: Vector3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tvelocity: Vector3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tcurrentSpeed: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tdt: number"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): (Vector3, Vector3)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal maxBoostSpeed = CONFIG.BaseSpeed * CONFIG.BoostMultiplier"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal speedAlpha = math.clamp("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t(currentSpeed - CONFIG.BaseSpeed) / math.max(0.001, maxBoostSpeed - CONFIG.BaseSpeed),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal smoothTime = CONFIG.SmoothTimeNormal + (CONFIG.SmoothTimeBoost - CONFIG.SmoothTimeNormal) * speedAlpha"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal diff = current - target"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal distSq = diff:Dot(diff)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif distSq > CONFIG.SnapDistanceSq or distSq < 1e-6 then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\treturn target, Vector3.zero"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal omega = 2.0 / math.max(1e-4, smoothTime)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal expFactor = math.exp(-omega * dt)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal temp = (velocity + diff * omega) * dt"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal nextVel = (velocity - temp * omega) * expFactor"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal nextPos = target + (diff + temp) * expFactor"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\treturn nextPos, nextVel"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Handle Cannon Shoot Recoil (handleShootRecoil in CQl67Veh.js)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "BulletShootEvent.Event:Connect(function(muzzleDirection: Vector3?)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal dir = muzzleDirection or Vector3.new(1, 0, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal flatDir = Vector3.new(dir.X, 0, dir.Z)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif flatDir.Magnitude > 0.001 then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tflatDir = flatDir.Unit"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\telse"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tflatDir = Vector3.new(1, 0, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal nextRecoil = recoilOffset - flatDir * CONFIG.RecoilKickDistance"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif nextRecoil.Magnitude > CONFIG.MaxRecoilDistance then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tnextRecoil = nextRecoil.Unit * CONFIG.MaxRecoilDistance"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\trecoilOffset = nextRecoil"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttrauma = math.min(1.0, trauma + 0.35)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CameraShakeEvent.Event:Connect(function(amount: number)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttrauma = math.min(1.0, trauma + (amount or 0.45))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Transition out of Hexagon Intro Mode when \"LET\'S GO\" is clicked"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "IntroCompleteEvent.Event:Connect(function()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tisIntroActive = false"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttargetZoomScale = 1.0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tTweenService:Create("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tCamera,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tTweenInfo.new(0.85, Enum.EasingStyle.Back, Enum.EasingDirection.Out),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t{ FieldOfView = CONFIG.GameplayFOV }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t):Play()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Mouse Wheel Zoom adjustment"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "UserInputService.InputChanged:Connect(function(input, gameProcessed)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif gameProcessed or isIntroActive then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\treturn"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif input.UserInputType == Enum.UserInputType.MouseWheel then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tCONFIG.ZoomTargetValue = math.clamp(CONFIG.ZoomTargetValue - input.Position.Z * 0.08, 0.0, 1.0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Initialize Camera"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "Camera.CameraType = Enum.CameraType.Scriptable"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "Camera.FieldOfView = CONFIG.IntroFOV"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local initialRoot = getTankRoot()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "if initialRoot then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttargetPos = initialRoot.Position"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttargetEased = initialRoot.Position"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "RunService:BindToRenderStep(\"LyoooIsometricCamera\", Enum.RenderPriority.Camera.Value + 1, function(rawDt: number)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal dt = math.min(rawDt, 0.05)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif math.abs(dt - 0.016667) < 0.0022 then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tdt = 0.016667"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal root = getTankRoot()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal currentSpeed = CONFIG.BaseSpeed"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif root then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\ttargetPos = root.Position"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tcurrentSpeed = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- 1. Critically-Damped Target Follow"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttargetEased, targetVelocity = stepCriticalDampedSpring(targetEased, targetPos, targetVelocity, currentSpeed, dt)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- 2. Smooth Zoom Interpolation"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tCONFIG.ZoomValue = CONFIG.ZoomValue + (CONFIG.ZoomTargetValue - CONFIG.ZoomValue) * (1 - math.exp(-8 * dt))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tcurrentZoomScale = currentZoomScale + (targetZoomScale - currentZoomScale) * (1 - math.exp(-5 * dt))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal zoomDist = CONFIG.ZoomMinDistance + CONFIG.ZoomAmplitude * CONFIG.ZoomValue"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal baseAngleDir = CONFIG.DefaultAngleOffset.Unit"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal angleVec = (baseAngleDir * zoomDist * CONFIG.DistanceMultiplier) / math.max(0.5, currentZoomScale)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- 3. Mouse Pan Offset (projected on ground basis relative to camera angle)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal forwardVec = Vector3.new(-angleVec.X, 0, -angleVec.Z).Unit"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal rightVec = forwardVec:Cross(upVec).Unit"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif not isIntroActive then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal viewportSize = Camera.ViewportSize"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal mouseLoc = UserInputService:GetMouseLocation()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal normMouseX = (mouseLoc.X / math.max(viewportSize.X, 1)) * 2 - 1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal normMouseY = -((mouseLoc.Y / math.max(viewportSize.Y, 1)) * 2 - 1)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\ttargetMousePan = rightVec * (normMouseX * CONFIG.MousePanSensitivity)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t+ forwardVec * (normMouseY * CONFIG.MousePanSensitivity)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\telse"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\ttargetMousePan = Vector3.zero"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal mouseLerp = 1 - math.exp(-CONFIG.MousePanDampSpeed * dt)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tmousePanOffset = mousePanOffset:Lerp(targetMousePan, mouseLerp)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- 4. Recoil & Trauma Decay"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\trecoilOffset = recoilOffset:Lerp(Vector3.zero, 1 - math.exp(-10 * dt))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttrauma = math.max(0, trauma - dt * 2.4)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal shakeMag = (trauma * trauma) * (0.45 * METER_TO_STUDS)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal shakeVec = Vector3.new("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tmath.sin(os.clock() * 47) * shakeMag,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tmath.cos(os.clock() * 53) * shakeMag * 0.6,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tmath.sin(os.clock() * 41) * shakeMag"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- 5. Hexagon Intro Framing Shift (places Tank centered inside right-side Hexagon cutout)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal introOffset = Vector3.zero"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif isIntroActive or currentZoomScale > 1.01 then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal blend = math.clamp((currentZoomScale - 1.0) / (CONFIG.IntroZoomScale - 1.0), 0, 1)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal shiftRight = -rightVec * (3.2 * METER_TO_STUDS * blend)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal shiftUp = Vector3.new(0, 0.65 * METER_TO_STUDS * blend, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tintroOffset = shiftRight + shiftUp"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal focusPoint = targetEased + mousePanOffset + recoilOffset + introOffset + shakeVec"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal camPos = focusPoint + angleVec"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tCamera.CFrame = CFrame.lookAt(camPos, focusPoint, upVec)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'tank-builder-controller\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'2. TankBuilder.server.lua & TankController.client.lua\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    robloxPath:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'ServerScriptService/TankBuilder.server.lua + StarterPlayerScripts/TankController.client.lua\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    scriptType: \'Script\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    summary:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Rig Tank 11-bagian & Factory Playground (Hydrant, Manhole, ExplosiveBarrel, ConcreteFence, PowerCore) + Kontrol Fisika 1:1 dari Rapier (speed 8, boost 1.9x, turretDamping 0.06, projectileSpeed 55, recoil 0.16, dan Grab Mode [G]).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: `--!strict"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "--[["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ============================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  PART A: ServerScriptService/TankBuilder.server.lua"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  Builds the composite Neon-Green Tank (#b8ff3c / #c7ff72) & Factory Playground"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  props with exact Rapier-equivalent mass, friction, restitution, and welds."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ============================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
