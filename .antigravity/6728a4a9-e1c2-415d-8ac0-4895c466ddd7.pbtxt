            lines {
              text: "local function createPart("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tname: string,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tsize: Vector3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tcolor: Color3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tmaterial: Enum.Material,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tparent: Instance"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "): Part"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal p = Instance.new(\"Part\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tp.Name = name"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tp.Size = size"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tp.Color = color"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tp.Material = material"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tp.TopSurface = Enum.SurfaceType.Smooth"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tp.BottomSurface = Enum.SurfaceType.Smooth"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tp.CanCollide = false"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tp.Massless = true"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tp.Parent = parent"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\treturn p"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
