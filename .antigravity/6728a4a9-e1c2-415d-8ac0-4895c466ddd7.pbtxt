            }
            lines {
              text: "            mountedTank.bodyGroup.rotation.y = mountedTank.hullYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            activeSpeed = Math.hypot(mountedTank.vx, mountedTank.vz);"
