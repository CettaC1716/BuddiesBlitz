            lines {
              text: "/**"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: " * Port of Lyo\'s StrokeManager.prototype.initStrokeGeometry & Nn (StrokeMaterial)"
