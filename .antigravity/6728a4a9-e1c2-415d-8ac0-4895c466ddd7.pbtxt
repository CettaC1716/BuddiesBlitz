    action_spec {
      command {
        instruction: "Append Buddy Blitz constants, 7 Buddy classes, Lyo daylight palette, and pure 2x2x2 Stacking Pad recipe evaluation logic to src/game/rules.ts"
        is_edit: true
        file {
          absolute_uri: "file:///src/game/rules.ts"
