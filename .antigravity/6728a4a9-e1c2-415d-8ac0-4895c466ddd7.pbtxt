            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const mat = new THREE.ShaderMaterial({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    uniforms: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uMap: { value: mapTex },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
