            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // 1. Clone ONLY the reference trunk mesh itself (sourceRoot is a Mesh in tree-1b.glb / tree-1a.glb)"
