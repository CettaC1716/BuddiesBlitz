            lines {
              text: "          if ("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            mountedTank.storedCrates.length > 0 &&"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            Math.hypot(mountedTank.x - blueBase.padX, mountedTank.z - blueBase.padZ) < 4.8"
