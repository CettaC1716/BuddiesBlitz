            }
            lines {
              text: "    // Helper: Fire Projectile"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const spawnProjectile = ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      origin: THREE.Vector3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
