            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            mountedTank.x = clamp(mountedTank.x + mountedTank.vx * dt, -40, 40);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            mountedTank.z = clamp(mountedTank.z + mountedTank.vz * dt, -40, 40);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            mountedTank.root.position.set(mountedTank.x, 0, mountedTank.z);"
