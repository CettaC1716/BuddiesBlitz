            }
            lines {
              text: "      ctx.fillStyle = \'#fec83e\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      ctx.fillRect(0, 0, 128, 128);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      ctx.fillStyle = \'#11121a\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      for (let i = -128; i < 256; i += 32) {"
