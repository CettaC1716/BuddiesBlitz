            }
            lines {
              text: "    const seed = getRandom();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const radius = 1 - Math.pow(getRandom(), 3);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const phi = Math.PI * 2 * getRandom();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const theta = Math.PI * getRandom();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const sph = new THREE.Spherical(radius, theta, phi);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const center = new THREE.Vector3().setFromSpherical(sph);"
