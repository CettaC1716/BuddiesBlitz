            lines {
              text: "function CrateRecipes.ChooseNextAllowedSlot(slots: { string }, buildOrder: string): number?"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal spec = CrateRecipes.BuildOrders[buildOrder] or CrateRecipes.BuildOrders[\"1x1x2\"]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tfor _, slotIdx in ipairs(spec.AllowedSlots) do"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tif (slots[slotIdx] or \"Empty\") == \"Empty\" then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\treturn slotIdx"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\treturn nil"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function CrateRecipes.EvaluatePad(slots: { string }): (string, any, boolean, boolean)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal redCount = 0"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal superCount = 0"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal topLayerCount = 0"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tfor i = 1, 8 do"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\t\tlocal s = slots[i] or \"Empty\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\t\tif s == \"Red\" then"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\t\t\tredCount += 1"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\t\telseif s == \"Super\" then"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\t\t\tsuperCount += 1"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\t\tif s ~= \"Empty\" and i >= 5 then"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\t\t\ttopLayerCount += 1"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal total = redCount + superCount"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal isMerged = total >= 2"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal isSuper = superCount >= 1"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal key = \"1x1x1\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tif total == 8 then"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\t\tkey = \"2x2x2\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\telseif total >= 4 then"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\t\tkey = (topLayerCount >= 2) and \"2x1x2\" or \"2x2x1\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\telseif total >= 2 then"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\t\tkey = (topLayerCount >= 1) and \"1x1x2\" or \"2x1x1\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal entry = CrateRecipes.Recipes[key]"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal chosen = isSuper and entry.Super or entry.Regular"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\treturn key, chosen, isMerged, isSuper"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "end"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "-- ============================================================================"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "-- BAGIAN B: ServerScriptService/Phase2_CrateStackingSystem.server.lua (Script)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "-- Spawner Red/Super/Megacrate, Carry/Throw (E), Kick Open (F), Grid 2x2x2 & Merge"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "-- Clean Match Start (0/8 Pad), Ghost Wireframe [Q], Carry/Throw (E) & Kick Craft (F)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- ============================================================================"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "local Workspace = game:GetService(\"Workspace\")"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "local TweenService = game:GetService(\"TweenService\")"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "local Debris = game:GetService(\"Debris\")"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "local Remotes = ReplicatedStorage:WaitForChild(\"Remotes\")"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "local CrateActionRemote = Remotes:WaitForChild(\"CrateAction\") :: RemoteEvent"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "local Arena = Workspace:WaitForChild(\"BuddyBlitzArena\")"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "local CratesFolder = Instance.new(\"Folder\")"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "CratesFolder.Name = \"WorldCrates\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "CratesFolder.Parent = Arena"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "local PickupsFolder = Instance.new(\"Folder\")"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "PickupsFolder.Name = \"Pickups\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "PickupsFolder.Parent = Arena"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "-- State 8 slot (2x2x2) untuk setiap Stacking Pad tim"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "local padSlotStates: { [Model]: { slots: { string }, crateParts: { BasePart? } } } = {}"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "-- State 8 slot (2x2x2) + Pola Ghost Wireframe [Q] untuk setiap Stacking Pad tim (Mulai dari 0/8!)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local padSlotStates: { [Model]: { slots: { string }, crateParts: { BasePart? }, buildOrder: string, ghostBox: Part? } } = {}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "local function getPadSlotWorldPosition(padModel: Model, slotIdx: number): Vector3"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal primary = padModel.PrimaryPart :: BasePart"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal layer = (slotIdx <= 4) and 0 or 1"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal localIdx = ((slotIdx - 1) % 4)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal row = math.floor(localIdx / 2)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal col = localIdx % 2"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\treturn primary.Position + Vector3.new((col - 0.5) * 4.0, 2.2 + layer * 3.8, (row - 0.5) * 4.0)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "end"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "-- Update Kerangka Transparan (Ghost Wireframe SelectionBox) Sesuai Tombol [Q]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local function syncPadGhostWireframe(padModel: Model, buildOrder: string)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal spec = CrateRecipes.BuildOrders[buildOrder] or CrateRecipes.BuildOrders[\"1x1x2\"]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal primary = padModel.PrimaryPart :: BasePart"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal ghost = padModel:FindFirstChild(\"GhostWireframeBox\") :: Part?"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif not ghost then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tghost = Instance.new(\"Part\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tghost.Name = \"GhostWireframeBox\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tghost.Transparency = 1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tghost.Anchored = true"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tghost.CanCollide = false"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tghost.CanQuery = false"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tghost.Parent = padModel"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal sel = Instance.new(\"SelectionBox\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tsel.Name = \"GhostOutline\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tsel.Color3 = Color3.fromHex(\"#00d2ff\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tsel.LineThickness = 0.08"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tsel.Adornee = ghost"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tsel.Parent = ghost"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tghost.Size = spec.GhostSize"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tghost.CFrame = primary.CFrame * CFrame.new(0, spec.GhostSize.Y * 0.5 + 0.3, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tpadModel:SetAttribute(\"BuildOrder\", buildOrder)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Spawner Peti dengan Parasut + Animasi Squash & Stretch saat mendarat"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "local function spawnFallingCrate(crateType: \"Red\" | \"Super\" | \"Mega\", dropCenter: Vector3)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal size = (crateType == \"Mega\") and Vector3.new(7.6, 7.6, 7.6) or Vector3.new(3.6, 3.6, 3.6)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal color = Color3.fromHex(\"#ff3b30\")"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
