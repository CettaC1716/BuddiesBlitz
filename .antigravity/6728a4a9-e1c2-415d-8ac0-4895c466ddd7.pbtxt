    content: "import React, { useEffect, useRef } from \'react\';\nimport * as THREE from \'three\';\nimport {\n  REA_CONSTANTS,\n  LIGHTING_PRESETS,\n  LightingPresetKey,\n  stepCriticalDampedSpring3D,\n  computeTankSpeedStep,\n  stepTurretYaw,\n  clamp,\n  Vec3,\n  CrateSlotType,\n  evaluateStackingPadRecipe,\n  chooseNextPadSlotIndex,\n  BuildOrderTarget,\n  BUILD_ORDER_SPECS,\n  resolveCursorCommandTarget,\n  BUDDY_CLASSES,\n  BuddyClassId,\n  TeamCommandMode,\n} from \'./rules\';\nimport { soundEngine } from \'./audio\';\nimport {\n  loadAllRealLyoAssets,\n  createLyoInfiniteGrassSystem,\n  populateRealLyoTreeFromGlb,\n  populateRealLyoTankFromGlb,\n  spawnRealLyoPropFromGlb,\n  getLyoDefaultLightDirection,\n  LoadedLyoAssets,\n  LyoWindUniforms,\n} from \'./lyoAssetsAndShaders\';\n\n\nexport type GameState = \'title\' | \'playing\' | \'paused\' | \'gameover\';\n\nexport interface RadarDot {\n  id: string;\n  kind: \'player\' | \'ally\' | \'enemy\' | \'crate_red\' | \'crate_super\' | \'tank_blue\' | \'tank_red\';\n  x: number;\n  z: number;\n}\n\nexport interface HudSnapshot {\n  hp: number;\n  maxHp: number;\n  score: number;\n  bestScore: number;\n  speedKmh: number;\n  isBoosting: boolean;\n  isGrabMode: boolean;\n  grabbedPropName: string | null;\n  collectedItems: string[];\n  powerCoreActivated: boolean;\n  enemiesDefeated: number;\n  totalEnemies: number;\n  lightingPreset: LightingPresetKey;\n  cameraFovMode: \'webgl35\' | \'roblox18\';\n  outcome: \'victory\' | \'defeat\' | null;\n  clearTimeSec: number;\n  // Team Buddies 3D World State\n  controlMode: \'buddy\' | \'tank\';\n  activeClass: BuddyClassId;\n  equippedWeapon: string;\n  ammo: number;\n  carryingCrate: \'none\' | \'red\' | \'super\';\n  tankStoredCrates: number;\n  padSlots: CrateSlotType[];\n  padShape: string;\n  padOutputName: string;\n  padIsMerged: boolean;\n  padIsSuper: boolean;\n  buildOrder: BuildOrderTarget;\n  buildOrderLabel: string;\n  buildOrderTargetCrates: number;\n  teamCommand: TeamCommandMode;\n  alliedBuddiesCount: number;\n  blueBaseHp: number;\n  redBaseHp: number;\n  contextHint: string;\n  radarDots: RadarDot[];\n}\n\ninterface FactoryPlaygroundCanvasProps {\n  gameState: GameState;\n  lightingPreset: LightingPresetKey;\n  cameraFovMode: \'webgl35\' | \'roblox18\';\n  resetTrigger: number;\n  onHudUpdate: (snapshot: HudSnapshot) => void;\n  onGameOver: (outcome: \'victory\' | \'defeat\', finalSnapshot: HudSnapshot) => void;\n  onTogglePause: () => void;\n}\n\ninterface WorldCrate {\n  id: number;\n  kind: \'red\' | \'super\';\n  mesh: THREE.Group;\n  parachuteMesh: THREE.Mesh;\n  x: number;\n  y: number;\n  z: number;\n  vx: number;\n  vy: number;\n  vz: number;\n  state: \'falling\' | \'grounded\' | \'carried\' | \'thrown\' | \'stacked\';\n  carrierId: number | null;\n  squashTimer: number;\n}\n\ninterface WorldPickup {\n  id: number;\n  kind: \'health\' | \'ammo\' | \'weapon\' | \'powerup\';\n  weaponName: string;\n  mesh: THREE.Group;\n  x: number;\n  z: number;\n  bobPhase: number;\n  collected: boolean;\n}\n\ninterface DestructibleTree {\n  id: number;\n  mesh: THREE.Group;\n  x: number;\n  z: number;\n  hp: number;\n  maxHp: number;\n  alive: boolean;\n  hitFlashTimer: number;\n}\n\ninterface TankVehicle {\n  id: number;\n  isSuper: boolean;\n  team: \'blue\' | \'red\';\n  root: THREE.Group;\n  bodyGroup: THREE.Group;\n  turretGroup: THREE.Group;\n  barrelGroup: THREE.Group;\n  riderGroup: THREE.Group;\n  muzzleFlash: THREE.Mesh;\n  x: number;\n  z: number;\n  vx: number;\n  vz: number;\n  hullYaw: number;\n  turretYaw: number;\n  currentDriveSpeed: number;\n  recoilTimer: number;\n  hp: number;"
