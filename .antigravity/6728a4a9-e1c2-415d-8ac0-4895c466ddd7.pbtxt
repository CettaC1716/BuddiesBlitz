            lines {
              text: "local function weldParts(root: BasePart, part: BasePart)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal weld = Instance.new(\"WeldConstraint\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tweld.Part0 = root"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tweld.Part1 = part"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
