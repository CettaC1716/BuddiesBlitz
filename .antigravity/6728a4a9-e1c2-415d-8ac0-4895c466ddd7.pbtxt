              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\thum.WalkSpeed = 16"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tcPart.Anchored = false"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tcPart.CanCollide = true"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tcPart.CFrame = root.CFrame * CFrame.new(0, 2.5, -4.5)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tcPart.AssemblyLinearVelocity = root.CFrame.LookVector * 36 + Vector3.new(0, 18, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
