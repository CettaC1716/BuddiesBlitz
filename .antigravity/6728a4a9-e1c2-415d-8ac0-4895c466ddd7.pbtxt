HREE.Group;\n  parachuteMesh: THREE.Mesh;\n  x: number;\n  y: number;\n  z: number;\n  vx: number;\n  vy: number;\n  vz: number;\n  state: \'falling\' | \'grounded\' | \'carried\' | \'thrown\' | \'stacked\';\n  carrierId: number | null;\n  squashTimer: number;\n}\n\ninterface WorldPickup {\n  id: number;\n  kind: \'health\' | \'ammo\' | \'weapon\' | \'powerup\';\n  weaponName: string;\n  mesh: THREE.Group;\n  x: number;\n  z: number;\n  bobPhase: number;\n  collected: boolean;\n}\n\ninterface DestructibleTree {\n  id: number;\n  mesh: THREE.Group;\n  x: number;\n  z: number;\n  hp: number;\n  maxHp: number;\n  alive: boolean;\n  hitFlashTimer: number;\n}\n\ninterface TankVehicle {\n  id: number;\n  isSuper: boolean;\n  team: \'blue\' | \'red\';\n  root: THREE.Group;\n  bodyGroup: THREE.Group;\n  turretGroup: THREE.Group;\n  barrelGroup: THREE.Group;\n  riderGroup: THREE.Group;\n  muzzleFlash: THREE.Mesh;\n  x: number;\n  z: number;\n  vx: number;\n  vz: number;\n  hullYaw: number;\n  turretYaw: number;\n  currentDriveSpeed: number;\n  recoilTimer: number;\n  hp: number;\n  maxHp: number;\n  storedCrates: (\'red\' | \'super\')[];\n  occupiedByPlayer: boolean;\n}\n\ninterface BuddyUnit {\n  id: number;\n  team: \'blue\' | \'red\';\n  isPlayer: boolean;\n  classId: BuddyClassId;\n  root: THREE.Group;\n  bodyGroup: THREE.Group;\n  headMesh: THREE.Mesh;\n  leftArmPivot: THREE.Group;\n  rightArmPivot: THREE.Group;\n  leftLegPivot: THREE.Group;\n  rightLegPivot: THREE.Group;\n  weaponMesh: THREE.Mesh;\n  overheadCrateGroup: THREE.Group;\n  overheadCrateBox: THREE.Mesh;\n  teamRing: THREE.Mesh;\n  x: number;\n  y: number;\n  z: number;\n  vx: number;\n  vz: number;\n  yaw: number;\n  hp: number;\n  maxHp: number;\n  weaponName: string;\n  ammo: number;\n  carryingCrate: \'none\' | \'red\' | \'super\';\n  walkCycle: number;\n  shootCooldown: number;\n  hitFlashTimer: number;\n  isFrozen: boolean;\n  frozenTimer: number;\n  aiTargetCrateId: number | null;\n  alive: boolean;\n  respawnTimer: number;\n}\n\ninterface Projectile {\n  active: boolean;\n  isPlayerTeam: boolean;\n  weaponType: string;\n  mesh: THREE.Mesh;\n  pos: THREE.Vector3;\n  vel: THREE.Vector3;\n  life: number;\n  damage: number;\n}\n\ninterface ExplosionParticle {\n  active: boolean;\n  mesh: THREE.Mesh;\n  vel: THREE.Vector3;\n  life: number;\n  maxLife: number;\n}\n\nconst BUILD_ORDER_CYCLE: BuildOrderTarget[] = [\'AUTO\', \'1x1x1\', \'1x1x2\', \'2x2x1\', \'2x1x2\', \'2x2x2\'];\nconst COMMAND_CYCLE: TeamCommandMode[] = [\'HARVEST\', \'ATTACK\', \'DEFEND\', \'FOLLOW\'];\nconst BLUE_BUDDY_ROTATION: BuddyClassId[] = [\'Infuntry\', \'Ninja\', \'Medic\', \'Commando\', \'Cyborg\', \'Stealthy\', \'SuperBuddie\'];\n"
          replacement_content: "import React, { useEffect, useRef } from \'react\';\nimport * as THREE from \'three\';\nimport {\n  REA_CONSTANTS,\n  LIGHTING_PRESETS,\n  LightingPresetKey,\n  stepCriticalDampedSpring3D,\n  computeTankSpeedStep,\n  stepTurretYaw,\n  clamp,\n  Vec3,\n  CrateSlotType,\n  evaluateStackingPadRecipe,\n  chooseNextPadSlotIndex,\n  BuildOrderTarget,\n  BUILD_ORDER_SPECS,\n  resolveCursorCommandTarget,\n  BUDDY_CLASSES,\n  BuddyClassId,\n  TeamCommandMode,\n} from \'./rules\';\nimport { soundEngine } from \'./audio\';\n\nexport type GameState = \'title\' | \'playing\' | \'paused\' | \'gameover\';\n\nexport interface RadarDot {\n  id: string;\n  kind: \'player\' | \'ally\' | \'enemy\' | \'crate_red\' | \'crate_super\' | \'tank_blue\' | \'tank_red\';\n  x: number;\n  z: number;\n}\n\nexport interface HudSnapshot {\n  hp: number;\n  maxHp: number;\n  score: number;\n  bestScore: number;\n  speedKmh: number;\n  isBoosting: boolean;\n  isGrabMode: boolean;\n  grabbedPropName: string | null;\n  collectedItems: string[];\n  powerCoreActivated: boolean;\n  enemiesDefeated: number;\n  totalEnemies: number;\n  lightingPreset: LightingPresetKey;\n  cameraFovMode: \'webgl35\' | \'roblox18\';\n  outcome: \'victory\' | \'defeat\' | null;\n  clearTimeSec: number;\n  // Team Buddies 3D World State\n  controlMode: \'buddy\' | \'tank\';\n  activeClass: BuddyClassId;\n  equippedWeapon: string;\n  ammo: number;\n  carryingCrate: \'none\' | \'red\' | \'super\';\n  tankStoredCrates: number;\n  padSlots: CrateSlotType[];\n  padShape: string;\n  padOutputName: string;\n  padIsMerged: boolean;\n  padIsSuper: boolean;\n  buildOrder: BuildOrderTarget;\n  buildOrderLabel: string;\n  buildOrderTargetCrates: number;\n  teamCommand: TeamCommandMode;\n  alliedBuddiesCount: number;\n  blueBaseHp: number;\n  redBaseHp: number;\n  contextHint: string;\n  radarDots: RadarDot[];\n}\n\ninterface FactoryPlaygroundCanvasProps {\n  gameState: GameState;\n  lightingPreset: LightingPresetKey;\n  cameraFovMode: \'webgl35\' | \'roblox18\';\n  resetTrigger: number;\n  onHudUpdate: (snapshot: HudSnapshot) => void;\n  onGameOver: (outcome: \'victory\' | \'defeat\', finalSnapshot: HudSnapshot) => void;\n  onTogglePause: () => void;\n}\n\ninterface WorldCrate {\n  id: number;\n  kind: \'red\' | \'super\';\n  mesh: THREE.Group;\n  parachuteMesh: THREE.Mesh;\n  x: number;\n  y: number;\n  z: number;\n  vx: number;\n  vy: number;\n  vz: number;\n  state: \'falling\' | \'grounded\' | \'carried\' | \'thrown\' | \'stacked\';\n  carrierId: number | null;\n  squashTimer: number;\n}\n\ninterface WorldPickup {\n  id: number;\n  kind: \'health\' | \'ammo\' | \'weapon\' | \'powerup\';\n  weaponName: string;\n  mesh: THREE.Group;\n  x: number;\n  z: number;\n  bobPhase: number;\n  collected: boolean;\n}\n\ninterface DestructibleTree {\n  id: number;\n  mesh: THREE.Group;\n  x: number;\n  z: number;\n  hp: number;\n  maxHp: number;\n  alive: boolean;\n  hitFlashTimer: number;\n}\n\ninterface TankVehicle {\n  id: number;\n  isSuper: boolean;\n  team: \'blue\' | \'red\';\n  root: THREE.Group;\n  bodyGroup: THREE.Group;\n  turretGroup: THREE.Group;\n  barrelGroup: THREE.Group;\n  riderGroup: THREE.Group;\n  muzzleFlash: THREE.Mesh;\n  x: number;\n  z: number;\n  vx: number;\n  vz: number;\n  hullYaw: number;\n  turretYaw: number;\n  currentDriveSpeed: number;\n  recoilTimer: number;\n  hp: number;\n  maxHp: number;\n  storedCrates: (\'red\' | \'super\')[];\n  occupiedByPlayer: boolean;\n  occupiedByAiId: number | null;\n}\n\ninterface BuddyUnit {\n  id: number;\n  team: \'blue\' | \'red\';\n  isPlayer: boolean;\n  classId: BuddyClassId;\n  root: THREE.Group;\n  bodyGroup: THREE.Group;\n  headMesh: THREE.Mesh;\n  leftArmPivot: THREE.Group;\n  rightArmPivot: THREE.Group;\n  leftLegPivot: THREE.Group;\n  rightLegPivot: THREE.Group;\n  weaponMesh: THREE.Mesh;\n  overheadCrateGroup: THREE.Group;\n  overheadCrateBox: THREE.Mesh;\n  saluteSign: {\n    sprite: THREE.Sprite;\n    updateText: (title: string, subtitle: string, accentHex: string, progressRatio?: number) => void;\n  };\n  teamRing: THREE.Mesh;\n  x: number;\n  y: number;\n  z: number;\n  vx: number;\n  vz: number;\n  yaw: number;\n  hp: number;\n  maxHp: number;\n  weaponName: string;\n  ammo: number;\n  carryingCrate: \'none\' | \'red\' | \'super\';\n  walkCycle: number;\n  shootCooldown: number;\n  hitFlashTimer: number;\n  isFrozen: boolean;\n  frozenTimer: number;\n  saluteTimer: number;\n  aiTargetCrateId: number | null;\n  alive: boolean;\n  respawnTimer: number;\n}\n\ninterface Projectile {\n  active: boolean;\n  isPlayerTeam: boolean;\n  weaponType: string;\n  mesh: THREE.Mesh;\n  pos: THREE.Vector3;\n  vel: THREE.Vector3;\n  life: number;\n  damage: number;\n}\n\ninterface ExplosionParticle {\n  active: boolean;\n  mesh: THREE.Mesh;\n  vel: THREE.Vector3;\n  life: number;\n  maxLife: number;\n}\n\nconst BUILD_ORDER_CYCLE: BuildOrderTarget[] = [\n  \'1x1x1\',\n  \'2x1x1\',\n  \'1x1x2\',\n  \'2x2x1\',\n  \'2x1x2\',\n  \'2x2x2\',\n];\nconst COMMAND_CYCLE: TeamCommandMode[] = [\'HARVEST\', \'ATTACK\', \'DEFEND\', \'FOLLOW\'];\nconst BLUE_BUDDY_ROTATION: BuddyClassId[] = [\'Infuntry\', \'Ninja\', \'Medic\', \'Commando\', \'Cyborg\', \'Stealthy\', \'SuperBuddie\'];\n"
          start_line: 1
          end_line: 195
        }
      }
    }
