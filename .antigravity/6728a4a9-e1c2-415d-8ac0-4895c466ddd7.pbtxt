            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const buildTrackBelt = (curve: THREE.CatmullRomCurve3, isRight: boolean) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const geo = isRight ? createMirroredGeometry(glbTrackSeg.geometry) : glbTrackSeg.geometry.clone();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
