            }
            lines {
              text: "-- Loop Kamera Angled Top-Down & Rotasi Karakter Menghadap Crosshair"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "RunService:BindToRenderStep(\"LyoTopDownCamera\", Enum.RenderPriority.Camera.Value + 1, function(dt: number)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal char = LocalPlayer.Character"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal root = char and (char:FindFirstChild(\"HumanoidRootPart\") :: BasePart?) or nil"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif not root then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\treturn"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tCamera.CameraType = Enum.CameraType.Scriptable"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tCamera.FieldOfView = CAM_FOV"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal mouseLoc = UserInputService:GetMouseLocation()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tcrosshairRoot.Position = UDim2.fromOffset(mouseLoc.X, mouseLoc.Y)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- Raycast posisi kursor mouse pada bidang tanah Y = root.Position.Y"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal unitRay = Camera:ViewportPointToRay(mouseLoc.X, mouseLoc.Y)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif math.abs(unitRay.Direction.Y) > 0.0001 then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal t = (root.Position.Y - unitRay.Origin.Y) / unitRay.Direction.Y"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tif t > 0 then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tcurrentAimWorldPoint = unitRay.Origin + unitRay.Direction * t"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- Camera Deadzone di tengah layar"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal deltaToPlayer = root.Position - focusPosition"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal planarDelta = Vector3.new(deltaToPlayer.X, 0, deltaToPlayer.Z)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif planarDelta.Magnitude > DEADZONE_RADIUS then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal excess = planarDelta.Unit * (planarDelta.Magnitude - DEADZONE_RADIUS)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tfocusPosition = Vector3.new(focusPosition.X + excess.X, root.Position.Y, focusPosition.Z + excess.Z)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\telse"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tfocusPosition = Vector3.new(focusPosition.X, root.Position.Y, focusPosition.Z)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- Mouse Aim Lead halus menggunakan 1 - math.exp(-10 * dt)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal aimOffset = currentAimWorldPoint - root.Position"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal clampedLead = Vector3.new(aimOffset.X, 0, aimOffset.Z)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif clampedLead.Magnitude > 0.01 then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tclampedLead = clampedLead.Unit * math.min(clampedLead.Magnitude * 0.22, AIM_LEAD_MAX)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal alpha = 1.0 - math.exp(-10.0 * dt)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tsmoothedAimLead = smoothedAimLead:Lerp(clampedLead, alpha)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal finalFocus = focusPosition + smoothedAimLead"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal camRotation = CFrame.Angles(math.rad(CAM_PITCH_DEG), 0, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal camOffset = camRotation:VectorToWorldSpace(Vector3.new(0, 0, CAM_DISTANCE))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tCamera.CFrame = CFrame.lookAt(finalFocus + camOffset, finalFocus)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- Putar karakter menghadap titik Crosshair (Circle-Strafe siap setiap saat)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal lookVec = Vector3.new(currentAimWorldPoint.X - root.Position.X, 0, currentAimWorldPoint.Z - root.Position.Z)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif lookVec.Magnitude > 0.25 then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal targetYaw = math.atan2(-lookVec.X, -lookVec.Z)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\troot.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, targetYaw, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end)`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    id: \'phase2-crate-stacking\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    phase: \'FASE 2\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    title: \'Phase 2: CrateRecipes.lua & Phase2_CrateStackingSystem.server.lua\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    path: \'ReplicatedStorage/Config/CrateRecipes.lua & ServerScriptService/Phase2_CrateStackingSystem.server.lua\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: `--!strict"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- ============================================================================"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- BAGIAN A: ReplicatedStorage/Config/CrateRecipes.lua (ModuleScript)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Tabel Resep Rakitan 1..8 Kotak + Aturan Emas Super Crate (+1 Biru = SUPER)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- ============================================================================"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local CrateRecipes = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tRecipes = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t[\"1x1x1\"] = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tCount = 1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tShape = \"1x1x1 (Single)\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
