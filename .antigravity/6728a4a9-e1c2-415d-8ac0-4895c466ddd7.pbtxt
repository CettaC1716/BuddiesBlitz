            }
            lines {
              text: "          const moveSpeed = 9.2 * spec.speedMultiplier * carryPenalty * boostMult;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
