            }
            lines {
              text: "\torb.Material = Enum.Material.Neon"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\torb.Position = pos + Vector3.new(0, 2, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\torb.Anchored = true"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\torb:SetAttribute(\"PowerUpType\", pType)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
