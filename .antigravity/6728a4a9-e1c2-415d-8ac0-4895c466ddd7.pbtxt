            lines {
              text: "    code: `--!strict"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Lokasi: ServerScriptService/Phase3_VehicleAndCombat.server.lua"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Open-Top Lyo Tank (Avatar menyembul di atas Turret & berputar 360\302\260),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Fitur Crate Run-Over (angkut 4 peti sekaligus), Kamikaze Eject 2.5s,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Senjata (Uzi, Shotgun, Ice Gun Freeze+Shatter, Bazooka, Katana Ninja) & 11 Power-Ups"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local Workspace = game:GetService(\"Workspace\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local Debris = game:GetService(\"Debris\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local Remotes = ReplicatedStorage:WaitForChild(\"Remotes\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local FireWeaponRemote = Remotes:WaitForChild(\"FireWeapon\") :: RemoteEvent"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local Arena = Workspace:WaitForChild(\"BuddyBlitzArena\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local VehiclesFolder = Instance.new(\"Folder\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "VehiclesFolder.Name = \"Vehicles\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "VehiclesFolder.Parent = Arena"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- ============================================================================"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- 1. BUILDER OPEN-TOP LYO TANK (+ FITUR CRATE RUN-OVER 4 PETI & KAMIKAZE EJECT)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- ============================================================================"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local function spawnOpenTopLyoTank(spawnPos: Vector3, isSuperTyrant: boolean, teamColor: Color3): Model"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal tank = Instance.new(\"Model\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttank.Name = isSuperTyrant and \"TyrantTank\" or \"LyoTank\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttank:SetAttribute(\"HP\", isSuperTyrant and 650 or 400)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttank:SetAttribute(\"MaxHP\", isSuperTyrant and 650 or 400)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttank:SetAttribute(\"IsSuper\", isSuperTyrant)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttank:SetAttribute(\"StoredCrates\", 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttank:SetAttribute(\"IsCritical\", false)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal hull = Instance.new(\"Part\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\thull.Name = \"Hull\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\thull.Size = Vector3.new(7.2, 2.8, 8.6)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\thull.Color = isSuperTyrant and Color3.fromHex(\"#00d2ff\") or Color3.fromHex(\"#b8ff3c\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\thull.Position = spawnPos"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\thull.Material = Enum.Material.SmoothPlastic"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\thull.Parent = tank"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttank.PrimaryPart = hull"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal turret = Instance.new(\"Part\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tturret.Name = \"Turret\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tturret.Size = Vector3.new(4.8, 2.0, 4.8)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tturret.Color = teamColor"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tturret.Position = spawnPos + Vector3.new(0, 2.4, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tturret.CanCollide = false"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tturret.Parent = tank"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal turretMotor = Instance.new(\"Motor6D\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tturretMotor.Name = \"TurretMotor\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tturretMotor.Part0 = hull"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tturretMotor.Part1 = turret"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tturretMotor.C0 = CFrame.new(0, 2.4, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tturretMotor.Parent = hull"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- Kursi Open-Top Hatch: Kepala & Badan Atas Avatar menyembul dari dalam Turret"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal seat = Instance.new(\"VehicleSeat\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tseat.Name = \"OpenTopHatchSeat\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tseat.Size = Vector3.new(2.2, 0.6, 2.2)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
