    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "    const handleSandboxQuickDropCrate = (kind: \'red\' | \'super\') => {\n      soundEngine.playPickup();\n      const actorX = mountedTank ? mountedTank.x : playerUnit.x;\n      const actorZ = mountedTank ? mountedTank.z : playerUnit.z;\n      const actorYaw = mountedTank ? mountedTank.hullYaw : playerUnit.yaw;\n      const dropX = clamp(actorX + Math.cos(actorYaw) * 2.8 + (Math.random() - 0.5) * 0.8, -36, 36);\n      const dropZ = clamp(actorZ - Math.sin(actorYaw) * 2.8 + (Math.random() - 0.5) * 0.8, -36, 36);\n      spawnWorldCrate(kind, dropX, dropZ, true);\n      spawnBurstParticles(dropX, 1.0, dropZ, 8);\n    };\n\n    const handleSandboxQuickSpawnTank = () => {\n      soundEngine.playPowerCore();\n      const actorX = mountedTank ? mountedTank.x : playerUnit.x;\n      const actorZ = mountedTank ? mountedTank.z : playerUnit.z;\n      const actorYaw = mountedTank ? mountedTank.hullYaw : playerUnit.yaw;\n      const spawnX = clamp(actorX + Math.cos(actorYaw) * 4.2, -36, 36);\n      const spawnZ = clamp(actorZ - Math.sin(actorYaw) * 4.2, -36, 36);\n      const newTank = createLyoTankVehicle(spawnX, spawnZ, false, \'blue\');\n      tanks.push(newTank);\n      spawnBurstParticles(spawnX, 1.6, spawnZ, 16);\n    };"
        replacement_content: "    const handleSandboxQuickDropCrate = (kind: \'red\' | \'super\') => {\n      soundEngine.playPickup();\n      const actorX = mountedTank ? mountedTank.x : playerUnit.x;\n      const actorZ = mountedTank ? mountedTank.z : playerUnit.z;\n      const actorYaw = mountedTank ? mountedTank.hullYaw : playerUnit.yaw;\n      const fwdX = Math.cos(actorYaw);\n      const fwdZ = -Math.sin(actorYaw);\n      const rightX = Math.sin(actorYaw);\n      const rightZ = Math.cos(actorYaw);\n      const sideOffset = kind === \'red\' ? -1.55 : 1.55;\n      const dropX = clamp(actorX + fwdX * 2.8 + rightX * sideOffset, -36, 36);\n      const dropZ = clamp(actorZ + fwdZ * 2.8 + rightZ * sideOffset, -36, 36);\n      spawnWorldCrate(kind, dropX, dropZ, true);\n      spawnBurstParticles(dropX, 1.0, dropZ, 8);\n    };\n\n    const handleSandboxQuickSpawnTank = () => {\n      soundEngine.playPowerCore();\n      const actorX = mountedTank ? mountedTank.x : playerUnit.x;\n      const actorZ = mountedTank ? mountedTank.z : playerUnit.z;\n      const actorYaw = mountedTank ? mountedTank.hullYaw : playerUnit.yaw;\n      const spawnX = clamp(actorX + Math.cos(actorYaw) * 5.2, -36, 36);\n      const spawnZ = clamp(actorZ - Math.sin(actorYaw) * 5.2, -36, 36);\n      const newTank = createLyoTankVehicle(spawnX, spawnZ, false, \'blue\');\n      tanks.push(newTank);\n      spawnBurstParticles(spawnX, 1.6, spawnZ, 16);\n    };"
        start_line: 1857
        end_line: 1880
      }
      num_matches: 1
    }
    description: "Offset sandbox quick drop/spawn positions so Red Crate, Blue Super Crate, and Lyo Tank spawn side-by-side without overlapping"
