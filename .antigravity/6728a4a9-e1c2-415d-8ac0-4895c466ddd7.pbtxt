            }
            lines {
              text: "        shakeZ;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      camera.position.set("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        focusX + _camOffset.x,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        focusY + _camOffset.y,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
