              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const renderer = new THREE.WebGLRenderer({"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      antialias: !isSoftwareGl,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      powerPreference: \'high-performance\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    });"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    renderer.outputColorSpace = THREE.SRGBColorSpace;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    renderer.toneMapping = THREE.ACESFilmicToneMapping;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    renderer.toneMappingExposure = 1.1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
