    content: "    dirLight.shadow.camera.near = 2;\n    dirLight.shadow.camera.far = 120;\n    const d = 48;\n    dirLight.shadow.camera.left = -d;\n    dirLight.shadow.camera.right = d;\n    dirLight.shadow.camera.top = d;\n    dirLight.shadow.camera.bottom = -d;\n    dirLight.shadow.bias = -0.0005;\n    dirLight.shadow.normalBias = 0.02;\n    scene.add(dirLight);\n    scene.add(dirLight.target);\n\n    const rimLight = new THREE.DirectionalLight(\'#b8ff3c\', 0.55);\n    rimLight.position.set(-24, 14, -22);\n    scene.add(rimLight);\n\n    // Apply Lighting Preset helper\n    const applyLightingPreset = (presetKey: LightingPresetKey) => {\n      const p = LIGHTING_PRESETS[presetKey] || LIGHTING_PRESETS.day;\n      dirLight.color.set(p.lightColor);\n      dirLight.intensity = p.lightIntensity;\n      hemiLight.groundColor.set(p.shadowColor);\n      hemiLight.color.set(p.revealColor);\n      const bgCol = new THREE.Color(p.shadowColor).lerp(new THREE.Color(p.fogColorA), 0.35);\n      scene.background = bgCol;\n      if (scene.fog instanceof THREE.FogExp2) {\n        scene.fog.color.copy(bgCol);\n      }\n    };\n    applyLightingRef.current = applyLightingPreset;\n    applyLightingPreset(lightingPresetRef.current);\n\n    const applyFovMode = (mode: \'webgl35\' | \'roblox18\') => {\n      camera.fov = mode === \'roblox18\' ? REA_CONSTANTS.camera.robloxPseudoOrthoFov : REA_CONSTANTS.camera.fov;\n      camera.updateProjectionMatrix();\n    };\n    applyFovModeRef.current = applyFovMode;\n\n    // 3. Procedural Textures & Materials Library\n    const maxAniso = renderer.capabilities.getMaxAnisotropy();\n\n    const createCrossHatchAsphaltTexture = (): THREE.CanvasTexture => {\n      const c = document.createElement(\'canvas\');\n      c.width = 256;\n      c.height = 256;\n      const ctx = c.getContext(\'2d\')!;\n      ctx.fillStyle = \'#232634\';\n      ctx.fillRect(0, 0, 256, 256);\n      // Subtle 45-degree comic cross-hatching lines (replicates Kn in B1Nq4Kq6.js)\n      ctx.strokeStyle = \'rgba(17, 18, 26, 0.42)\';\n      ctx.lineWidth = 2;\n      for (let i = -256; i < 512; i += 16) {\n        ctx.beginPath();\n        ctx.moveTo(i, 0);\n        ctx.lineTo(i + 256, 256);\n        ctx.stroke();\n      }\n      ctx.strokeStyle = \'rgba(255, 255, 255, 0.04)\';\n      for (let i = 0; i < 256; i += 64) {\n        ctx.strokeRect(i, 0, 64, 256);\n        ctx.strokeRect(0, i, 256, 64);\n      }\n      const tex = new THREE.CanvasTexture(c);\n      tex.colorSpace = THREE.SRGBColorSpace;\n      tex.wrapS = THREE.RepeatWrapping;\n      tex.wrapT = THREE.RepeatWrapping;\n      tex.repeat.set(22, 22);\n      tex.anisotropy = maxAniso;\n      return tex;\n    };\n\n    const createHazardStripeTexture = (): THREE.CanvasTexture => {\n      const c = document.createElement(\'canvas\');\n      c.width = 128;\n      c.height = 128;\n      const ctx = c.getContext(\'2d\')!;\n      ctx.fillStyle = \'#fec83e\';\n      ctx.fillRect(0, 0, 128, 128);\n      ctx.fillStyle = \'#11121a\';\n      for (let i = -128; i < 256; i += 32) {\n        ctx.beginPath();\n        ctx.moveTo(i, 0);\n        ctx.lineTo(i + 16, 0);\n        ctx.lineTo(i + 144, 128);\n        ctx.lineTo(i + 128, 128);\n        ctx.closePath();\n        ctx.fill();\n      }\n      const tex = new THREE.CanvasTexture(c);\n      tex.colorSpace = THREE.SRGBColorSpace;\n      tex.wrapS = THREE.RepeatWrapping;\n      tex.wrapT = THREE.RepeatWrapping;\n      tex.anisotropy = maxAniso;\n      return tex;\n    };\n\n    const asphaltTex = createCrossHatchAsphaltTexture();\n    const hazardTex = createHazardStripeTexture();\n\n    // Shared Materials + 3-Step Cel-Shading Gradient Map (replicates Yn Toon Shader + Nn StrokeMaterial)\n    const toonSteps = new Uint8Array([95, 195, 255]);\n    const toonGradientMap = new THREE.DataTexture(toonSteps, 3, 1, THREE.RedFormat);\n    toonGradientMap.minFilter = THREE.NearestFilter;\n    toonGradientMap.magFilter = THREE.NearestFilter;\n    toonGradientMap.needsUpdate = true;\n\n    const inkOutlineMat = new THREE.MeshBasicMaterial({\n      color: 0x17110f,\n      side: THREE.BackSide,\n    });\n    const hoverOutlineMat = new THREE.MeshBasicMaterial({\n      color: 0xffaa00,\n      side: THREE.BackSide,\n    });\n    const flashWhiteMat = new THREE.MeshBasicMaterial({\n      color: 0xffffff,\n    });\n\n    const matTankLime = new THREE.MeshToonMaterial({\n      color: 0x9ef01a,\n      gradientMap: toonGradientMap,\n    });\n    const matTankHighlight = new THREE.MeshToonMaterial({\n      color: 0xb8ff3c,\n      gradientMap: toonGradientMap,\n    });\n    const matYellow = new THREE.MeshToonMaterial({\n      color: 0xffbe18,\n      gradientMap: toonGradientMap,\n    });\n    const matDarkSteel = new THREE.MeshToonMaterial({\n      color: 0x222533,\n      gradientMap: toonGradientMap,\n    });\n    const matGunmetal = new THREE.MeshToonMaterial({\n      color: 0x3b3f52,\n      gradientMap: toonGradientMap,\n    });\n    const matRedBarrel = new THREE.MeshToonMaterial({\n      color: 0xf42f4c,\n      gradientMap: toonGradientMap,\n    });\n    const matHazard = new THREE.MeshToonMaterial({\n      color: 0xffffff,\n      map: hazardTex,\n      gradientMap: toonGradientMap,\n    });\n    const matConcrete = new THREE.MeshToonMaterial({\n      color: 0x62667a,\n      gradientMap: toonGradientMap,\n    });\n    const matZebra = new THREE.MeshStandardMaterial({\n      color: 0xf2f4f8,\n      roughness: 0.6,\n      metalness: 0.05,\n      polygonOffset: true,\n      polygonOffsetFactor: -1,\n      polygonOffsetUnits: -1,\n    });\n\n    // Helper: Add mesh + BackSide hard ink outline (replicates Nn StrokeMaterial)\n    const addOutlinedPart = (\n      parent: THREE.Object3D,\n      geo: THREE.BufferGeometry,\n      mat: THREE.Material,\n      pos: [number, number, number],\n      rot: [number, number, number] = [0, 0, 0],\n      outlineScale = 1.075,\n      castShadow = true,\n    ): THREE.Mesh => {\n      const mesh = new THREE.Mesh(geo, mat);\n      mesh.position.set(pos[0], pos[1], pos[2]);\n      mesh.rotation.set(rot[0], rot[1], rot[2]);\n      mesh.castShadow = castShadow && !isSoftwareGl;\n      mesh.receiveShadow = !isSoftwareGl;\n      mesh.userData.baseMaterial = mat;\n\n      const outline = new THREE.Mesh(geo, inkOutlineMat);\n      outline.scale.setScalar(outlineScale);\n      outline.name = \'InkStroke\';\n      mesh.add(outline);\n\n      parent.add(mesh);\n      return mesh;\n    };\n\n    // Soft radial contact shadow geometry (shared)\n    const shadowDiscGeo = new THREE.CircleGeometry(1.4, 20);\n    shadowDiscGeo.rotateX(-Math.PI / 2);\n    const shadowDiscMat = new THREE.MeshBasicMaterial({\n      color: 0x090a10,\n      transparent: true,\n      opacity: 0.42,\n      depthWrite: false,\n    });\n\n    // 4. Ground, Crossroads, Zebra Crossings, Perimeter Hills & Factory Landmarks\n    const groundGeo = new THREE.PlaneGeometry(180, 180);\n    groundGeo.rotateX(-Math.PI / 2);\n    const groundMat = new THREE.MeshStandardMaterial({\n      color: 0xffffff,\n      map: asphaltTex,\n      roughness: 0.88,\n      metalness: 0.08,\n    });\n    const groundMesh = new THREE.Mesh(groundGeo, groundMat);\n    groundMesh.receiveShadow = !isSoftwareGl;\n    scene.add(groundMesh);\n\n    // Main Factory Road Crossings (offset by +0.02 on Y to prevent Z-fighting)\n    const roadMat = new THREE.MeshStandardMaterial({\n      color: 0x191b24,\n      roughness: 0.78,\n      metalness: 0.1,\n    });\n    const roadNS = new THREE.Mesh(new THREE.BoxGeometry(10, 0.03, 96), roadMat);\n    roadNS.position.set(0, 0.015, 0);\n    roadNS.receiveShadow = !isSoftwareGl;\n    scene.add(roadNS);\n\n    const roadEW = new THREE.Mesh(new THREE.BoxGeometry(96, 0.03, 10), roadMat);\n    roadEW.position.set(0, 0.016, 0);\n    roadEW.receiveShadow = !isSoftwareGl;\n    scene.add(roadEW);\n\n    // Zebra Crossings at 4 intersections\n    const stripeGeo = new THREE.BoxGeometry(2.4, 0.02, 0.55);\n    const zebraOffsets = [\n      { x: -9, z: 0, rotY: 0 },\n      { x: 9, z: 0, rotY: 0 },\n      { x: 0, z: -9, rotY: Math.PI / 2 },\n      { x: 0, z: 9, rotY: Math.PI / 2 },\n    ];\n    zebraOffsets.forEach((zo) => {\n      const zGroup = new THREE.Group();\n      zGroup.position.set(zo.x, 0.035, zo.z);\n      zGroup.rotation.y = zo.rotY;\n      for (let i = -3; i <= 3; i++) {\n        const s = new THREE.Mesh(stripeGeo, matZebra);\n        s.position.set(0, 0, i * 1.1);\n        zGroup.add(s);"
