            }
            lines {
              text: "        float onEWRoad = (1.0 - smoothstep(20.0, 21.5, abs(anchor.x))) * (1.0 - smoothstep(2.5, 3.3, abs(anchor.z)));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float onCenterPad = 1.0 - smoothstep(3.6, 4.4, max(abs(anchor.x), abs(anchor.z)));"
