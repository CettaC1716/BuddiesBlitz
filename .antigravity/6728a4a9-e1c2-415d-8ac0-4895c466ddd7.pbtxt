            }
            lines {
              text: "\t\t\tSuper = { Name = \"Pocket Rocket / Laser Rifle\", Category = \"LiteWeapon\", Tier = 2 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t},"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t[\"2x1x1\"] = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tCount = 2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tShape = \"2x1x1 (Flat)\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tRegular = { Name = \"Hand Grenade / Time Bomb\", Category = \"Grenade\", Tier = 1 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tSuper = { Name = \"Cluster / Lightning Grenade\", Category = \"Grenade\", Tier = 2 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t},"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t[\"1x1x2\"] = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tCount = 2,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tShape = \"1x1x2 (Vertical)\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tRegular = { Name = \"Buddy Tier 1 (Infuntry / Medic / Ninja)\", Category = \"BuddyT1\", Tier = 1 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tSuper = { Name = \"Super Buddy Tier 1 (Super Ninja / Stealthy)\", Category = \"BuddyT1\", Tier = 2 },"
