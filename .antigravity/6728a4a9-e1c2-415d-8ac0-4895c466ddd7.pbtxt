              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        vUv = uv;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        vec4 worldPosition = modelMatrix * vec4(position, 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        vWorldPos = worldPosition.xyz;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        vWorldNormal = normalize(mat3(modelMatrix) * normal);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        gl_Position = projectionMatrix * viewMatrix * worldPosition;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    `,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    fragmentShader: /* glsl */ `"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uniform sampler2D uMap;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uniform float uHasMap;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uniform vec3 uBaseColor;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uniform vec3 uShadowColor;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
