        target_content: "export type GameState = \'title\' | \'playing\' | \'paused\' | \'gameover\';\n\nexport interface RadarDot {\n  id: string;\n  kind: \'player\' | \'ally\' | \'enemy\' | \'crate_red\' | \'crate_super\' | \'tank_blue\' | \'tank_red\';\n  x: number;\n  z: number;\n}\n\nexport interface HudSnapshot {\n  hp: number;\n  maxHp: number;\n  score: number;\n  bestScore: number;\n  speedKmh: number;\n  isBoosting: boolean;\n  isGrabMode: boolean;\n  grabbedPropName: string | null;\n  collectedItems: string[];\n  powerCoreActivated: boolean;\n  enemiesDefeated: number;\n  totalEnemies: number;\n  lightingPreset: LightingPresetKey;\n  cameraFovMode: \'webgl35\' | \'roblox18\';\n  outcome: \'victory\' | \'defeat\' | null;\n  clearTimeSec: number;\n  // Team Buddies 3D World State\n  controlMode: \'buddy\' | \'tank\';\n  activeClass: BuddyClassId;\n  equippedWeapon: string;\n  ammo: number;\n  carryingCrate: \'none\' | \'red\' | \'super\';\n  tankStoredCrates: number;\n  padSlots: CrateSlotType[];\n  padShape: string;\n  padOutputName: string;\n  padIsMerged: boolean;\n  padIsSuper: boolean;\n  buildOrder: BuildOrderTarget;\n  buildOrderLabel: string;\n  buildOrderTargetCrates: number;\n  teamCommand: TeamCommandMode;\n  alliedBuddiesCount: number;\n  blueBaseHp: number;\n  redBaseHp: number;\n  contextHint: string;\n  radarDots: RadarDot[];\n}\n\ninterface FactoryPlaygroundCanvasProps {\n  gameState: GameState;\n  lightingPreset: LightingPresetKey;\n  cameraFovMode: \'webgl35\' | \'roblox18\';\n  resetTrigger: number;\n  onHudUpdate: (snapshot: HudSnapshot) => void;\n  onGameOver: (outcome: \'victory\' | \'defeat\', finalSnapshot: HudSnapshot) => void;\n  onTogglePause: () => void;\n}\n\ninterface WorldCrate {\n  id: number;\n  kind: \'red\' | \'super\';\n  mesh: THREE.Group;\n  parachuteMesh: THREE.Mesh;\n  x: number;\n  y: number;\n  z: number;\n  vx: number;\n  vy: number;\n  vz: number;\n  state: \'falling\' | \'grounded\' | \'carried\' | \'thrown\' | \'stacked\';\n  carrierId: number | null;\n  squashTimer: number;\n}\n\ninterface WorldPickup {\n  id: number;\n  kind: \'health\' | \'ammo\' | \'weapon\' | \'powerup\';\n  weaponName: string;\n  mesh: THREE.Group;\n  x: number;\n  z: number;\n  bobPhase: number;\n  collected: boolean;\n}\n\ninterface DestructibleTree {\n  id: number;\n  mesh: THREE.Group;\n  x: number;\n  z: number;\n  hp: number;\n  maxHp: number;\n  alive: boolean;\n  hitFlashTimer: number;\n}"
        replacement_content: "export type GameState = \'title\' | \'playing\' | \'paused\' | \'gameover\';\nexport type PlayMode = \'sandbox\' | \'editor\' | \'match\';\n\nexport type EditorToolId =\n  | \'tree_purple\'\n  | \'tree_gold\'\n  | \'turbine\'\n  | \'power_core\'\n  | \'concrete_fence\'\n  | \'barricade\'\n  | \'explosive_barrel\'\n  | \'hydrant\'\n  | \'move_blue_hq\'\n  | \'move_blue_pad\'\n  | \'move_red_hq\'\n  | \'move_red_pad\'\n  | \'move_drop_zone\';\n\nexport interface PlacedMapProp {\n  id: number;\n  kind:\n    | \'tree_purple\'\n    | \'tree_gold\'\n    | \'turbine\'\n    | \'power_core\'\n    | \'concrete_fence\'\n    | \'barricade\'\n    | \'explosive_barrel\'\n    | \'hydrant\';\n  x: number;\n  z: number;\n  rotY: number;\n  scale: number;\n}\n\nexport interface ArenaMapLayout {\n  blueHq: { x: number; z: number };\n  bluePad: { x: number; z: number };\n  redHq: { x: number; z: number };\n  redPad: { x: number; z: number };\n  centerDropZone: { x: number; z: number };\n  props: PlacedMapProp[];\n}\n\nexport const MAP_STORAGE_KEY = \'lyo_arena_map_layout_v2\';\n\nexport const DEFAULT_ARENA_MAP_LAYOUT: ArenaMapLayout = {\n  blueHq: { x: 0, z: 22 },\n  bluePad: { x: -6.2, z: 16.5 },\n  redHq: { x: 0, z: -22 },\n  redPad: { x: 6.2, z: -16.5 },\n  centerDropZone: { x: 0, z: 0 },\n  props: [\n    // Lush 8-10 unit tall Lyo Trees right near Player Start (z = +10..+16) so they are immediately visible!\n    { id: 101, kind: \'tree_purple\', x: -7.2, z: 11.4, rotY: 0.2, scale: 1.0 },\n    { id: 102, kind: \'tree_gold\', x: 7.2, z: 11.4, rotY: -0.4, scale: 1.0 },\n    { id: 103, kind: \'tree_gold\', x: -12.4, z: 15.6, rotY: 1.1, scale: 1.05 },\n    { id: 104, kind: \'tree_purple\', x: 12.4, z: 15.6, rotY: -0.8, scale: 1.05 },\n    // Mid-arena & Northern Lyo Trees\n    { id: 105, kind: \'tree_purple\', x: -10.5, z: 3.5, rotY: 0.5, scale: 1.0 },\n    { id: 106, kind: \'tree_gold\', x: 10.5, z: 3.5, rotY: -0.6, scale: 1.0 },\n    { id: 107, kind: \'tree_gold\', x: -10.5, z: -9.5, rotY: 0.8, scale: 1.0 },\n    { id: 108, kind: \'tree_purple\', x: 10.5, z: -9.5, rotY: -0.3, scale: 1.0 },\n    { id: 109, kind: \'tree_purple\', x: -18.5, z: 8.5, rotY: 0.0, scale: 1.1 },\n    { id: 110, kind: \'tree_gold\', x: 18.5, z: 8.5, rotY: 1.5, scale: 1.1 },\n    { id: 111, kind: \'tree_gold\', x: -18.5, z: -8.5, rotY: -1.2, scale: 1.1 },\n    { id: 112, kind: \'tree_purple\', x: 18.5, z: -8.5, rotY: 0.7, scale: 1.1 },\n    // Default Factory Playground .glb Props\n    { id: 201, kind: \'power_core\', x: 6.8, z: 15.4, rotY: -Math.PI / 5, scale: 1.0 },\n    { id: 202, kind: \'turbine\', x: -15.5, z: 4.2, rotY: 0.3, scale: 1.0 },\n    { id: 203, kind: \'turbine\', x: 15.5, z: -4.2, rotY: -2.5, scale: 1.0 },\n    { id: 204, kind: \'concrete_fence\', x: -5.2, z: 7.2, rotY: 0, scale: 1.0 },\n    { id: 205, kind: \'barricade\', x: 5.2, z: 7.2, rotY: 0, scale: 1.0 },\n    { id: 206, kind: \'hydrant\', x: -4.2, z: 5.5, rotY: 0, scale: 1.0 },\n    { id: 207, kind: \'explosive_barrel\', x: 4.4, z: 5.5, rotY: 0.4, scale: 1.0 },\n  ],\n};\n\nexport interface RadarDot {\n  id: string;\n  kind: \'player\' | \'ally\' | \'enemy\' | \'crate_red\' | \'crate_super\' | \'tank_blue\' | \'tank_red\';\n  x: number;\n  z: number;\n}\n\nexport interface HudSnapshot {\n  hp: number;\n  maxHp: number;\n  score: number;\n  bestScore: number;\n  speedKmh: number;\n  isBoosting: boolean;\n  isGrabMode: boolean;\n  grabbedPropName: string | null;\n  collectedItems: string[];\n  powerCoreActivated: boolean;\n  enemiesDefeated: number;\n  totalEnemies: number;\n  lightingPreset: LightingPresetKey;\n  cameraFovMode: \'webgl35\' | \'roblox18\';\n  outcome: \'victory\' | \'defeat\' | null;\n  clearTimeSec: number;\n  // Team Buddies 3D World State\n  controlMode: \'buddy\' | \'tank\';\n  activeClass: BuddyClassId;\n  equippedWeapon: string;\n  ammo: number;\n  carryingCrate: \'none\' | \'red\' | \'super\';\n  tankStoredCrates: number;\n  padSlots: CrateSlotType[];\n  padShape: string;\n  padOutputName: string;\n  padIsMerged: boolean;\n  padIsSuper: boolean;\n  buildOrder: BuildOrderTarget;\n  buildOrderLabel: string;\n  buildOrderTargetCrates: number;\n  teamCommand: TeamCommandMode;\n  alliedBuddiesCount: number;\n  blueBaseHp: number;\n  redBaseHp: number;\n  contextHint: string;\n  radarDots: RadarDot[];\n  // Map Editor State\n  editorObjectCount: number;\n  editorCursorX: number;\n  editorCursorZ: number;\n  editorRotDeg: number;\n  editorScale: number;\n}\n\ninterface FactoryPlaygroundCanvasProps {\n  gameState: GameState;\n  playMode: PlayMode;\n  editorTool: EditorToolId;\n  lightingPreset: LightingPresetKey;\n  cameraFovMode: \'webgl35\' | \'roblox18\';\n  resetTrigger: number;\n  onHudUpdate: (snapshot: HudSnapshot) => void;\n  onGameOver: (outcome: \'victory\' | \'defeat\', finalSnapshot: HudSnapshot) => void;\n  onTogglePause: () => void;\n  onMapSaved?: (message: string) => void;\n}\n\ninterface WorldCrate {\n  id: number;\n  kind: \'red\' | \'super\';\n  mesh: THREE.Group;\n  parachuteMesh: THREE.Mesh;\n  x: number;\n  y: number;\n  z: number;\n  vx: number;\n  vy: number;\n  vz: number;\n  state: \'falling\' | \'grounded\' | \'carried\' | \'thrown\' | \'stacked\';\n  carrierId: number | null;\n  squashTimer: number;\n}\n\ninterface WorldPickup {\n  id: number;\n  kind: \'health\' | \'ammo\' | \'weapon\' | \'powerup\';\n  weaponName: string;\n  mesh: THREE.Group;\n  x: number;\n  z: number;\n  bobPhase: number;\n  collected: boolean;\n}\n\ninterface DestructibleTree {\n  id: number;\n  propId: number;\n  isPurple: boolean;\n  scale: number;\n  mesh: THREE.Group;\n  x: number;\n  z: number;\n  hp: number;\n  maxHp: number;\n  alive: boolean;\n  hitFlashTimer: number;\n}"
