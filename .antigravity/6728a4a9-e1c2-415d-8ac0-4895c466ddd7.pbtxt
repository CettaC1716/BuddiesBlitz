    command_line: "node -e \'\nconst fs = require(\"fs\");\nfor (const f of [\"turbine.glb\", \"power-core.glb\", \"concrete-fence-1a.glb\", \"barricade-1a.glb\", \"explosive-barrel.glb\", \"hydrant.glb\"]) {\n  const buf = fs.readFileSync(\"public/extracted_lyo_assets/models/\" + f);\n  const jsonLen = buf.readUInt32LE(12);\n  const gltf = JSON.parse(buf.slice(20, 20 + jsonLen).toString(\"utf8\"));\n  console.log(\"=== \" + f + \" === scene roots:\", gltf.scenes[0].nodes.map(i => i + \":\" + gltf.nodes[i].name));\n}\n\'"
