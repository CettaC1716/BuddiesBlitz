    command_line: "node -e \'\nconst fs = require(\"fs\");\nfor (const f of [\"public/extracted_lyo_assets/models/tree-1b.glb\", \"public/extracted_lyo_assets/models/tree-1a.glb\"]) {\n  const buf = fs.readFileSync(f);\n  const jsonLen = buf.readUInt32LE(12);\n  const gltf = JSON.parse(buf.slice(20, 20 + jsonLen).toString(\"utf8\"));\n  const ref = gltf.nodes.find(n => n.name && n.name.includes(\"REF\"));\n  console.log(f, \"REF:\", ref.name, \"scale:\", ref.scale, \"translation:\", ref.translation);\n  for (const cIdx of (ref.children || [])) {\n    const c = gltf.nodes[cIdx];\n    console.log(\"  child:\", c.name, \"t:\", c.translation, \"s:\", c.scale);\n  }\n  const mesh = gltf.meshes[ref.mesh];\n  const posAcc = gltf.accessors[mesh.primitives[0].attributes.POSITION];\n  console.log(\"  mesh min:\", posAcc.min, \"max:\", posAcc.max);\n}\n\'"
