            lines {
              text: "      const inst = new THREE.InstancedMesh(geo, glbTrackSeg.material, numSegments);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const dummy = new THREE.Object3D();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const frames = curve.computeFrenetFrames(numSegments, true);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (let i = 0; i < numSegments; i++) {"
