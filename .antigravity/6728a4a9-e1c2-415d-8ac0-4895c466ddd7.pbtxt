        replacement_chunks {
          target_content: "    // 2. Scene, Camera & Lyo Daylight Lighting\n    const scene = new THREE.Scene();\n    scene.background = new THREE.Color(\'#9ad9ea\');\n    scene.fog = new THREE.FogExp2(\'#9ad9ea\', 0.0055);\n\n    const camera = new THREE.PerspectiveCamera(\n      REA_CONSTANTS.camera.fov,\n      (container.clientWidth || window.innerWidth) / (container.clientHeight || window.innerHeight),\n      REA_CONSTANTS.camera.near,\n      REA_CONSTANTS.camera.far,\n    );\n\n    const hemiLight = new THREE.HemisphereLight(\'#fffdf0\', \'#5f6ea5\', 1.15);\n    scene.add(hemiLight);\n\n    const dirLight = new THREE.DirectionalLight(\'#fff5e4\', 1.85);\n    dirLight.position.set(14, 34, 16);\n    dirLight.castShadow = !isSoftwareGl;\n    dirLight.shadow.mapSize.set(isSoftwareGl ? 512 : 1024, isSoftwareGl ? 512 : 1024);\n    const d = 48;\n    dirLight.shadow.camera.near = 2;\n    dirLight.shadow.camera.far = 120;\n    dirLight.shadow.camera.left = -d;\n    dirLight.shadow.camera.right = d;\n    dirLight.shadow.camera.top = d;\n    dirLight.shadow.camera.bottom = -d;\n    dirLight.shadow.bias = -0.0005;\n    scene.add(dirLight);\n    scene.add(dirLight.target);\n\n    const applyLightingPreset = (presetKey: LightingPresetKey) => {\n      if (presetKey === \'day\') {\n        dirLight.color.set(\'#fff5e4\');\n        dirLight.intensity = 1.85;\n        hemiLight.color.set(\'#fffdf0\');\n        hemiLight.groundColor.set(\'#5f6ea5\');\n        scene.background = new THREE.Color(\'#9ad9ea\');\n        if (scene.fog instanceof THREE.FogExp2) scene.fog.color.set(\'#9ad9ea\');\n        return;\n      }\n      const p = LIGHTING_PRESETS[presetKey] || LIGHTING_PRESETS.day;\n      dirLight.color.set(p.lightColor);\n      dirLight.intensity = p.lightIntensity;\n      hemiLight.groundColor.set(p.shadowColor);\n      hemiLight.color.set(p.revealColor);\n      const bgCol = new THREE.Color(p.shadowColor).lerp(new THREE.Color(p.fogColorA), 0.35);\n      scene.background = bgCol;\n      if (scene.fog instanceof THREE.FogExp2) {\n        scene.fog.color.copy(bgCol);\n      }\n    };\n    applyLightingRef.current = applyLightingPreset;\n    applyLightingPreset(lightingPresetRef.current);"
          replacement_content: "    // 2. Scene, Camera & Warm Evening Sunset Horizon Sky Dome\n    const scene = new THREE.Scene();\n    scene.background = new THREE.Color(\'#ff9d66\');\n    scene.fog = new THREE.FogExp2(\'#ff9d66\', 0.0042);\n\n    const skyUniforms = {\n      uTopColor: { value: new THREE.Color(\'#42488a\') },\n      uMidSkyColor: { value: new THREE.Color(\'#b66aa6\') },\n      uHorizonColor: { value: new THREE.Color(\'#ff985a\') },\n      uLowerGlowColor: { value: new THREE.Color(\'#ffd984\') },\n      uSunDirection: { value: new THREE.Vector3(-0.22, 0.085, -0.97).normalize() },\n    };\n\n    const skyDomeGeo = new THREE.SphereGeometry(420, 32, 24);\n    const skyDomeMat = new THREE.ShaderMaterial({\n      uniforms: skyUniforms,\n      vertexShader: /* glsl */ `\n        varying vec3 vLocalDir;\n        void main() {\n          vLocalDir = normalize(position);\n          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\n        }\n      `,\n      fragmentShader: /* glsl */ `\n        uniform vec3 uTopColor;\n        uniform vec3 uMidSkyColor;\n        uniform vec3 uHorizonColor;\n        uniform vec3 uLowerGlowColor;\n        uniform vec3 uSunDirection;\n        varying vec3 vLocalDir;\n\n        void main() {\n          vec3 dir = normalize(vLocalDir);\n          float h = clamp(dir.y, -0.1, 1.0);\n\n          // Warm evening sunset gradient: golden-amber horizon -> coral-peach -> dusk rose-violet -> twilight indigo\n          float tLow = smoothstep(-0.04, 0.09, h);\n          float tMid = smoothstep(0.06, 0.22, h);\n          float tHigh = smoothstep(0.18, 0.48, h);\n\n          vec3 col = mix(uLowerGlowColor, uHorizonColor, tLow);\n          col = mix(col, uMidSkyColor, tMid);\n          col = mix(col, uTopColor, tHigh);\n\n          // Stylized cel-shaded setting sun & warm horizon halo\n          float sunCos = max(dot(dir, normalize(uSunDirection)), 0.0);\n          float sunHalo = smoothstep(0.88, 0.992, sunCos) * 0.42;\n          float sunDisc = step(0.9965, sunCos);\n          col = mix(col, vec3(1.0, 0.92, 0.68), clamp(sunHalo + sunDisc * 0.95, 0.0, 1.0));\n\n          // Subtle cel-shaded warm evening cloud bands in upper sky\n          float cloudBand = sin(dir.x * 9.5 + dir.z * 4.2) * cos(dir.x * 5.0 - dir.z * 7.0);\n          float cloudMask = smoothstep(0.05, 0.14, h) * (1.0 - smoothstep(0.24, 0.38, h));\n          float cloudStep = step(0.32, cloudBand) * cloudMask * 0.18;\n          col = mix(col, uLowerGlowColor, cloudStep);\n\n          gl_FragColor = vec4(col, 1.0);\n        }\n      `,\n      side: THREE.BackSide,\n      depthWrite: false,\n    });\n    const skyDomeMesh = new THREE.Mesh(skyDomeGeo, skyDomeMat);\n    skyDomeMesh.name = \'WarmEveningSkyDome\';\n    skyDomeMesh.renderOrder = -10;\n    scene.add(skyDomeMesh);\n\n    const camera = new THREE.PerspectiveCamera(\n      REA_CONSTANTS.camera.fov,\n      (container.clientWidth || window.innerWidth) / (container.clientHeight || window.innerHeight),\n      REA_CONSTANTS.camera.near,\n      REA_CONSTANTS.camera.far,\n    );\n\n    const hemiLight = new THREE.HemisphereLight(\'#ffebd2\', \'#5b5694\', 1.2);\n    scene.add(hemiLight);\n\n    const dirLight = new THREE.DirectionalLight(\'#ffe4b5\', 1.9);\n    dirLight.position.set(14, 34, 16);\n    dirLight.castShadow = !isSoftwareGl;\n    dirLight.shadow.mapSize.set(isSoftwareGl ? 512 : 1024, isSoftwareGl ? 512 : 1024);\n    const d = 48;\n    dirLight.shadow.camera.near = 2;\n    dirLight.shadow.camera.far = 120;\n    dirLight.shadow.camera.left = -d;\n    dirLight.shadow.camera.right = d;\n    dirLight.shadow.camera.top = d;\n    dirLight.shadow.camera.bottom = -d;\n    dirLight.shadow.bias = -0.0005;\n    scene.add(dirLight);\n    scene.add(dirLight.target);\n\n    const applyLightingPreset = (presetKey: LightingPresetKey) => {\n      if (presetKey === \'day\' || presetKey === \'dusk\') {\n        dirLight.color.set(\'#ffe4b5\');\n        dirLight.intensity = 1.9;\n        hemiLight.color.set(\'#ffebd2\');\n        hemiLight.groundColor.set(\'#5b5694\');\n        skyUniforms.uTopColor.value.set(presetKey === \'dusk\' ? \'#352f6e\' : \'#42488a\');\n        skyUniforms.uMidSkyColor.value.set(presetKey === \'dusk\' ? \'#9e4f8c\' : \'#b66aa6\');\n        skyUniforms.uHorizonColor.value.set(presetKey === \'dusk\' ? \'#ff7b54\' : \'#ff985a\');\n        skyUniforms.uLowerGlowColor.value.set(\'#ffd984\');\n        scene.background = new THREE.Color(\'#ff985a\');\n        if (scene.fog instanceof THREE.FogExp2) scene.fog.color.set(\'#ff985a\');\n        return;\n      }\n      const p = LIGHTING_PRESETS[presetKey] || LIGHTING_PRESETS.day;\n      dirLight.color.set(p.lightColor);\n      dirLight.intensity = p.lightIntensity;\n      hemiLight.groundColor.set(p.shadowColor);\n      hemiLight.color.set(p.revealColor);\n      const bgCol = new THREE.Color(p.shadowColor).lerp(new THREE.Color(p.fogColorA), 0.35);\n      skyUniforms.uTopColor.value.copy(new THREE.Color(p.shadowColor));\n      skyUniforms.uMidSkyColor.value.copy(bgCol);\n      skyUniforms.uHorizonColor.value.copy(new THREE.Color(p.fogColorA));\n      skyUniforms.uLowerGlowColor.value.copy(new THREE.Color(p.fogColorB));\n      scene.background = bgCol;\n      if (scene.fog instanceof THREE.FogExp2) {\n        scene.fog.color.copy(bgCol);\n      }\n    };\n    applyLightingRef.current = applyLightingPreset;\n    applyLightingPreset(lightingPresetRef.current);"
