  code_action {
    action_spec {
      command {
        instruction: "Update src/components/ReaLuauModal.tsx to include the 4-Phase Buddy Blitz GDD scripts and Explorer tree alongside the REA report"
        is_edit: true
        file {
          absolute_uri: "file:///src/components/ReaLuauModal.tsx"
