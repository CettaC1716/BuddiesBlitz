    content: "/**\n * Pure physics, camera spring, and gameplay math extracted via REA from\n * https://longhoang-lyo.com/ (bundles CQl67Veh.js, B1Nq4Kq6.js, BlAypStk.js, CJn-Xu8f.js)\n */\n\nexport interface Vec3 {\n  x: number;\n  y: number;\n  z: number;\n}\n\nexport type LightingPresetKey = \'day\' | \'dusk\' | \'night\' | \'dawn\';\n\nexport interface LightingPresetConfig {\n  key: LightingPresetKey;\n  label: string;\n  revealColor: string;\n  revealIntensity: number;\n  lightColor: string;\n  lightIntensity: number;\n  shadowColor: string;\n  fogColorA: string;\n  fogColorB: string;\n  fogNearRatio: number;\n  fogFarRatio: number;\n  viewportFilterColor: string;\n  viewportFilterOpacity: number;\n}\n\n/**\n * Exact deobfuscated constants from longhoang-lyo.com production bundles\n */\nexport const REA_CONSTANTS = {\n  camera: {\n    fov: 35,\n    robloxPseudoOrthoFov: 18,\n    near: 0.1,\n    far: 1000,\n    defaultAngleOffset: { x: 4, y: 14, z: 8 } as Vec3,\n    playerStartAngleOffset: { x: 0, y: 2, z: 14 } as Vec3,\n    powerCoreAngleOffset: { x: 0, y: 0, z: 10 } as Vec3,\n    zoom: {\n      minDistance: 9,\n      amplitude: 12,\n      defaultValue: 0.6,\n      defaultDistance: 16.2,\n      bridgeTargetDistance: 25,\n    },\n    followSpring: {\n      smoothTimeNormal: 0.18,\n      smoothTimeBoost: 0.22,\n      snapDistanceSqThreshold: 36,\n    },\n    mousePan: {\n      sensitivity: 1.3,\n      dampSpeed: 5,\n      dragPanSensitivity: 0.05,\n    },\n    recoil: {\n      kickDistance: 0.13,\n      maxRecoilDistance: 0.37,\n    },\n    intro: {\n      targetZoomScaleDesktop: 1.5,\n      targetZoomScaleMobile: 1.2,\n      centerX: 0.75,\n      centerY: 0.5,\n      playerRotationY: -0.52,\n      playerStartRotationYDeg: -180,\n    },\n    worldSpawns: {\n      playerStartPosition: { x: 57.334, y: 10.068, z: 98.584 } as Vec3,\n      tutorShootPosition: { x: 16.34, y: 7.652, z: 88.309 } as Vec3,\n    },\n  },\n  physics: {\n    gravity: { x: 0, y: -9.81, z: 0 } as Vec3,\n    fixedTimeStep: 1 / 60,\n    maxPhysicsStepsPerFrame: 5,\n    robotBody: {\n      modelScale: 0.9,\n      linearDamping: 0.5,\n      angularDamping: 0.8,\n      restitution: 0.4,\n      friction: 0.3,\n      lockRotationsX: true,\n      lockRotationsY: false,\n      lockRotationsZ: true,\n      ccdEnabled: true,\n    },\n    drive: {\n      speed: 8.0,\n      boostMultiplier: 1.9,\n      boostMaxSpeed: 15.2,\n      rotationSpeed: 3.12,\n      boostRotationMultiplier: 1.2,\n      driveLerpRate: 8.0,\n      rotationLerpRate: 50.0,\n      forwardFrictionFactor: 0.5,\n      lateralFrictionFactor: 20.0,\n      rotationDampingFactor: 0.15,\n      turretDamping: 0.06,\n      airControlFactor: 0.45,\n      airRotationControlFactor: 0.3,\n      collisionAngularMultiplier: 0.3,\n      collisionPushBackMultiplier: 0.35,\n    },\n    terrain: {\n      friction: 0.8,\n      restitution: 0.0,\n    },\n    enemyBody: {\n      linearDamping: 0.8,\n      angularDamping: 0.8,\n      restitution: 0.5,\n      friction: 0.3,\n      density: 10.0,\n      bevelRadius: 0.08,\n      fodderHealth: 14,\n      bossHealth: 40,\n      playerMaxHealth: 30,\n    },\n    cannon: {\n      fireRate: 0.2,\n      shotInterval: 0.08,\n      projectileSpeed: 55.0,\n      projectileLife: 1.0,\n      projectileSpread: 0.05,\n      recoilDistance: 0.16,\n      barrelRecoilDistance: 0.16,\n      recoilPushDuration: 0.1,\n      recoilReturnDuration: 0.5,\n      turretLiftAmount: 0.06,\n      turretRotateAngleDeg: 6,\n      bodyLiftAmount: 0.05,\n      bodyRotateAngleDeg: 12,\n      muzzleLightColor: \'#00ff66\',\n      muzzleLightIntensity: 1.1,\n      muzzleLightDistance: 6.0,\n    },\n    grabMode: {\n      holdingDistance: 6.0,\n      springStrength: 180.0,\n      damping: 16.0,\n      maxPositionDelta: 1.5,\n      maxAngleDelta: 0.4,\n      maxAcceleration: 120.0,\n      maxAngularAcceleration: 80.0,\n      laserTravelSpeed: 7.5,\n      hoverStrokeColor: \'#ffaa00\',\n      hoverStrokeWidth: 0.055,\n    },\n  },\n  shadersAndLighting: {\n    outline: {\n      strokeWidth: 0.018,\n      strokeMaxDepth: 1.5,\n      strokeColor: \'#17110f\',\n      strokeColorRgb: [23, 17, 15] as [number, number, number],\n    },\n    hatch: {\n      angleRad: 0.7854,\n      frequency: 204,\n      noiseScale: 8,\n      noiseAmp: 0.3,\n    },\n    directionalKeyLight: {\n      color: \'#ffe8d6\',\n      intensity: 2.0,\n      offset: { x: 2, y: 25, z: -2 } as Vec3,\n    },\n    smoke: {\n      spawnRadiusMin: 0.03,\n      spawnRadiusMax: 0.16,\n      upwardVelMin: 1.28,\n      upwardVelMax: 1.92,\n      lifetimeMin: 5.5,\n      lifetimeMax: 8.5,\n      startScaleMin: 0.14,\n      startScaleMax: 0.24,\n      endScaleMin: 0.9,\n      endScaleMax: 1.4,\n      peakOpacityMin: 0.72,\n      peakOpacityMax: 0.92,\n      swayFreqX: [0.44, 0.88] as [number, number],\n      swayFreqZ: [0.58, 1.12] as [number, number],\n      swayAmp: [0.06, 0.14] as [number, number],\n    },\n    palette: {\n      brand10: \'#beef74\',\n      brand20: \'#c7ff72\',\n      neonLime: \'#b8ff3c\',\n      introLime: \'#b4ff39\',\n      neutral5: \'#11121a\',\n      neutral10: \'#191b24\',\n      neutral20: \'#272935\',\n      statusRed: \'#f42f4c\',\n      statusYellow: \'#fec83e\',\n    },\n  },\n  introHexagonSvgPath:\n    \'M165.38 1.02246L1.03955 130.303L18.744 351.961L165.38 480.474L359.797 463.998L468.628 351.961L498.16 191.008L394.397 15.8505L165.38 1.02246Z\',\n};\n\nexport const LIGHTING_PRESETS: Record<LightingPresetKey, LightingPresetConfig> = {\n  day: {\n    key: \'day\',\n    label: \'Day (0.00)\',\n    revealColor: \'#5f7df7\',\n    revealIntensity: 12,\n    lightColor: \'#ffe6b1\',\n    lightIntensity: 1.6,\n    shadowColor: \'#454778\',\n    fogColorA: \'#00a2ff\',\n    fogColorB: \'#f1ff64\',\n    fogNearRatio: 0.315,\n    fogFarRatio: 1.25,\n    viewportFilterColor: \'#ffffff\',\n    viewportFilterOpacity: 0,\n  },\n  dusk: {\n    key: \'dusk\',\n    label: \'Dusk (0.35)\',\n    revealColor: \'#d7ff7c\',\n    revealIntensity: 2.5,\n    lightColor: \'#ffebc7\',\n    lightIntensity: 1.4,\n    shadowColor: \'#66009c\',\n    fogColorA: \'#ff6d6d\',\n    fogColorB: \'#fff229\',\n    fogNearRatio: 0,\n    fogFarRatio: 1.25,\n    viewportFilterColor: \'#ff8181\',\n    viewportFilterOpacity: 0.12,\n  },\n  night: {\n    key: \'night\',\n    label: \'Night (0.60)\',\n    revealColor: \'#c2c6ff\',\n    revealIntensity: 10,\n    lightColor: \'#6277b8\',\n    lightIntensity: 1.5,\n    shadowColor: \'#1e2238\',\n    fogColorA: \'#5560a2\',\n    fogColorB: \'#1d2030\',\n    fogNearRatio: -0.043,\n    fogFarRatio: 1.0,\n    viewportFilterColor: \'#3240ff\',\n    viewportFilterOpacity: 0.14,\n  },\n  dawn: {\n    key: \'dawn\',\n    label: \'Dawn (0.85)\',\n    revealColor: \'#ffffff\',\n    revealIntensity: 4.85,\n    lightColor: \'#ffe5c0\',\n    lightIntensity: 1.5,\n    shadowColor: \'#494949\',\n    fogColorA: \'#ffca58\',\n    fogColorB: \'#ffebb6\',\n    fogNearRatio: 0.3,\n    fogFarRatio: 1.25,\n    viewportFilterColor: \'#fff7ef\',\n    viewportFilterOpacity: 0.08,\n  },\n};\n\nexport function clamp(val: number, min: number, max: number): number {\n  return Math.max(min, Math.min(max, val));\n}\n\nexport function lerp(a: number, b: number, t: number): number {\n  return a + (b - a) * t;\n}\n\n/**\n * Exact 1:1 port of CQl67Veh.js initFollowTarget critically damped spring\n */\nexport function stepCriticalDampedSpring3D(\n  current: Vec3,\n  target: Vec3,\n  velocity: Vec3,\n  currentSpeed: number,\n  dt: number,\n): { position: Vec3; velocity: Vec3 } {\n  const clampedDt = clamp(dt, 0.0001, 0.05);\n  const baseSpeed = REA_CONSTANTS.physics.drive.speed;\n  const maxBoostSpeed = baseSpeed * REA_CONSTANTS.physics.drive.boostMultiplier;\n  const speedAlpha = clamp(\n    (currentSpeed - baseSpeed) / Math.max(0.001, maxBoostSpeed - baseSpeed),\n    0,\n    1,\n  );\n  const smoothTime = lerp(\n    REA_CONSTANTS.camera.followSpring.smoothTimeNormal,\n    REA_CONSTANTS.camera.followSpring.smoothTimeBoost,\n    speedAlpha,\n  );\n\n  const dx = current.x - target.x;\n  const dy = current.y - target.y;\n  const dz = current.z - target.z;\n  const distSq = dx * dx + dy * dy + dz * dz;\n\n  if (distSq > REA_CONSTANTS.camera.followSpring.snapDistanceSqThreshold || distSq < 1e-6) {\n    return {\n      position: { x: target.x, y: target.y, z: target.z },\n      velocity: { x: 0, y: 0, z: 0 },\n    };\n  }\n\n  const omega = 2 / Math.max(1e-4, smoothTime);\n  const exp = Math.exp(-omega * clampedDt);\n\n  const tempX = (velocity.x + dx * omega) * clampedDt;\n  const tempY = (velocity.y + dy * omega) * clampedDt;\n  const tempZ = (velocity.z + dz * omega) * clampedDt;\n\n  const nextVelX = (velocity.x - tempX * omega) * exp;\n  const nextVelY = (velocity.y - tempY * omega) * exp;\n  const nextVelZ = (velocity.z - tempZ * omega) * exp;\n\n  const nextPosX = target.x + (dx + tempX) * exp;\n  const nextPosY = target.y + (dy + tempY) * exp;\n  const nextPosZ = target.z + (dz + tempZ) * exp;\n\n  return {\n    position: { x: nextPosX, y: nextPosY, z: nextPosZ },\n    velocity: { x: nextVelX, y: nextVelY, z: nextVelZ },\n  };\n}\n\n/**\n * Exact 1:1 port of ur.handlePhysics drive speed & boost ramp from B1Nq4Kq6.js\n */\nexport function computeTankSpeedStep(\n  currentSpeed: number,\n  isBoosting: boolean,\n  dt: number,\n): number {\n  const base = REA_CONSTANTS.physics.drive.speed;\n  const maxBoost = base * REA_CONSTANTS.physics.drive.boostMultiplier;\n  const deltaSpeed = (maxBoost - base) * (isBoosting ? 1 : -10) * dt;\n  return clamp(currentSpeed + deltaSpeed, base, maxBoost);\n}\n\n/**\n * Computes shortest signed angle difference in radians (-PI..PI)\n */\nexport function shortestAngleDelta(fromRad: number, toRad: number): number {\n  let diff = ((toRad - fromRad + Math.PI) % (Math.PI * 2)) - Math.PI;\n  if (diff < -Math.PI) diff += Math.PI * 2;\n  return diff;\n}\n\n/**\n * Exact turret slerp damping factor from B1Nq4Kq6.js applyTurretAim:\n * n = turretDamping * 60; r = 1 - Math.exp(-n * dt)\n */\nexport function stepTurretYaw(currentYaw: number, targetYaw: number, dt: number): number {\n  const rate = REA_CONSTANTS.physics.drive.turretDamping * 60;\n  const alpha = 1 - Math.exp(-rate * clamp(dt, 0, 0.05));\n  return currentYaw + shortestAngleDelta(currentYaw, targetYaw) * alpha;\n}\n\n/**\n * Checks whether all 4 collectible types have been gathered to unlock Power Core\n */\nexport function isPowerCoreReady(collectedCount: number, requiredCount = 4): boolean {\n  return collectedCount >= requiredCount;\n}\n\n/**\n * BUDDY BLITZ: Crate Warfare (Team Buddies x Lyo Visual Direction) Constants\n */\nexport const LYO_ARENA_PALETTE = {\n  grassMain: \'#5ec932\',\n  grassBlade: \'#6cd938\',\n  dirtRoad: \'#d89c60\',\n  dirtBorder: \'#c28348\',\n  treeTrunk: \'#8c4a27\',\n  treeCanopy: \'#1d1f8c\',\n  skyBright: \'#9ad9ea\',\n  inkOutline: \'#12121e\',\n  redCrate: \'#ff3b30\',\n  superCrate: \'#00d2ff\',\n  megaCrate: \'#8e95a5\',\n  greenSwitch: \'#32ff6a\',\n  comicNeon: \'#b4ff39\',\n} as const;\n\nexport type CrateSlotType = \'empty\' | \'red\' | \'super\';\n\nexport type RecipeCategory =\n  | \'none\'\n  | \'lite_weapon\'\n  | \'grenade\'\n  | \'heavy_weapon\'\n  | \'buddy_t1\'\n  | \'buddy_t2\'\n  | \'vehicle\';\n\nexport interface PadEvaluationResult {\n  totalCrates: number;\n  redCount: number;\n  superCount: number;\n  isMerged: boolean;\n  isSuper: boolean;\n  shapeKey: \'Empty\' | \'1x1x1\' | \'2x1x1\' | \'1x1x2\' | \'2x2x1\' | \'2x1x2\' | \'2x2x2\' | \'Partial\';\n  category: RecipeCategory;\n  outputName: string;\n  spawnType: \'none\' | \'weapon\' | \'grenade\' | \'buddy\' | \'tank\';\n}\n\nexport type BuddyClassId =\n  | \'Infuntry\'\n  | \'Commando\'\n  | \'Medic\'\n  | \'Ninja\'\n  | \'Cyborg\'\n  | \'Stealthy\'\n  | \'SuperBuddie\';\n\nexport interface BuddyClassSpec {\n  id: BuddyClassId;\n  name: string;\n  tier: 1 | 2;\n  isSuperOnly: boolean;\n  maxHp: number;\n  speedMultiplier: number;\n  jumpMultiplier: number;\n  colorHex: string;\n  canSliceMergedCrates: boolean;\n  vehicleResistant: boolean;\n  canFly: boolean;\n  traitLabel: string;\n}\n\nexport const BUDDY_CLASSES: Record<BuddyClassId, BuddyClassSpec> = {\n  Infuntry: {\n    id: \'Infuntry\',\n    name: \'Infuntry\',\n    tier: 1,\n    isSuperOnly: false,\n    maxHp: 100,\n    speedMultiplier: 1.0,\n    jumpMultiplier: 1.0,\n    colorHex: \'#ff3b30\',\n    canSliceMergedCrates: false,\n    vehicleResistant: false,\n    canFly: false,\n    traitLabel: \'Crate Harvester\',\n  },\n  Commando: {\n    id: \'Commando\',\n    name: \'Commando\',\n    tier: 2,\n    isSuperOnly: false,\n    maxHp: 135,\n    speedMultiplier: 1.2,\n    jumpMultiplier: 1.05,\n    colorHex: \'#ff9500\',\n    canSliceMergedCrates: false,\n    vehicleResistant: false,\n    canFly: false,\n    traitLabel: \'Super-Strafe\',\n  },\n  Medic: {\n    id: \'Medic\',\n    name: \'Medic\',\n    tier: 1,\n    isSuperOnly: false,\n    maxHp: 110,\n    speedMultiplier: 1.05,\n    jumpMultiplier: 1.0,\n    colorHex: \'#ffffff\',\n    canSliceMergedCrates: false,\n    vehicleResistant: false,\n    canFly: false,\n    traitLabel: \'HP Regen Aura\',\n  },\n  Ninja: {\n    id: \'Ninja\',\n    name: \'Ninja\',\n    tier: 1,\n    isSuperOnly: false,\n    maxHp: 115,\n    speedMultiplier: 1.38,\n    jumpMultiplier: 1.45,\n    colorHex: \'#1c1c28\',\n    canSliceMergedCrates: true,\n    vehicleResistant: false,\n    canFly: false,\n    traitLabel: \'Katana Crate Slicer\',\n  },\n  Cyborg: {\n    id: \'Cyborg\',\n    name: \'Cyborg\',\n    tier: 2,\n    isSuperOnly: false,\n    maxHp: 180,\n    speedMultiplier: 0.95,\n    jumpMultiplier: 1.0,\n    colorHex: \'#7d889e\',\n    canSliceMergedCrates: false,\n    vehicleResistant: true,\n    canFly: false,\n    traitLabel: \'Anti-Tank Fist\',\n  },\n  Stealthy: {\n    id: \'Stealthy\',\n    name: \'Stealthy\',\n    tier: 1,\n    isSuperOnly: true,\n    maxHp: 125,\n    speedMultiplier: 1.3,\n    jumpMultiplier: 1.25,\n    colorHex: \'#4f46e5\',\n    canSliceMergedCrates: true,\n    vehicleResistant: false,\n    canFly: false,\n    traitLabel: \'Cloak + Disarm\',\n  },\n  SuperBuddie: {\n    id: \'SuperBuddie\',\n    name: \'Super Buddie\',\n    tier: 2,\n    isSuperOnly: true,\n    maxHp: 260,\n    speedMultiplier: 1.45,\n    jumpMultiplier: 1.8,\n    colorHex: \'#00d2ff\',\n    canSliceMergedCrates: false,\n    vehicleResistant: true,\n    canFly: true,\n    traitLabel: \'Flight + Laser Eyes\',\n  },\n};\n\nexport type TeamCommandMode = \'FOLLOW\' | \'HARVEST\' | \'ATTACK\' | \'DEFEND\' | \'MOUNT\';\n\n/**\n * Pure Team Buddies 2x2x2 Stacking Pad Recipe Evaluator.\n * Slots 0..3 represent bottom layer (2x2); slots 4..7 represent top layer (2x2).\n */\nexport function evaluateStackingPadRecipe(slots: ReadonlyArray<CrateSlotType>): PadEvaluationResult {\n  let redCount = 0;\n  let superCount = 0;\n  let bottomCount = 0;\n  let topCount = 0;\n\n  for (let i = 0; i < 8; i++) {\n    const s = slots[i] ?? \'empty\';\n    if (s === \'red\') redCount++;\n    if (s === \'super\') superCount++;\n    if (s !== \'empty\') {\n      if (i < 4) bottomCount++;\n      else topCount++;\n    }\n  }\n\n  const totalCrates = redCount + superCount;\n  const isMerged = totalCrates >= 2;\n  const isSuper = superCount >= 1;\n\n  if (totalCrates === 0) {\n    return {\n      totalCrates: 0,\n      redCount: 0,\n      superCount: 0,\n      isMerged: false,\n      isSuper: false,\n      shapeKey: \'Empty\',\n      category: \'none\',\n      outputName: \'Pad Kosong\',\n      spawnType: \'none\',\n    };\n  }\n\n  if (totalCrates === 8) {\n    return {\n      totalCrates,\n      redCount,\n      superCount,\n      isMerged,\n      isSuper,\n      shapeKey: \'2x2x2\',\n      category: \'vehicle\',\n      outputName: isSuper ? \'Tyrant Tank\' : \'Lyo Tank\',\n      spawnType: \'tank\',\n    };\n  }\n\n  if (totalCrates >= 4) {\n    const isVerticalWall = topCount >= 2;\n    if (isVerticalWall) {\n      return {\n        totalCrates,\n        redCount,\n        superCount,\n        isMerged,\n        isSuper,\n        shapeKey: \'2x1x2\',\n        category: \'buddy_t2\',\n        outputName: isSuper ? \'Super Buddie\' : \'Commando / Cyborg\',\n        spawnType: \'buddy\',\n      };\n    }\n    return {\n      totalCrates,\n      redCount,\n      superCount,\n      isMerged,\n      isSuper,\n      shapeKey: \'2x2x1\',\n      category: \'heavy_weapon\',\n      outputName: isSuper ? \'Supazooka\' : \'Bazooka\',\n      spawnType: \'weapon\',\n    };\n  }\n\n  if (totalCrates >= 2) {\n    const isVerticalColumn = topCount >= 1;\n    if (isVerticalColumn) {\n      return {\n        totalCrates,\n        redCount,\n        superCount,\n        isMerged,\n        isSuper,\n        shapeKey: \'1x1x2\',\n        category: \'buddy_t1\',\n        outputName: isSuper ? \'Stealthy / Ninja\' : \'Infuntry / Ninja\',\n        spawnType: \'buddy\',\n      };\n    }\n    return {\n      totalCrates,\n      redCount,\n      superCount,\n      isMerged,\n      isSuper,\n      shapeKey: \'2x1x1\',\n      category: \'grenade\',\n      outputName: isSuper ? \'Cluster Bomb\' : \'Hand Grenade\',\n      spawnType: \'grenade\',\n    };\n  }\n\n  return {\n    totalCrates: 1,\n    redCount,\n    superCount,\n    isMerged: false,\n    isSuper,\n    shapeKey: \'1x1x1\',\n    category: \'lite_weapon\',\n    outputName: isSuper ? \'Laser Rifle\' : \'Ice Gun / Uzi\',\n    spawnType: \'weapon\',\n  };\n}\n\nexport type BuildOrderTarget = \'AUTO\' | \'1x1x1\' | \'1x1x2\' | \'2x2x1\' | \'2x1x2\' | \'2x2x2\';\n\n/**\n * Selects the next physical 3D slot index (0..7) on a 2x2x2 Stacking Pad\n * based on the active Build Order target so vertical Buddy stacks (1x1x2, 2x1x2)\n * and flat Weapon stacks (2x2x1) snap into the right 3D coordinates.\n */\nexport function chooseNextPadSlotIndex(\n  slots: ReadonlyArray<CrateSlotType>,\n  buildOrder: BuildOrderTarget = \'AUTO\',\n): number {\n  let priorityOrder: number[];\n  if (buildOrder === \'2x2x1\') {\n    // Fill bottom 2x2 layer first for Heavy Weapons (Bazooka / Gatling)\n    priorityOrder = [0, 1, 2, 3, 4, 5, 6, 7];\n  } else if (buildOrder === \'1x1x2\') {\n    // Fill vertical column (slot 0 bottom, then slot 4 directly on top) for Buddy T1\n    priorityOrder = [0, 4, 1, 5, 2, 6, 3, 7];\n  } else if (buildOrder === \'2x1x2\') {\n    // Fill 2x1x2 wall (slots 0,1 bottom + 4,5 top) for Buddy T2\n    priorityOrder = [0, 1, 4, 5, 2, 3, 6, 7];\n  } else {\n    // AUTO & 2x2x2: progresses 1x1x1 (0) -> 1x1x2 Buddy (4) -> 2x1x2 Buddy T2 (1,5) -> 2x2x2 Tank (2,3,6,7)\n    priorityOrder = [0, 4, 1, 5, 2, 3, 6, 7];\n  }\n\n  for (const idx of priorityOrder) {\n    if ((slots[idx] ?? \'empty\') === \'empty\') {\n      return idx;\n    }\n  }\n  return -1;\n}\n\n\n"
    num_lines: 698
