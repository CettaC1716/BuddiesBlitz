            }
            lines {
              text: "          crateSpawnTimer = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          spawnWorldCrate("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            \'red\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            (Math.random() - 0.5) * 5.0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            (Math.random() - 0.5) * 5.0,"
