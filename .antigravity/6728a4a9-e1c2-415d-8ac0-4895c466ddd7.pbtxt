            lines {
              text: "-- Evaluasi & Snap Peti ke Stacking Pad 2x2x2 + Hologram Preview"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local function trySnapCrateToNearestPad(crate: BasePart)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal bases = Arena:FindFirstChild(\"Bases\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif not bases then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\treturn"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tfor _, baseModel in ipairs(bases:GetChildren()) do"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal padModel = baseModel:FindFirstChild(\"StackingPad_\" .. tostring(baseModel:GetAttribute(\"TeamName\"))) :: Model?"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tif padModel and padModel.PrimaryPart and padModel:GetAttribute(\"PadActive\") == true then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tlocal dist = (crate.Position - padModel.PrimaryPart.Position).Magnitude"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tif dist <= 14.0 then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\tif not padSlotStates[padModel] then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\tpadSlotStates[padModel] = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\t\tslots = { \"Empty\", \"Empty\", \"Empty\", \"Empty\", \"Empty\", \"Empty\", \"Empty\", \"Empty\" },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\t\tcrateParts = {},"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\t}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\tlocal state = padSlotStates[padModel]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\tfor slotIdx = 1, 8 do"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\tif state.slots[slotIdx] == \"Empty\" then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\t\tlocal cType = tostring(crate:GetAttribute(\"CrateType\") or \"Red\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\t\tstate.slots[slotIdx] = (cType == \"Super\") and \"Super\" or \"Red\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\t\tstate.crateParts[slotIdx] = crate"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\t\tcrate.Anchored = true"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\t\tcrate.CanCollide = true"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\t\tcrate.CFrame = CFrame.new(getPadSlotWorldPosition(padModel, slotIdx))"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\t\tcrate:SetAttribute(\"OnPad\", true)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\t\tlocal _, recipeInfo, isMerged, isSuper = CrateRecipes.EvaluatePad(state.slots)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\t\tfor _, part in pairs(state.crateParts) do"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
