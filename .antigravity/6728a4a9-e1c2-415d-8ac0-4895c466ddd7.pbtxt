              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const rect = renderer.domElement.getBoundingClientRect();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (rect.width <= 0 || rect.height <= 0) return;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      mouseNormalized.x = ((clientX - rect.left) / rect.width) * 2 - 1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      mouseNormalized.y = -((clientY - rect.top) / rect.height) * 2 + 1;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
