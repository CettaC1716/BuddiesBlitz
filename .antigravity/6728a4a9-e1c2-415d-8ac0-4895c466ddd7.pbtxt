            }
            lines {
              text: "    const raycaster = new THREE.Raycaster();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const groundPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -1.15);"
