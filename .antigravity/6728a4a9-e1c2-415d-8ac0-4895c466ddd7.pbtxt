            }
            lines {
              text: "    const keysHeld = new Set<string>();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const keysJustPressed = new Set<string>();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const mouseNormalized = new THREE.Vector2(0, 0);"
