            lines {
              text: "\t\t\tlocal baseModel = hitInstance:FindFirstAncestorOfClass(\"Model\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tif baseModel and baseModel:GetAttribute(\"TeamName\") == \"Blue\" then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\tresolvedMode = \"DEFEND\""
