 assert.ok(next > 0 && next < Math.PI / 2);\n});\n\ntest(\'isPowerCoreReady triggers when all 4 factory parts are collected\', () => {\n  assert.equal(isPowerCoreReady(3, 4), false);\n  assert.equal(isPowerCoreReady(4, 4), true);\n});\n"
