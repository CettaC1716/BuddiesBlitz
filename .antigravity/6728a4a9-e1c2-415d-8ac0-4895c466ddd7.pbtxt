  planner_response {
    thinking: "**Updating the Code**\n\nI\'m working on replacing a significant chunk of code within the FactoryPlaygroundCanvas.tsx file. Specifically, I\'m integrating a \"Clean Match Start\" implementation, which seems to initialize `bluePadSlots` with a list of empty strings. This is just the first step.\n\n\n**Refining the Blueprint**\n\nNow I\'m focusing on the Stacking Pad\'s visual and functional aspects. I\'m implementing translucent cyan wireframes (`ghostSlotMeshes`) for each of the 8 slots, along with a dynamic outer bounding box (`ghostPatternBox`). This box resizes and repositions based on the `BUILD_ORDER_SPECS`. Also, when crates are placed on the pad and the player presses `[Q]`, they\'ll get repacked, with excess crates ejected.\n\n\n**Implementing New Interactions**\n\nI\'ve been working on new player interactions now. My focus is on implementing scroll-wheel zoom for the camera, and it seems to be working smoothly, within a range of 0.75 to 1.65. I\'ve also implemented the buildHudSnapshot which populates radar dots with player, allied AI buddies, enemy red buddies, crates, and tanks. Now I\'m integrating new interactions with the [V] key using resolveCursorCommandTarget, including options to HARVEST, ATTACK, DEFEND, MOUNT and FOLLOW. I\'m also adding a salute animation for allied AI buddies.\n\n\n"
    tool_calls {
      id: "call_270615"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Implement Clean Match Start, [Q] Ghost Wireframe Outline & strict slot constraints, Camera Zoom-Out + Scroll Wheel Zoom, Mini-Radar dots, and [V] Cursor-Targeted AI Command with AI Salute in src/game/FactoryPlaygroundCanvas.tsx\", \"EndLine\":2258, \"Instruction\":\"Update pad ghost wireframes, clean match start, AI salute & cursor command, camera zoom-out, and radar dots in src/game/FactoryPlaygroundCanvas.tsx\", \"ReplacementContent\":\"      // Merged Crates Wireframe Cage (visible when >= 2 crates are merged on the pad)\\n      const mergedCage = new THREE.Mesh(\\n        new THREE.BoxGeometry(3.85, 2.95, 3.85),\\n        new THREE.MeshBasicMaterial({ color: 0xb4ff39, wireframe: true, transparent: true, opacity: 0.7 }),\\n      );\\n      mergedCage.position.set(0, 1.65, 0);\\n      mergedCage.visible = false;\\n      padGroup.add(mergedCage);\\n\\n      // Ghost Pattern Outer Wireframe Bounding Box (matches [Q] Build Order shape!)\\n      const ghostPatternBox = new THREE.Mesh(\\n        new THREE.BoxGeometry(1, 1, 1),\\n        new THREE.MeshBasicMaterial({\\n          color: 0x00d2ff,\\n          wireframe: true,\\n          transparent: true,\\n          opacity: 0.85,\\n        }),\\n      );\\n      ghostPatternBox.visible = team === \'blue\';\\n      padGroup.add(ghostPatternBox);\\n\\n      // 8 Physical 3D Crate Slot Meshes + 8 Ghost Wireframe Slot Boxes on the Pad\\n      const slotMeshes: THREE.Mesh[] = [];\\n      const ghostSlotMeshes: THREE.Mesh[] = [];\\n      const slotGeo = new THREE.BoxGeometry(1.38, 1.38, 1.38);\\n      const ghostSlotGeo = new THREE.BoxGeometry(1.32, 1.32, 1.32);\\n      const ghostSlotMat = new THREE.MeshBasicMaterial({\\n        color: 0xb8ff3c,\\n        wireframe: true,\\n        transparent: true,\\n        opacity: 0.55,\\n      });\\n\\n      for (let i = 0; i < 8; i++) {\\n        const layer = i < 4 ? 0 : 1;\\n        const [tx, tz] = tileOffsets[i % 4];\\n        const m = addOutlinedPart(\\n          padGroup,\\n          slotGeo,\\n          matRedCrate,\\n          [tx, 0.92 + layer * 1.42, tz],\\n          [0, 0, 0],\\n          1.07,\\n          true,\\n        );\\n        m.visible = false;\\n        slotMeshes.push(m);\\n\\n        const gm = new THREE.Mesh(ghostSlotGeo, ghostSlotMat);\\n        gm.position.set(tx, 0.92 + layer * 1.42, tz);\\n        gm.visible = false;\\n        padGroup.add(gm);\\n        ghostSlotMeshes.push(gm);\\n      }\\n\\n      const padSign = createBillboardSign(5.8, 1.42);\\n      padSign.sprite.position.set(0, 4.5, 0);\\n      padGroup.add(padSign.sprite);\\n\\n      return {\\n        baseGroup,\\n        hpSign,\\n        padGroup,\\n        padX,\\n        padZ,\\n        slotMeshes,\\n        ghostSlotMeshes,\\n        ghostPatternBox,\\n        mergedCage,\\n        padSign,\\n      };\\n    };\\n\\n    const blueBase = buildBaseHqAndPad(\'blue\', 0, 22, -6.2, 16.5);\\n    const redBase = buildBaseHqAndPad(\'red\', 0, -22, 6.2, -16.5);\\n\\n    // =========================================================================\\n    // 6. DESTRUCTIBLE LYO STYLIZED TREES (BROWN TRUNK #8c4a27 + BLUE-PURPLE CANOPY #1d1f8c)\\n    // =========================================================================\\n    const trees: DestructibleTree[] = [];\\n    const treeCoords: [number, number][] = [\\n      [-11, 10],\\n      [11, 10],\\n      [-11, -10],\\n      [11, -10],\\n      [-19, 12],\\n      [19, 12],\\n      [-19, -12],\\n      [19, -12],\\n    ];\\n    treeCoords.forEach(([tx, tz], idx) => {\\n      const grp = new THREE.Group();\\n      grp.position.set(tx, 0, tz);\\n      const shadow = new THREE.Mesh(shadowDiscGeo, shadowDiscMat);\\n      shadow.position.y = 0.02;\\n      shadow.scale.setScalar(1.35);\\n      grp.add(shadow);\\n\\n      addOutlinedPart(grp, new THREE.CylinderGeometry(0.42, 0.56, 2.3, 10), matTreeTrunk, [0, 1.15, 0]);\\n      addOutlinedPart(grp, new THREE.SphereGeometry(1.65, 14, 12), matTreeCanopy, [0, 3.05, 0]);\\n      scene.add(grp);\\n\\n      trees.push({\\n        id: idx + 1,\\n        mesh: grp,\\n        x: tx,\\n        z: tz,\\n        hp: 45,\\n        maxHp: 45,\\n        alive: true,\\n        hitFlashTimer: 0,\\n      });\\n    });\\n\\n    // =========================================================================\\n    // 7. BUILDER FOR CHIBI/BLOCKY TEAM BUDDIES CHARACTERS & OPEN-TOP LYO TANKS\\n    // =========================================================================\\n    let nextEntityId = 1;\\n\\n    const createBuddyCharacterUnit = (\\n      team: \'blue\' | \'red\',\\n      isPlayer: boolean,\\n      classId: BuddyClassId,\\n      spawnX: number,\\n      spawnZ: number,\\n    ): BuddyUnit => {\\n      const spec = BUDDY_CLASSES[classId];\\n      const root = new THREE.Group();\\n      root.position.set(spawnX, 0, spawnZ);\\n      scene.add(root);\\n\\n      const shadow = new THREE.Mesh(shadowDiscGeo, shadowDiscMat);\\n      shadow.position.y = 0.02;\\n      shadow.scale.setScalar(0.8);\\n      root.add(shadow);\\n\\n      const ringMat = new THREE.MeshBasicMaterial({\\n        color: isPlayer ? 0xb4ff39 : team === \'blue\' ? 0x2979ff : 0xff3b30,\\n      });\\n      const teamRing = new THREE.Mesh(new THREE.RingGeometry(0.68, 0.92, 24), ringMat);\\n      teamRing.rotation.x = -Math.PI / 2;\\n      teamRing.position.y = 0.04;\\n      root.add(teamRing);\\n\\n      const bodyGroup = new THREE.Group();\\n      root.add(bodyGroup);\\n\\n      const torsoMat = makeToonMat(team === \'blue\' ? spec.colorHex : \'#ff3b30\');\\n      const teamTrimMat = team === \'blue\' ? matBlueTeam : matRedTeam;\\n\\n      // Blocky Chibi Torso\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(0.86, 0.88, 0.54), torsoMat, [0, 1.02, 0]);\\n      // Backpack / Class Pack\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(0.56, 0.56, 0.28), teamTrimMat, [0, 1.05, -0.36]);\\n\\n      // Chibi Head (1.2x scale) + Bandana/Helmet\\n      const headMesh = addOutlinedPart(bodyGroup, new THREE.BoxGeometry(0.76, 0.72, 0.74), matSkin, [0, 1.84, 0]);\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(0.82, 0.24, 0.8), teamTrimMat, [0, 2.12, 0]);\\n\\n      // Left & Right Animated Arms\\n      const leftArmPivot = new THREE.Group();\\n      leftArmPivot.position.set(-0.62, 1.36, 0);\\n      bodyGroup.add(leftArmPivot);\\n      addOutlinedPart(leftArmPivot, new THREE.BoxGeometry(0.32, 0.72, 0.32), matSkin, [0, -0.28, 0]);\\n\\n      const rightArmPivot = new THREE.Group();\\n      rightArmPivot.position.set(0.62, 1.36, 0);\\n      bodyGroup.add(rightArmPivot);\\n      addOutlinedPart(rightArmPivot, new THREE.BoxGeometry(0.32, 0.72, 0.32), matSkin, [0, -0.28, 0]);\\n\\n      // 3D Weapon Mesh in Right Hand\\n      const weaponMesh = addOutlinedPart(\\n        rightArmPivot,\\n        new THREE.BoxGeometry(0.24, 0.28, 0.95),\\n        matGunmetal,\\n        [0, -0.52, 0.42],\\n      );\\n\\n      // Left & Right Animated Legs\\n      const leftLegPivot = new THREE.Group();\\n      leftLegPivot.position.set(-0.24, 0.58, 0);\\n      bodyGroup.add(leftLegPivot);\\n      addOutlinedPart(leftLegPivot, new THREE.BoxGeometry(0.34, 0.58, 0.36), matDarkSteel, [0, -0.28, 0]);\\n\\n      const rightLegPivot = new THREE.Group();\\n      rightLegPivot.position.set(0.24, 0.58, 0);\\n      bodyGroup.add(rightLegPivot);\\n      addOutlinedPart(rightLegPivot, new THREE.BoxGeometry(0.34, 0.58, 0.36), matDarkSteel, [0, -0.28, 0]);\\n\\n      // Overhead Carried 3D Crate (visible when carrying a crate above the head!)\\n      const overheadCrateGroup = new THREE.Group();\\n      overheadCrateGroup.position.set(0, 2.82, 0);\\n      overheadCrateGroup.visible = false;\\n      bodyGroup.add(overheadCrateGroup);\\n      const overheadCrateBox = addOutlinedPart(\\n        overheadCrateGroup,\\n        new THREE.BoxGeometry(1.18, 1.18, 1.18),\\n        matRedCrate,\\n        [0, 0, 0],\\n      );\\n\\n      // Overhead AI Salute Sign (pops up above AI Buddy head when [V] command is issued!)\\n      const saluteSign = createBillboardSign(3.4, 0.92);\\n      saluteSign.sprite.position.set(0, 3.1, 0);\\n      saluteSign.sprite.visible = false;\\n      root.add(saluteSign.sprite);\\n\\n      return {\\n        id: nextEntityId++,\\n        team,\\n        isPlayer,\\n        classId,\\n        root,\\n        bodyGroup,\\n        headMesh,\\n        leftArmPivot,\\n        rightArmPivot,\\n        leftLegPivot,\\n        rightLegPivot,\\n        weaponMesh,\\n        overheadCrateGroup,\\n        overheadCrateBox,\\n        saluteSign,\\n        teamRing,\\n        x: spawnX,\\n        y: 0,\\n        z: spawnZ,\\n        vx: 0,\\n        vz: 0,\\n        yaw: team === \'blue\' ? Math.PI : 0,\\n        hp: 30,\\n        maxHp: 30,\\n        weaponName: classId === \'Ninja\' ? \'Katana\' : classId === \'SuperBuddie\' ? \'Laser Eyes\' : \'Uzi\',\\n        ammo: 120,\\n        carryingCrate: \'none\',\\n        walkCycle: 0,\\n        shootCooldown: 0,\\n        hitFlashTimer: 0,\\n        isFrozen: false,\\n        frozenTimer: 0,\\n        saluteTimer: 0,\\n        aiTargetCrateId: null,\\n        alive: true,\\n        respawnTimer: 0,\\n      };\\n    };\\n\\n    const createLyoTankVehicle = (spawnX: number, spawnZ: number, isSuper: boolean, team: \'blue\' | \'red\'): TankVehicle => {\\n      const root = new THREE.Group();\\n      root.position.set(spawnX, 0, spawnZ);\\n      scene.add(root);\\n\\n      const shadow = new THREE.Mesh(shadowDiscGeo, shadowDiscMat);\\n      shadow.position.y = 0.02;\\n      shadow.scale.set(1.5, 1.3, 1);\\n      root.add(shadow);\\n\\n      const bodyGroup = new THREE.Group();\\n      root.add(bodyGroup);\\n\\n      const primaryMat = isSuper ? matTankSuper : matTankLime;\\n      const highlightMat = isSuper ? matBlueTeam : matTankHighlight;\\n\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(2.35, 0.72, 1.65), primaryMat, [0, 0.58, 0]);\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(1.85, 0.34, 1.38), highlightMat, [0.1, 0.98, 0]);\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(2.65, 0.56, 0.38), matDarkSteel, [0, 0.36, -0.92]);\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(2.65, 0.56, 0.38), matDarkSteel, [0, 0.36, 0.92]);\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(2.75, 0.14, 0.46), primaryMat, [0, 0.68, -0.92]);\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(2.75, 0.14, 0.46), primaryMat, [0, 0.68, 0.92]);\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(0.28, 0.44, 1.15), matYellow, [-1.18, 0.64, 0]);\\n\\n      const turretGroup = new THREE.Group();\\n      turretGroup.position.set(-0.05, 1.15, 0);\\n      bodyGroup.add(turretGroup);\\n\\n      addOutlinedPart(turretGroup, new THREE.BoxGeometry(1.36, 0.58, 1.28), primaryMat, [0, 0.25, 0]);\\n      // Open-Top Hatch Rim\\n      addOutlinedPart(turretGroup, new THREE.CylinderGeometry(0.4, 0.44, 0.18, 12), matDarkSteel, [-0.12, 0.58, 0]);\\n\\n      // Open-Top Rider Mesh (Visible ONLY when a Buddy is mounted inside the Tank!)\\n      const riderGroup = new THREE.Group();\\n      riderGroup.visible = false;\\n      turretGroup.add(riderGroup);\\n      addOutlinedPart(riderGroup, new THREE.BoxGeometry(0.48, 0.38, 0.44), matBlueTeam, [-0.12, 0.8, 0]);\\n      addOutlinedPart(riderGroup, new THREE.BoxGeometry(0.56, 0.54, 0.54), matSkin, [-0.12, 1.18, 0]);\\n      addOutlinedPart(riderGroup, new THREE.BoxGeometry(0.62, 0.2, 0.6), matYellow, [-0.12, 1.42, 0]);\\n\\n      const barrelGroup = new THREE.Group();\\n      barrelGroup.position.set(0.65, 0.26, 0);\\n      turretGroup.add(barrelGroup);\\n\\n      if (isSuper) {\\n        // Super Tyrant Tank has Dual Cannons!\\n        addOutlinedPart(barrelGroup, new THREE.CylinderGeometry(0.12, 0.14, 1.5, 10), matGunmetal, [0.65, 0, -0.26], [0, 0, -Math.PI / 2]);\\n        addOutlinedPart(barrelGroup, new THREE.CylinderGeometry(0.12, 0.14, 1.5, 10), matGunmetal, [0.65, 0, 0.26], [0, 0, -Math.PI / 2]);\\n        addOutlinedPart(barrelGroup, new THREE.CylinderGeometry(0.19, 0.19, 0.28, 10), matYellow, [1.38, 0, -0.26], [0, 0, -Math.PI / 2]);\\n        addOutlinedPart(barrelGroup, new THREE.CylinderGeometry(0.19, 0.19, 0.28, 10), matYellow, [1.38, 0, 0.26], [0, 0, -Math.PI / 2]);\\n      } else {\\n        addOutlinedPart(barrelGroup, new THREE.CylinderGeometry(0.14, 0.16, 1.45, 12), matGunmetal, [0.65, 0, 0], [0, 0, -Math.PI / 2]);\\n        addOutlinedPart(barrelGroup, new THREE.CylinderGeometry(0.22, 0.22, 0.28, 12), matYellow, [1.38, 0, 0], [0, 0, -Math.PI / 2]);\\n      }\\n\\n      const muzzleFlash = new THREE.Mesh(\\n        new THREE.SphereGeometry(0.42, 10, 10),\\n        new THREE.MeshBasicMaterial({ color: 0xb8ff3c }),\\n      );\\n      muzzleFlash.position.set(1.62, 0, 0);\\n      muzzleFlash.visible = false;\\n      barrelGroup.add(muzzleFlash);\\n\\n      return {\\n        id: nextEntityId++,\\n        isSuper,\\n        team,\\n        root,\\n        bodyGroup,\\n        turretGroup,\\n        barrelGroup,\\n        riderGroup,\\n        muzzleFlash,\\n        x: spawnX,\\n        z: spawnZ,\\n        vx: 0,\\n        vz: 0,\\n        hullYaw: -Math.PI / 2,\\n        turretYaw: -Math.PI / 2,\\n        currentDriveSpeed: REA_CONSTANTS.physics.drive.speed,\\n        recoilTimer: 0,\\n        hp: isSuper ? 60 : 40,\\n        maxHp: isSuper ? 60 : 40,\\n        storedCrates: [],\\n        occupiedByPlayer: false,\\n        occupiedByAiId: null,\\n      };\\n    };\\n\\n    // =========================================================================\\n    // 8. WORLD STATE: CRATES, PICKUPS, BUDDIES, TANKS, BASE HP & STACKING PADS\\n    // =========================================================================\\n    const worldCrates: WorldCrate[] = [];\\n    const worldPickups: WorldPickup[] = [];\\n    const buddyUnits: BuddyUnit[] = [];\\n    const tanks: TankVehicle[] = [];\\n\\n    // 1. Clean Match Start: Both Stacking Pads start completely empty (0/8 crates)\\n    let bluePadSlots: CrateSlotType[] = [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'];\\n    let redPadSlots: CrateSlotType[] = [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'];\\n    let buildOrder: BuildOrderTarget = \'1x1x2\';\\n    let teamCommand: TeamCommandMode = \'HARVEST\';\\n    let blueBaseHp = 2000;\\n    let redBaseHp = 2000;\\n    let score = 0;\\n    let bestScore = 0;\\n    let enemiesDefeated = 0;\\n    let blueBuddyClassIdx = 0;\\n    let mountedTank: TankVehicle | null = null;\\n    let crateSpawnTimer = 0;\\n    let superCrateSpawnTimer = 0;\\n    let redCraftTimer = 0;\\n\\n    const syncPadVisuals = (\\n      baseObj: ReturnType<typeof buildBaseHqAndPad>,\\n      slots: CrateSlotType[],\\n      teamLabel: string,\\n      hp: number,\\n    ) => {\\n      const ev = evaluateStackingPadRecipe(slots);\\n      const isBlue = teamLabel === \'BLUE\';\\n      const orderSpec = BUILD_ORDER_SPECS[isBlue ? buildOrder : \'1x1x2\'];\\n\\n      // Update Ghost Pattern Bounding Wireframe on Blue Pad to match [Q] pattern\\n      if (isBlue) {\\n        baseObj.ghostPatternBox.visible = true;\\n        baseObj.ghostPatternBox.scale.set(\\n          orderSpec.ghostBoxSize[0],\\n          orderSpec.ghostBoxSize[1],\\n          orderSpec.ghostBoxSize[2],\\n        );\\n        baseObj.ghostPatternBox.position.set(\\n          orderSpec.ghostBoxCenter[0],\\n          orderSpec.ghostBoxCenter[1],\\n          orderSpec.ghostBoxCenter[2],\\n        );\\n      } else {\\n        baseObj.ghostPatternBox.visible = false;\\n      }\\n\\n      for (let i = 0; i < 8; i++) {\\n        const s = slots[i];\\n        const mesh = baseObj.slotMeshes[i];\\n        const ghostMesh = baseObj.ghostSlotMeshes[i];\\n        const isAllowedInPattern = isBlue && orderSpec.allowedSlots.includes(i);\\n\\n        if (s === \'empty\') {\\n          mesh.visible = false;\\n          ghostMesh.visible = isAllowedInPattern;\\n        } else {\\n          mesh.visible = true;\\n          mesh.material = s === \'super\' ? matSuperCrate : matRedCrate;\\n          ghostMesh.visible = false;\\n        }\\n      }\\n\\n      baseObj.mergedCage.visible = ev.isMerged;\\n      const targetMax = isBlue ? orderSpec.targetCrates : 8;\\n      baseObj.padSign.updateText(\\n        ev.totalCrates === 0\\n          ? isBlue\\n            ? `POLA [Q] ${buildOrder}: ${orderSpec.label.toUpperCase()}`\\n            : \'STACKING PAD 2x2x2\'\\n          : `${ev.shapeKey}: ${ev.outputName.toUpperCase()}`,\\n        ev.totalCrates === 0\\n          ? `0/${targetMax} PETI \302\267 LEMPAR [E]`\\n          : `[F] RAKIT (${ev.totalCrates}/${targetMax} PETI${ev.isMerged ? \' \302\267 MERGED\' : \'\'})`,\\n        ev.isSuper ? \'#00d2ff\' : \'#b4ff39\',\\n        clamp(ev.totalCrates / Math.max(1, targetMax), 0, 1),\\n      );\\n      baseObj.hpSign.updateText(\\n        `${teamLabel} HQ`,\\n        `${hp} / 2000 HP`,\\n        isBlue ? \'#00d2ff\' : \'#ff3b30\',\\n        hp / 2000,\\n      );\\n    };\\n\\n    const spawnWorldCrate = (kind: \'red\' | \'super\', x: number, z: number, startGrounded = false) => {\\n      if (worldCrates.length >= 22) return;\\n      const g = new THREE.Group();\\n      const startY = startGrounded ? 0.65 : 16 + Math.random() * 4;\\n      g.position.set(x, startY, z);\\n      scene.add(g);\\n\\n      addOutlinedPart(\\n        g,\\n        new THREE.BoxGeometry(1.25, 1.25, 1.25),\\n        kind === \'super\' ? matSuperCrate : matRedCrate,\\n        [0, 0, 0],\\n      );\\n      // White Parachute dome while falling\\n      const chuteGeo = new THREE.SphereGeometry(1.15, 12, 8, 0, Math.PI * 2, 0, Math.PI / 2);\\n      const parachuteMesh = new THREE.Mesh(chuteGeo, matWhite);\\n      parachuteMesh.position.set(0, 1.6, 0);\\n      parachuteMesh.visible = !startGrounded;\\n      g.add(parachuteMesh);\\n\\n      worldCrates.push({\\n        id: nextEntityId++,\\n        kind,\\n        mesh: g,\\n        parachuteMesh,\\n        x,\\n        y: startY,\\n        z,\\n        vx: 0,\\n        vy: 0,\\n        vz: 0,\\n        state: startGrounded ? \'grounded\' : \'falling\',\\n        carrierId: null,\\n        squashTimer: startGrounded ? 0.25 : 0,\\n      });\\n    };\\n\\n    const spawnWorldPickup = (\\n      kind: WorldPickup[\'kind\'],\\n      weaponName: string,\\n      x: number,\\n      z: number,\\n    ) => {\\n      const g = new THREE.Group();\\n      g.position.set(x, 0.75, z);\\n      scene.add(g);\\n\\n      if (kind === \'health\') {\\n        addOutlinedPart(g, new THREE.OctahedronGeometry(0.55, 0), matRedCrate, [0, 0, 0]);\\n      } else if (kind === \'ammo\') {\\n        addOutlinedPart(g, new THREE.BoxGeometry(0.75, 0.55, 0.55), matYellow, [0, 0, 0]);\\n      } else if (kind === \'powerup\') {\\n        addOutlinedPart(g, new THREE.IcosahedronGeometry(0.62, 0), matTankHighlight, [0, 0, 0]);\\n      } else {\\n        // 3D Crafted Weapon Pickup on a glowing pedestal\\n        addOutlinedPart(g, new THREE.CylinderGeometry(0.7, 0.8, 0.16, 12), matYellow, [0, -0.55, 0]);\\n        addOutlinedPart(g, new THREE.BoxGeometry(0.36, 0.38, 1.25), matSuperCrate, [0, 0.1, 0]);\\n      }\\n\\n      worldPickups.push({\\n        id: nextEntityId++,\\n        kind,\\n        weaponName,\\n        mesh: g,\\n        x,\\n        z,\\n        bobPhase: Math.random() * Math.PI * 2,\\n        collected: false,\\n      });\\n    };\\n\\n    // Player Buddy + Initial Allied & Enemy AI Buddies (Clean Match Start: 0/8 Pad, No Free Tank!)\\n    let playerUnit = createBuddyCharacterUnit(\'blue\', true, \'Infuntry\', 0, 12.5);\\n    buddyUnits.push(playerUnit);\\n\\n    const spawnInitialSquadsAndObjects = () => {\\n      // Clear any old dynamic meshes\\n      worldCrates.forEach((c) => scene.remove(c.mesh));\\n      worldCrates.length = 0;\\n      worldPickups.forEach((p) => scene.remove(p.mesh));\\n      worldPickups.length = 0;\\n      buddyUnits.forEach((b) => scene.remove(b.root));\\n      buddyUnits.length = 0;\\n      tanks.forEach((t) => scene.remove(t.root));\\n      tanks.length = 0;\\n\\n      // 1. Clean Match Start: Stacking Pads start at 0/8 crates and NO free Tank is pre-spawned!\\n      bluePadSlots = [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'];\\n      redPadSlots = [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'];\\n      blueBaseHp = 2000;\\n      redBaseHp = 2000;\\n      score = 0;\\n      enemiesDefeated = 0;\\n      mountedTank = null;\\n\\n      // 2. Main Player Character (Blocky Chibi Buddy)\\n      playerUnit = createBuddyCharacterUnit(\'blue\', true, \'Infuntry\', 0, 12.5);\\n      buddyUnits.push(playerUnit);\\n\\n      // 3. One Allied Blue AI Buddy (Harvester/Fighter)\\n      buddyUnits.push(createBuddyCharacterUnit(\'blue\', false, \'Ninja\', -3.8, 14.2));\\n\\n      // 4. Three Red Team AI Buddies (Harvesting crates & attacking Blue Team)\\n      buddyUnits.push(createBuddyCharacterUnit(\'red\', false, \'Infuntry\', -3.5, -13.5));\\n      buddyUnits.push(createBuddyCharacterUnit(\'red\', false, \'Commando\', 3.5, -13.5));\\n      buddyUnits.push(createBuddyCharacterUnit(\'red\', false, \'Cyborg\', 0, -15.5));\\n\\n      // 5. Initial Red Crates & Blue Super Crates in the Drop Zones & along the road\\n      spawnWorldCrate(\'red\', -1.6, 9.8, true);\\n      spawnWorldCrate(\'super\', 1.8, 9.2, true);\\n      spawnWorldCrate(\'red\', -2.5, 2.5, true);\\n      spawnWorldCrate(\'red\', 2.5, 2.5, true);\\n      spawnWorldCrate(\'red\', -2.2, -2.5, true);\\n      spawnWorldCrate(\'red\', 2.2, -2.5, true);\\n      spawnWorldCrate(\'red\', 0, 0, false);\\n      spawnWorldCrate(\'super\', -15.5, 0, false);\\n      spawnWorldCrate(\'super\', 15.5, 0, false);\\n\\n      trees.forEach((t) => {\\n        t.alive = true;\\n        t.hp = t.maxHp;\\n        t.mesh.visible = true;\\n      });\\n\\n      syncPadVisuals(blueBase, bluePadSlots, \'BLUE\', blueBaseHp);\\n      syncPadVisuals(redBase, redPadSlots, \'RED\', redBaseHp);\\n    };\\n\\n    spawnInitialSquadsAndObjects();\\n\\n    // =========================================================================\\n    // 9. PROJECTILE & EXPLOSION PARTICLE POOLS\\n    // =========================================================================\\n    const projectiles: Projectile[] = [];\\n    const projGeo = new THREE.SphereGeometry(0.24, 8, 8);\\n    const playerProjMat = new THREE.MeshBasicMaterial({ color: 0xb8ff3c });\\n    const iceProjMat = new THREE.MeshBasicMaterial({ color: 0x00d2ff });\\n    const enemyProjMat = new THREE.MeshBasicMaterial({ color: 0xff3b30 });\\n\\n    for (let i = 0; i < 40; i++) {\\n      const m = new THREE.Mesh(projGeo, playerProjMat);\\n      m.visible = false;\\n      scene.add(m);\\n      projectiles.push({\\n        active: false,\\n        isPlayerTeam: true,\\n        weaponType: \'Uzi\',\\n        mesh: m,\\n        pos: new THREE.Vector3(),\\n        vel: new THREE.Vector3(),\\n        life: 0,\\n        damage: 8,\\n      });\\n    }\\n\\n    const fireProjectile = (\\n      isPlayerTeam: boolean,\\n      weaponType: string,\\n      origin: THREE.Vector3,\\n      dir: THREE.Vector3,\\n      speed: number,\\n      damage: number,\\n    ) => {\\n      const slot = projectiles.find((p) => !p.active);\\n      if (!slot) return;\\n      slot.active = true;\\n      slot.isPlayerTeam = isPlayerTeam;\\n      slot.weaponType = weaponType;\\n      slot.pos.copy(origin);\\n      slot.vel.copy(dir).normalize().multiplyScalar(speed);\\n      slot.life = 1.25;\\n      slot.damage = damage;\\n      slot.mesh.material = !isPlayerTeam\\n        ? enemyProjMat\\n        : weaponType === \'Ice Gun\'\\n        ? iceProjMat\\n        : playerProjMat;\\n      slot.mesh.scale.setScalar(weaponType === \'TankCannon\' || weaponType === \'Bazooka\' || weaponType === \'Supazooka\' ? 1.75 : 1.0);\\n      slot.mesh.position.copy(origin);\\n      slot.mesh.visible = true;\\n    };\\n\\n    const explosionParticles: ExplosionParticle[] = [];\\n    const expGeo = new THREE.SphereGeometry(0.32, 8, 8);\\n    for (let i = 0; i < 48; i++) {\\n      const mat = new THREE.MeshBasicMaterial({\\n        color: i % 2 === 0 ? 0xfec83e : 0xb4ff39,\\n        transparent: true,\\n        opacity: 1,\\n      });\\n      const m = new THREE.Mesh(expGeo, mat);\\n      m.visible = false;\\n      scene.add(m);\\n      explosionParticles.push({\\n        active: false,\\n        mesh: m,\\n        vel: new THREE.Vector3(),\\n        life: 0,\\n        maxLife: 0.45,\\n      });\\n    }\\n\\n    const spawnBurstParticles = (x: number, y: number, z: number, count = 12) => {\\n      let spawned = 0;\\n      for (const ep of explosionParticles) {\\n        if (!ep.active && spawned < count) {\\n          ep.active = true;\\n          ep.life = 0;\\n          ep.maxLife = 0.35 + Math.random() * 0.25;\\n          ep.mesh.position.set(x, y, z);\\n          ep.mesh.scale.setScalar(0.7 + Math.random() * 0.8);\\n          ep.mesh.visible = true;\\n          const angle = Math.random() * Math.PI * 2;\\n          const spd = 3 + Math.random() * 7;\\n          ep.vel.set(Math.cos(angle) * spd, 4 + Math.random() * 6, Math.sin(angle) * spd);\\n          spawned++;\\n        }\\n      }\\n    };\\n\\n    // =========================================================================\\n    // 10. INTERACTION HANDLERS:\\n    //     [E] PICKUP / THROW CRATE TO 2x2x2 PAD (STRICTLY WITHIN [Q] GHOST SLOTS)\\n    //     [F] KICK OPEN CRATE OR CRAFT STACKING PAD (WEAPON / AI BUDDY / LYO TANK)\\n    //     [G] MOUNT / DISMOUNT OPEN-TOP LYO TANK\\n    //     [Q] CYCLE BUILD ORDER GHOST WIREFRAME \302\267 [V] CURSOR AI COMMAND + SALUTE\\n    // =========================================================================\\n    const addCrateToPadSlots = (team: \'blue\' | \'red\', kind: \'red\' | \'super\'): boolean => {\\n      const slots = team === \'blue\' ? bluePadSlots : redPadSlots;\\n      const activePattern: BuildOrderTarget = team === \'blue\' ? buildOrder : \'1x1x2\';\\n      const nextIdx = chooseNextPadSlotIndex(slots, activePattern);\\n      if (nextIdx === -1) return false;\\n      slots[nextIdx] = kind;\\n      if (team === \'blue\') {\\n        syncPadVisuals(blueBase, bluePadSlots, \'BLUE\', blueBaseHp);\\n      } else {\\n        syncPadVisuals(redBase, redPadSlots, \'RED\', redBaseHp);\\n      }\\n      return true;\\n    };\\n\\n    const handlePlayerPickupOrThrowCrate = () => {\\n      if (mountedTank) {\\n        if (mountedTank.storedCrates.length > 0) {\\n          const distToPad = Math.hypot(mountedTank.x - blueBase.padX, mountedTank.z - blueBase.padZ);\\n          if (distToPad <= 9.0) {\\n            while (mountedTank.storedCrates.length > 0) {\\n              const cKind = mountedTank.storedCrates[0];\\n              if (!addCrateToPadSlots(\'blue\', cKind)) break;\\n              mountedTank.storedCrates.shift();\\n            }\\n            soundEngine.playPickup();\\n            return;\\n          }\\n        }\\n        return;\\n      }\\n\\n      if (!playerUnit.alive) return;\\n\\n      // Case A: Already carrying a crate above head -> Throw it toward Stacking Pad or forward!\\n      if (playerUnit.carryingCrate !== \'none\') {\\n        const carriedKind = playerUnit.carryingCrate;\\n        playerUnit.carryingCrate = \'none\';\\n        playerUnit.overheadCrateGroup.visible = false;\\n        soundEngine.playShoot();\\n\\n        const distToBluePad = Math.hypot(playerUnit.x - blueBase.padX, playerUnit.z - blueBase.padZ);\\n        if (distToBluePad <= 10.5) {\\n          if (addCrateToPadSlots(\'blue\', carriedKind)) {\\n            score += carriedKind === \'super\' ? 60 : 30;\\n            spawnBurstParticles(blueBase.padX, 1.8, blueBase.padZ, 10);\\n            soundEngine.playPickup();\\n            return;\\n          }\\n        }\\n\\n        // Otherwise throw crate forward onto the ground\\n        const throwX = clamp(playerUnit.x + Math.cos(playerUnit.yaw) * 3.8, -36, 36);\\n        const throwZ = clamp(playerUnit.z - Math.sin(playerUnit.yaw) * 3.8, -36, 36);\\n        const dPadFromLand = Math.hypot(throwX - blueBase.padX, throwZ - blueBase.padZ);\\n        if (dPadFromLand <= 6.5 && addCrateToPadSlots(\'blue\', carriedKind)) {\\n          score += carriedKind === \'super\' ? 60 : 30;\\n          spawnBurstParticles(blueBase.padX, 1.8, blueBase.padZ, 10);\\n          soundEngine.playPickup();\\n          return;\\n        }\\n        spawnWorldCrate(carriedKind, throwX, throwZ, true);\\n        return;\\n      }\\n\\n      // Case B: Not carrying -> Find nearest grounded crate within 5.5m and lift it overhead!\\n      let nearestCrate: WorldCrate | null = null;\\n      let bestDist = 5.5;\\n      for (const c of worldCrates) {\\n        if (c.state === \'grounded\' || c.state === \'falling\') {\\n          const d = Math.hypot(c.x - playerUnit.x, c.z - playerUnit.z);\\n          if (d < bestDist) {\\n            bestDist = d;\\n            nearestCrate = c;\\n          }\\n        }\\n      }\\n\\n      if (nearestCrate) {\\n        playerUnit.carryingCrate = nearestCrate.kind;\\n        playerUnit.overheadCrateBox.material =\\n          nearestCrate.kind === \'super\' ? matSuperCrate : matRedCrate;\\n        playerUnit.overheadCrateGroup.visible = true;\\n        scene.remove(nearestCrate.mesh);\\n        const idx = worldCrates.indexOf(nearestCrate);\\n        if (idx !== -1) worldCrates.splice(idx, 1);\\n        soundEngine.playPickup();\\n      }\\n    };\\n\\n    const craftFromBluePad = () => {\\n      const padEval = evaluateStackingPadRecipe(bluePadSlots);\\n      if (padEval.totalCrates === 0) return false;\\n\\n      soundEngine.playPowerCore();\\n      spawnBurstParticles(blueBase.padX, 2.0, blueBase.padZ, 18);\\n\\n      const spawnX = blueBase.padX + 4.2;\\n      const spawnZ = blueBase.padZ - 1.2;\\n\\n      if (padEval.spawnType === \'tank\') {\\n        // 8 Crates (2x2x2) -> Spawn 3D Lyo Tank or Super Tyrant Tank!\\n        const newTank = createLyoTankVehicle(spawnX, spawnZ, padEval.isSuper, \'blue\');\\n        tanks.push(newTank);\\n        score += padEval.isSuper ? 500 : 350;\\n      } else if (padEval.spawnType === \'buddy\') {\\n        // 2 Vertical (1x1x2) or 4 Vertical (2x1x2) -> Spawn 3D Allied AI Buddy!\\n        let chosenClass: BuddyClassId = BLUE_BUDDY_ROTATION[blueBuddyClassIdx % BLUE_BUDDY_ROTATION.length];\\n        blueBuddyClassIdx++;\\n        if (padEval.category === \'buddy_t2\') {\\n          chosenClass = padEval.isSuper ? \'SuperBuddie\' : \'Cyborg\';\\n        } else if (padEval.isSuper) {\\n          chosenClass = \'Stealthy\';\\n        }\\n        const newBuddy = createBuddyCharacterUnit(\\n          \'blue\',\\n          false,\\n          chosenClass,\\n          spawnX + (Math.random() - 0.5) * 2,\\n          spawnZ + (Math.random() - 0.5) * 2,\\n        );\\n        buddyUnits.push(newBuddy);\\n        score += 220;\\n      } else {\\n        // 1x1x1, 2x1x1, or 2x2x1 -> Spawn 3D Weapon Pickup & also auto-equip player!\\n        const wName = padEval.outputName;\\n        spawnWorldPickup(\'weapon\', wName, spawnX, spawnZ);\\n        playerUnit.weaponName = wName;\\n        playerUnit.ammo = 200;\\n        score += 140;\\n      }\\n\\n      bluePadSlots = [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'];\\n      syncPadVisuals(blueBase, bluePadSlots, \'BLUE\', blueBaseHp);\\n      return true;\\n    };\\n\\n    const handlePlayerKickOrCraft = () => {\\n      const actorX = mountedTank ? mountedTank.x : playerUnit.x;\\n      const actorZ = mountedTank ? mountedTank.z : playerUnit.z;\\n\\n      // 1. Check if near Blue Team Stacking Pad (within 9.5m) and pad has crates\\n      const distToPad = Math.hypot(actorX - blueBase.padX, actorZ - blueBase.padZ);\\n      const padEval = evaluateStackingPadRecipe(bluePadSlots);\\n\\n      if (distToPad <= 9.5 && padEval.totalCrates > 0) {\\n        craftFromBluePad();\\n        return;\\n      }\\n\\n      // 2. Otherwise if near a loose crate outside the Pad -> Kick it open into Health + Ammo!\\n      let nearestCrate: WorldCrate | null = null;\\n      let bestDist = 4.8;\\n      for (const c of worldCrates) {\\n        if (c.state === \'grounded\') {\\n          const d = Math.hypot(c.x - actorX, c.z - actorZ);\\n          if (d < bestDist) {\\n            bestDist = d;\\n            nearestCrate = c;\\n          }\\n        }\\n      }\\n\\n      if (nearestCrate) {\\n        soundEngine.playHit();\\n        spawnBurstParticles(nearestCrate.x, 0.9, nearestCrate.z, 10);\\n        spawnWorldPickup(\'health\', \'Health +25\', nearestCrate.x - 0.9, nearestCrate.z);\\n        spawnWorldPickup(\'ammo\', \'Ammo +50\', nearestCrate.x + 0.9, nearestCrate.z);\\n        scene.remove(nearestCrate.mesh);\\n        const idx = worldCrates.indexOf(nearestCrate);\\n        if (idx !== -1) worldCrates.splice(idx, 1);\\n      }\\n    };\\n\\n    const handleToggleMountTank = () => {\\n      // Dismount if currently riding a Tank\\n      if (mountedTank) {\\n        soundEngine.playUiClick();\\n        mountedTank.occupiedByPlayer = false;\\n        mountedTank.riderGroup.visible = false;\\n        playerUnit.x = clamp(mountedTank.x - 2.6, -38, 38);\\n        playerUnit.z = clamp(mountedTank.z + 1.2, -38, 38);\\n        playerUnit.root.position.set(playerUnit.x, 0, playerUnit.z);\\n        playerUnit.root.visible = true;\\n        mountedTank = null;\\n        return;\\n      }\\n\\n      // Otherwise check if near any Tank within 6.5m -> Mount into Open-Top Turret!\\n      if (!playerUnit.alive) return;\\n      let nearestTank: TankVehicle | null = null;\\n      let bestDist = 6.5;\\n      for (const t of tanks) {\\n        if (!t.occupiedByPlayer && t.hp > 0) {\\n          const d = Math.hypot(t.x - playerUnit.x, t.z - playerUnit.z);\\n          if (d < bestDist) {\\n            bestDist = d;\\n            nearestTank = t;\\n          }\\n        }\\n      }\\n\\n      if (nearestTank) {\\n        soundEngine.playPickup();\\n        // If an AI Buddy was riding this tank, dismount the AI Buddy so Player takes command\\n        if (nearestTank.occupiedByAiId !== null) {\\n          const aiRider = buddyUnits.find((b) => b.id === nearestTank!.occupiedByAiId);\\n          if (aiRider) {\\n            aiRider.x = clamp(nearestTank.x + 2.4, -38, 38);\\n            aiRider.z = clamp(nearestTank.z + 1.2, -38, 38);\\n            aiRider.root.visible = true;\\n          }\\n          nearestTank.occupiedByAiId = null;\\n        }\\n        if (playerUnit.carryingCrate !== \'none\' && nearestTank.storedCrates.length < 4) {\\n          nearestTank.storedCrates.push(playerUnit.carryingCrate);\\n          playerUnit.carryingCrate = \'none\';\\n          playerUnit.overheadCrateGroup.visible = false;\\n        }\\n        mountedTank = nearestTank;\\n        nearestTank.occupiedByPlayer = true;\\n        nearestTank.riderGroup.visible = true;\\n        playerUnit.root.visible = false;\\n      }\\n    };\\n\\n    const handleCycleBuildOrder = () => {\\n      soundEngine.playUiClick();\\n      const idx = BUILD_ORDER_CYCLE.indexOf(buildOrder);\\n      buildOrder = BUILD_ORDER_CYCLE[(idx + 1) % BUILD_ORDER_CYCLE.length];\\n\\n      // Repack any existing crates on Blue Pad so they strictly occupy only the new [Q] pattern\'s allowed slots!\\n      const existingCrates = bluePadSlots.filter((s) => s !== \'empty\') as (\'red\' | \'super\')[];\\n      bluePadSlots = [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'];\\n      for (const kind of existingCrates) {\\n        const slotIdx = chooseNextPadSlotIndex(bluePadSlots, buildOrder);\\n        if (slotIdx !== -1) {\\n          bluePadSlots[slotIdx] = kind;\\n        } else {\\n          // Eject excess crates onto the ground beside the pad so no crate is lost\\n          spawnWorldCrate(kind, blueBase.padX + 2.8, blueBase.padZ - 1.5, true);\\n        }\\n      }\\n      syncPadVisuals(blueBase, bluePadSlots, \'BLUE\', blueBaseHp);\\n    };\\n\\n    const triggerAlliedSalute = (saluteLabel: string) => {\\n      for (const b of buddyUnits) {\\n        if (b.team === \'blue\' && !b.isPlayer && b.alive) {\\n          b.saluteTimer = 1.65;\\n          b.saluteSign.updateText(\'HORMAT!\', saluteLabel, \'#b8ff3c\', 1);\\n          b.saluteSign.sprite.visible = true;\\n        }\\n      }\\n    };\\n\\n    const handleCursorOrCycleTeamCommand = (useCursorTarget: boolean) => {\\n      soundEngine.playUiClick();\\n      const freeBlueTanks = tanks.filter(\\n        (t) => t.team === \'blue\' && !t.occupiedByPlayer && t.occupiedByAiId === null && t.hp > 0,\\n      );\\n\\n      if (useCursorTarget) {\\n        const res = resolveCursorCommandTarget({\\n          cursorX: aimWorldPoint.x,\\n          cursorZ: aimWorldPoint.z,\\n          crates: worldCrates.filter((c) => c.state === \'grounded\' || c.state === \'falling\'),\\n          enemies: buddyUnits.filter((b) => b.team === \'red\' && b.alive),\\n          emptyTanks: freeBlueTanks,\\n          blueBase: { x: 0, z: 22, padX: blueBase.padX, padZ: blueBase.padZ },\\n          redBase: { x: 0, z: -22, padX: redBase.padX, padZ: redBase.padZ },\\n          currentCommand: teamCommand,\\n        });\\n        teamCommand = res.command;\\n        triggerAlliedSalute(res.saluteLabel);\\n      } else {\\n        const idx = COMMAND_CYCLE.indexOf(teamCommand);\\n        teamCommand = COMMAND_CYCLE[(idx + 1) % COMMAND_CYCLE.length];\\n        const labelMap: Record<TeamCommandMode, string> = {\\n          HARVEST: \'PANEN PETI\',\\n          ATTACK: \'SERANG MUSUH\',\\n          DEFEND: \'JAGA MARKAS\',\\n          FOLLOW: \'IKUTI PEMAIN\',\\n          MOUNT: \'NAIK TANK\',\\n        };\\n        triggerAlliedSalute(labelMap[teamCommand]);\\n      }\\n    };\\n\\n    const handleSwapBuddy = () => {\\n      if (mountedTank) return;\\n      const alliedPool = buddyUnits.filter((b) => b.team === \'blue\' && b.alive);\\n      if (alliedPool.length <= 1) return;\\n      soundEngine.playUiClick();\\n      const currentIdx = alliedPool.indexOf(playerUnit);\\n      const nextBuddy = alliedPool[(currentIdx + 1) % alliedPool.length];\\n      playerUnit.isPlayer = false;\\n      (playerUnit.teamRing.material as THREE.MeshBasicMaterial).color.setHex(0x2979ff);\\n      nextBuddy.isPlayer = true;\\n      (nextBuddy.teamRing.material as THREE.MeshBasicMaterial).color.setHex(0xb4ff39);\\n      playerUnit = nextBuddy;\\n    };\\n\\n    // =========================================================================\\n    // 11. INPUT LISTENERS (WASD, MOUSE AIM, SCROLL ZOOM, CLICK SHOOT, E/F/G/Q/V/TAB)\\n    // =========================================================================\\n    const keys: Record<string, boolean> = {};\\n    const mouseNdc = new THREE.Vector2(0, 0);\\n    const raycaster = new THREE.Raycaster();\\n    const groundPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -0.6);\\n    const aimWorldPoint = new THREE.Vector3(0, 0.6, 0);\\n    let isPointerDown = false;\\n    // Default 22% wider zoom-out so Base HQ, Stacking Pad 2x2x2, and Drop Zone road are visible at once!\\n    let cameraZoom = 1.22;\\n\\n    const onKeyDown = (e: KeyboardEvent) => {\\n      keys[e.code] = true;\\n      if (gameStateRef.current !== \'playing\') return;\\n\\n      if (e.code === \'Escape\' || e.code === \'KeyP\') {\\n        e.preventDefault();\\n        onTogglePause();\\n      } else if (e.code === \'KeyE\') {\\n        e.preventDefault();\\n        handlePlayerPickupOrThrowCrate();\\n      } else if (e.code === \'KeyF\') {\\n        e.preventDefault();\\n        handlePlayerKickOrCraft();\\n      } else if (e.code === \'KeyG\') {\\n        e.preventDefault();\\n        handleToggleMountTank();\\n      } else if (e.code === \'KeyQ\') {\\n        e.preventDefault();\\n        handleCycleBuildOrder();\\n      } else if (e.code === \'KeyV\') {\\n        e.preventDefault();\\n        handleCursorOrCycleTeamCommand(true);\\n      } else if (e.code === \'Tab\') {\\n        e.preventDefault();\\n        handleSwapBuddy();\\n      }\\n    };\\n\\n    const onKeyUp = (e: KeyboardEvent) => {\\n      keys[e.code] = false;\\n    };\\n\\n    const updateMouseWorldAim = (clientX: number, clientY: number) => {\\n      const rect = renderer.domElement.getBoundingClientRect();\\n      if (rect.width <= 0 || rect.height <= 0) return;\\n      mouseNdc.x = ((clientX - rect.left) / rect.width) * 2 - 1;\\n      mouseNdc.y = -((clientY - rect.top) / rect.height) * 2 + 1;\\n    };\\n\\n    const onPointerMove = (e: PointerEvent) => {\\n      updateMouseWorldAim(e.clientX, e.clientY);\\n    };\\n\\n    const onPointerDown = (e: PointerEvent) => {\\n      if (gameStateRef.current !== \'playing\') return;\\n      updateMouseWorldAim(e.clientX, e.clientY);\\n      if (e.button === 0) {\\n        isPointerDown = true;\\n      } else if (e.button === 2) {\\n        handlePlayerPickupOrThrowCrate();\\n      }\\n    };\\n\\n    const onPointerUp = (e: PointerEvent) => {\\n      if (e.button === 0) {\\n        isPointerDown = false;\\n      }\\n    };\\n\\n    const onWheel = (e: WheelEvent) => {\\n      cameraZoom = clamp(cameraZoom + Math.sign(e.deltaY) * 0.08, 0.78, 1.65);\\n    };\\n\\n    const onContextMenu = (e: MouseEvent) => e.preventDefault();\\n\\n    // Also allow external HUD buttons to trigger actions via CustomEvent\\n    const onBuddyActionEvent = (e: Event) => {\\n      const ce = e as CustomEvent<string>;\\n      if (ce.detail === \'pickupOrThrow\') handlePlayerPickupOrThrowCrate();\\n      else if (ce.detail === \'kickOrCraft\') handlePlayerKickOrCraft();\\n      else if (ce.detail === \'mountOrDismount\') handleToggleMountTank();\\n      else if (ce.detail === \'cycleBuildOrder\') handleCycleBuildOrder();\\n      else if (ce.detail === \'cycleCommand\') handleCursorOrCycleTeamCommand(false);\\n      else if (ce.detail === \'swapBuddy\') handleSwapBuddy();\\n    };\\n\\n    window.addEventListener(\'keydown\', onKeyDown);\\n    window.addEventListener(\'keyup\', onKeyUp);\\n    window.addEventListener(\'buddy-action\', onBuddyActionEvent);\\n    renderer.domElement.addEventListener(\'pointermove\', onPointerMove);\\n    renderer.domElement.addEventListener(\'pointerdown\', onPointerDown);\\n    renderer.domElement.addEventListener(\'wheel\', onWheel, { passive: true });\\n    window.addEventListener(\'pointerup\', onPointerUp);\\n    renderer.domElement.addEventListener(\'contextmenu\', onContextMenu);\\n\\n    const onResize = () => {\\n      if (!container) return;\\n      const w = container.clientWidth || window.innerWidth;\\n      const h = container.clientHeight || window.innerHeight;\\n      camera.aspect = w / h;\\n      camera.updateProjectionMatrix();\\n      renderer.setSize(w, h);\\n    };\\n    window.addEventListener(\'resize\', onResize);\\n\\n    // =========================================================================\\n    // 12. CAMERA SPRING & MAIN 60FPS ANIMATION LOOP\\n    // =========================================================================\\n    let camFollowPos: Vec3 = { x: 0, y: 0.8, z: 12.5 };\\n    let camFollowVel: Vec3 = { x: 0, y: 0, z: 0 };\\n    const mousePanCurrent = { x: 0, z: 0 };\\n    const recoilOffset = { x: 0, z: 0 };\\n    let shakeTrauma = 0;\\n    let grassBucketIdx = 0;\\n    let hudSyncAccumulator = 0;\\n    let runElapsedSec = 0;\\n\\n    resetArenaRef.current = () => {\\n      spawnInitialSquadsAndObjects();\\n      runElapsedSec = 0;\\n    };\\n\\n    let rafId = 0;\\n    let prevTime = performance.now();\\n\\n    const animate = (now: number) => {\\n      rafId = requestAnimationFrame(animate);\\n      const rawDt = (now - prevTime) / 1000;\\n      prevTime = now;\\n      const dt = Math.min(rawDt, 0.05);\\n      const timeSec = now * 0.001;\\n\\n      const state = gameStateRef.current;\\n\\n      // 1. Time-Sliced 4-Bucket Wind Grass Animation (60 FPS)\\n      grassBucketIdx = (grassBucketIdx + 1) % 4;\\n      for (let i = grassBucketIdx; i < grassCount; i += 4) {\\n        const g = grassBaseData[i];\\n        const sway = Math.sin(timeSec * 2.8 + g.phase) * 0.22;\\n        dummyGrass.position.set(g.x, 0, g.z);\\n        dummyGrass.rotation.set(sway, g.rotY, sway * 0.5);\\n        dummyGrass.scale.set(1, g.scaleY, 1);\\n        dummyGrass.updateMatrix();\\n        grassInstanced.setMatrixAt(i, dummyGrass.matrix);\\n      }\\n      grassInstanced.instanceMatrix.needsUpdate = true;\\n\\n      // 2. Raycast Mouse Crosshair onto Ground Plane\\n      raycaster.setFromCamera(mouseNdc, camera);\\n      raycaster.ray.intersectPlane(groundPlane, aimWorldPoint);\\n\\n      // Pulse the [Q] Ghost Wireframe opacity gently\\n      const ghostMat = blueBase.ghostPatternBox.material as THREE.MeshBasicMaterial;\\n      ghostMat.opacity = 0.65 + Math.sin(timeSec * 4.0) * 0.22;\\n\\n      // 3. Gameplay Simulation Step\\n      let activeSpeed = 0;\\n      const isBoosting = Boolean(keys[\'ShiftLeft\'] || keys[\'ShiftRight\']);\\n\\n      if (state === \'playing\') {\\n        runElapsedSec += dt;\\n\\n        // Periodic Parachute Crate Drops in Central & Side Drop Zones\\n        crateSpawnTimer += dt;\\n        if (crateSpawnTimer >= 4.2) {\\n          crateSpawnTimer = 0;\\n          spawnWorldCrate(\\n            \'red\',\\n            (Math.random() - 0.5) * 5.0,\\n            (Math.random() - 0.5) * 5.0,\\n            false,\\n          );\\n        }\\n\\n        superCrateSpawnTimer += dt;\\n        if (superCrateSpawnTimer >= 11.0) {\\n          superCrateSpawnTimer = 0;\\n          const sideX = Math.random() < 0.5 ? -17 : 17;\\n          spawnWorldCrate(\\n            \'super\',\\n            sideX + (Math.random() - 0.5) * 2.5,\\n            (Math.random() - 0.5) * 2.5,\\n            false,\\n          );\\n        }\\n\\n        // Update Falling & Grounded Crates (Parachute descent + Squash & Stretch landing)\\n        for (const c of worldCrates) {\\n          if (c.state === \'falling\') {\\n            c.y -= 5.2 * dt;\\n            c.mesh.position.y = c.y;\\n            c.mesh.rotation.y = Math.sin(timeSec * 2.5 + c.id) * 0.18;\\n            if (c.y <= 0.65) {\\n              c.y = 0.65;\\n              c.state = \'grounded\';\\n              c.parachuteMesh.visible = false;\\n              c.squashTimer = 0.28;\\n              c.mesh.position.y = 0.65;\\n              c.mesh.rotation.y = 0;\\n            }\\n          } else if (c.state === \'grounded\') {\\n            if (c.squashTimer > 0) {\\n              c.squashTimer = Math.max(0, c.squashTimer - dt);\\n              const s = Math.sin((c.squashTimer / 0.28) * Math.PI) * 0.28;\\n              c.mesh.scale.set(1 + s, 1 - s * 0.8, 1 + s);\\n            } else {\\n              c.mesh.scale.set(1, 1, 1);\\n            }\\n          }\\n        }\\n\\n        // Player Movement Input (WASD)\\n        let moveX = 0;\\n        let moveZ = 0;\\n        if (keys[\'KeyW\'] || keys[\'ArrowUp\']) moveZ -= 1;\\n        if (keys[\'KeyS\'] || keys[\'ArrowDown\']) moveZ += 1;\\n        if (keys[\'KeyA\'] || keys[\'ArrowLeft\']) moveX -= 1;\\n        if (keys[\'KeyD\'] || keys[\'ArrowRight\']) moveX += 1;\\n\\n        if (mountedTank) {\\n          // =================================================================\\n          // A. DRIVING OPEN-TOP LYO TANK MODE\\n          // =================================================================\\n          let throttle = 0;\\n          let turn = 0;\\n          if (keys[\'KeyW\'] || keys[\'ArrowUp\']) throttle += 1;\\n          if (keys[\'KeyS\'] || keys[\'ArrowDown\']) throttle -= 1;\\n          if (keys[\'KeyA\'] || keys[\'ArrowLeft\']) turn += 1;\\n          if (keys[\'KeyD\'] || keys[\'ArrowRight\']) turn -= 1;\\n\\n          mountedTank.currentDriveSpeed = computeTankSpeedStep(\\n            mountedTank.currentDriveSpeed,\\n            isBoosting && throttle !== 0,\\n            dt,\\n          );\\n\\n          if (turn !== 0) {\\n            const rev = throttle < 0 ? -1 : 1;\\n            mountedTank.hullYaw += turn * rev * REA_CONSTANTS.physics.drive.rotationSpeed * dt;\\n          }\\n\\n          const fwdX = Math.cos(mountedTank.hullYaw);\\n          const fwdZ = -Math.sin(mountedTank.hullYaw);\\n          const targetVx = fwdX * throttle * mountedTank.currentDriveSpeed;\\n          const targetVz = fwdZ * throttle * mountedTank.currentDriveSpeed;\\n          mountedTank.vx += (targetVx - mountedTank.vx) * Math.min(1, 10 * dt);\\n          mountedTank.vz += (targetVz - mountedTank.vz) * Math.min(1, 10 * dt);\\n\\n          mountedTank.x = clamp(mountedTank.x + mountedTank.vx * dt, -40, 40);\\n          mountedTank.z = clamp(mountedTank.z + mountedTank.vz * dt, -40, 40);\\n          mountedTank.root.position.set(mountedTank.x, 0, mountedTank.z);\\n          mountedTank.bodyGroup.rotation.y = mountedTank.hullYaw;\\n          activeSpeed = Math.hypot(mountedTank.vx, mountedTank.vz);\\n\\n          // Rotate Turret + Open-Top Rider 360\302\260 toward Mouse Crosshair\\n          const aimDx = aimWorldPoint.x - mountedTank.x;\\n          const aimDz = aimWorldPoint.z - mountedTank.z;\\n          const desiredWorldYaw = Math.atan2(-aimDz, aimDx);\\n          mountedTank.turretYaw = stepTurretYaw(\\n            mountedTank.turretYaw,\\n            desiredWorldYaw - mountedTank.hullYaw,\\n            dt,\\n          );\\n          mountedTank.turretGroup.rotation.y = mountedTank.turretYaw;\\n\\n          // Team Buddies Feature: Crate Run-Over (Carry up to 4 crates by driving over them!)\\n          for (let i = worldCrates.length - 1; i >= 0; i--) {\\n            const c = worldCrates[i];\\n            if (c.state === \'grounded\' && mountedTank.storedCrates.length < 4) {\\n              if (Math.hypot(c.x - mountedTank.x, c.z - mountedTank.z) < 2.2) {\\n                mountedTank.storedCrates.push(c.kind);\\n                scene.remove(c.mesh);\\n                worldCrates.splice(i, 1);\\n                soundEngine.playPickup();\\n              }\\n            }\\n          }\\n\\n          // Auto-unload Tank\'s stored crates when driving next to Blue Stacking Pad\\n          if (\\n            mountedTank.storedCrates.length > 0 &&\\n            Math.hypot(mountedTank.x - blueBase.padX, mountedTank.z - blueBase.padZ) < 4.8\\n          ) {\\n            while (mountedTank.storedCrates.length > 0) {\\n              const kind = mountedTank.storedCrates[0];\\n              if (!addCrateToPadSlots(\'blue\', kind)) break;\\n              mountedTank.storedCrates.shift();\\n              score += 35;\\n            }\\n            soundEngine.playPickup();\\n          }\\n\\n          // Keep playerUnit position synced to the Tank\\n          playerUnit.x = mountedTank.x;\\n          playerUnit.z = mountedTank.z;\\n\\n          // Tank Cannon Firing\\n          if (mountedTank.recoilTimer > 0) {\\n            mountedTank.recoilTimer = Math.max(0, mountedTank.recoilTimer - dt);\\n            mountedTank.barrelGroup.position.x = 0.65 - mountedTank.recoilTimer * 1.1;\\n          } else {\\n            mountedTank.barrelGroup.position.x = 0.65;\\n          }\\n\\n          if ((isPointerDown || keys[\'Space\']) && mountedTank.recoilTimer <= 0.02) {\\n            mountedTank.recoilTimer = 0.22;\\n            soundEngine.playShoot();\\n            const totalYaw = mountedTank.hullYaw + mountedTank.turretYaw;\\n            const sDir = new THREE.Vector3(Math.cos(totalYaw), 0, -Math.sin(totalYaw));\\n            const muzzleOrigin = new THREE.Vector3(\\n              mountedTank.x + sDir.x * 2.1,\\n              1.35,\\n              mountedTank.z + sDir.z * 2.1,\\n            );\\n            fireProjectile(true, \'TankCannon\', muzzleOrigin, sDir, 46, mountedTank.isSuper ? 26 : 18);\\n            recoilOffset.x -= sDir.x * 0.18;\\n            recoilOffset.z -= sDir.z * 0.18;\\n            shakeTrauma = Math.min(1, shakeTrauma + 0.25);\\n          }\\n        } else if (playerUnit.alive) {\\n          // =================================================================\\n          // B. ON-FOOT CHIBI BUDDY CHARACTER MODE\\n          // =================================================================\\n          const spec = BUDDY_CLASSES[playerUnit.classId];\\n          const carryPenalty = playerUnit.carryingCrate !== \'none\' ? 0.85 : 1.0;\\n          const boostMult = isBoosting ? 1.38 : 1.0;\\n          const moveSpeed = 9.2 * spec.speedMultiplier * carryPenalty * boostMult;\\n\\n          const inputLen = Math.hypot(moveX, moveZ);\\n          if (inputLen > 0.01) {\\n            playerUnit.vx = (moveX / inputLen) * moveSpeed;\\n            playerUnit.vz = (moveZ / inputLen) * moveSpeed;\\n            playerUnit.walkCycle += dt * moveSpeed * 1.65;\\n          } else {\\n            playerUnit.vx *= Math.exp(-14 * dt);\\n            playerUnit.vz *= Math.exp(-14 * dt);\\n          }\\n\\n          playerUnit.x = clamp(playerUnit.x + playerUnit.vx * dt, -40, 40);\\n          playerUnit.z = clamp(playerUnit.z + playerUnit.vz * dt, -40, 40);\\n          activeSpeed = Math.hypot(playerUnit.vx, playerUnit.vz);\\n\\n          // Rotate Character smoothly toward Mouse Crosshair\\n          const aimDx = aimWorldPoint.x - playerUnit.x;\\n          const aimDz = aimWorldPoint.z - playerUnit.z;\\n          if (Math.hypot(aimDx, aimDz) > 0.2) {\\n            playerUnit.yaw = Math.atan2(-aimDz, aimDx);\\n          }\\n\\n          // Player Shooting (when not carrying a crate above head)\\n          if (playerUnit.shootCooldown > 0) {\\n            playerUnit.shootCooldown = Math.max(0, playerUnit.shootCooldown - dt);\\n          }\\n          if (\\n            (isPointerDown || keys[\'Space\']) &&\\n            playerUnit.carryingCrate === \'none\' &&\\n            playerUnit.shootCooldown <= 0\\n          ) {\\n            const wName = playerUnit.weaponName;\\n            const isHeavy = wName === \'Bazooka\' || wName === \'Supazooka\';\\n            playerUnit.shootCooldown = isHeavy ? 0.42 : 0.16;\\n            soundEngine.playShoot();\\n\\n            const sDir = new THREE.Vector3(Math.cos(playerUnit.yaw), 0, -Math.sin(playerUnit.yaw));\\n            const muzzlePos = new THREE.Vector3(\\n              playerUnit.x + sDir.x * 1.15,\\n              1.15,\\n              playerUnit.z + sDir.z * 1.15,\\n            );\\n            fireProjectile(\\n              true,\\n              wName.includes(\'Ice\') ? \'Ice Gun\' : wName,\\n              muzzlePos,\\n              sDir,\\n              isHeavy ? 38 : 44,\\n              isHeavy ? 22 : 9,\\n            );\\n          }\\n        }\\n\\n        // Update AI-Driven Open-Top Tanks (when an AI Buddy mounted a crafted Tank!)\\n        for (const t of tanks) {\\n          if (!t.occupiedByPlayer && t.occupiedByAiId !== null && t.hp > 0) {\\n            const targetZ = -18;\\n            const dx = 0 - t.x;\\n            const dz = targetZ - t.z;\\n            const d = Math.hypot(dx, dz);\\n            if (d > 4.0) {\\n              t.hullYaw = Math.atan2(-dz, dx);\\n              t.x = clamp(t.x + (dx / d) * 6.5 * dt, -40, 40);\\n              t.z = clamp(t.z + (dz / d) * 6.5 * dt, -40, 40);\\n              t.root.position.set(t.x, 0, t.z);\\n              t.bodyGroup.rotation.y = t.hullYaw;\\n            }\\n            if (t.recoilTimer > 0) {\\n              t.recoilTimer = Math.max(0, t.recoilTimer - dt);\\n            } else {\\n              t.recoilTimer = 1.1;\\n              const sDir = new THREE.Vector3(0, 0, -1);\\n              fireProjectile(\\n                true,\\n                \'TankCannon\',\\n                new THREE.Vector3(t.x, 1.35, t.z - 2.0),\\n                sDir,\\n                42,\\n                16,\\n              );\\n            }\\n          }\\n        }\\n\\n        // ===================================================================\\n        // C. UPDATE ALL AI BUDDIES (BLUE ALLIES & RED ENEMIES: HARVEST, SALUTE & COMBAT)\\n        // ===================================================================\\n        for (const b of buddyUnits) {\\n          if (!b.alive) {\\n            b.respawnTimer -= dt;\\n            if (b.respawnTimer <= 0) {\\n              b.alive = true;\\n              b.hp = b.maxHp;\\n              b.isFrozen = false;\\n              b.carryingCrate = \'none\';\\n              b.overheadCrateGroup.visible = false;\\n              b.x = (Math.random() - 0.5) * 8;\\n              b.z = b.team === \'blue\' ? 16 : -16;\\n              b.root.visible = true;\\n            }\\n            continue;\\n          }\\n\\n          // Skip on-foot AI update if this AI Buddy is currently riding inside a Tank\\n          const ridingTank = tanks.find((t) => t.occupiedByAiId === b.id);\\n          if (ridingTank) {\\n            b.x = ridingTank.x;\\n            b.z = ridingTank.z;\\n            b.root.visible = false;\\n            continue;\\n          }\\n\\n          if (b.saluteTimer > 0) {\\n            b.saluteTimer = Math.max(0, b.saluteTimer - dt);\\n            if (b.saluteTimer <= 0) {\\n              b.saluteSign.sprite.visible = false;\\n            }\\n          }\\n\\n          if (b.isFrozen) {\\n            b.frozenTimer -= dt;\\n            if (b.frozenTimer <= 0) {\\n              b.isFrozen = false;\\n            }\\n          }\\n\\n          // Medic passive HP regeneration\\n          if (b.classId === \'Medic\' && b.hp < b.maxHp) {\\n            b.hp = Math.min(b.maxHp, b.hp + dt * 1.5);\\n          }\\n\\n          if (!b.isPlayer && !b.isFrozen) {\\n            const spec = BUDDY_CLASSES[b.classId];\\n            const aiSpeed = 6.8 * spec.speedMultiplier;\\n            const homePadX = b.team === \'blue\' ? blueBase.padX : redBase.padX;\\n            const homePadZ = b.team === \'blue\' ? blueBase.padZ : redBase.padZ;\\n            const enemyHqZ = b.team === \'blue\' ? -22 : 22;\\n\\n            let goalX = b.x;\\n            let goalZ = b.z;\\n            const aiMode = b.team === \'blue\' ? teamCommand : \'HARVEST\';\\n\\n            // Check if Blue Stacking Pad has already filled all slots of the active [Q] pattern\\n            const bluePatternFull =\\n              b.team === \'blue\' && chooseNextPadSlotIndex(bluePadSlots, buildOrder) === -1;\\n\\n            if (b.carryingCrate !== \'none\') {\\n              // Carry overhead crate back to team\'s Stacking Pad 2x2x2!\\n              goalX = homePadX;\\n              goalZ = homePadZ;\\n              if (Math.hypot(b.x - homePadX, b.z - homePadZ) < 2.6) {\\n                if (addCrateToPadSlots(b.team, b.carryingCrate)) {\\n                  b.carryingCrate = \'none\';\\n                  b.overheadCrateGroup.visible = false;\\n                  if (b.team === \'blue\') score += 25;\\n                }\\n              }\\n            } else if (aiMode === \'MOUNT\' && b.team === \'blue\') {\\n              const freeTank = tanks.find(\\n                (t) => t.team === \'blue\' && !t.occupiedByPlayer && t.occupiedByAiId === null && t.hp > 0,\\n              );\\n              if (freeTank) {\\n                goalX = freeTank.x;\\n                goalZ = freeTank.z;\\n                if (Math.hypot(b.x - freeTank.x, b.z - freeTank.z) < 2.2) {\\n                  freeTank.occupiedByAiId = b.id;\\n                  freeTank.riderGroup.visible = true;\\n                  b.root.visible = false;\\n                }\\n              } else {\\n                goalX = 0;\\n                goalZ = enemyHqZ;\\n              }\\n            } else if (aiMode === \'FOLLOW\' && b.team === \'blue\') {\\n              goalX = playerUnit.x - 2.5;\\n              goalZ = playerUnit.z + 2.0;\\n            } else if (aiMode === \'DEFEND\' && b.team === \'blue\') {\\n              goalX = 0;\\n              goalZ = 15;\\n            } else if (aiMode === \'ATTACK\' || bluePatternFull) {\\n              goalX = 0;\\n              goalZ = enemyHqZ;\\n            } else {\\n              // HARVEST mode: Find nearest grounded crate in the arena!\\n              let bestCrate: WorldCrate | null = null;\\n              let bestDist = 999;\\n              for (const c of worldCrates) {\\n                if (c.state === \'grounded\') {\\n                  const d = Math.hypot(c.x - b.x, c.z - b.z);\\n                  if (d < bestDist) {\\n                    bestDist = d;\\n                    bestCrate = c;\\n                  }\\n                }\\n              }\\n\\n              if (bestCrate) {\\n                goalX = bestCrate.x;\\n                goalZ = bestCrate.z;\\n                if (bestDist < 1.65) {\\n                  b.carryingCrate = bestCrate.kind;\\n                  b.overheadCrateBox.material =\\n                    bestCrate.kind === \'super\' ? matSuperCrate : matRedCrate;\\n                  b.overheadCrateGroup.visible = true;\\n                  scene.remove(bestCrate.mesh);\\n                  const idx = worldCrates.indexOf(bestCrate);\\n                  if (idx !== -1) worldCrates.splice(idx, 1);\\n                }\\n              } else {\\n                goalX = 0;\\n                goalZ = enemyHqZ * 0.5;\\n              }\\n            }\\n\\n            const dx = goalX - b.x;\\n            const dz = goalZ - b.z;\\n            const dist = Math.hypot(dx, dz);\\n            if (dist > 0.6 && b.saluteTimer <= 1.1) {\\n              b.vx = (dx / dist) * aiSpeed;\\n              b.vz = (dz / dist) * aiSpeed;\\n              b.x = clamp(b.x + b.vx * dt, -40, 40);\\n              b.z = clamp(b.z + b.vz * dt, -40, 40);\\n              b.yaw = Math.atan2(-b.vz, b.vx);\\n              b.walkCycle += dt * aiSpeed * 1.6;\\n            } else {\\n              b.vx = 0;\\n              b.vz = 0;\\n            }\\n\\n            // AI Shooting at nearest enemy within 14m when not carrying a crate\\n            if (b.shootCooldown > 0) b.shootCooldown -= dt;\\n            if (b.carryingCrate === \'none\' && b.shootCooldown <= 0) {\\n              let targetX: number | null = null;\\n              let targetZ: number | null = null;\\n              let minEnemyDist = 14.5;\\n\\n              for (const other of buddyUnits) {\\n                if (other.alive && other.team !== b.team) {\\n                  const ed = Math.hypot(other.x - b.x, other.z - b.z);\\n                  if (ed < minEnemyDist) {\\n                    minEnemyDist = ed;\\n                    targetX = other.x;\\n                    targetZ = other.z;\\n                  }\\n                }\\n              }\\n\\n              if (targetX !== null && targetZ !== null) {\\n                b.shootCooldown = 1.15 + Math.random() * 0.4;\\n                b.yaw = Math.atan2(-(targetZ - b.z), targetX - b.x);\\n                const dir = new THREE.Vector3(targetX - b.x, 0, targetZ - b.z).normalize();\\n                fireProjectile(\\n                  b.team === \'blue\',\\n                  b.weaponName,\\n                  new THREE.Vector3(b.x + dir.x * 1.1, 1.1, b.z + dir.z * 1.1),\\n                  dir,\\n                  24,\\n                  4,\\n                );\\n              }\\n            }\\n          }\\n\\n          // Animate Chibi Buddy Limbs (Running legs + Overhead crate arms vs Salute vs Weapon arm)\\n          const floatY = BUDDY_CLASSES[b.classId].canFly ? 0.65 + Math.sin(timeSec * 4 + b.id) * 0.18 : 0;\\n          b.root.position.set(b.x, floatY, b.z);\\n          b.bodyGroup.rotation.y = b.yaw - Math.PI / 2;\\n\\n          const speedMag = Math.hypot(b.vx, b.vz);\\n          const legSwing = speedMag > 0.4 ? Math.sin(b.walkCycle) * 0.68 : 0;\\n          b.leftLegPivot.rotation.x = legSwing;\\n          b.rightLegPivot.rotation.x = -legSwing;\\n\\n          if (b.carryingCrate !== \'none\') {\\n            // Raise BOTH arms straight up overhead to hold the 3D Crate!\\n            b.leftArmPivot.rotation.x = Math.PI * 0.92;\\n            b.rightArmPivot.rotation.x = Math.PI * 0.92;\\n            b.rightArmPivot.rotation.z = 0;\\n            b.weaponMesh.visible = false;\\n            b.overheadCrateGroup.visible = true;\\n          } else if (b.saluteTimer > 0) {\\n            // Military Salute Pose when acknowledging [V] Command!\\n            b.leftArmPivot.rotation.x = 0;\\n            b.rightArmPivot.rotation.x = -Math.PI * 0.82;\\n            b.rightArmPivot.rotation.z = -0.38;\\n            b.weaponMesh.visible = false;\\n            b.overheadCrateGroup.visible = false;\\n          } else {\\n            b.leftArmPivot.rotation.x = -legSwing * 0.6;\\n            b.rightArmPivot.rotation.x = -Math.PI * 0.35;\\n            b.rightArmPivot.rotation.z = 0;\\n            b.weaponMesh.visible = true;\\n            b.overheadCrateGroup.visible = false;\\n          }\\n\\n          if (b.hitFlashTimer > 0) {\\n            b.hitFlashTimer = Math.max(0, b.hitFlashTimer - dt);\\n            b.headMesh.material = flashWhiteMat;\\n          } else if (b.isFrozen) {\\n            b.headMesh.material = frozenIceMat;\\n          } else {\\n            b.headMesh.material = matSkin;\\n          }\\n        }\\n\\n        // Red Team Stacking Pad Auto-Crafter (so Red Team also crafts buddies from stacked crates!)\\n        const redEval = evaluateStackingPadRecipe(redPadSlots);\\n        if (redEval.totalCrates >= 2) {\\n          redCraftTimer += dt;\\n          if (redCraftTimer >= 3.0) {\\n            redCraftTimer = 0;\\n            const activeRed = buddyUnits.filter((u) => u.team === \'red\' && u.alive).length;\\n            if (activeRed < 5) {\\n              buddyUnits.push(\\n                createBuddyCharacterUnit(\\n                  \'red\',\\n                  false,\\n                  redEval.isSuper ? \'Cyborg\' : \'Commando\',\\n                  redBase.padX - 2.5,\\n                  redBase.padZ + 2.0,\\n                ),\\n              );\\n            }\\n            redPadSlots = [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'];\\n            syncPadVisuals(redBase, redPadSlots, \'RED\', redBaseHp);\\n          }\\n        }\\n\\n        // ===================================================================\\n        // D. UPDATE PROJECTILES, TREE DESTRUCTION, BASE HQ DAMAGE & PICKUPS\\n        // ===================================================================\\n        for (const p of projectiles) {\\n          if (!p.active) continue;\\n          p.life -= dt;\\n          if (p.life <= 0) {\\n            p.active = false;\\n            p.mesh.visible = false;\\n            continue;\\n          }\\n          p.pos.addScaledVector(p.vel, dt);\\n          p.mesh.position.copy(p.pos);\\n\\n          // 1. Check hit against Destructible Lyo Trees\\n          let hitResolved = false;\\n          for (const tr of trees) {\\n            if (tr.alive && Math.hypot(p.pos.x - tr.x, p.pos.z - tr.z) < 1.65) {\\n              tr.hp -= p.damage;\\n              tr.hitFlashTimer = 0.12;\\n              soundEngine.playHit();\\n              spawnBurstParticles(p.pos.x, 1.5, p.pos.z, 6);\\n              if (tr.hp <= 0) {\\n                tr.alive = false;\\n                tr.mesh.visible = false;\\n                score += 80;\\n                soundEngine.playExplosion();\\n                spawnBurstParticles(tr.x, 2.2, tr.z, 16);\\n                spawnWorldPickup(\'powerup\', \'Shield / Boost\', tr.x, tr.z);\\n              }\\n              hitResolved = true;\\n              break;\\n            }\\n          }\\n          if (hitResolved) {\\n            p.active = false;\\n            p.mesh.visible = false;\\n            continue;\\n          }\\n\\n          // 2. Check hit against Enemy Base HQ\\n          if (p.isPlayerTeam && Math.hypot(p.pos.x - 0, p.pos.z - -22) < 3.6) {\\n            redBaseHp = Math.max(0, redBaseHp - p.damage * 8);\\n            score += 25;\\n            syncPadVisuals(redBase, redPadSlots, \'RED\', redBaseHp);\\n            spawnBurstParticles(p.pos.x, 2.0, p.pos.z, 8);\\n            soundEngine.playHit();\\n            p.active = false;\\n            p.mesh.visible = false;\\n            if (redBaseHp <= 0) {\\n              soundEngine.playVictory();\\n              bestScore = Math.max(bestScore, score + 1000);\\n              onGameOver(\'victory\', buildHudSnapshot(\'victory\'));\\n            }\\n            continue;\\n          } else if (!p.isPlayerTeam && Math.hypot(p.pos.x - 0, p.pos.z - 22) < 3.6) {\\n            blueBaseHp = Math.max(0, blueBaseHp - p.damage * 4);\\n            syncPadVisuals(blueBase, bluePadSlots, \'BLUE\', blueBaseHp);\\n            p.active = false;\\n            p.mesh.visible = false;\\n            continue;\\n          }\\n\\n          // 3. Check hit against Buddy Units (including Ice Gun Freeze + Shatter rule!)\\n          for (const b of buddyUnits) {\\n            if (!b.alive) continue;\\n            if (b.isPlayer && mountedTank) continue;\\n            if ((p.isPlayerTeam && b.team === \'red\') || (!p.isPlayerTeam && b.team === \'blue\')) {\\n              if (Math.hypot(p.pos.x - b.x, p.pos.z - b.z) < 1.15) {\\n                if (p.weaponType === \'Ice Gun\') {\\n                  b.isFrozen = true;\\n                  b.frozenTimer = 4.0;\\n                  b.hp -= Math.ceil(p.damage * 0.5);\\n                } else if (b.isFrozen) {\\n                  // Frozen targets shatter immediately on follow-up hit!\\n                  b.hp = 0;\\n                } else {\\n                  b.hp -= p.damage;\\n                }\\n                b.hitFlashTimer = 0.14;\\n                soundEngine.playHit();\\n                spawnBurstParticles(b.x, 1.2, b.z, 8);\\n\\n                if (b.hp <= 0) {\\n                  b.alive = false;\\n                  b.respawnTimer = 6.0;\\n                  b.root.visible = false;\\n                  soundEngine.playExplosion();\\n                  spawnBurstParticles(b.x, 1.4, b.z, 16);\\n                  if (b.team === \'red\') {\\n                    enemiesDefeated++;\\n                    score += 150;\\n                    spawnWorldPickup(\'health\', \'Health +25\', b.x, b.z);\\n                  } else if (b.isPlayer) {\\n                    b.alive = true;\\n                    b.hp = b.maxHp;\\n                    b.x = 0;\\n                    b.z = 14;\\n                    b.root.visible = true;\\n                  }\\n                }\\n                hitResolved = true;\\n                break;\\n              }\\n            }\\n          }\\n          if (hitResolved) {\\n            p.active = false;\\n            p.mesh.visible = false;\\n          }\\n        }\\n\\n        // Collect 3D Pickups (Weapons, Health Hearts, Ammo Boxes, Tree Power-Ups)\\n        const collectorX = mountedTank ? mountedTank.x : playerUnit.x;\\n        const collectorZ = mountedTank ? mountedTank.z : playerUnit.z;\\n        for (let i = worldPickups.length - 1; i >= 0; i--) {\\n          const pk = worldPickups[i];\\n          pk.bobPhase += dt * 3.5;\\n          pk.mesh.position.y = 0.75 + Math.sin(pk.bobPhase) * 0.2;\\n          pk.mesh.rotation.y += dt * 2.2;\\n\\n          if (Math.hypot(pk.x - collectorX, pk.z - collectorZ) < 2.1) {\\n            soundEngine.playPickup();\\n            if (pk.kind === \'health\') {\\n              playerUnit.hp = Math.min(playerUnit.maxHp, playerUnit.hp + 10);\\n            } else if (pk.kind === \'ammo\') {\\n              playerUnit.ammo += 60;\\n            } else if (pk.kind === \'weapon\') {\\n              playerUnit.weaponName = pk.weaponName;\\n              playerUnit.ammo = 200;\\n            } else if (pk.kind === \'powerup\') {\\n              playerUnit.hp = playerUnit.maxHp;\\n              score += 120;\\n            }\\n            scene.remove(pk.mesh);\\n            worldPickups.splice(i, 1);\\n          }\\n        }\\n\\n        // Update Explosion Particles\\n        for (const ep of explosionParticles) {\\n          if (!ep.active) continue;\\n          ep.life += dt;\\n          if (ep.life >= ep.maxLife) {\\n            ep.active = false;\\n            ep.mesh.visible = false;\\n            continue;\\n          }\\n          ep.vel.y -= 14 * dt;\\n          ep.mesh.position.addScaledVector(ep.vel, dt);\\n          const alpha = 1 - ep.life / ep.maxLife;\\n          (ep.mesh.material as THREE.MeshBasicMaterial).opacity = alpha;\\n        }\\n      }\\n\\n      // 4. Critically-Damped Follow Camera (~22% Zoomed-Out + Scroll Wheel Zoom)\\n      const focusTarget: Vec3 =\\n        state === \'title\'\\n          ? { x: 2.0, y: 0.9, z: 13.0 }\\n          : mountedTank\\n          ? { x: mountedTank.x, y: 1.1, z: mountedTank.z }\\n          : { x: playerUnit.x, y: 1.0, z: playerUnit.z };\\n\\n      const springStep = stepCriticalDampedSpring3D(\\n        camFollowPos,\\n        focusTarget,\\n        camFollowVel,\\n        Math.max(8, activeSpeed),\\n        dt,\\n      );\\n      camFollowPos = springStep.position;\\n      camFollowVel = springStep.velocity;\\n\\n      const panAlpha = 1 - Math.exp(-REA_CONSTANTS.camera.mousePan.dampSpeed * dt);\\n      const panScale = state === \'title\' ? 0.3 : REA_CONSTANTS.camera.mousePan.sensitivity;\\n      mousePanCurrent.x += (mouseNdc.x * panScale - mousePanCurrent.x) * panAlpha;\\n      mousePanCurrent.z += (-mouseNdc.y * panScale - mousePanCurrent.z) * panAlpha;\\n\\n      recoilOffset.x *= Math.exp(-10 * dt);\\n      recoilOffset.z *= Math.exp(-10 * dt);\\n      shakeTrauma = Math.max(0, shakeTrauma - dt * 2.5);\\n      const shakeAmt = shakeTrauma * shakeTrauma * 0.35;\\n      const shakeX = (Math.random() - 0.5) * shakeAmt;\\n      const shakeZ = (Math.random() - 0.5) * shakeAmt;\\n\\n      const fovScale = cameraFovModeRef.current === \'roblox18\' ? 1.85 : 1.0;\\n      const zoomMult = state === \'title\' ? 1.0 : cameraZoom;\\n      const camOffset =\\n        state === \'title\'\\n          ? { x: -3.2, y: 11.2, z: 13.5 }\\n          : { x: 0, y: 16.5 * zoomMult, z: 13.8 * zoomMult };\\n\\n      const finalLookX = camFollowPos.x + mousePanCurrent.x + recoilOffset.x + shakeX;\\n      const finalLookZ = camFollowPos.z + mousePanCurrent.z + recoilOffset.z + shakeZ;\\n\\n      camera.position.set(\\n        finalLookX + camOffset.x * fovScale,\\n        camFollowPos.y + camOffset.y * fovScale,\\n        finalLookZ + camOffset.z * fovScale,\\n      );\\n      camera.lookAt(finalLookX, camFollowPos.y, finalLookZ);\\n\\n      dirLight.position.set(finalLookX + 14, 34, finalLookZ + 16);\\n      dirLight.target.position.set(finalLookX, 0, finalLookZ);\\n\\n      renderer.render(scene, camera);\\n\\n      // 5. Periodic HUD Snapshot Sync (including live Mini-Radar entity coordinates)\\n      hudSyncAccumulator += dt;\\n      if (hudSyncAccumulator >= 0.1) {\\n        hudSyncAccumulator = 0;\\n        onHudUpdate(buildHudSnapshot(null));\\n      }\\n    };\\n\\n    const buildHudSnapshot = (outcome: \'victory\' | \'defeat\' | null): HudSnapshot => {\\n      const padEval = evaluateStackingPadRecipe(bluePadSlots);\\n      const orderSpec = BUILD_ORDER_SPECS[buildOrder];\\n      const actorX = mountedTank ? mountedTank.x : playerUnit.x;\\n      const actorZ = mountedTank ? mountedTank.z : playerUnit.z;\\n\\n      let contextHint = `WASD Lari \302\267 [E] Ambil Peti \302\267 [Q] Pola ${buildOrder} \302\267 [V] Teropong AI`;\\n      if (mountedTank) {\\n        contextHint = `Mengendarai ${mountedTank.isSuper ? \'Tyrant Tank\' : \'Lyo Tank\'} (${mountedTank.storedCrates.length}/4 Peti) \302\267 [G] Turun`;\\n      } else if (playerUnit.carryingCrate !== \'none\') {\\n        contextHint = `Membawa Peti di Kepala \302\267 [E] Lempar ke Pad (${padEval.totalCrates}/${orderSpec.targetCrates})`;\\n      } else if (Math.hypot(actorX - blueBase.padX, actorZ - blueBase.padZ) <= 8.5 && padEval.totalCrates > 0) {\\n        contextHint = `Dekat Pad \302\267 [F] Rakit ${padEval.outputName}`;\\n      } else {\\n        for (const t of tanks) {\\n          if (!t.occupiedByPlayer && Math.hypot(t.x - actorX, t.z - actorZ) <= 5.5) {\\n            contextHint = \'Dekat Tank Lyo \302\267 [G] Naik ke Kubah Meriam\';\\n            break;\\n          }\\n        }\\n      }\\n\\n      // Build Mini-Radar dots from live 3D entities\\n      const radarDots: RadarDot[] = [];\\n      for (const c of worldCrates) {\\n        if (c.state === \'grounded\' || c.state === \'falling\') {\\n          radarDots.push({\\n            id: `c-${c.id}`,\\n            kind: c.kind === \'super\' ? \'crate_super\' : \'crate_red\',\\n            x: c.x,\\n            z: c.z,\\n          });\\n        }\\n      }\\n      for (const t of tanks) {\\n        if (t.hp > 0) {\\n          radarDots.push({\\n            id: `t-${t.id}`,\\n            kind: t.team === \'blue\' ? \'tank_blue\' : \'tank_red\',\\n            x: t.x,\\n            z: t.z,\\n          });\\n        }\\n      }\\n      for (const b of buddyUnits) {\\n        if (!b.alive) continue;\\n        radarDots.push({\\n          id: `b-${b.id}`,\\n          kind: b.isPlayer ? \'player\' : b.team === \'blue\' ? \'ally\' : \'enemy\',\\n          x: b.isPlayer && mountedTank ? mountedTank.x : b.x,\\n          z: b.isPlayer && mountedTank ? mountedTank.z : b.z,\\n        });\\n      }\\n\\n      return {\\n        hp: mountedTank ? mountedTank.hp : playerUnit.hp,\\n        maxHp: mountedTank ? mountedTank.maxHp : playerUnit.maxHp,\\n        score,\\n        bestScore: Math.max(bestScore, score),\\n        speedKmh: Math.round(\\n          Math.hypot(\\n            mountedTank ? mountedTank.vx : playerUnit.vx,\\n            mountedTank ? mountedTank.vz : playerUnit.vz,\\n          ) * 3.6,\\n        ),\\n        isBoosting: Boolean(keys[\'ShiftLeft\'] || keys[\'ShiftRight\']),\\n        isGrabMode: Boolean(mountedTank),\\n        grabbedPropName: mountedTank ? \'Lyo Tank\' : null,\\n        collectedItems: [\\n          padEval.totalCrates >= 1 ? \'GEAR\' : \'\',\\n          padEval.totalCrates >= 2 ? \'TOOLS\' : \'\',\\n          padEval.totalCrates >= 4 ? \'CIRCUIT\' : \'\',\\n          padEval.totalCrates >= 8 ? \'FUEL\' : \'\',\\n        ].filter(Boolean),\\n        powerCoreActivated: redBaseHp <= 0,\\n        enemiesDefeated,\\n        totalEnemies: 4,\\n        lightingPreset: lightingPresetRef.current,\\n        cameraFovMode: cameraFovModeRef.current,\\n        outcome,\\n        clearTimeSec: Math.round(runElapsedSec),\\n        controlMode: mountedTank ? \'tank\' : \'buddy\',\\n        activeClass: playerUnit.classId,\\n        equippedWeapon: mountedTank ? \'Meriam Tank 105mm\' : playerUnit.weaponName,\\n        ammo: playerUnit.ammo,\\n        carryingCrate: playerUnit.carryingCrate,\\n        tankStoredCrates: mountedTank ? mountedTank.storedCrates.length : 0,\\n        padSlots: [...bluePadSlots],\\n        padShape: padEval.shapeKey,\\n        padOutputName: padEval.outputName,\\n        padIsMerged: padEval.isMerged,\\n        padIsSuper: padEval.isSuper,\\n        buildOrder,\\n        buildOrderLabel: orderSpec.label,\\n        buildOrderTargetCrates: orderSpec.targetCrates,\\n        teamCommand,\\n        alliedBuddiesCount: buddyUnits.filter((b) => b.team === \'blue\' && b.alive).length,\\n        blueBaseHp,\\n        redBaseHp,\\n        contextHint,\\n        radarDots,\\n      };\\n    };\\n\\n    rafId = requestAnimationFrame(animate);\\n\\n    return () => {\\n      cancelAnimationFrame(rafId);\\n      window.removeEventListener(\'keydown\', onKeyDown);\\n      window.removeEventListener(\'keyup\', onKeyUp);\\n      window.removeEventListener(\'buddy-action\', onBuddyActionEvent);\\n      window.removeEventListener(\'pointerup\', onPointerUp);\\n      window.removeEventListener(\'resize\', onResize);\\n      renderer.domElement.removeEventListener(\'pointermove\', onPointerMove);\\n      renderer.domElement.removeEventListener(\'pointerdown\', onPointerDown);\\n      renderer.domElement.removeEventListener(\'wheel\', onWheel);\\n      renderer.domElement.removeEventListener(\'contextmenu\', onContextMenu);\\n      renderer.dispose();\\n    };\\n  }, [onGameOver, onHudUpdate, onTogglePause]);\\n\\n  return (\\n    <div\\n      ref={mountRef}\\n      className=\\\"fixed inset-0 w-screen h-screen overflow-hidden\\\"\\n      style={{ cursor: gameState === \'playing\' ? \'crosshair\' : \'default\' }}\\n    />\\n  );\\n};\\n\", \"StartLine\":580, \"TargetContent\":\"      // Merged Crates Wireframe Cage (visible when >= 2 crates are merged on the pad)\\n      const mergedCage = new THREE.Mesh(\\n        new THREE.BoxGeometry(3.85, 2.95, 3.85),\\n        new THREE.MeshBasicMaterial({ color: 0xb4ff39, wireframe: true, transparent: true, opacity: 0.7 }),\\n      );\\n      mergedCage.position.set(0, 1.65, 0);\\n      mergedCage.visible = false;\\n      padGroup.add(mergedCage);\\n\\n      // 8 Physical 3D Crate Slot Meshes on the Pad (slots 0..3 bottom layer, slots 4..7 top layer)\\n      const slotMeshes: THREE.Mesh[] = [];\\n      const slotGeo = new THREE.BoxGeometry(1.38, 1.38, 1.38);\\n      for (let i = 0; i < 8; i++) {\\n        const layer = i < 4 ? 0 : 1;\\n        const [tx, tz] = tileOffsets[i % 4];\\n        const m = addOutlinedPart(\\n          padGroup,\\n          slotGeo,\\n          matRedCrate,\\n          [tx, 0.92 + layer * 1.42, tz],\\n          [0, 0, 0],\\n          1.07,\\n          true,\\n        );\\n        m.visible = false;\\n        slotMeshes.push(m);\\n      }\\n\\n      const padSign = createBillboardSign(5.8, 1.42);\\n      padSign.sprite.position.set(0, 4.5, 0);\\n      padGroup.add(padSign.sprite);\\n\\n      return { baseGroup, hpSign, padGroup, padX, padZ, slotMeshes, mergedCage, padSign };\\n    };\\n\\n    const blueBase = buildBaseHqAndPad(\'blue\', 0, 22, -6.2, 16.5);\\n    const redBase = buildBaseHqAndPad(\'red\', 0, -22, 6.2, -16.5);\\n\\n    // =========================================================================\\n    // 6. DESTRUCTIBLE LYO STYLIZED TREES (BROWN TRUNK #8c4a27 + BLUE-PURPLE CANOPY #1d1f8c)\\n    // =========================================================================\\n    const trees: DestructibleTree[] = [];\\n    const treeCoords: [number, number][] = [\\n      [-11, 10],\\n      [11, 10],\\n      [-11, -10],\\n      [11, -10],\\n      [-19, 12],\\n      [19, 12],\\n      [-19, -12],\\n      [19, -12],\\n    ];\\n    treeCoords.forEach(([tx, tz], idx) => {\\n      const grp = new THREE.Group();\\n      grp.position.set(tx, 0, tz);\\n      const shadow = new THREE.Mesh(shadowDiscGeo, shadowDiscMat);\\n      shadow.position.y = 0.02;\\n      shadow.scale.setScalar(1.35);\\n      grp.add(shadow);\\n\\n      addOutlinedPart(grp, new THREE.CylinderGeometry(0.42, 0.56, 2.3, 10), matTreeTrunk, [0, 1.15, 0]);\\n      addOutlinedPart(grp, new THREE.SphereGeometry(1.65, 14, 12), matTreeCanopy, [0, 3.05, 0]);\\n      scene.add(grp);\\n\\n      trees.push({\\n        id: idx + 1,\\n        mesh: grp,\\n        x: tx,\\n        z: tz,\\n        hp: 45,\\n        maxHp: 45,\\n        alive: true,\\n        hitFlashTimer: 0,\\n      });\\n    });\\n\\n    // =========================================================================\\n    // 7. BUILDER FOR CHIBI/BLOCKY TEAM BUDDIES CHARACTERS & OPEN-TOP LYO TANKS\\n    // =========================================================================\\n    let nextEntityId = 1;\\n\\n    const createBuddyCharacterUnit = (\\n      team: \'blue\' | \'red\',\\n      isPlayer: boolean,\\n      classId: BuddyClassId,\\n      spawnX: number,\\n      spawnZ: number,\\n    ): BuddyUnit => {\\n      const spec = BUDDY_CLASSES[classId];\\n      const root = new THREE.Group();\\n      root.position.set(spawnX, 0, spawnZ);\\n      scene.add(root);\\n\\n      const shadow = new THREE.Mesh(shadowDiscGeo, shadowDiscMat);\\n      shadow.position.y = 0.02;\\n      shadow.scale.setScalar(0.8);\\n      root.add(shadow);\\n\\n      const ringMat = new THREE.MeshBasicMaterial({\\n        color: isPlayer ? 0xb4ff39 : team === \'blue\' ? 0x2979ff : 0xff3b30,\\n      });\\n      const teamRing = new THREE.Mesh(new THREE.RingGeometry(0.68, 0.92, 24), ringMat);\\n      teamRing.rotation.x = -Math.PI / 2;\\n      teamRing.position.y = 0.04;\\n      root.add(teamRing);\\n\\n      const bodyGroup = new THREE.Group();\\n      root.add(bodyGroup);\\n\\n      const torsoMat = makeToonMat(team === \'blue\' ? spec.colorHex : \'#ff3b30\');\\n      const teamTrimMat = team === \'blue\' ? matBlueTeam : matRedTeam;\\n\\n      // Blocky Chibi Torso\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(0.86, 0.88, 0.54), torsoMat, [0, 1.02, 0]);\\n      // Backpack / Class Pack\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(0.56, 0.56, 0.28), teamTrimMat, [0, 1.05, -0.36]);\\n\\n      // Chibi Head (1.2x scale) + Bandana/Helmet\\n      const headMesh = addOutlinedPart(bodyGroup, new THREE.BoxGeometry(0.76, 0.72, 0.74), matSkin, [0, 1.84, 0]);\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(0.82, 0.24, 0.8), teamTrimMat, [0, 2.12, 0]);\\n\\n      // Left & Right Animated Arms\\n      const leftArmPivot = new THREE.Group();\\n      leftArmPivot.position.set(-0.62, 1.36, 0);\\n      bodyGroup.add(leftArmPivot);\\n      addOutlinedPart(leftArmPivot, new THREE.BoxGeometry(0.32, 0.72, 0.32), matSkin, [0, -0.28, 0]);\\n\\n      const rightArmPivot = new THREE.Group();\\n      rightArmPivot.position.set(0.62, 1.36, 0);\\n      bodyGroup.add(rightArmPivot);\\n      addOutlinedPart(rightArmPivot, new THREE.BoxGeometry(0.32, 0.72, 0.32), matSkin, [0, -0.28, 0]);\\n\\n      // 3D Weapon Mesh in Right Hand\\n      const weaponMesh = addOutlinedPart(\\n        rightArmPivot,\\n        new THREE.BoxGeometry(0.24, 0.28, 0.95),\\n        matGunmetal,\\n        [0, -0.52, 0.42],\\n      );\\n\\n      // Left & Right Animated Legs\\n      const leftLegPivot = new THREE.Group();\\n      leftLegPivot.position.set(-0.24, 0.58, 0);\\n      bodyGroup.add(leftLegPivot);\\n      addOutlinedPart(leftLegPivot, new THREE.BoxGeometry(0.34, 0.58, 0.36), matDarkSteel, [0, -0.28, 0]);\\n\\n      const rightLegPivot = new THREE.Group();\\n      rightLegPivot.position.set(0.24, 0.58, 0);\\n      bodyGroup.add(rightLegPivot);\\n      addOutlinedPart(rightLegPivot, new THREE.BoxGeometry(0.34, 0.58, 0.36), matDarkSteel, [0, -0.28, 0]);\\n\\n      // Overhead Carried 3D Crate (visible when carrying a crate above the head!)\\n      const overheadCrateGroup = new THREE.Group();\\n      overheadCrateGroup.position.set(0, 2.82, 0);\\n      overheadCrateGroup.visible = false;\\n      bodyGroup.add(overheadCrateGroup);\\n      const overheadCrateBox = addOutlinedPart(\\n        overheadCrateGroup,\\n        new THREE.BoxGeometry(1.18, 1.18, 1.18),\\n        matRedCrate,\\n        [0, 0, 0],\\n      );\\n\\n      return {\\n        id: nextEntityId++,\\n        team,\\n        isPlayer,\\n        classId,\\n        root,\\n        bodyGroup,\\n        headMesh,\\n        leftArmPivot,\\n        rightArmPivot,\\n        leftLegPivot,\\n        rightLegPivot,\\n        weaponMesh,\\n        overheadCrateGroup,\\n        overheadCrateBox,\\n        teamRing,\\n        x: spawnX,\\n        y: 0,\\n        z: spawnZ,\\n        vx: 0,\\n        vz: 0,\\n        yaw: team === \'blue\' ? Math.PI : 0,\\n        hp: 30,\\n        maxHp: 30,\\n        weaponName: classId === \'Ninja\' ? \'Katana\' : classId === \'SuperBuddie\' ? \'Laser Eyes\' : \'Uzi\',\\n        ammo: 120,\\n        carryingCrate: \'none\',\\n        walkCycle: 0,\\n        shootCooldown: 0,\\n        hitFlashTimer: 0,\\n        isFrozen: false,\\n        frozenTimer: 0,\\n        aiTargetCrateId: null,\\n        alive: true,\\n        respawnTimer: 0,\\n      };\\n    };\\n\\n    const createLyoTankVehicle = (spawnX: number, spawnZ: number, isSuper: boolean, team: \'blue\' | \'red\'): TankVehicle => {\\n      const root = new THREE.Group();\\n      root.position.set(spawnX, 0, spawnZ);\\n      scene.add(root);\\n\\n      const shadow = new THREE.Mesh(shadowDiscGeo, shadowDiscMat);\\n      shadow.position.y = 0.02;\\n      shadow.scale.set(1.5, 1.3, 1);\\n      root.add(shadow);\\n\\n      const bodyGroup = new THREE.Group();\\n      root.add(bodyGroup);\\n\\n      const primaryMat = isSuper ? matTankSuper : matTankLime;\\n      const highlightMat = isSuper ? matBlueTeam : matTankHighlight;\\n\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(2.35, 0.72, 1.65), primaryMat, [0, 0.58, 0]);\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(1.85, 0.34, 1.38), highlightMat, [0.1, 0.98, 0]);\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(2.65, 0.56, 0.38), matDarkSteel, [0, 0.36, -0.92]);\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(2.65, 0.56, 0.38), matDarkSteel, [0, 0.36, 0.92]);\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(2.75, 0.14, 0.46), primaryMat, [0, 0.68, -0.92]);\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(2.75, 0.14, 0.46), primaryMat, [0, 0.68, 0.92]);\\n      addOutlinedPart(bodyGroup, new THREE.BoxGeometry(0.28, 0.44, 1.15), matYellow, [-1.18, 0.64, 0]);\\n\\n      const turretGroup = new THREE.Group();\\n      turretGroup.position.set(-0.05, 1.15, 0);\\n      bodyGroup.add(turretGroup);\\n\\n      addOutlinedPart(turretGroup, new THREE.BoxGeometry(1.36, 0.58, 1.28), primaryMat, [0, 0.25, 0]);\\n      // Open-Top Hatch Rim\\n      addOutlinedPart(turretGroup, new THREE.CylinderGeometry(0.4, 0.44, 0.18, 12), matDarkSteel, [-0.12, 0.58, 0]);\\n\\n      // Open-Top Rider Mesh (Visible ONLY when a Buddy is mounted inside the Tank!)\\n      const riderGroup = new THREE.Group();\\n      riderGroup.visible = false;\\n      turretGroup.add(riderGroup);\\n      addOutlinedPart(riderGroup, new THREE.BoxGeometry(0.48, 0.38, 0.44), matBlueTeam, [-0.12, 0.8, 0]);\\n      addOutlinedPart(riderGroup, new THREE.BoxGeometry(0.56, 0.54, 0.54), matSkin, [-0.12, 1.18, 0]);\\n      addOutlinedPart(riderGroup, new THREE.BoxGeometry(0.62, 0.2, 0.6), matYellow, [-0.12, 1.42, 0]);\\n\\n      const barrelGroup = new THREE.Group();\\n      barrelGroup.position.set(0.65, 0.26, 0);\\n      turretGroup.add(barrelGroup);\\n\\n      if (isSuper) {\\n        // Super Tyrant Tank has Dual Cannons!\\n        addOutlinedPart(barrelGroup, new THREE.CylinderGeometry(0.12, 0.14, 1.5, 10), matGunmetal, [0.65, 0, -0.26], [0, 0, -Math.PI / 2]);\\n        addOutlinedPart(barrelGroup, new THREE.CylinderGeometry(0.12, 0.14, 1.5, 10), matGunmetal, [0.65, 0, 0.26], [0, 0, -Math.PI / 2]);\\n        addOutlinedPart(barrelGroup, new THREE.CylinderGeometry(0.19, 0.19, 0.28, 10), matYellow, [1.38, 0, -0.26], [0, 0, -Math.PI / 2]);\\n        addOutlinedPart(barrelGroup, new THREE.CylinderGeometry(0.19, 0.19, 0.28, 10), matYellow, [1.38, 0, 0.26], [0, 0, -Math.PI / 2]);\\n      } else {\\n        addOutlinedPart(barrelGroup, new THREE.CylinderGeometry(0.14, 0.16, 1.45, 12), matGunmetal, [0.65, 0, 0], [0, 0, -Math.PI / 2]);\\n        addOutlinedPart(barrelGroup, new THREE.CylinderGeometry(0.22, 0.22, 0.28, 12), matYellow, [1.38, 0, 0], [0, 0, -Math.PI / 2]);\\n      }\\n\\n      const muzzleFlash = new THREE.Mesh(\\n        new THREE.SphereGeometry(0.42, 10, 10),\\n        new THREE.MeshBasicMaterial({ color: 0xb8ff3c }),\\n      );\\n      muzzleFlash.position.set(1.62, 0, 0);\\n      muzzleFlash.visible = false;\\n      barrelGroup.add(muzzleFlash);\\n\\n      return {\\n        id: nextEntityId++,\\n        isSuper,\\n        team,\\n        root,\\n        bodyGroup,\\n        turretGroup,\\n        barrelGroup,\\n        riderGroup,\\n        muzzleFlash,\\n        x: spawnX,\\n        z: spawnZ,\\n        vx: 0,\\n        vz: 0,\\n        hullYaw: -Math.PI / 2,\\n        turretYaw: -Math.PI / 2,\\n        currentDriveSpeed: REA_CONSTANTS.physics.drive.speed,\\n        recoilTimer: 0,\\n        hp: isSuper ? 60 : 40,\\n        maxHp: isSuper ? 60 : 40,\\n        storedCrates: [],\\n        occupiedByPlayer: false,\\n      };\\n    };\\n\\n    // =========================================================================\\n    // 8. WORLD STATE: CRATES, PICKUPS, BUDDIES, TANKS, BASE HP & STACKING PADS\\n    // =========================================================================\\n    const worldCrates: WorldCrate[] = [];\\n    const worldPickups: WorldPickup[] = [];\\n    const buddyUnits: BuddyUnit[] = [];\\n    const tanks: TankVehicle[] = [];\\n\\n    let bluePadSlots: CrateSlotType[] = [\'red\', \'empty\', \'empty\', \'empty\', \'super\', \'empty\', \'empty\', \'empty\'];\\n    let redPadSlots: CrateSlotType[] = [\'red\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'];\\n    let buildOrder: BuildOrderTarget = \'AUTO\';\\n    let teamCommand: TeamCommandMode = \'HARVEST\';\\n    let blueBaseHp = 2000;\\n    let redBaseHp = 2000;\\n    let score = 0;\\n    let bestScore = 0;\\n    let enemiesDefeated = 0;\\n    let blueBuddyClassIdx = 0;\\n    let mountedTank: TankVehicle | null = null;\\n    let crateSpawnTimer = 0;\\n    let superCrateSpawnTimer = 0;\\n    let redCraftTimer = 0;\\n\\n    const syncPadVisuals = (\\n      baseObj: ReturnType<typeof buildBaseHqAndPad>,\\n      slots: CrateSlotType[],\\n      teamLabel: string,\\n      hp: number,\\n    ) => {\\n      const ev = evaluateStackingPadRecipe(slots);\\n      for (let i = 0; i < 8; i++) {\\n        const s = slots[i];\\n        const mesh = baseObj.slotMeshes[i];\\n        if (s === \'empty\') {\\n          mesh.visible = false;\\n        } else {\\n          mesh.visible = true;\\n          mesh.material = s === \'super\' ? matSuperCrate : matRedCrate;\\n        }\\n      }\\n      baseObj.mergedCage.visible = ev.isMerged;\\n      baseObj.padSign.updateText(\\n        ev.totalCrates === 0 ? \'STACKING PAD 2x2x2\' : `${ev.shapeKey}: ${ev.outputName.toUpperCase()}`,\\n        ev.totalCrates === 0\\n          ? \'LEMPAR PETI [E] KE SINI\'\\n          : `[F] RAKIT (${ev.totalCrates}/8 PETI${ev.isMerged ? \' \302\267 MERGED\' : \'\'})`,\\n        ev.isSuper ? \'#00d2ff\' : \'#b4ff39\',\\n        ev.totalCrates / 8,\\n      );\\n      baseObj.hpSign.updateText(\\n        `${teamLabel} HQ`,\\n        `${hp} / 2000 HP`,\\n        teamLabel === \'BLUE\' ? \'#00d2ff\' : \'#ff3b30\',\\n        hp / 2000,\\n      );\\n    };\\n\\n    const spawnWorldCrate = (kind: \'red\' | \'super\', x: number, z: number, startGrounded = false) => {\\n      if (worldCrates.length >= 22) return;\\n      const g = new THREE.Group();\\n      const startY = startGrounded ? 0.65 : 16 + Math.random() * 4;\\n      g.position.set(x, startY, z);\\n      scene.add(g);\\n\\n      addOutlinedPart(\\n        g,\\n        new THREE.BoxGeometry(1.25, 1.25, 1.25),\\n        kind === \'super\' ? matSuperCrate : matRedCrate,\\n        [0, 0, 0],\\n      );\\n      // White Parachute dome while falling\\n      const chuteGeo = new THREE.SphereGeometry(1.15, 12, 8, 0, Math.PI * 2, 0, Math.PI / 2);\\n      const parachuteMesh = new THREE.Mesh(chuteGeo, matWhite);\\n      parachuteMesh.position.set(0, 1.6, 0);\\n      parachuteMesh.visible = !startGrounded;\\n      g.add(parachuteMesh);\\n\\n      worldCrates.push({\\n        id: nextEntityId++,\\n        kind,\\n        mesh: g,\\n        parachuteMesh,\\n        x,\\n        y: startY,\\n        z,\\n        vx: 0,\\n        vy: 0,\\n        vz: 0,\\n        state: startGrounded ? \'grounded\' : \'falling\',\\n        carrierId: null,\\n        squashTimer: startGrounded ? 0.25 : 0,\\n      });\\n    };\\n\\n    const spawnWorldPickup = (\\n      kind: WorldPickup[\'kind\'],\\n      weaponName: string,\\n      x: number,\\n      z: number,\\n    ) => {\\n      const g = new THREE.Group();\\n      g.position.set(x, 0.75, z);\\n      scene.add(g);\\n\\n      if (kind === \'health\') {\\n        addOutlinedPart(g, new THREE.OctahedronGeometry(0.55, 0), matRedCrate, [0, 0, 0]);\\n      } else if (kind === \'ammo\') {\\n        addOutlinedPart(g, new THREE.BoxGeometry(0.75, 0.55, 0.55), matYellow, [0, 0, 0]);\\n      } else if (kind === \'powerup\') {\\n        addOutlinedPart(g, new THREE.IcosahedronGeometry(0.62, 0), matTankHighlight, [0, 0, 0]);\\n      } else {\\n        // 3D Crafted Weapon Pickup on a glowing pedestal\\n        addOutlinedPart(g, new THREE.CylinderGeometry(0.7, 0.8, 0.16, 12), matYellow, [0, -0.55, 0]);\\n        addOutlinedPart(g, new THREE.BoxGeometry(0.36, 0.38, 1.25), matSuperCrate, [0, 0.1, 0]);\\n      }\\n\\n      worldPickups.push({\\n        id: nextEntityId++,\\n        kind,\\n        weaponName,\\n        mesh: g,\\n        x,\\n        z,\\n        bobPhase: Math.random() * Math.PI * 2,\\n        collected: false,\\n      });\\n    };\\n\\n    // Player Buddy + Initial Allied & Enemy AI Buddies + Parked Lyo Tank\\n    let playerUnit = createBuddyCharacterUnit(\'blue\', true, \'Infuntry\', 0, 11.5);\\n    buddyUnits.push(playerUnit);\\n\\n    const spawnInitialSquadsAndObjects = () => {\\n      // Clear any old dynamic meshes\\n      worldCrates.forEach((c) => scene.remove(c.mesh));\\n      worldCrates.length = 0;\\n      worldPickups.forEach((p) => scene.remove(p.mesh));\\n      worldPickups.length = 0;\\n      buddyUnits.forEach((b) => scene.remove(b.root));\\n      buddyUnits.length = 0;\\n      tanks.forEach((t) => scene.remove(t.root));\\n      tanks.length = 0;\\n\\n      bluePadSlots = [\'red\', \'empty\', \'empty\', \'empty\', \'super\', \'empty\', \'empty\', \'empty\'];\\n      redPadSlots = [\'red\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'];\\n      blueBaseHp = 2000;\\n      redBaseHp = 2000;\\n      score = 0;\\n      enemiesDefeated = 0;\\n      mountedTank = null;\\n\\n      // 1. Main Player Character (Blocky Chibi Buddy)\\n      playerUnit = createBuddyCharacterUnit(\'blue\', true, \'Infuntry\', 0, 11.5);\\n      buddyUnits.push(playerUnit);\\n\\n      // 2. One Allied Blue AI Buddy (Harvester/Fighter)\\n      buddyUnits.push(createBuddyCharacterUnit(\'blue\', false, \'Ninja\', -4.2, 13.5));\\n\\n      // 3. Three Red Team AI Buddies (Harvesting crates & attacking Blue Team)\\n      buddyUnits.push(createBuddyCharacterUnit(\'red\', false, \'Infuntry\', -3.5, -13.5));\\n      buddyUnits.push(createBuddyCharacterUnit(\'red\', false, \'Commando\', 3.5, -13.5));\\n      buddyUnits.push(createBuddyCharacterUnit(\'red\', false, \'Cyborg\', 0, -15.5));\\n\\n      // 4. One Parked Open-Top Lyo Tank near Blue Base (ready to Mount with [G], plus more can be crafted from 8 crates!)\\n      tanks.push(createLyoTankVehicle(4.2, 13.2, false, \'blue\'));\\n\\n      // 5. Initial Red Crates & Blue Super Crates in the Drop Zones & near Blue Base\\n      spawnWorldCrate(\'red\', -1.5, 10.2, true);\\n      spawnWorldCrate(\'super\', 1.8, 9.6, true);\\n      spawnWorldCrate(\'red\', -2.5, 1.5, true);\\n      spawnWorldCrate(\'red\', 2.5, -1.5, true);\\n      spawnWorldCrate(\'red\', 0, 0, false);\\n      spawnWorldCrate(\'super\', -15.5, 0, false);\\n      spawnWorldCrate(\'super\', 15.5, 0, false);\\n\\n      trees.forEach((t) => {\\n        t.alive = true;\\n        t.hp = t.maxHp;\\n        t.mesh.visible = true;\\n      });\\n\\n      syncPadVisuals(blueBase, bluePadSlots, \'BLUE\', blueBaseHp);\\n      syncPadVisuals(redBase, redPadSlots, \'RED\', redBaseHp);\\n    };\\n\\n    spawnInitialSquadsAndObjects();\\n\\n    // =========================================================================\\n    // 9. PROJECTILE & EXPLOSION PARTICLE POOLS\\n    // =========================================================================\\n    const projectiles: Projectile[] = [];\\n    const projGeo = new THREE.SphereGeometry(0.24, 8, 8);\\n    const playerProjMat = new THREE.MeshBasicMaterial({ color: 0xb8ff3c });\\n    const iceProjMat = new THREE.MeshBasicMaterial({ color: 0x00d2ff });\\n    const enemyProjMat = new THREE.MeshBasicMaterial({ color: 0xff3b30 });\\n\\n    for (let i = 0; i < 40; i++) {\\n      const m = new THREE.Mesh(projGeo, playerProjMat);\\n      m.visible = false;\\n      scene.add(m);\\n      projectiles.push({\\n        active: false,\\n        isPlayerTeam: true,\\n        weaponType: \'Uzi\',\\n        mesh: m,\\n        pos: new THREE.Vector3(),\\n        vel: new THREE.Vector3(),\\n        life: 0,\\n        damage: 8,\\n      });\\n    }\\n\\n    const fireProjectile = (\\n      isPlayerTeam: boolean,\\n      weaponType: string,\\n      origin: THREE.Vector3,\\n      dir: THREE.Vector3,\\n      speed: number,\\n      damage: number,\\n    ) => {\\n      const slot = projectiles.find((p) => !p.active);\\n      if (!slot) return;\\n      slot.active = true;\\n      slot.isPlayerTeam = isPlayerTeam;\\n      slot.weaponType = weaponType;\\n      slot.pos.copy(origin);\\n      slot.vel.copy(dir).normalize().multiplyScalar(speed);\\n      slot.life = 1.25;\\n      slot.damage = damage;\\n      slot.mesh.material = !isPlayerTeam\\n        ? enemyProjMat\\n        : weaponType === \'Ice Gun\'\\n        ? iceProjMat\\n        : playerProjMat;\\n      slot.mesh.scale.setScalar(weaponType === \'TankCannon\' || weaponType === \'Bazooka\' || weaponType === \'Supazooka\' ? 1.75 : 1.0);\\n      slot.mesh.position.copy(origin);\\n      slot.mesh.visible = true;\\n    };\\n\\n    const explosionParticles: ExplosionParticle[] = [];\\n    const expGeo = new THREE.SphereGeometry(0.32, 8, 8);\\n    for (let i = 0; i < 48; i++) {\\n      const mat = new THREE.MeshBasicMaterial({\\n        color: i % 2 === 0 ? 0xfec83e : 0xb4ff39,\\n        transparent: true,\\n        opacity: 1,\\n      });\\n      const m = new THREE.Mesh(expGeo, mat);\\n      m.visible = false;\\n      scene.add(m);\\n      explosionParticles.push({\\n        active: false,\\n        mesh: m,\\n        vel: new THREE.Vector3(),\\n        life: 0,\\n        maxLife: 0.45,\\n      });\\n    }\\n\\n    const spawnBurstParticles = (x: number, y: number, z: number, count = 12) => {\\n      let spawned = 0;\\n      for (const ep of explosionParticles) {\\n        if (!ep.active && spawned < count) {\\n          ep.active = true;\\n          ep.life = 0;\\n          ep.maxLife = 0.35 + Math.random() * 0.25;\\n          ep.mesh.position.set(x, y, z);\\n          ep.mesh.scale.setScalar(0.7 + Math.random() * 0.8);\\n          ep.mesh.visible = true;\\n          const angle = Math.random() * Math.PI * 2;\\n          const spd = 3 + Math.random() * 7;\\n          ep.vel.set(Math.cos(angle) * spd, 4 + Math.random() * 6, Math.sin(angle) * spd);\\n          spawned++;\\n        }\\n      }\\n    };\\n\\n    // =========================================================================\\n    // 10. INTERACTION HANDLERS:\\n    //     [E] PICKUP / THROW CRATE TO 2x2x2 PAD\\n    //     [F] KICK OPEN CRATE OR CRAFT STACKING PAD (WEAPON / AI BUDDY / LYO TANK)\\n    //     [G] MOUNT / DISMOUNT OPEN-TOP LYO TANK\\n    //     [Q] CYCLE BUILD ORDER \302\267 [V] SQUAD COMMAND \302\267 [TAB] BUDDY SWAP\\n    // =========================================================================\\n    const addCrateToPadSlots = (team: \'blue\' | \'red\', kind: \'red\' | \'super\'): boolean => {\\n      const slots = team === \'blue\' ? bluePadSlots : redPadSlots;\\n      const nextIdx = chooseNextPadSlotIndex(slots, team === \'blue\' ? buildOrder : \'AUTO\');\\n      if (nextIdx === -1) return false;\\n      slots[nextIdx] = kind;\\n      if (team === \'blue\') {\\n        syncPadVisuals(blueBase, bluePadSlots, \'BLUE\', blueBaseHp);\\n      } else {\\n        syncPadVisuals(redBase, redPadSlots, \'RED\', redBaseHp);\\n      }\\n      return true;\\n    };\\n\\n    const handlePlayerPickupOrThrowCrate = () => {\\n      if (mountedTank) {\\n        // Pressing E while in a tank also unloads stored crates if near pad, or dismounts\\n        if (mountedTank.storedCrates.length > 0) {\\n          const distToPad = Math.hypot(mountedTank.x - blueBase.padX, mountedTank.z - blueBase.padZ);\\n          if (distToPad <= 9.0) {\\n            while (mountedTank.storedCrates.length > 0) {\\n              const cKind = mountedTank.storedCrates.shift()!;\\n              addCrateToPadSlots(\'blue\', cKind);\\n            }\\n            soundEngine.playPickup();\\n            return;\\n          }\\n        }\\n        return;\\n      }\\n\\n      if (!playerUnit.alive) return;\\n\\n      // Case A: Already carrying a crate above head -> Throw it toward Stacking Pad or forward!\\n      if (playerUnit.carryingCrate !== \'none\') {\\n        const carriedKind = playerUnit.carryingCrate;\\n        playerUnit.carryingCrate = \'none\';\\n        playerUnit.overheadCrateGroup.visible = false;\\n        soundEngine.playShoot();\\n\\n        const distToBluePad = Math.hypot(playerUnit.x - blueBase.padX, playerUnit.z - blueBase.padZ);\\n        if (distToBluePad <= 10.5) {\\n          if (addCrateToPadSlots(\'blue\', carriedKind)) {\\n            score += carriedKind === \'super\' ? 60 : 30;\\n            spawnBurstParticles(blueBase.padX, 1.8, blueBase.padZ, 10);\\n            soundEngine.playPickup();\\n            return;\\n          }\\n        }\\n\\n        // Otherwise throw crate forward in a parabolic arc onto the ground\\n        const throwX = clamp(playerUnit.x + Math.cos(playerUnit.yaw) * 3.8, -36, 36);\\n        const throwZ = clamp(playerUnit.z - Math.sin(playerUnit.yaw) * 3.8, -36, 36);\\n        const dPadFromLand = Math.hypot(throwX - blueBase.padX, throwZ - blueBase.padZ);\\n        if (dPadFromLand <= 6.5 && addCrateToPadSlots(\'blue\', carriedKind)) {\\n          score += carriedKind === \'super\' ? 60 : 30;\\n          spawnBurstParticles(blueBase.padX, 1.8, blueBase.padZ, 10);\\n          soundEngine.playPickup();\\n          return;\\n        }\\n        spawnWorldCrate(carriedKind, throwX, throwZ, true);\\n        return;\\n      }\\n\\n      // Case B: Not carrying -> Find nearest grounded crate within 5.5m and lift it overhead!\\n      let nearestCrate: WorldCrate | null = null;\\n      let bestDist = 5.5;\\n      for (const c of worldCrates) {\\n        if (c.state === \'grounded\' || c.state === \'falling\') {\\n          const d = Math.hypot(c.x - playerUnit.x, c.z - playerUnit.z);\\n          if (d < bestDist) {\\n            bestDist = d;\\n            nearestCrate = c;\\n          }\\n        }\\n      }\\n\\n      if (nearestCrate) {\\n        playerUnit.carryingCrate = nearestCrate.kind;\\n        playerUnit.overheadCrateBox.material =\\n          nearestCrate.kind === \'super\' ? matSuperCrate : matRedCrate;\\n        playerUnit.overheadCrateGroup.visible = true;\\n        scene.remove(nearestCrate.mesh);\\n        const idx = worldCrates.indexOf(nearestCrate);\\n        if (idx !== -1) worldCrates.splice(idx, 1);\\n        soundEngine.playPickup();\\n      }\\n    };\\n\\n    const handlePlayerKickOrCraft = () => {\\n      const actorX = mountedTank ? mountedTank.x : playerUnit.x;\\n      const actorZ = mountedTank ? mountedTank.z : playerUnit.z;\\n\\n      // 1. Check if near Blue Team Stacking Pad (within 9.5m) and pad has crates\\n      const distToPad = Math.hypot(actorX - blueBase.padX, actorZ - blueBase.padZ);\\n      const padEval = evaluateStackingPadRecipe(bluePadSlots);\\n\\n      if (distToPad <= 9.5 && padEval.totalCrates > 0) {\\n        soundEngine.playPowerCore();\\n        spawnBurstParticles(blueBase.padX, 2.0, blueBase.padZ, 18);\\n\\n        const spawnX = blueBase.padX + 3.6;\\n        const spawnZ = blueBase.padZ - 1.5;\\n\\n        if (padEval.spawnType === \'tank\') {\\n          // 8 Crates (2x2x2) -> Spawn 3D Lyo Tank or Super Tyrant Tank!\\n          const newTank = createLyoTankVehicle(spawnX, spawnZ, padEval.isSuper, \'blue\');\\n          tanks.push(newTank);\\n          score += padEval.isSuper ? 500 : 350;\\n        } else if (padEval.spawnType === \'buddy\') {\\n          // 2 Vertical (1x1x2) or 4 Vertical (2x1x2) -> Spawn 3D Allied AI Buddy!\\n          let chosenClass: BuddyClassId = BLUE_BUDDY_ROTATION[blueBuddyClassIdx % BLUE_BUDDY_ROTATION.length];\\n          blueBuddyClassIdx++;\\n          if (padEval.category === \'buddy_t2\') {\\n            chosenClass = padEval.isSuper ? \'SuperBuddie\' : \'Cyborg\';\\n          } else if (padEval.isSuper) {\\n            chosenClass = \'Stealthy\';\\n          }\\n          const newBuddy = createBuddyCharacterUnit(\\n            \'blue\',\\n            false,\\n            chosenClass,\\n            spawnX + (Math.random() - 0.5) * 2,\\n            spawnZ + (Math.random() - 0.5) * 2,\\n          );\\n          buddyUnits.push(newBuddy);\\n          score += 220;\\n        } else {\\n          // 1x1x1, 2x1x1, or 2x2x1 -> Spawn 3D Weapon Pickup & also auto-equip player!\\n          const wName = padEval.outputName;\\n          spawnWorldPickup(\'weapon\', wName, spawnX, spawnZ);\\n          playerUnit.weaponName = wName;\\n          playerUnit.ammo = 200;\\n          score += 140;\\n        }\\n\\n        bluePadSlots = [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'];\\n        syncPadVisuals(blueBase, bluePadSlots, \'BLUE\', blueBaseHp);\\n        return;\\n      }\\n\\n      // 2. Otherwise if near a loose crate outside the Pad -> Kick it open into Health + Ammo!\\n      let nearestCrate: WorldCrate | null = null;\\n      let bestDist = 4.8;\\n      for (const c of worldCrates) {\\n        if (c.state === \'grounded\') {\\n          const d = Math.hypot(c.x - actorX, c.z - actorZ);\\n          if (d < bestDist) {\\n            bestDist = d;\\n            nearestCrate = c;\\n          }\\n        }\\n      }\\n\\n      if (nearestCrate) {\\n        soundEngine.playHit();\\n        spawnBurstParticles(nearestCrate.x, 0.9, nearestCrate.z, 10);\\n        spawnWorldPickup(\'health\', \'Health +25\', nearestCrate.x - 0.9, nearestCrate.z);\\n        spawnWorldPickup(\'ammo\', \'Ammo +50\', nearestCrate.x + 0.9, nearestCrate.z);\\n        scene.remove(nearestCrate.mesh);\\n        const idx = worldCrates.indexOf(nearestCrate);\\n        if (idx !== -1) worldCrates.splice(idx, 1);\\n      }\\n    };\\n\\n    const handleToggleMountTank = () => {\\n      // Dismount if currently riding a Tank\\n      if (mountedTank) {\\n        soundEngine.playUiClick();\\n        mountedTank.occupiedByPlayer = false;\\n        mountedTank.riderGroup.visible = false;\\n        playerUnit.x = clamp(mountedTank.x - 2.6, -38, 38);\\n        playerUnit.z = clamp(mountedTank.z + 1.2, -38, 38);\\n        playerUnit.root.position.set(playerUnit.x, 0, playerUnit.z);\\n        playerUnit.root.visible = true;\\n        mountedTank = null;\\n        return;\\n      }\\n\\n      // Otherwise check if near any unoccupied Tank within 6.5m -> Mount into Open-Top Turret!\\n      if (!playerUnit.alive) return;\\n      let nearestTank: TankVehicle | null = null;\\n      let bestDist = 6.5;\\n      for (const t of tanks) {\\n        if (!t.occupiedByPlayer && t.hp > 0) {\\n          const d = Math.hypot(t.x - playerUnit.x, t.z - playerUnit.z);\\n          if (d < bestDist) {\\n            bestDist = d;\\n            nearestTank = t;\\n          }\\n        }\\n      }\\n\\n      if (nearestTank) {\\n        soundEngine.playPickup();\\n        // If player was carrying a crate, store it inside the tank!\\n        if (playerUnit.carryingCrate !== \'none\' && nearestTank.storedCrates.length < 4) {\\n          nearestTank.storedCrates.push(playerUnit.carryingCrate);\\n          playerUnit.carryingCrate = \'none\';\\n          playerUnit.overheadCrateGroup.visible = false;\\n        }\\n        mountedTank = nearestTank;\\n        nearestTank.occupiedByPlayer = true;\\n        nearestTank.riderGroup.visible = true;\\n        playerUnit.root.visible = false;\\n      }\\n    };\\n\\n    const handleCycleBuildOrder = () => {\\n      soundEngine.playUiClick();\\n      const idx = BUILD_ORDER_CYCLE.indexOf(buildOrder);\\n      buildOrder = BUILD_ORDER_CYCLE[(idx + 1) % BUILD_ORDER_CYCLE.length];\\n    };\\n\\n    const handleCycleTeamCommand = () => {\\n      soundEngine.playUiClick();\\n      const idx = COMMAND_CYCLE.indexOf(teamCommand);\\n      teamCommand = COMMAND_CYCLE[(idx + 1) % COMMAND_CYCLE.length];\\n    };\\n\\n    const handleSwapBuddy = () => {\\n      if (mountedTank) return;\\n      const alliedPool = buddyUnits.filter((b) => b.team === \'blue\' && b.alive);\\n      if (alliedPool.length <= 1) return;\\n      soundEngine.playUiClick();\\n      const currentIdx = alliedPool.indexOf(playerUnit);\\n      const nextBuddy = alliedPool[(currentIdx + 1) % alliedPool.length];\\n      playerUnit.isPlayer = false;\\n      (playerUnit.teamRing.material as THREE.MeshBasicMaterial).color.setHex(0x2979ff);\\n      nextBuddy.isPlayer = true;\\n      (nextBuddy.teamRing.material as THREE.MeshBasicMaterial).color.setHex(0xb4ff39);\\n      playerUnit = nextBuddy;\\n    };\\n\\n    // =========================================================================\\n    // 11. INPUT LISTENERS (WASD, MOUSE AIM, CLICK SHOOT, E/F/G/Q/V/TAB)\\n    // =========================================================================\\n    const keys: Record<string, boolean> = {};\\n    const mouseNdc = new THREE.Vector2(0, 0);\\n    const raycaster = new THREE.Raycaster();\\n    const groundPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -0.6);\\n    const aimWorldPoint = new THREE.Vector3(0, 0.6, 0);\\n    let isPointerDown = false;\\n\\n    const onKeyDown = (e: KeyboardEvent) => {\\n      keys[e.code] = true;\\n      if (gameStateRef.current !== \'playing\') return;\\n\\n      if (e.code === \'Escape\' || e.code === \'KeyP\') {\\n        e.preventDefault();\\n        onTogglePause();\\n      } else if (e.code === \'KeyE\') {\\n        e.preventDefault();\\n        handlePlayerPickupOrThrowCrate();\\n      } else if (e.code === \'KeyF\') {\\n        e.preventDefault();\\n        handlePlayerKickOrCraft();\\n      } else if (e.code === \'KeyG\') {\\n        e.preventDefault();\\n        handleToggleMountTank();\\n      } else if (e.code === \'KeyQ\') {\\n        e.preventDefault();\\n        handleCycleBuildOrder();\\n      } else if (e.code === \'KeyV\') {\\n        e.preventDefault();\\n        handleCycleTeamCommand();\\n      } else if (e.code === \'Tab\') {\\n        e.preventDefault();\\n        handleSwapBuddy();\\n      }\\n    };\\n\\n    const onKeyUp = (e: KeyboardEvent) => {\\n      keys[e.code] = false;\\n    };\\n\\n    const updateMouseWorldAim = (clientX: number, clientY: number) => {\\n      const rect = renderer.domElement.getBoundingClientRect();\\n      if (rect.width <= 0 || rect.height <= 0) return;\\n      mouseNdc.x = ((clientX - rect.left) / rect.width) * 2 - 1;\\n      mouseNdc.y = -((clientY - rect.top) / rect.height) * 2 + 1;\\n    };\\n\\n    const onPointerMove = (e: PointerEvent) => {\\n      updateMouseWorldAim(e.clientX, e.clientY);\\n    };\\n\\n    const onPointerDown = (e: PointerEvent) => {\\n      if (gameStateRef.current !== \'playing\') return;\\n      updateMouseWorldAim(e.clientX, e.clientY);\\n      if (e.button === 0) {\\n        isPointerDown = true;\\n      } else if (e.button === 2) {\\n        handlePlayerPickupOrThrowCrate();\\n      }\\n    };\\n\\n    const onPointerUp = (e: PointerEvent) => {\\n      if (e.button === 0) {\\n        isPointerDown = false;\\n      }\\n    };\\n\\n    const onContextMenu = (e: MouseEvent) => e.preventDefault();\\n\\n    // Also allow external HUD buttons to trigger actions via CustomEvent\\n    const onBuddyActionEvent = (e: Event) => {\\n      const ce = e as CustomEvent<string>;\\n      if (ce.detail === \'pickupOrThrow\') handlePlayerPickupOrThrowCrate();\\n      else if (ce.detail === \'kickOrCraft\') handlePlayerKickOrCraft();\\n      else if (ce.detail === \'mountOrDismount\') handleToggleMountTank();\\n      else if (ce.detail === \'cycleBuildOrder\') handleCycleBuildOrder();\\n      else if (ce.detail === \'cycleCommand\') handleCycleTeamCommand();\\n      else if (ce.detail === \'swapBuddy\') handleSwapBuddy();\\n    };\\n\\n    window.addEventListener(\'keydown\', onKeyDown);\\n    window.addEventListener(\'keyup\', onKeyUp);\\n    window.addEventListener(\'buddy-action\', onBuddyActionEvent);\\n    renderer.domElement.addEventListener(\'pointermove\', onPointerMove);\\n    renderer.domElement.addEventListener(\'pointerdown\', onPointerDown);\\n    window.addEventListener(\'pointerup\', onPointerUp);\\n    renderer.domElement.addEventListener(\'contextmenu\', onContextMenu);\\n\\n    const onResize = () => {\\n      if (!container) return;\\n      const w = container.clientWidth || window.innerWidth;\\n      const h = container.clientHeight || window.innerHeight;\\n      camera.aspect = w / h;\\n      camera.updateProjectionMatrix();\\n      renderer.setSize(w, h);\\n    };\\n    window.addEventListener(\'resize\', onResize);\\n\\n    // =========================================================================\\n    // 12. CAMERA SPRING & MAIN 60FPS ANIMATION LOOP\\n    // =========================================================================\\n    let camFollowPos: Vec3 = { x: 0, y: 0.8, z: 11.5 };\\n    let camFollowVel: Vec3 = { x: 0, y: 0, z: 0 };\\n    const mousePanCurrent = { x: 0, z: 0 };\\n    const recoilOffset = { x: 0, z: 0 };\\n    let shakeTrauma = 0;\\n    let grassBucketIdx = 0;\\n    let hudSyncAccumulator = 0;\\n    let runElapsedSec = 0;\\n\\n    resetArenaRef.current = () => {\\n      spawnInitialSquadsAndObjects();\\n      runElapsedSec = 0;\\n    };\\n\\n    let rafId = 0;\\n    let prevTime = performance.now();\\n\\n    const animate = (now: number) => {\\n      rafId = requestAnimationFrame(animate);\\n      const rawDt = (now - prevTime) / 1000;\\n      prevTime = now;\\n      const dt = Math.min(rawDt, 0.05);\\n      const timeSec = now * 0.001;\\n\\n      const state = gameStateRef.current;\\n\\n      // 1. Time-Sliced 4-Bucket Wind Grass Animation (60 FPS)\\n      grassBucketIdx = (grassBucketIdx + 1) % 4;\\n      for (let i = grassBucketIdx; i < grassCount; i += 4) {\\n        const g = grassBaseData[i];\\n        const sway = Math.sin(timeSec * 2.8 + g.phase) * 0.22;\\n        dummyGrass.position.set(g.x, 0, g.z);\\n        dummyGrass.rotation.set(sway, g.rotY, sway * 0.5);\\n        dummyGrass.scale.set(1, g.scaleY, 1);\\n        dummyGrass.updateMatrix();\\n        grassInstanced.setMatrixAt(i, dummyGrass.matrix);\\n      }\\n      grassInstanced.instanceMatrix.needsUpdate = true;\\n\\n      // 2. Raycast Mouse Crosshair onto Ground Plane\\n      raycaster.setFromCamera(mouseNdc, camera);\\n      raycaster.ray.intersectPlane(groundPlane, aimWorldPoint);\\n\\n      // 3. Gameplay Simulation Step\\n      let activeSpeed = 0;\\n      const isBoosting = Boolean(keys[\'ShiftLeft\'] || keys[\'ShiftRight\']);\\n\\n      if (state === \'playing\') {\\n        runElapsedSec += dt;\\n\\n        // Periodic Parachute Crate Drops in Central & Side Drop Zones\\n        crateSpawnTimer += dt;\\n        if (crateSpawnTimer >= 4.2) {\\n          crateSpawnTimer = 0;\\n          spawnWorldCrate(\\n            \'red\',\\n            (Math.random() - 0.5) * 5.0,\\n            (Math.random() - 0.5) * 5.0,\\n            false,\\n          );\\n        }\\n\\n        superCrateSpawnTimer += dt;\\n        if (superCrateSpawnTimer >= 11.0) {\\n          superCrateSpawnTimer = 0;\\n          const sideX = Math.random() < 0.5 ? -17 : 17;\\n          spawnWorldCrate(\\n            \'super\',\\n            sideX + (Math.random() - 0.5) * 2.5,\\n            (Math.random() - 0.5) * 2.5,\\n            false,\\n          );\\n        }\\n\\n        // Update Falling & Grounded Crates (Parachute descent + Squash & Stretch landing)\\n        for (const c of worldCrates) {\\n          if (c.state === \'falling\') {\\n            c.y -= 5.2 * dt;\\n            c.mesh.position.y = c.y;\\n            c.mesh.rotation.y = Math.sin(timeSec * 2.5 + c.id) * 0.18;\\n            if (c.y <= 0.65) {\\n              c.y = 0.65;\\n              c.state = \'grounded\';\\n              c.parachuteMesh.visible = false;\\n              c.squashTimer = 0.28;\\n              c.mesh.position.y = 0.65;\\n              c.mesh.rotation.y = 0;\\n            }\\n          } else if (c.state === \'grounded\') {\\n            if (c.squashTimer > 0) {\\n              c.squashTimer = Math.max(0, c.squashTimer - dt);\\n              const s = Math.sin((c.squashTimer / 0.28) * Math.PI) * 0.28;\\n              c.mesh.scale.set(1 + s, 1 - s * 0.8, 1 + s);\\n            } else {\\n              c.mesh.scale.set(1, 1, 1);\\n            }\\n          }\\n        }\\n\\n        // Player Movement Input (WASD)\\n        let moveX = 0;\\n        let moveZ = 0;\\n        if (keys[\'KeyW\'] || keys[\'ArrowUp\']) moveZ -= 1;\\n        if (keys[\'KeyS\'] || keys[\'ArrowDown\']) moveZ += 1;\\n        if (keys[\'KeyA\'] || keys[\'ArrowLeft\']) moveX -= 1;\\n        if (keys[\'KeyD\'] || keys[\'ArrowRight\']) moveX += 1;\\n\\n        if (mountedTank) {\\n          // =================================================================\\n          // A. DRIVING OPEN-TOP LYO TANK MODE\\n          // =================================================================\\n          let throttle = 0;\\n          let turn = 0;\\n          if (keys[\'KeyW\'] || keys[\'ArrowUp\']) throttle += 1;\\n          if (keys[\'KeyS\'] || keys[\'ArrowDown\']) throttle -= 1;\\n          if (keys[\'KeyA\'] || keys[\'ArrowLeft\']) turn += 1;\\n          if (keys[\'KeyD\'] || keys[\'ArrowRight\']) turn -= 1;\\n\\n          mountedTank.currentDriveSpeed = computeTankSpeedStep(\\n            mountedTank.currentDriveSpeed,\\n            isBoosting && throttle !== 0,\\n            dt,\\n          );\\n\\n          if (turn !== 0) {\\n            const rev = throttle < 0 ? -1 : 1;\\n            mountedTank.hullYaw += turn * rev * REA_CONSTANTS.physics.drive.rotationSpeed * dt;\\n          }\\n\\n          const fwdX = Math.cos(mountedTank.hullYaw);\\n          const fwdZ = -Math.sin(mountedTank.hullYaw);\\n          const targetVx = fwdX * throttle * mountedTank.currentDriveSpeed;\\n          const targetVz = fwdZ * throttle * mountedTank.currentDriveSpeed;\\n          mountedTank.vx += (targetVx - mountedTank.vx) * Math.min(1, 10 * dt);\\n          mountedTank.vz += (targetVz - mountedTank.vz) * Math.min(1, 10 * dt);\\n\\n          mountedTank.x = clamp(mountedTank.x + mountedTank.vx * dt, -40, 40);\\n          mountedTank.z = clamp(mountedTank.z + mountedTank.vz * dt, -40, 40);\\n          mountedTank.root.position.set(mountedTank.x, 0, mountedTank.z);\\n          mountedTank.bodyGroup.rotation.y = mountedTank.hullYaw;\\n          activeSpeed = Math.hypot(mountedTank.vx, mountedTank.vz);\\n\\n          // Rotate Turret + Open-Top Rider 360\302\260 toward Mouse Crosshair\\n          const aimDx = aimWorldPoint.x - mountedTank.x;\\n          const aimDz = aimWorldPoint.z - mountedTank.z;\\n          const desiredWorldYaw = Math.atan2(-aimDz, aimDx);\\n          mountedTank.turretYaw = stepTurretYaw(\\n            mountedTank.turretYaw,\\n            desiredWorldYaw - mountedTank.hullYaw,\\n            dt,\\n          );\\n          mountedTank.turretGroup.rotation.y = mountedTank.turretYaw;\\n\\n          // Team Buddies Feature: Crate Run-Over (Carry up to 4 crates by driving over them!)\\n          for (let i = worldCrates.length - 1; i >= 0; i--) {\\n            const c = worldCrates[i];\\n            if (c.state === \'grounded\' && mountedTank.storedCrates.length < 4) {\\n              if (Math.hypot(c.x - mountedTank.x, c.z - mountedTank.z) < 2.2) {\\n                mountedTank.storedCrates.push(c.kind);\\n                scene.remove(c.mesh);\\n                worldCrates.splice(i, 1);\\n                soundEngine.playPickup();\\n              }\\n            }\\n          }\\n\\n          // Auto-unload Tank\'s stored crates when driving next to Blue Stacking Pad\\n          if (\\n            mountedTank.storedCrates.length > 0 &&\\n            Math.hypot(mountedTank.x - blueBase.padX, mountedTank.z - blueBase.padZ) < 4.8\\n          ) {\\n            while (mountedTank.storedCrates.length > 0) {\\n              const kind = mountedTank.storedCrates.shift()!;\\n              if (!addCrateToPadSlots(\'blue\', kind)) break;\\n              score += 35;\\n            }\\n            soundEngine.playPickup();\\n          }\\n\\n          // Keep playerUnit position synced to the Tank\\n          playerUnit.x = mountedTank.x;\\n          playerUnit.z = mountedTank.z;\\n\\n          // Tank Cannon Firing\\n          if (mountedTank.recoilTimer > 0) {\\n            mountedTank.recoilTimer = Math.max(0, mountedTank.recoilTimer - dt);\\n            mountedTank.barrelGroup.position.x = 0.65 - mountedTank.recoilTimer * 1.1;\\n          } else {\\n            mountedTank.barrelGroup.position.x = 0.65;\\n          }\\n\\n          if ((isPointerDown || keys[\'Space\']) && mountedTank.recoilTimer <= 0.02) {\\n            mountedTank.recoilTimer = 0.22;\\n            soundEngine.playShoot();\\n            const totalYaw = mountedTank.hullYaw + mountedTank.turretYaw;\\n            const sDir = new THREE.Vector3(Math.cos(totalYaw), 0, -Math.sin(totalYaw));\\n            const muzzleOrigin = new THREE.Vector3(\\n              mountedTank.x + sDir.x * 2.1,\\n              1.35,\\n              mountedTank.z + sDir.z * 2.1,\\n            );\\n            fireProjectile(true, \'TankCannon\', muzzleOrigin, sDir, 46, mountedTank.isSuper ? 26 : 18);\\n            recoilOffset.x -= sDir.x * 0.18;\\n            recoilOffset.z -= sDir.z * 0.18;\\n            shakeTrauma = Math.min(1, shakeTrauma + 0.25);\\n          }\\n        } else if (playerUnit.alive) {\\n          // =================================================================\\n          // B. ON-FOOT CHIBI BUDDY CHARACTER MODE\\n          // =================================================================\\n          const spec = BUDDY_CLASSES[playerUnit.classId];\\n          const carryPenalty = playerUnit.carryingCrate !== \'none\' ? 0.85 : 1.0;\\n          const boostMult = isBoosting ? 1.38 : 1.0;\\n          const moveSpeed = 9.2 * spec.speedMultiplier * carryPenalty * boostMult;\\n\\n          const inputLen = Math.hypot(moveX, moveZ);\\n          if (inputLen > 0.01) {\\n            playerUnit.vx = (moveX / inputLen) * moveSpeed;\\n            playerUnit.vz = (moveZ / inputLen) * moveSpeed;\\n            playerUnit.walkCycle += dt * moveSpeed * 1.65;\\n          } else {\\n            playerUnit.vx *= Math.exp(-14 * dt);\\n            playerUnit.vz *= Math.exp(-14 * dt);\\n          }\\n\\n          playerUnit.x = clamp(playerUnit.x + playerUnit.vx * dt, -40, 40);\\n          playerUnit.z = clamp(playerUnit.z + playerUnit.vz * dt, -40, 40);\\n          activeSpeed = Math.hypot(playerUnit.vx, playerUnit.vz);\\n\\n          // Rotate Character smoothly toward Mouse Crosshair\\n          const aimDx = aimWorldPoint.x - playerUnit.x;\\n          const aimDz = aimWorldPoint.z - playerUnit.z;\\n          if (Math.hypot(aimDx, aimDz) > 0.2) {\\n            playerUnit.yaw = Math.atan2(-aimDz, aimDx);\\n          }\\n\\n          // Player Shooting (when not carrying a crate above head)\\n          if (playerUnit.shootCooldown > 0) {\\n            playerUnit.shootCooldown = Math.max(0, playerUnit.shootCooldown - dt);\\n          }\\n          if (\\n            (isPointerDown || keys[\'Space\']) &&\\n            playerUnit.carryingCrate === \'none\' &&\\n            playerUnit.shootCooldown <= 0\\n          ) {\\n            const wName = playerUnit.weaponName;\\n            const isHeavy = wName === \'Bazooka\' || wName === \'Supazooka\';\\n            playerUnit.shootCooldown = isHeavy ? 0.42 : 0.16;\\n            soundEngine.playShoot();\\n\\n            const sDir = new THREE.Vector3(Math.cos(playerUnit.yaw), 0, -Math.sin(playerUnit.yaw));\\n            const muzzlePos = new THREE.Vector3(\\n              playerUnit.x + sDir.x * 1.15,\\n              1.15,\\n              playerUnit.z + sDir.z * 1.15,\\n            );\\n            fireProjectile(\\n              true,\\n              wName.includes(\'Ice\') ? \'Ice Gun\' : wName,\\n              muzzlePos,\\n              sDir,\\n              isHeavy ? 38 : 44,\\n              isHeavy ? 22 : 9,\\n            );\\n          }\\n        }\\n\\n        // ===================================================================\\n        // C. UPDATE ALL AI BUDDIES (BLUE ALLIES & RED ENEMIES: HARVEST & COMBAT)\\n        // ===================================================================\\n        for (const b of buddyUnits) {\\n          if (!b.alive) {\\n            b.respawnTimer -= dt;\\n            if (b.respawnTimer <= 0) {\\n              b.alive = true;\\n              b.hp = b.maxHp;\\n              b.isFrozen = false;\\n              b.carryingCrate = \'none\';\\n              b.overheadCrateGroup.visible = false;\\n              b.x = (Math.random() - 0.5) * 8;\\n              b.z = b.team === \'blue\' ? 16 : -16;\\n              b.root.visible = true;\\n            }\\n            continue;\\n          }\\n\\n          if (b.isFrozen) {\\n            b.frozenTimer -= dt;\\n            if (b.frozenTimer <= 0) {\\n              b.isFrozen = false;\\n            }\\n          }\\n\\n          // Medic passive HP regeneration\\n          if (b.classId === \'Medic\' && b.hp < b.maxHp) {\\n            b.hp = Math.min(b.maxHp, b.hp + dt * 1.5);\\n          }\\n\\n          if (!b.isPlayer && !b.isFrozen) {\\n            const spec = BUDDY_CLASSES[b.classId];\\n            const aiSpeed = 6.8 * spec.speedMultiplier;\\n            const homePadX = b.team === \'blue\' ? blueBase.padX : redBase.padX;\\n            const homePadZ = b.team === \'blue\' ? blueBase.padZ : redBase.padZ;\\n            const enemyHqZ = b.team === \'blue\' ? -22 : 22;\\n\\n            let goalX = b.x;\\n            let goalZ = b.z;\\n            const aiMode = b.team === \'blue\' ? teamCommand : \'HARVEST\';\\n\\n            if (b.carryingCrate !== \'none\') {\\n              // Carry overhead crate back to team\'s Stacking Pad 2x2x2!\\n              goalX = homePadX;\\n              goalZ = homePadZ;\\n              if (Math.hypot(b.x - homePadX, b.z - homePadZ) < 2.6) {\\n                addCrateToPadSlots(b.team, b.carryingCrate);\\n                b.carryingCrate = \'none\';\\n                b.overheadCrateGroup.visible = false;\\n                if (b.team === \'blue\') score += 25;\\n              }\\n            } else if (aiMode === \'FOLLOW\' && b.team === \'blue\') {\\n              goalX = playerUnit.x - 2.5;\\n              goalZ = playerUnit.z + 2.0;\\n            } else if (aiMode === \'DEFEND\' && b.team === \'blue\') {\\n              goalX = 0;\\n              goalZ = 15;\\n            } else if (aiMode === \'ATTACK\') {\\n              goalX = 0;\\n              goalZ = enemyHqZ;\\n            } else {\\n              // HARVEST mode: Find nearest grounded crate in the arena!\\n              let bestCrate: WorldCrate | null = null;\\n              let bestDist = 999;\\n              for (const c of worldCrates) {\\n                if (c.state === \'grounded\') {\\n                  const d = Math.hypot(c.x - b.x, c.z - b.z);\\n                  if (d < bestDist) {\\n                    bestDist = d;\\n                    bestCrate = c;\\n                  }\\n                }\\n              }\\n\\n              if (bestCrate) {\\n                goalX = bestCrate.x;\\n                goalZ = bestCrate.z;\\n                if (bestDist < 1.65) {\\n                  b.carryingCrate = bestCrate.kind;\\n                  b.overheadCrateBox.material =\\n                    bestCrate.kind === \'super\' ? matSuperCrate : matRedCrate;\\n                  b.overheadCrateGroup.visible = true;\\n                  scene.remove(bestCrate.mesh);\\n                  const idx = worldCrates.indexOf(bestCrate);\\n                  if (idx !== -1) worldCrates.splice(idx, 1);\\n                }\\n              } else {\\n                goalX = 0;\\n                goalZ = enemyHqZ * 0.5;\\n              }\\n            }\\n\\n            const dx = goalX - b.x;\\n            const dz = goalZ - b.z;\\n            const dist = Math.hypot(dx, dz);\\n            if (dist > 0.6) {\\n              b.vx = (dx / dist) * aiSpeed;\\n              b.vz = (dz / dist) * aiSpeed;\\n              b.x = clamp(b.x + b.vx * dt, -40, 40);\\n              b.z = clamp(b.z + b.vz * dt, -40, 40);\\n              b.yaw = Math.atan2(-b.vz, b.vx);\\n              b.walkCycle += dt * aiSpeed * 1.6;\\n            } else {\\n              b.vx = 0;\\n              b.vz = 0;\\n            }\\n\\n            // AI Shooting at nearest enemy within 14m when not carrying a crate\\n            if (b.shootCooldown > 0) b.shootCooldown -= dt;\\n            if (b.carryingCrate === \'none\' && b.shootCooldown <= 0) {\\n              let targetX: number | null = null;\\n              let targetZ: number | null = null;\\n              let minEnemyDist = 14.5;\\n\\n              for (const other of buddyUnits) {\\n                if (other.alive && other.team !== b.team) {\\n                  const ed = Math.hypot(other.x - b.x, other.z - b.z);\\n                  if (ed < minEnemyDist) {\\n                    minEnemyDist = ed;\\n                    targetX = other.x;\\n                    targetZ = other.z;\\n                  }\\n                }\\n              }\\n\\n              if (targetX !== null && targetZ !== null) {\\n                b.shootCooldown = 1.15 + Math.random() * 0.4;\\n                b.yaw = Math.atan2(-(targetZ - b.z), targetX - b.x);\\n                const dir = new THREE.Vector3(targetX - b.x, 0, targetZ - b.z).normalize();\\n                fireProjectile(\\n                  b.team === \'blue\',\\n                  b.weaponName,\\n                  new THREE.Vector3(b.x + dir.x * 1.1, 1.1, b.z + dir.z * 1.1),\\n                  dir,\\n                  24,\\n                  4,\\n                );\\n              }\\n            }\\n          }\\n\\n          // Animate Chibi Buddy Limbs (Running legs + Overhead crate arms vs Weapon arm)\\n          const floatY = BUDDY_CLASSES[b.classId].canFly ? 0.65 + Math.sin(timeSec * 4 + b.id) * 0.18 : 0;\\n          b.root.position.set(b.x, floatY, b.z);\\n          b.bodyGroup.rotation.y = b.yaw - Math.PI / 2;\\n\\n          const speedMag = Math.hypot(b.vx, b.vz);\\n          const legSwing = speedMag > 0.4 ? Math.sin(b.walkCycle) * 0.68 : 0;\\n          b.leftLegPivot.rotation.x = legSwing;\\n          b.rightLegPivot.rotation.x = -legSwing;\\n\\n          if (b.carryingCrate !== \'none\') {\\n            // Raise BOTH arms straight up overhead to hold the 3D Crate!\\n            b.leftArmPivot.rotation.x = Math.PI * 0.92;\\n            b.rightArmPivot.rotation.x = Math.PI * 0.92;\\n            b.weaponMesh.visible = false;\\n            b.overheadCrateGroup.visible = true;\\n          } else {\\n            b.leftArmPivot.rotation.x = -legSwing * 0.6;\\n            b.rightArmPivot.rotation.x = -Math.PI * 0.35;\\n            b.weaponMesh.visible = true;\\n            b.overheadCrateGroup.visible = false;\\n          }\\n\\n          if (b.hitFlashTimer > 0) {\\n            b.hitFlashTimer = Math.max(0, b.hitFlashTimer - dt);\\n            b.headMesh.material = flashWhiteMat;\\n          } else if (b.isFrozen) {\\n            b.headMesh.material = frozenIceMat;\\n          } else {\\n            b.headMesh.material = matSkin;\\n          }\\n        }\\n\\n        // Red Team Stacking Pad Auto-Crafter (so Red Team also crafts buddies from stacked crates!)\\n        const redEval = evaluateStackingPadRecipe(redPadSlots);\\n        if (redEval.totalCrates >= 2) {\\n          redCraftTimer += dt;\\n          if (redCraftTimer >= 3.0) {\\n            redCraftTimer = 0;\\n            const activeRed = buddyUnits.filter((u) => u.team === \'red\' && u.alive).length;\\n            if (activeRed < 5) {\\n              buddyUnits.push(\\n                createBuddyCharacterUnit(\\n                  \'red\',\\n                  false,\\n                  redEval.isSuper ? \'Cyborg\' : \'Commando\',\\n                  redBase.padX - 2.5,\\n                  redBase.padZ + 2.0,\\n                ),\\n              );\\n            }\\n            redPadSlots = [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'];\\n            syncPadVisuals(redBase, redPadSlots, \'RED\', redBaseHp);\\n          }\\n        }\\n\\n        // ===================================================================\\n        // D. UPDATE PROJECTILES, TREE DESTRUCTION, BASE HQ DAMAGE & PICKUPS\\n        // ===================================================================\\n        for (const p of projectiles) {\\n          if (!p.active) continue;\\n          p.life -= dt;\\n          if (p.life <= 0) {\\n            p.active = false;\\n            p.mesh.visible = false;\\n            continue;\\n          }\\n          p.pos.addScaledVector(p.vel, dt);\\n          p.mesh.position.copy(p.pos);\\n\\n          // 1. Check hit against Destructible Lyo Trees\\n          let hitResolved = false;\\n          for (const tr of trees) {\\n            if (tr.alive && Math.hypot(p.pos.x - tr.x, p.pos.z - tr.z) < 1.65) {\\n              tr.hp -= p.damage;\\n              tr.hitFlashTimer = 0.12;\\n              soundEngine.playHit();\\n              spawnBurstParticles(p.pos.x, 1.5, p.pos.z, 6);\\n              if (tr.hp <= 0) {\\n                tr.alive = false;\\n                tr.mesh.visible = false;\\n                score += 80;\\n                soundEngine.playExplosion();\\n                spawnBurstParticles(tr.x, 2.2, tr.z, 16);\\n                spawnWorldPickup(\'powerup\', \'Shield / Boost\', tr.x, tr.z);\\n              }\\n              hitResolved = true;\\n              break;\\n            }\\n          }\\n          if (hitResolved) {\\n            p.active = false;\\n            p.mesh.visible = false;\\n            continue;\\n          }\\n\\n          // 2. Check hit against Enemy Base HQ\\n          if (p.isPlayerTeam && Math.hypot(p.pos.x - 0, p.pos.z - -22) < 3.6) {\\n            redBaseHp = Math.max(0, redBaseHp - p.damage * 8);\\n            score += 25;\\n            syncPadVisuals(redBase, redPadSlots, \'RED\', redBaseHp);\\n            spawnBurstParticles(p.pos.x, 2.0, p.pos.z, 8);\\n            soundEngine.playHit();\\n            p.active = false;\\n            p.mesh.visible = false;\\n            if (redBaseHp <= 0) {\\n              soundEngine.playVictory();\\n              bestScore = Math.max(bestScore, score + 1000);\\n              onGameOver(\'victory\', buildHudSnapshot(\'victory\'));\\n            }\\n            continue;\\n          } else if (!p.isPlayerTeam && Math.hypot(p.pos.x - 0, p.pos.z - 22) < 3.6) {\\n            blueBaseHp = Math.max(0, blueBaseHp - p.damage * 4);\\n            syncPadVisuals(blueBase, bluePadSlots, \'BLUE\', blueBaseHp);\\n            p.active = false;\\n            p.mesh.visible = false;\\n            continue;\\n          }\\n\\n          // 3. Check hit against Buddy Units (including Ice Gun Freeze + Shatter rule!)\\n          for (const b of buddyUnits) {\\n            if (!b.alive) continue;\\n            if (b.isPlayer && mountedTank) continue;\\n            if ((p.isPlayerTeam && b.team === \'red\') || (!p.isPlayerTeam && b.team === \'blue\')) {\\n              if (Math.hypot(p.pos.x - b.x, p.pos.z - b.z) < 1.15) {\\n                if (p.weaponType === \'Ice Gun\') {\\n                  b.isFrozen = true;\\n                  b.frozenTimer = 4.0;\\n                  b.hp -= Math.ceil(p.damage * 0.5);\\n                } else if (b.isFrozen) {\\n                  // Frozen targets shatter immediately on follow-up hit!\\n                  b.hp = 0;\\n                } else {\\n                  b.hp -= p.damage;\\n                }\\n                b.hitFlashTimer = 0.14;\\n                soundEngine.playHit();\\n                spawnBurstParticles(b.x, 1.2, b.z, 8);\\n\\n                if (b.hp <= 0) {\\n                  b.alive = false;\\n                  b.respawnTimer = 6.0;\\n                  b.root.visible = false;\\n                  soundEngine.playExplosion();\\n                  spawnBurstParticles(b.x, 1.4, b.z, 16);\\n                  if (b.team === \'red\') {\\n                    enemiesDefeated++;\\n                    score += 150;\\n                    spawnWorldPickup(\'health\', \'Health +25\', b.x, b.z);\\n                  } else if (b.isPlayer) {\\n                    // Respawn player at Blue Base after short reset or trigger defeat if Blue Base is critical\\n                    b.alive = true;\\n                    b.hp = b.maxHp;\\n                    b.x = 0;\\n                    b.z = 14;\\n                    b.root.visible = true;\\n                  }\\n                }\\n                hitResolved = true;\\n                break;\\n              }\\n            }\\n          }\\n          if (hitResolved) {\\n            p.active = false;\\n            p.mesh.visible = false;\\n          }\\n        }\\n\\n        // Collect 3D Pickups (Weapons, Health Hearts, Ammo Boxes, Tree Power-Ups)\\n        const collectorX = mountedTank ? mountedTank.x : playerUnit.x;\\n        const collectorZ = mountedTank ? mountedTank.z : playerUnit.z;\\n        for (let i = worldPickups.length - 1; i >= 0; i--) {\\n          const pk = worldPickups[i];\\n          pk.bobPhase += dt * 3.5;\\n          pk.mesh.position.y = 0.75 + Math.sin(pk.bobPhase) * 0.2;\\n          pk.mesh.rotation.y += dt * 2.2;\\n\\n          if (Math.hypot(pk.x - collectorX, pk.z - collectorZ) < 2.1) {\\n            soundEngine.playPickup();\\n            if (pk.kind === \'health\') {\\n              playerUnit.hp = Math.min(playerUnit.maxHp, playerUnit.hp + 10);\\n            } else if (pk.kind === \'ammo\') {\\n              playerUnit.ammo += 60;\\n            } else if (pk.kind === \'weapon\') {\\n              playerUnit.weaponName = pk.weaponName;\\n              playerUnit.ammo = 200;\\n            } else if (pk.kind === \'powerup\') {\\n              playerUnit.hp = playerUnit.maxHp;\\n              score += 120;\\n            }\\n            scene.remove(pk.mesh);\\n            worldPickups.splice(i, 1);\\n          }\\n        }\\n\\n        // Update Explosion Particles\\n        for (const ep of explosionParticles) {\\n          if (!ep.active) continue;\\n          ep.life += dt;\\n          if (ep.life >= ep.maxLife) {\\n            ep.active = false;\\n            ep.mesh.visible = false;\\n            continue;\\n          }\\n          ep.vel.y -= 14 * dt;\\n          ep.mesh.position.addScaledVector(ep.vel, dt);\\n          const alpha = 1 - ep.life / ep.maxLife;\\n          (ep.mesh.material as THREE.MeshBasicMaterial).opacity = alpha;\\n        }\\n      }\\n\\n      // 4. Critically-Damped Follow Camera (Tracks active Buddy OR Mounted Open-Top Tank)\\n      const focusTarget: Vec3 =\\n        state === \'title\'\\n          ? { x: 2.4, y: 0.9, z: 13.0 }\\n          : mountedTank\\n          ? { x: mountedTank.x, y: 1.1, z: mountedTank.z }\\n          : { x: playerUnit.x, y: 1.0, z: playerUnit.z };\\n\\n      const springStep = stepCriticalDampedSpring3D(\\n        camFollowPos,\\n        focusTarget,\\n        camFollowVel,\\n        Math.max(8, activeSpeed),\\n        dt,\\n      );\\n      camFollowPos = springStep.position;\\n      camFollowVel = springStep.velocity;\\n\\n      const panAlpha = 1 - Math.exp(-REA_CONSTANTS.camera.mousePan.dampSpeed * dt);\\n      const panScale = state === \'title\' ? 0.3 : REA_CONSTANTS.camera.mousePan.sensitivity;\\n      mousePanCurrent.x += (mouseNdc.x * panScale - mousePanCurrent.x) * panAlpha;\\n      mousePanCurrent.z += (-mouseNdc.y * panScale - mousePanCurrent.z) * panAlpha;\\n\\n      recoilOffset.x *= Math.exp(-10 * dt);\\n      recoilOffset.z *= Math.exp(-10 * dt);\\n      shakeTrauma = Math.max(0, shakeTrauma - dt * 2.5);\\n      const shakeAmt = shakeTrauma * shakeTrauma * 0.35;\\n      const shakeX = (Math.random() - 0.5) * shakeAmt;\\n      const shakeZ = (Math.random() - 0.5) * shakeAmt;\\n\\n      const fovScale = cameraFovModeRef.current === \'roblox18\' ? 1.85 : 1.0;\\n      const camOffset = state === \'title\' ? { x: -3.2, y: 10.5, z: 12.5 } : { x: 0, y: 16.5, z: 13.5 };\\n\\n      const finalLookX = camFollowPos.x + mousePanCurrent.x + recoilOffset.x + shakeX;\\n      const finalLookZ = camFollowPos.z + mousePanCurrent.z + recoilOffset.z + shakeZ;\\n\\n      camera.position.set(\\n        finalLookX + camOffset.x * fovScale,\\n        camFollowPos.y + camOffset.y * fovScale,\\n        finalLookZ + camOffset.z * fovScale,\\n      );\\n      camera.lookAt(finalLookX, camFollowPos.y, finalLookZ);\\n\\n      dirLight.position.set(finalLookX + 14, 34, finalLookZ + 16);\\n      dirLight.target.position.set(finalLookX, 0, finalLookZ);\\n\\n      renderer.render(scene, camera);\\n\\n      // 5. Periodic HUD Snapshot Sync\\n      hudSyncAccumulator += dt;\\n      if (hudSyncAccumulator >= 0.1) {\\n        hudSyncAccumulator = 0;\\n        onHudUpdate(buildHudSnapshot(null));\\n      }\\n    };\\n\\n    const buildHudSnapshot = (outcome: \'victory\' | \'defeat\' | null): HudSnapshot => {\\n      const padEval = evaluateStackingPadRecipe(bluePadSlots);\\n      const actorX = mountedTank ? mountedTank.x : playerUnit.x;\\n      const actorZ = mountedTank ? mountedTank.z : playerUnit.z;\\n\\n      let contextHint = \'WASD Lari \302\267 [E] Ambil Peti \302\267 [G] Naik Tank\';\\n      if (mountedTank) {\\n        contextHint = `Mengendarai ${mountedTank.isSuper ? \'Tyrant Tank\' : \'Lyo Tank\'} (${mountedTank.storedCrates.length}/4 Peti) \302\267 [G] Turun`;\\n      } else if (playerUnit.carryingCrate !== \'none\') {\\n        contextHint = \'Membawa Peti di Kepala \302\267 [E] Lempar ke Stacking Pad\';\\n      } else if (Math.hypot(actorX - blueBase.padX, actorZ - blueBase.padZ) <= 7.5 && padEval.totalCrates > 0) {\\n        contextHint = `Dekat Pad \302\267 [F] Rakit ${padEval.outputName}`;\\n      } else {\\n        for (const t of tanks) {\\n          if (!t.occupiedByPlayer && Math.hypot(t.x - actorX, t.z - actorZ) <= 4.6) {\\n            contextHint = \'Dekat Tank Lyo \302\267 [G] Naik ke Kubah Meriam\';\\n            break;\\n          }\\n        }\\n      }\\n\\n      return {\\n        hp: mountedTank ? mountedTank.hp : playerUnit.hp,\\n        maxHp: mountedTank ? mountedTank.maxHp : playerUnit.maxHp,\\n        score,\\n        bestScore: Math.max(bestScore, score),\\n        speedKmh: Math.round(\\n          Math.hypot(\\n            mountedTank ? mountedTank.vx : playerUnit.vx,\\n            mountedTank ? mountedTank.vz : playerUnit.vz,\\n          ) * 3.6,\\n        ),\\n        isBoosting: Boolean(keys[\'ShiftLeft\'] || keys[\'ShiftRight\']),\\n        isGrabMode: Boolean(mountedTank),\\n        grabbedPropName: mountedTank ? \'Lyo Tank\' : null,\\n        collectedItems: [\\n          padEval.totalCrates >= 1 ? \'GEAR\' : \'\',\\n          padEval.totalCrates >= 2 ? \'TOOLS\' : \'\',\\n          padEval.totalCrates >= 4 ? \'CIRCUIT\' : \'\',\\n          padEval.totalCrates >= 8 ? \'FUEL\' : \'\',\\n        ].filter(Boolean),\\n        powerCoreActivated: redBaseHp <= 0,\\n        enemiesDefeated,\\n        totalEnemies: 4,\\n        lightingPreset: lightingPresetRef.current,\\n        cameraFovMode: cameraFovModeRef.current,\\n        outcome,\\n        clearTimeSec: Math.round(runElapsedSec),\\n        controlMode: mountedTank ? \'tank\' : \'buddy\',\\n        activeClass: playerUnit.classId,\\n        equippedWeapon: mountedTank ? \'Meriam Tank 105mm\' : playerUnit.weaponName,\\n        ammo: playerUnit.ammo,\\n        carryingCrate: playerUnit.carryingCrate,\\n        tankStoredCrates: mountedTank ? mountedTank.storedCrates.length : 0,\\n        padSlots: [...bluePadSlots],\\n        padShape: padEval.shapeKey,\\n        padOutputName: padEval.outputName,\\n        padIsMerged: padEval.isMerged,\\n        padIsSuper: padEval.isSuper,\\n        buildOrder,\\n        teamCommand,\\n        alliedBuddiesCount: buddyUnits.filter((b) => b.team === \'blue\' && b.alive).length,\\n        blueBaseHp,\\n        redBaseHp,\\n        contextHint,\\n      };\\n    };\\n\\n    rafId = requestAnimationFrame(animate);\\n\\n    return () => {\\n      cancelAnimationFrame(rafId);\\n      window.removeEventListener(\'keydown\', onKeyDown);\\n      window.removeEventListener(\'keyup\', onKeyUp);\\n      window.removeEventListener(\'buddy-action\', onBuddyActionEvent);\\n      window.removeEventListener(\'pointerup\', onPointerUp);\\n      window.removeEventListener(\'resize\', onResize);\\n      renderer.domElement.removeEventListener(\'pointermove\', onPointerMove);\\n      renderer.domElement.removeEventListener(\'pointerdown\', onPointerDown);\\n      renderer.domElement.removeEventListener(\'contextmenu\', onContextMenu);\\n      renderer.dispose();\\n    };\\n  }, [onGameOver, onHudUpdate, onTogglePause]);\\n\\n  return (\\n    <div\\n      ref={mountRef}\\n      className=\\\"fixed inset-0 w-screen h-screen overflow-hidden\\\"\\n      style={{ cursor: gameState === \'playing\' ? \'crosshair\' : \'default\' }}\\n    />\\n  );\\n};\\n\", \"TargetFile\":\"/src/game/FactoryPlaygroundCanvas.tsx\", \"toolAction\":\"Updating gameplay loop in FactoryPlaygroundCanvas.tsx\", \"toolSummary\":\"Update gameplay loop in FactoryPlaygroundCanvas.tsx\"}"
