        instruction: "Update src/App.tsx to integrate evaluateStackingPadRecipe, BUDDY_CLASSES, TeamCommandMode, and clean 1-3 word UI labels"
        is_edit: true
        file {
          absolute_uri: "file:///src/App.tsx"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "import React, { useState, useEffect, useCallback, useRef } from \'react\';\nimport {\n  FactoryPlaygroundCanvas,\n  GameState,\n  HudSnapshot,\n} from \'./game/FactoryPlaygroundCanvas\';\nimport {\n  REA_CONSTANTS,\n  LIGHTING_PRESETS,\n  LightingPresetKey,\n} from \'./game/rules\';\nimport { soundEngine } from \'./game/audio\';\nimport { ReaLuauModal } from \'./components/ReaLuauModal\';\n\nconst INITIAL_HUD: HudSnapshot = {\n  hp: 30,\n  maxHp: 30,\n  score: 0,\n  bestScore: 0,\n  speedKmh: 0,\n  isBoosting: false,\n  isGrabMode: false,\n  grabbedPropName: null,\n  collectedItems: [],\n  powerCoreActivated: false,\n  enemiesDefeated: 0,\n  totalEnemies: 4,\n  lightingPreset: \'day\',\n  cameraFovMode: \'webgl35\',\n  outcome: null,\n  clearTimeSec: 0,\n};\n\nconst PRESET_ORDER: LightingPresetKey[] = [\'day\', \'dusk\', \'night\', \'dawn\'];\nconst REQUIRED_ITEMS = [\'GEAR\', \'TOOLS\', \'CIRCUIT\', \'FUEL\'];\n\nexport default function App() {\n  const [gameState, setGameState] = useState<GameState>(() => {\n    if (typeof window !== \'undefined\') {\n      const params = new URLSearchParams(window.location.search);\n      if (params.get(\'autostart\') === \'1\') {\n        return \'playing\';\n      }\n    }\n    return \'title\';\n  });\n\n  const [hud, setHud] = useState<HudSnapshot>(INITIAL_HUD);\n  const [finalRunStats, setFinalRunStats] = useState<HudSnapshot | null>(null);\n  const [lightingPreset, setLightingPreset] = useState<LightingPresetKey>(\'day\');\n  const [cameraFovMode, setCameraFovMode] = useState<\'webgl35\' | \'roblox18\'>(\'webgl35\');\n  const [isMuted, setIsMuted] = useState<boolean>(false);\n  const [isReaModalOpen, setIsReaModalOpen] = useState<boolean>(false);\n  const [isDockCollapsed, setIsDockCollapsed] = useState<boolean>(false);\n  const [resetTrigger, setResetTrigger] = useState<number>(0);\n\n  const hexContainerRef = useRef<HTMLDivElement | null>(null);\n  const [hexRect, setHexRect] = useState<{ left: number; top: number; width: number; height: number }>({\n    left: 720,\n    top: 140,\n    width: 480,\n    height: 462,\n  });\n\n  // Sync gameState to document.body.dataset.state\n  useEffect(() => {\n    document.body.dataset.state = gameState;\n  }, [gameState]);\n\n  // Measure Hexagon Mask Container on Title Screen so SVG cutout aligns 1:1\n  const syncHexBounds = useCallback(() => {\n    if (!hexContainerRef.current) return;\n    const r = hexContainerRef.current.getBoundingClientRect();\n    if (r.width > 0 && r.height > 0) {\n      setHexRect({\n        left: r.left,\n        top: r.top,\n        width: r.width,\n        height: r.height,\n      });\n    }\n  }, []);\n\n  useEffect(() => {\n    syncHexBounds();\n    window.addEventListener(\'resize\', syncHexBounds);\n    return () => window.removeEventListener(\'resize\', syncHexBounds);\n  }, [syncHexBounds, gameState]);\n\n  // Start / Restart Handshake (immediate t = 0ms state transition)\n  const handleStartGame = useCallback(\n    (shouldReset = false) => {\n      soundEngine.playUiClick();\n      if (document.activeElement instanceof HTMLElement) {\n        document.activeElement.blur();\n      }\n      if (shouldReset) {\n        setResetTrigger((prev) => prev + 1);\n        setFinalRunStats(null);\n      }\n      document.body.dataset.state = \'playing\';\n      setGameState(\'playing\');\n    },\n    [],\n  );\n\n  const handleToggleAudio = useCallback(() => {\n    const nextMuted = !soundEngine.muted;\n    soundEngine.muted = nextMuted;\n    setIsMuted(nextMuted);\n    if (!nextMuted) {\n      soundEngine.playUiClick();\n    }\n  }, []);\n\n  const handleCycleLighting = useCallback(() => {\n    soundEngine.playUiClick();\n    setLightingPreset((prev) => {\n      const idx = PRESET_ORDER.indexOf(prev);\n      return PRESET_ORDER[(idx + 1) % PRESET_ORDER.length];\n    });\n  }, []);\n\n  const handleToggleFovMode = useCallback(() => {\n    soundEngine.playUiClick();\n    setCameraFovMode((prev) => (prev === \'webgl35\' ? \'roblox18\' : \'webgl35\'));\n  }, []);\n\n  const handleTogglePause = useCallback(() => {\n    soundEngine.playUiClick();\n    setGameState((prev) => {\n      const next = prev === \'playing\' ? \'paused\' : prev === \'paused\' ? \'playing\' : prev;\n      document.body.dataset.state = next;\n      return next;\n    });\n  }, []);\n\n  const handleGameOver = useCallback(\n    (_outcome: \'victory\' | \'defeat\', snapshot: HudSnapshot) => {\n      setFinalRunStats(snapshot);\n      document.body.dataset.state = \'gameover\';\n      setGameState(\'gameover\');\n    },\n    [],\n  );\n\n  // Global Keyboard Shortcuts (Enter/Space on Title, M Mute, L Lighting, C Camera FOV, H Hide Dock, R REA Modal)\n  useEffect(() => {\n    const onKeyDown = (e: KeyboardEvent) => {\n      if (isReaModalOpen) {\n        if (e.code === \'Escape\') {\n          setIsReaModalOpen(false);\n        }\n        return;\n      }\n\n      if (gameState === \'title\' && (e.code === \'Enter\' || e.code === \'Space\')) {\n        e.preventDefault();\n        handleStartGame(false);\n        return;\n      }\n\n      if (e.code === \'KeyM\') {\n        handleToggleAudio();\n      } else if (e.code === \'KeyL\') {\n        handleCycleLighting();\n      } else if (e.code === \'KeyC\') {\n        handleToggleFovMode();\n      } else if (e.code === \'KeyH\') {\n        setIsDockCollapsed((prev) => !prev);\n      } else if (e.code === \'KeyR\' && gameState === \'playing\') {\n        soundEngine.playUiClick();\n        setIsReaModalOpen(true);\n      }\n    };\n\n    window.addEventListener(\'keydown\', onKeyDown);\n    return () => window.removeEventListener(\'keydown\', onKeyDown);\n  }, [\n    gameState,\n    isReaModalOpen,\n    handleStartGame,\n    handleToggleAudio,\n    handleCycleLighting,\n    handleToggleFovMode,\n  ]);\n\n  const currentPresetConfig = LIGHTING_PRESETS[lightingPreset];\n  const scaleX = hexRect.width / 500;\n  const scaleY = hexRect.height / 482;\n\n  return (\n    <main className=\"relative w-screen h-screen overflow-hidden select-none\">\n      {/* 1. Isolated 60FPS Three.js Factory Playground Canvas */}\n      <FactoryPlaygroundCanvas\n        gameState={gameState}\n        lightingPreset={lightingPreset}\n        cameraFovMode={cameraFovMode}\n        resetTrigger={resetTrigger}\n        onHudUpdate={setHud}\n        onGameOver={handleGameOver}\n        onTogglePause={handleTogglePause}\n      />\n\n      {/* Atmospheric Viewport Color Tint Overlay (from Ja=class in B1Nq4Kq6.js) */}\n      <div\n        aria-hidden=\"true\"\n        className=\"fixed inset-0 pointer-events-none z-10 transition-colors duration-700\"\n        style={{\n          backgroundColor: currentPresetConfig.viewportFilterColor,\n          opacity: currentPresetConfig.viewportFilterOpacity,\n        }}\n      />\n\n      {/* =====================================================================\n          2. TITLE SCREEN: HEXAGON CUTOUT & COMIC STICKER LOCKUP (CJn-Xu8f.js)\n         ===================================================================== */}\n      {gameState === \'title\' && (\n        <section\n          aria-label=\"LYOOO Portfolio Title Screen\"\n          className=\"fixed inset-0 z-20 flex flex-col justify-between pointer-events-none\"\n        >\n          {/* Full-Viewport SVG Mask with Polygon/Hexagon Cutout over the 3D Tank */}\n          <svg\n            className=\"fixed inset-0 w-full h-full pointer-events-none\"\n            width=\"100%\"\n            height=\"100%\"\n            preserveAspectRatio=\"none\"\n          >\n            <defs>\n              <mask\n                id=\"intro-mask-cutout\"\n                maskUnits=\"userSpaceOnUse\"\n                x=\"0\"\n                y=\"0\"\n                width=\"100%\"\n                height=\"100%\"\n              >\n                <rect width=\"100%\" height=\"100%\" fill=\"white\" />\n                <g\n                  transform={`translate(${hexRect.left}, ${hexRect.top}) scale(${scaleX}, ${scaleY})`}\n                >\n                  <path d={REA_CONSTANTS.introHexagonSvgPath} fill=\"black\" />\n                </g>\n              </mask>\n              <linearGradient id=\"intro-overlay-gradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                <stop offset=\"0%\" stopColor=\"#0b0c12\" stopOpacity=\"0.94\" />\n                <stop offset=\"52%\" stopColor=\"#11121a\" stopOpacity=\"0.86\" />\n                <stop offset=\"100%\" stopColor=\"#11121a\" stopOpacity=\"0.72\" />\n              </linearGradient>\n            </defs>\n            <rect\n              width=\"100%\"\n              height=\"100%\"\n              fill=\"url(#intro-overlay-gradient)\"\n              mask=\"url(#intro-mask-cutout)\"\n            />\n          </svg>\n\n          {/* Main Asymmetric Grid: Left Comic Sticker Typography | Right Hexagon Viewport */}\n          <div className=\"relative z-10 flex-1 grid grid-cols-1 lg:grid-cols-12 items-center px-6 sm:px-12 lg:px-16 pt-8 pb-4 gap-6\">\n            {/* Left Column: Bespoke Inline SVG Comic Sticker Title Lockup (\"LYOOO\" + \"PORTFOLIO\") */}\n            <div className=\"lg:col-span-6 flex flex-col items-start justify-end lg:justify-center space-y-5 pointer-events-auto\">\n              {/* Custom Inline SVG Comic Sticker Emblem */}\n              <svg\n                viewBox=\"0 0 560 225\"\n                className=\"w-full max-w-[510px] drop-shadow-[6px_8px_0px_#11121a]\"\n                role=\"img\"\n                aria-label=\"LYOOO PORTFOLIO\"\n              >\n                {/* White Outer Sticker Backing for LYOOO */}\n                <g transform=\"rotate(-3 260 85)\">\n                  <rect\n                    x=\"10\"\n                    y=\"12\"\n                    width=\"455\"\n                    height=\"108\"\n                    rx=\"18\"\n                    fill=\"#ffffff\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"8\"\n                  />\n                  <text\n                    x=\"32\"\n                    y=\"94\"\n                    fontFamily=\"\'Barlow\', sans-serif\"\n                    fontWeight=\"900\"\n                    fontStyle=\"italic\"\n                    fontSize=\"94\"\n                    letterSpacing=\"2\"\n                    fill=\"#ffffff\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"16\"\n                    paintOrder=\"stroke fill\"\n                  >\n                    LYOOO\n                  </text>\n                </g>\n\n                {/* Neon-Lime Sticker Backing (#b4ff39) for PORTFOLIO */}\n                <g transform=\"translate(24, 108) rotate(-1.5 220 45)\">\n                  <rect\n                    x=\"0\"\n                    y=\"0\"\n                    width=\"430\"\n                    height=\"84\"\n                    rx=\"14\"\n                    fill=\"#b4ff39\"\n                    stroke=\"#ffffff\"\n                    strokeWidth=\"10\"\n                  />\n                  <rect\n                    x=\"4\"\n                    y=\"4\"\n                    width=\"422\"\n                    height=\"76\"\n                    rx=\"11\"\n                    fill=\"#b4ff39\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"6\"\n                  />\n                  <text\n                    x=\"26\"\n                    y=\"61\"\n                    fontFamily=\"\'Barlow\', sans-serif\"\n                    fontWeight=\"900\"\n                    fontSize=\"58\"\n                    letterSpacing=\"4\"\n                    fill=\"#11121a\"\n                  >\n                    PORTFOLIO\n                  </text>\n                </g>\n              </svg>\n\n              <p className=\"max-w-lg text-sm sm:text-base font-semibold text-[#dfdfe2] leading-relaxed\">\n                Think this was just an AI prompt, huh? Think again! Forged with 2300+ hours of\n                love, Rapier physics, TSL toon shaders, and now reverse-engineered 1:1 for\n                WebGL &amp; Roblox Studio (Luau).\n              </p>\n\n              {/* Secondary Action: Inspect REA Report & Complete Roblox Luau Scripts */}\n              <div className=\"flex flex-wrap items-center gap-3 pt-1\">\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    soundEngine.playUiClick();\n                    setIsReaModalOpen(true);\n                  }}\n                  className=\"px-4 py-2.5 bg-[#272935] hover:bg-[#393b49] text-[#b8ff3c] font-black text-xs sm:text-sm rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow transition-transform hover:-translate-y-0.5 cursor-pointer whitespace-nowrap\"\n                >\n                  VIEW REA REPORT &amp; ROBLOX LUAU SCRIPTS\n                </button>\n              </div>\n            </div>\n\n            {/* Right Column: Hexagon Cutout Frame, Polygon Mute Button, and Tilted \"LET\'S GO\" CTA */}\n            <div className=\"lg:col-span-6 flex items-center justify-center\">\n              <div\n                ref={hexContainerRef}\n                className=\"relative w-[330px] h-[318px] sm:w-[440px] sm:h-[424px] lg:w-[485px] lg:h-[468px] pointer-events-none\"\n              >\n                {/* Exact Polygon Stroke Outline around Cutout (from CJn-Xu8f.js) */}\n                <svg\n                  width=\"100%\"\n                  height=\"100%\"\n                  viewBox=\"0 0 500 482\"\n                  fill=\"none\"\n                  className=\"absolute inset-0 w-full h-full\"\n                >\n                  <path\n                    d={REA_CONSTANTS.introHexagonSvgPath}\n                    fill=\"none\"\n                    stroke=\"rgba(255, 255, 255, 0.55)\"\n                    strokeWidth=\"3.5\"\n                  />\n                  <path\n                    d={REA_CONSTANTS.introHexagonSvgPath}\n                    fill=\"none\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"2\"\n                    strokeDasharray=\"10 6\"\n                  />\n                </svg>\n\n                {/* Top-Right Polygon Mute Audio Button (startup-intro__mute) */}\n                <button\n                  type=\"button\"\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    handleToggleAudio();\n                  }}\n                  aria-label={isMuted ? \'Unmute audio\' : \'Mute audio\'}\n                  className=\"pointer-events-auto absolute top-3 right-6 w-14 h-14 flex items-center justify-center bg-white hover:bg-[#fec83e] text-[#11121a] border-4 border-[#11121a] ring-2 ring-white rounded-2xl rotate-6 comic-sticker-shadow transition-transform hover:scale-105 active:scale-95 cursor-pointer\"\n                >\n                  {isMuted ? (\n                    <svg viewBox=\"0 0 24 24\" className=\"w-7 h-7\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\">\n                      <path d=\"M11 5L6 9H2v6h4l5 4V5z\" fill=\"#11121a\" />\n                      <line x1=\"22\" y1=\"9\" x2=\"16\" y2=\"15\" stroke=\"#f42f4c\" strokeWidth=\"3\" />\n                      <line x1=\"16\" y1=\"9\" x2=\"22\" y2=\"15\" stroke=\"#f42f4c\" strokeWidth=\"3\" />\n                    </svg>\n                  ) : (\n                    <svg viewBox=\"0 0 24 24\" className=\"w-7 h-7\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\">\n                      <path d=\"M11 5L6 9H2v6h4l5 4V5z\" fill=\"#11121a\" />\n                      <path d=\"M15.54 8.46a5 5 0 0 1 0 7.07\" />\n                      <path d=\"M19.07 4.93a10 10 0 0 1 0 14.14\" />\n                    </svg>\n                  )}\n                </button>\n\n                {/* Bottom Tilted Neon-Green \"LET\'S GO\" CTA Button (data-start=\"true\") */}\n                <button\n                  type=\"button\"\n                  data-start=\"true\"\n                  onClick={() => handleStartGame(false)}\n                  aria-label=\"LET\'S GO\"\n                  className=\"pointer-events-auto absolute -bottom-3 left-1/2 -translate-x-1/2 -rotate-3 hover:-rotate-6 hover:scale-108 active:scale-95 px-9 py-4 bg-[#b4ff39] hover:bg-[#c7ff72] text-[#11121a] font-black text-2xl sm:text-3xl tracking-wider rounded-2xl border-4 border-[#11121a] ring-4 ring-white comic-sticker-shadow-lg transition-all duration-150 cursor-pointer whitespace-nowrap\"\n                >\n                  LET&apos;S GO\n                </button>\n              </div>\n            </div>\n          </div>\n\n          {/* Flat Borderless Bottom Control Hint Line (game_title_and_hud.md Part I \302\2472.2) */}\n          <div className=\"relative z-10 pb-5 px-6 text-center text-xs sm:text-sm font-bold tracking-wide text-[#dfdfe2]/85\">\n            WASD Move &nbsp;\302\267&nbsp; Mouse Aim &nbsp;\302\267&nbsp; Space / Click Shoot &nbsp;\302\267&nbsp; Shift Boost &nbsp;\302\267&nbsp; G Physics Grab &nbsp;\302\267&nbsp; Esc Pause\n          </div>\n        </section>\n      )}\n\n      {/* =====================================================================\n          3. PLAYING HUD: WORLD-MATCHED COMIC CLUSTERS (>= 85% CLEAR VIEWPORT)\n         ===================================================================== */}\n      {gameState === \'playing\' && (\n        <div className=\"fixed inset-0 z-20 pointer-events-none flex flex-col justify-between p-4 sm:p-6\">\n          {/* Top Row: Left Player Vitality & Score Cluster | Right Compact Utility Buttons */}\n          <div className=\"flex items-start justify-between gap-4\">\n            {/* Top-Left Cluster: Vitality Pips + Tabular Score & Speed */}\n            <div className=\"pointer-events-auto flex flex-wrap items-center gap-3 bg-[#191b24]/95 border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl px-4 py-2.5 comic-sticker-shadow\">\n              {/* Custom SVG Tank Emblem + Discrete HP Vitality Pips */}\n              <div className=\"flex items-center gap-2.5 pr-3 border-r-2 border-[#393b49]\">\n                <svg viewBox=\"0 0 28 28\" className=\"w-7 h-7 shrink-0\" aria-hidden=\"true\">\n                  <rect x=\"2\" y=\"12\" width=\"22\" height=\"10\" rx=\"3\" fill=\"#b8ff3c\" stroke=\"#11121a\" strokeWidth=\"2.5\" />\n                  <rect x=\"7\" y=\"6\" width=\"11\" height=\"7\" rx=\"2\" fill=\"#c7ff72\" stroke=\"#11121a\" strokeWidth=\"2.5\" />\n                  <rect x=\"18\" y=\"8\" width=\"9\" height=\"3.5\" rx=\"1.5\" fill=\"#fec83e\" stroke=\"#11121a\" strokeWidth=\"2\" />\n                </svg>\n                <div>\n                  <div className=\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\">\n                    ARMOR HP\n                  </div>\n                  <div className=\"flex items-center gap-1 mt-0.5\">\n                    {Array.from({ length: 6 }).map((_, idx) => {\n                      const threshold = (idx + 1) * 5;\n                      const full = hud.hp >= threshold;\n                      const damaged = !full && hud.hp > threshold - 5;\n                      return (\n                        <span\n                          key={idx}\n                          className={`w-3.5 h-3.5 rounded-sm border-2 border-[#11121a] ${\n                            full\n                              ? \'bg-[#b8ff3c]\'\n                              : damaged\n                              ? \'bg-[#fec83e]\'\n                              : \'bg-[#272935]\'\n                          }`}\n                        />\n                      );\n                    })}\n                    <span className=\"ml-1.5 text-sm font-black font-mono-tabular text-white\">\n                      {hud.hp}/{hud.maxHp}\n                    </span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Hero Tabular Numerals: SCORE */}\n              <div className=\"pr-3 border-r-2 border-[#393b49]\">\n                <div className=\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\">\n                  SCORE\n                </div>\n                <div className=\"text-xl font-black font-mono-tabular text-[#b8ff3c] leading-none mt-0.5\">\n                  {hud.score}\n                </div>\n              </div>\n\n              {/* Hero Tabular Numerals: SPEED */}\n              <div className=\"pr-3 border-r-2 border-[#393b49]\">\n                <div className=\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\">\n                  SPEED {hud.isBoosting ? \'\302\267 BOOST\' : \'\'}\n                </div>\n                <div className=\"text-xl font-black font-mono-tabular text-[#fec83e] leading-none mt-0.5\">\n                  {hud.speedKmh} <span className=\"text-xs font-bold text-[#dfdfe2]\">KM/H</span>\n                </div>\n              </div>\n\n              {/* Factory Power Core Parts Counter */}\n              <div>\n                <div className=\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\">\n                  POWER CORE PARTS\n                </div>\n                <div className=\"flex items-center gap-1.5 mt-0.5\">\n                  {REQUIRED_ITEMS.map((item) => {\n                    const has = hud.collectedItems.includes(item);\n                    return (\n                      <span\n                        key={item}\n                        className={`px-1.5 py-0.5 text-[10px] font-black rounded border border-[#11121a] ${\n                          has\n                            ? \'bg-[#b8ff3c] text-[#11121a]\'\n                            : \'bg-[#272935] text-[#8f93a5]\'\n                        }`}\n                      >\n                        {item}\n                      </span>\n                    );\n                  })}\n                </div>\n              </div>\n            </div>\n\n            {/* Top-Right Compact Utility Icon Buttons (Mute [M], REA/Luau [R], Pause [P]) */}\n            <div className=\"pointer-events-auto flex items-center gap-2\">\n              <button\n                type=\"button\"\n                tabIndex={-1}\n                onClick={(e) => {\n                  e.currentTarget.blur();\n                  soundEngine.playUiClick();\n                  setIsReaModalOpen(true);\n                }}\n                aria-label=\"Open REA Report and Roblox Luau Code\"\n                className=\"px-3.5 h-11 flex items-center gap-2 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white comic-sticker-shadow cursor-pointer whitespace-nowrap\"\n              >\n                <span>REA &amp; LUAU [R]</span>\n              </button>\n\n              <button\n                type=\"button\"\n                tabIndex={-1}\n                onClick={(e) => {\n                  e.currentTarget.blur();\n                  handleToggleAudio();\n                }}\n                aria-label={isMuted ? \'Unmute Audio\' : \'Mute Audio\'}\n                className=\"w-11 h-11 flex items-center justify-center bg-[#191b24] hover:bg-[#272935] text-white font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow cursor-pointer\"\n              >\n                {isMuted ? \'MUTE\' : \'SND\'}\n              </button>\n\n              <button\n                type=\"button\"\n                tabIndex={-1}\n                onClick={(e) => {\n                  e.currentTarget.blur();\n                  handleTogglePause();\n                }}\n                aria-label=\"Pause Game\"\n                className=\"w-11 h-11 flex items-center justify-center bg-[#191b24] hover:bg-[#272935] text-white font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow cursor-pointer\"\n              >\n                II\n              </button>\n            </div>\n          </div>\n\n          {/* Unified Collapsible Bottom Control Dock (threejs skill \302\2475) */}\n          <div className=\"flex flex-col items-center\">\n            <button\n              type=\"button\"\n              tabIndex={-1}\n              onClick={(e) => {\n                e.currentTarget.blur();\n                setIsDockCollapsed((prev) => !prev);\n              }}\n              aria-label={isDockCollapsed ? \'Show Controls Dock\' : \'Hide Controls Dock\'}\n              className=\"pointer-events-auto mb-1.5 px-3 py-1 bg-[#191b24] hover:bg-[#272935] text-[#dfdfe2] font-extrabold text-xs rounded-lg border-2 border-[#11121a] comic-sticker-shadow cursor-pointer whitespace-nowrap\"\n            >\n              {isDockCollapsed ? \'\342\226\264 Show Controls [H]\' : \'\342\226\276 Hide Controls [H]\'}\n            </button>\n\n            {!isDockCollapsed && (\n              <div className=\"pointer-events-auto flex flex-wrap items-center justify-center gap-2 sm:gap-3 px-4 py-2.5 bg-[#191b24]/95 border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl comic-sticker-shadow max-w-[94vw]\">\n                {/* Lighting Cycle Switcher */}\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    handleCycleLighting();\n                  }}\n                  className=\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  Lighting [L]: <span className=\"text-[#fec83e] uppercase\">{lightingPreset}</span>\n                </button>\n\n                {/* Camera Frustum Toggle (WebGL 35\302\260 vs Roblox Isometric 18\302\260) */}\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    handleToggleFovMode();\n                  }}\n                  className=\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  Camera [C]:{\' \'}\n                  <span className=\"text-[#b8ff3c]\">\n                    {cameraFovMode === \'webgl35\' ? \'WebGL 35\302\260\' : \'Roblox Ortho 18\302\260\'}\n                  </span>\n                </button>\n\n                {/* Active Grab Mode Status */}\n                <div className=\"px-3 py-1.5 bg-[#11121a] text-xs font-extrabold rounded-lg border border-[#393b49] whitespace-nowrap\">\n                  Grab [G]:{\' \'}\n                  <span className={hud.isGrabMode ? \'text-[#fec83e]\' : \'text-[#8f93a5]\'}>\n                    {hud.isGrabMode\n                      ? hud.grabbedPropName\n                        ? `HOLDING ${hud.grabbedPropName}`\n                        : \'ACTIVE (AIM AT PROP)\'\n                      : \'OFF\'}\n                  </span>\n                </div>\n\n                {/* Enemies Defeated Counter */}\n                <div className=\"px-3 py-1.5 bg-[#11121a] text-xs font-extrabold font-mono-tabular rounded-lg border border-[#393b49] whitespace-nowrap\">\n                  BOTS: <span className=\"text-[#f42f4c]\">{hud.enemiesDefeated}/{hud.totalEnemies}</span>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* =====================================================================\n          4. PAUSE MODAL CARD (gameState === \'paused\')\n         ===================================================================== */}\n      {gameState === \'paused\' && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-labelledby=\"pause-modal-title\"\n          className=\"fixed inset-0 z-30 flex items-center justify-center p-4 pointer-events-auto\"\n          style={{ backgroundColor: \'rgba(17, 18, 26, 0.82)\' }}\n        >\n          <div className=\"w-full max-w-md bg-[#191b24] border-4 border-[#11121a] ring-4 ring-white rounded-2xl p-6 comic-sticker-shadow-lg text-center space-y-5\">\n            <h2\n              id=\"pause-modal-title\"\n              className=\"text-3xl font-black tracking-wide text-[#b8ff3c]\"\n            >\n              PLAYGROUND PAUSED\n            </h2>\n\n            <div className=\"grid grid-cols-3 gap-2.5 text-center\">\n              <div className=\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\">\n                <div className=\"text-[10px] font-black text-[#8f93a5]\">SCORE</div>\n                <div className=\"text-lg font-black font-mono-tabular text-white\">{hud.score}</div>\n              </div>\n              <div className=\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\">\n                <div className=\"text-[10px] font-black text-[#8f93a5]\">PARTS</div>\n                <div className=\"text-lg font-black font-mono-tabular text-[#fec83e]\">\n                  {hud.collectedItems.length}/4\n                </div>\n              </div>\n              <div className=\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\">\n                <div className=\"text-[10px] font-black text-[#8f93a5]\">BOTS KO</div>\n                <div className=\"text-lg font-black font-mono-tabular text-[#b8ff3c]\">\n                  {hud.enemiesDefeated}/{hud.totalEnemies}\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-2.5\">\n              <button\n                type=\"button\"\n                onClick={handleTogglePause}\n                className=\"w-full py-3 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-base rounded-xl border-3 border-[#11121a] comic-sticker-shadow cursor-pointer\"\n              >\n                RESUME GAMEPLAY [ESC]\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  soundEngine.playUiClick();\n                  setIsReaModalOpen(true);\n                }}\n                className=\"w-full py-3 bg-[#fec83e] hover:bg-[#fee763] text-[#11121a] font-black text-sm rounded-xl border-3 border-[#11121a] comic-sticker-shadow cursor-pointer\"\n              >\n                VIEW REA REPORT &amp; ROBLOX LUAU SCRIPTS\n              </button>\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => handleStartGame(true)}\n                  className=\"py-2.5 bg-[#272935] hover:bg-[#393b49] text-white font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer\"\n                >\n                  RESTART ARENA\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    soundEngine.playUiClick();\n                    document.body.dataset.state = \'title\';\n                    setGameState(\'title\');\n                  }}\n                  className=\"py-2.5 bg-[#272935] hover:bg-[#393b49] text-white font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer\"\n                >\n                  TITLE SCREEN\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* =====================================================================\n          5. VICTORY / GAME OVER MODAL CARD (gameState === \'gameover\')\n         ===================================================================== */}\n      {gameState === \'gameover\' && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-labelledby=\"gameover-modal-title\"\n          className=\"fixed inset-0 z-30 flex items-center justify-center p-4 pointer-events-auto\"\n          style={{ backgroundColor: \'rgba(17, 18, 26, 0.85)\' }}\n        >\n          <div className=\"w-full max-w-md bg-[#191b24] border-4 border-[#11121a] ring-4 ring-white rounded-2xl p-6 comic-sticker-shadow-lg text-center space-y-5\">\n            <h2\n              id=\"gameover-modal-title\"\n              className={`text-3xl font-black tracking-wide ${\n                (finalRunStats?.outcome || hud.outcome) === \'victory\'\n                  ? \'text-[#b8ff3c]\'\n                  : \'text-[#f42f4c]\'\n              }`}\n            >\n              {(finalRunStats?.outcome || hud.outcome) === \'victory\'\n                ? \'POWER CORE ACTIVATED!\'\n                : \'TANK DISABLED\'}\n            </h2>\n\n            <div className=\"grid grid-cols-3 gap-2.5 text-center\">\n              <div className=\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\">\n                <div className=\"text-[10px] font-black text-[#8f93a5]\">SCORE / BEST</div>\n                <div className=\"text-base font-black font-mono-tabular text-white\">\n                  {finalRunStats?.score ?? hud.score} / {finalRunStats?.bestScore ?? hud.bestScore}\n                </div>\n              </div>\n              <div className=\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\">\n                <div className=\"text-[10px] font-black text-[#8f93a5]\">CLEAR TIME</div>\n                <div className=\"text-base font-black font-mono-tabular text-[#fec83e]\">\n                  {finalRunStats?.clearTimeSec ?? hud.clearTimeSec}s\n                </div>\n              </div>\n              <div className=\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\">\n                <div className=\"text-[10px] font-black text-[#8f93a5]\">BOTS KO</div>\n                <div className=\"text-base font-black font-mono-tabular text-[#b8ff3c]\">\n                  {finalRunStats?.enemiesDefeated ?? hud.enemiesDefeated}/\n                  {finalRunStats?.totalEnemies ?? hud.totalEnemies}\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-2.5\">\n              <button\n                type=\"button\"\n                data-start=\"true\"\n                onClick={() => handleStartGame(true)}\n                className=\"w-full py-3.5 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-lg rounded-xl border-3 border-[#11121a] comic-sticker-shadow cursor-pointer\"\n              >\n                {(finalRunStats?.outcome || hud.outcome) === \'victory\'\n                  ? \'PLAY AGAIN\'\n                  : \'TRY AGAIN\'}\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  soundEngine.playUiClick();\n                  setIsReaModalOpen(true);\n                }}\n                className=\"w-full py-2.5 bg-[#fec83e] hover:bg-[#fee763] text-[#11121a] font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer\"\n              >\n                VIEW REA REPORT &amp; ROBLOX LUAU SCRIPTS\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* =====================================================================\n          6. REA EXTRACTION REPORT & ROBLOX STUDIO (LUAU) CODE MODAL\n         ===================================================================== */}\n      <ReaLuauModal\n        isOpen={isReaModalOpen}\n        onClose={() => setIsReaModalOpen(false)}\n      />\n    </main>\n  );\n}"
          replacement_content: "import React, { useState, useEffect, useCallback, useRef } from \'react\';\nimport {\n  FactoryPlaygroundCanvas,\n  GameState,\n  HudSnapshot,\n} from \'./game/FactoryPlaygroundCanvas\';\nimport {\n  REA_CONSTANTS,\n  LIGHTING_PRESETS,\n  LightingPresetKey,\n  CrateSlotType,\n  evaluateStackingPadRecipe,\n  BUDDY_CLASSES,\n  BuddyClassId,\n  TeamCommandMode,\n} from \'./game/rules\';\nimport { soundEngine } from \'./game/audio\';\nimport { ReaLuauModal } from \'./components/ReaLuauModal\';\n\nconst INITIAL_HUD: HudSnapshot = {\n  hp: 30,\n  maxHp: 30,\n  score: 0,\n  bestScore: 0,\n  speedKmh: 0,\n  isBoosting: false,\n  isGrabMode: false,\n  grabbedPropName: null,\n  collectedItems: [],\n  powerCoreActivated: false,\n  enemiesDefeated: 0,\n  totalEnemies: 4,\n  lightingPreset: \'day\',\n  cameraFovMode: \'webgl35\',\n  outcome: null,\n  clearTimeSec: 0,\n};\n\nconst PRESET_ORDER: LightingPresetKey[] = [\'day\', \'dusk\', \'night\', \'dawn\'];\nconst REQUIRED_ITEMS = [\'GEAR\', \'TOOLS\', \'CIRCUIT\', \'FUEL\'];\nconst BUDDY_CLASS_ORDER: BuddyClassId[] = [\n  \'Infuntry\',\n  \'Commando\',\n  \'Medic\',\n  \'Ninja\',\n  \'Cyborg\',\n  \'Stealthy\',\n  \'SuperBuddie\',\n];\nconst COMMAND_ORDER: TeamCommandMode[] = [\'FOLLOW\', \'HARVEST\', \'ATTACK\', \'DEFEND\', \'MOUNT\'];\n\nexport default function App() {\n  const [gameState, setGameState] = useState<GameState>(() => {\n    if (typeof window !== \'undefined\') {\n      const params = new URLSearchParams(window.location.search);\n      if (params.get(\'autostart\') === \'1\') {\n        return \'playing\';\n      }\n    }\n    return \'title\';\n  });\n\n  const [hud, setHud] = useState<HudSnapshot>(INITIAL_HUD);\n  const [finalRunStats, setFinalRunStats] = useState<HudSnapshot | null>(null);\n  const [lightingPreset, setLightingPreset] = useState<LightingPresetKey>(\'day\');\n  const [cameraFovMode, setCameraFovMode] = useState<\'webgl35\' | \'roblox18\'>(\'webgl35\');\n  const [isMuted, setIsMuted] = useState<boolean>(false);\n  const [isReaModalOpen, setIsReaModalOpen] = useState<boolean>(false);\n  const [isDockCollapsed, setIsDockCollapsed] = useState<boolean>(false);\n  const [resetTrigger, setResetTrigger] = useState<number>(0);\n\n  // Buddy Blitz 2x2x2 Stacking Pad (8 slots) + 7 Buddy Classes + Team Command (Q/V/Tab)\n  const [padSlots, setPadSlots] = useState<CrateSlotType[]>([\n    \'red\',\n    \'red\',\n    \'empty\',\n    \'empty\',\n    \'super\',\n    \'empty\',\n    \'empty\',\n    \'empty\',\n  ]);\n  const [activeBuddyClass, setActiveBuddyClass] = useState<BuddyClassId>(\'Ninja\');\n  const [teamCommand, setTeamCommand] = useState<TeamCommandMode>(\'HARVEST\');\n  const [lastCraftedItem, setLastCraftedItem] = useState<string>(\'Stealthy / Ninja\');\n\n  const padEval = evaluateStackingPadRecipe(padSlots);\n  const currentBuddySpec = BUDDY_CLASSES[activeBuddyClass];\n\n  const hexContainerRef = useRef<HTMLDivElement | null>(null);\n  const [hexRect, setHexRect] = useState<{ left: number; top: number; width: number; height: number }>({\n    left: 720,\n    top: 140,\n    width: 480,\n    height: 462,\n  });\n\n  useEffect(() => {\n    document.body.dataset.state = gameState;\n  }, [gameState]);\n\n  const syncHexBounds = useCallback(() => {\n    if (!hexContainerRef.current) return;\n    const r = hexContainerRef.current.getBoundingClientRect();\n    if (r.width > 0 && r.height > 0) {\n      setHexRect({\n        left: r.left,\n        top: r.top,\n        width: r.width,\n        height: r.height,\n      });\n    }\n  }, []);\n\n  useEffect(() => {\n    syncHexBounds();\n    window.addEventListener(\'resize\', syncHexBounds);\n    return () => window.removeEventListener(\'resize\', syncHexBounds);\n  }, [syncHexBounds, gameState]);\n\n  const handleStartGame = useCallback((shouldReset = false) => {\n    soundEngine.playUiClick();\n    if (document.activeElement instanceof HTMLElement) {\n      document.activeElement.blur();\n    }\n    if (shouldReset) {\n      setResetTrigger((prev) => prev + 1);\n      setFinalRunStats(null);\n    }\n    document.body.dataset.state = \'playing\';\n    setGameState(\'playing\');\n  }, []);\n\n  const handleToggleAudio = useCallback(() => {\n    const nextMuted = !soundEngine.muted;\n    soundEngine.muted = nextMuted;\n    setIsMuted(nextMuted);\n    if (!nextMuted) {\n      soundEngine.playUiClick();\n    }\n  }, []);\n\n  const handleCycleLighting = useCallback(() => {\n    soundEngine.playUiClick();\n    setLightingPreset((prev) => {\n      const idx = PRESET_ORDER.indexOf(prev);\n      return PRESET_ORDER[(idx + 1) % PRESET_ORDER.length];\n    });\n  }, []);\n\n  const handleToggleFovMode = useCallback(() => {\n    soundEngine.playUiClick();\n    setCameraFovMode((prev) => (prev === \'webgl35\' ? \'roblox18\' : \'webgl35\'));\n  }, []);\n\n  const handleAddCrateToPad = useCallback((crateType: \'red\' | \'super\') => {\n    soundEngine.playPickup();\n    setPadSlots((prev) => {\n      const emptyIdx = prev.findIndex((s) => s === \'empty\');\n      if (emptyIdx === -1) {\n        return [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'];\n      }\n      const next = [...prev];\n      next[emptyIdx] = crateType;\n      return next;\n    });\n  }, []);\n\n  const handleCraftPad = useCallback(() => {\n    soundEngine.playPowerCore();\n    setPadSlots((prev) => {\n      const evaluated = evaluateStackingPadRecipe(prev);\n      if (evaluated.totalCrates > 0) {\n        setLastCraftedItem(evaluated.outputName);\n      }\n      return [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'];\n    });\n  }, []);\n\n  const handleCycleCommand = useCallback(() => {\n    soundEngine.playUiClick();\n    setTeamCommand((prev) => {\n      const idx = COMMAND_ORDER.indexOf(prev);\n      return COMMAND_ORDER[(idx + 1) % COMMAND_ORDER.length];\n    });\n  }, []);\n\n  const handleSwapBuddy = useCallback(() => {\n    soundEngine.playUiClick();\n    setActiveBuddyClass((prev) => {\n      const idx = BUDDY_CLASS_ORDER.indexOf(prev);\n      return BUDDY_CLASS_ORDER[(idx + 1) % BUDDY_CLASS_ORDER.length];\n    });\n  }, []);\n\n  const handleTogglePause = useCallback(() => {\n    soundEngine.playUiClick();\n    setGameState((prev) => {\n      const next = prev === \'playing\' ? \'paused\' : prev === \'paused\' ? \'playing\' : prev;\n      document.body.dataset.state = next;\n      return next;\n    });\n  }, []);\n\n  const handleGameOver = useCallback(\n    (_outcome: \'victory\' | \'defeat\', snapshot: HudSnapshot) => {\n      setFinalRunStats(snapshot);\n      document.body.dataset.state = \'gameover\';\n      setGameState(\'gameover\');\n    },\n    [],\n  );\n\n  useEffect(() => {\n    const onKeyDown = (e: KeyboardEvent) => {\n      if (isReaModalOpen) {\n        if (e.code === \'Escape\') {\n          setIsReaModalOpen(false);\n        }\n        return;\n      }\n\n      if (gameState === \'title\' && (e.code === \'Enter\' || e.code === \'Space\')) {\n        e.preventDefault();\n        handleStartGame(false);\n        return;\n      }\n\n      if (e.code === \'KeyM\') {\n        handleToggleAudio();\n      } else if (e.code === \'KeyL\') {\n        handleCycleLighting();\n      } else if (e.code === \'KeyC\') {\n        handleToggleFovMode();\n      } else if (e.code === \'KeyH\') {\n        setIsDockCollapsed((prev) => !prev);\n      } else if (e.code === \'Digit1\' && gameState === \'playing\') {\n        handleAddCrateToPad(\'red\');\n      } else if (e.code === \'Digit2\' && gameState === \'playing\') {\n        handleAddCrateToPad(\'super\');\n      } else if (e.code === \'KeyF\' && gameState === \'playing\') {\n        handleCraftPad();\n      } else if (e.code === \'KeyV\' && gameState === \'playing\') {\n        handleCycleCommand();\n      } else if (e.code === \'Tab\' && gameState === \'playing\') {\n        e.preventDefault();\n        handleSwapBuddy();\n      } else if (e.code === \'KeyR\' && gameState === \'playing\') {\n        soundEngine.playUiClick();\n        setIsReaModalOpen(true);\n      }\n    };\n\n    window.addEventListener(\'keydown\', onKeyDown);\n    return () => window.removeEventListener(\'keydown\', onKeyDown);\n  }, [\n    gameState,\n    isReaModalOpen,\n    handleStartGame,\n    handleToggleAudio,\n    handleCycleLighting,\n    handleToggleFovMode,\n    handleAddCrateToPad,\n    handleCraftPad,\n    handleCycleCommand,\n    handleSwapBuddy,\n  ]);\n\n  const currentPresetConfig = LIGHTING_PRESETS[lightingPreset];\n  const scaleX = hexRect.width / 500;\n  const scaleY = hexRect.height / 482;\n\n  return (\n    <main className=\"relative w-screen h-screen overflow-hidden select-none\">\n      {/* 1. Isolated 60FPS Three.js Factory Playground Canvas */}\n      <FactoryPlaygroundCanvas\n        gameState={gameState}\n        lightingPreset={lightingPreset}\n        cameraFovMode={cameraFovMode}\n        resetTrigger={resetTrigger}\n        onHudUpdate={setHud}\n        onGameOver={handleGameOver}\n        onTogglePause={handleTogglePause}\n      />\n\n      {/* Atmospheric Viewport Color Tint Overlay */}\n      <div\n        aria-hidden=\"true\"\n        className=\"fixed inset-0 pointer-events-none z-10 transition-colors duration-700\"\n        style={{\n          backgroundColor: currentPresetConfig.viewportFilterColor,\n          opacity: currentPresetConfig.viewportFilterOpacity,\n        }}\n      />\n\n      {/* =====================================================================\n          2. TITLE SCREEN: HEXAGON CUTOUT & COMIC STICKER LOCKUP (CJn-Xu8f.js)\n         ===================================================================== */}\n      {gameState === \'title\' && (\n        <section\n          aria-label=\"LYOOO Portfolio Title Screen\"\n          className=\"fixed inset-0 z-20 flex flex-col justify-between pointer-events-none\"\n        >\n          <svg\n            className=\"fixed inset-0 w-full h-full pointer-events-none\"\n            width=\"100%\"\n            height=\"100%\"\n            preserveAspectRatio=\"none\"\n          >\n            <defs>\n              <mask\n                id=\"intro-mask-cutout\"\n                maskUnits=\"userSpaceOnUse\"\n                x=\"0\"\n                y=\"0\"\n                width=\"100%\"\n                height=\"100%\"\n              >\n                <rect width=\"100%\" height=\"100%\" fill=\"white\" />\n                <g\n                  transform={`translate(${hexRect.left}, ${hexRect.top}) scale(${scaleX}, ${scaleY})`}\n                >\n                  <path d={REA_CONSTANTS.introHexagonSvgPath} fill=\"black\" />\n                </g>\n              </mask>\n              <linearGradient id=\"intro-overlay-gradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                <stop offset=\"0%\" stopColor=\"#0b0c12\" stopOpacity=\"0.94\" />\n                <stop offset=\"52%\" stopColor=\"#11121a\" stopOpacity=\"0.86\" />\n                <stop offset=\"100%\" stopColor=\"#11121a\" stopOpacity=\"0.72\" />\n              </linearGradient>\n            </defs>\n            <rect\n              width=\"100%\"\n              height=\"100%\"\n              fill=\"url(#intro-overlay-gradient)\"\n              mask=\"url(#intro-mask-cutout)\"\n            />\n          </svg>\n\n          <div className=\"relative z-10 flex-1 grid grid-cols-1 lg:grid-cols-12 items-center px-6 sm:px-12 lg:px-16 pt-8 pb-4 gap-6\">\n            <div className=\"lg:col-span-6 flex flex-col items-start justify-end lg:justify-center space-y-5 pointer-events-auto\">\n              <svg\n                viewBox=\"0 0 560 225\"\n                className=\"w-full max-w-[510px] drop-shadow-[6px_8px_0px_#11121a]\"\n                role=\"img\"\n                aria-label=\"LYOOO PORTFOLIO\"\n              >\n                <g transform=\"rotate(-3 260 85)\">\n                  <rect\n                    x=\"10\"\n                    y=\"12\"\n                    width=\"455\"\n                    height=\"108\"\n                    rx=\"18\"\n                    fill=\"#ffffff\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"8\"\n                  />\n                  <text\n                    x=\"32\"\n                    y=\"94\"\n                    fontFamily=\"\'Barlow\', sans-serif\"\n                    fontWeight=\"900\"\n                    fontStyle=\"italic\"\n                    fontSize=\"94\"\n                    letterSpacing=\"2\"\n                    fill=\"#ffffff\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"16\"\n                    paintOrder=\"stroke fill\"\n                  >\n                    LYOOO\n                  </text>\n                </g>\n\n                <g transform=\"translate(24, 108) rotate(-1.5 220 45)\">\n                  <rect\n                    x=\"0\"\n                    y=\"0\"\n                    width=\"430\"\n                    height=\"84\"\n                    rx=\"14\"\n                    fill=\"#b4ff39\"\n                    stroke=\"#ffffff\"\n                    strokeWidth=\"10\"\n                  />\n                  <rect\n                    x=\"4\"\n                    y=\"4\"\n                    width=\"422\"\n                    height=\"76\"\n                    rx=\"11\"\n                    fill=\"#b4ff39\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"6\"\n                  />\n                  <text\n                    x=\"26\"\n                    y=\"61\"\n                    fontFamily=\"\'Barlow\', sans-serif\"\n                    fontWeight=\"900\"\n                    fontSize=\"58\"\n                    letterSpacing=\"4\"\n                    fill=\"#11121a\"\n                  >\n                    PORTFOLIO\n                  </text>\n                </g>\n              </svg>\n\n              <div className=\"flex flex-wrap items-center gap-3 pt-1\">\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    soundEngine.playUiClick();\n                    setIsReaModalOpen(true);\n                  }}\n                  className=\"px-4 py-2.5 bg-[#272935] hover:bg-[#393b49] text-[#b8ff3c] font-black text-xs sm:text-sm rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow transition-transform hover:-translate-y-0.5 cursor-pointer whitespace-nowrap\"\n                >\n                  Kode Luau\n                </button>\n              </div>\n            </div>\n\n            <div className=\"lg:col-span-6 flex items-center justify-center\">\n              <div\n                ref={hexContainerRef}\n                className=\"relative w-[330px] h-[318px] sm:w-[440px] sm:h-[424px] lg:w-[485px] lg:h-[468px] pointer-events-none\"\n              >\n                <svg\n                  width=\"100%\"\n                  height=\"100%\"\n                  viewBox=\"0 0 500 482\"\n                  fill=\"none\"\n                  className=\"absolute inset-0 w-full h-full\"\n                >\n                  <path\n                    d={REA_CONSTANTS.introHexagonSvgPath}\n                    fill=\"none\"\n                    stroke=\"rgba(255, 255, 255, 0.55)\"\n                    strokeWidth=\"3.5\"\n                  />\n                  <path\n                    d={REA_CONSTANTS.introHexagonSvgPath}\n                    fill=\"none\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"2\"\n                    strokeDasharray=\"10 6\"\n                  />\n                </svg>\n\n                <button\n                  type=\"button\"\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    handleToggleAudio();\n                  }}\n                  aria-label={isMuted ? \'Suara Mati\' : \'Suara Aktif\'}\n                  className=\"pointer-events-auto absolute top-3 right-6 w-14 h-14 flex items-center justify-center bg-white hover:bg-[#fec83e] text-[#11121a] font-black text-xs border-4 border-[#11121a] ring-2 ring-white rounded-2xl rotate-6 comic-sticker-shadow transition-transform hover:scale-105 active:scale-95 cursor-pointer\"\n                >\n                  {isMuted ? \'MUTE\' : \'SUARA\'}\n                </button>\n\n                <button\n                  type=\"button\"\n                  data-start=\"true\"\n                  onClick={() => handleStartGame(false)}\n                  aria-label=\"LET\'S GO\"\n                  className=\"pointer-events-auto absolute -bottom-3 left-1/2 -translate-x-1/2 -rotate-3 hover:-rotate-6 hover:scale-108 active:scale-95 px-9 py-4 bg-[#b4ff39] hover:bg-[#c7ff72] text-[#11121a] font-black text-2xl sm:text-3xl tracking-wider rounded-2xl border-4 border-[#11121a] ring-4 ring-white comic-sticker-shadow-lg transition-all duration-150 cursor-pointer whitespace-nowrap\"\n                >\n                  LET&apos;S GO\n                </button>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"relative z-10 pb-5 px-6 text-center text-xs sm:text-sm font-bold tracking-wide text-[#dfdfe2]/85\">\n            WASD Gerak &nbsp;\302\267&nbsp; Klik Tembak &nbsp;\302\267&nbsp; Shift Boost &nbsp;\302\267&nbsp; G Angkat &nbsp;\302\267&nbsp; F Rakit\n          </div>\n        </section>\n      )}\n\n      {/* =====================================================================\n          3. PLAYING HUD: WORLD-MATCHED COMIC CLUSTERS (>= 85% CLEAR VIEWPORT)\n         ===================================================================== */}\n      {gameState === \'playing\' && (\n        <div className=\"fixed inset-0 z-20 pointer-events-none flex flex-col justify-between p-4 sm:p-6\">\n          {/* Top Row */}\n          <div className=\"flex items-start justify-between gap-4\">\n            {/* Top-Left Cluster: Vitality + Score + Stacking Pad 2x2x2 */}\n            <div className=\"pointer-events-auto flex flex-wrap items-center gap-3 bg-[#191b24]/95 border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl px-4 py-2.5 comic-sticker-shadow\">\n              <div className=\"pr-3 border-r-2 border-[#393b49]\">\n                <div className=\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\">\n                  ARMOR HP\n                </div>\n                <div className=\"flex items-center gap-1 mt-0.5\">\n                  {Array.from({ length: 6 }).map((_, idx) => {\n                    const threshold = (idx + 1) * 5;\n                    const full = hud.hp >= threshold;\n                    const damaged = !full && hud.hp > threshold - 5;\n                    return (\n                      <span\n                        key={idx}\n                        className={`w-3.5 h-3.5 rounded-sm border-2 border-[#11121a] ${\n                          full\n                            ? \'bg-[#b8ff3c]\'\n                            : damaged\n                            ? \'bg-[#fec83e]\'\n                            : \'bg-[#272935]\'\n                        }`}\n                      />\n                    );\n                  })}\n                  <span className=\"ml-1.5 text-sm font-black font-mono-tabular text-white\">\n                    {hud.hp}/{hud.maxHp}\n                  </span>\n                </div>\n              </div>\n\n              <div className=\"pr-3 border-r-2 border-[#393b49]\">\n                <div className=\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\">\n                  SKOR\n                </div>\n                <div className=\"text-xl font-black font-mono-tabular text-[#b8ff3c] leading-none mt-0.5\">\n                  {hud.score}\n                </div>\n              </div>\n\n              {/* 2x2x2 Stacking Pad Status */}\n              <div className=\"pr-3 border-r-2 border-[#393b49]\">\n                <div className=\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\">\n                  PAD {padEval.shapeKey} {padEval.isMerged ? \'\302\267 MERGED\' : \'\'}\n                </div>\n                <div className=\"flex items-center gap-1 mt-0.5\">\n                  {padSlots.map((slot, idx) => (\n                    <span\n                      key={idx}\n                      className={`w-3 h-3 rounded-xs border border-[#11121a] ${\n                        slot === \'super\'\n                          ? \'bg-[#00d2ff]\'\n                          : slot === \'red\'\n                          ? \'bg-[#ff3b30]\'\n                          : \'bg-[#272935]\'\n                      }`}\n                    />\n                  ))}\n                  <span\n                    className={`ml-1.5 text-xs font-black ${\n                      padEval.isSuper ? \'text-[#00d2ff]\' : \'text-[#fec83e]\'\n                    }`}\n                  >\n                    {padEval.outputName}\n                  </span>\n                </div>\n              </div>\n\n              {/* Power Core Parts */}\n              <div>\n                <div className=\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\">\n                  INTI ENERGI\n                </div>\n                <div className=\"flex items-center gap-1.5 mt-0.5\">\n                  {REQUIRED_ITEMS.map((item) => {\n                    const has = hud.collectedItems.includes(item);\n                    return (\n                      <span\n                        key={item}\n                        className={`px-1.5 py-0.5 text-[10px] font-black rounded border border-[#11121a] ${\n                          has\n                            ? \'bg-[#b8ff3c] text-[#11121a]\'\n                            : \'bg-[#272935] text-[#8f93a5]\'\n                        }`}\n                      >\n                        {item}\n                      </span>\n                    );\n                  })}\n                </div>\n              </div>\n            </div>\n\n            {/* Top-Right Compact Utility Buttons */}\n            <div className=\"pointer-events-auto flex items-center gap-2\">\n              <button\n                type=\"button\"\n                tabIndex={-1}\n                onClick={(e) => {\n                  e.currentTarget.blur();\n                  soundEngine.playUiClick();\n                  setIsReaModalOpen(true);\n                }}\n                aria-label=\"Kode Luau\"\n                className=\"px-3.5 h-11 flex items-center gap-2 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white comic-sticker-shadow cursor-pointer whitespace-nowrap\"\n              >\n                <span>Kode Luau</span>\n              </button>\n\n              <button\n                type=\"button\"\n                tabIndex={-1}\n                onClick={(e) => {\n                  e.currentTarget.blur();\n                  handleToggleAudio();\n                }}\n                aria-label={isMuted ? \'Suara Mati\' : \'Suara Aktif\'}\n                className=\"w-14 h-11 flex items-center justify-center bg-[#191b24] hover:bg-[#272935] text-white font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow cursor-pointer\"\n              >\n                {isMuted ? \'MUTE\' : \'SUARA\'}\n              </button>\n\n              <button\n                type=\"button\"\n                tabIndex={-1}\n                onClick={(e) => {\n                  e.currentTarget.blur();\n                  handleTogglePause();\n                }}\n                aria-label=\"Jeda\"\n                className=\"w-14 h-11 flex items-center justify-center bg-[#191b24] hover:bg-[#272935] text-white font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow cursor-pointer\"\n              >\n                JEDA\n              </button>\n            </div>\n          </div>\n\n          {/* Unified Collapsible Bottom Control Dock */}\n          <div className=\"flex flex-col items-center\">\n            <button\n              type=\"button\"\n              tabIndex={-1}\n              onClick={(e) => {\n                e.currentTarget.blur();\n                setIsDockCollapsed((prev) => !prev);\n              }}\n              aria-label={isDockCollapsed ? \'Buka Panel\' : \'Tutup Panel\'}\n              className=\"pointer-events-auto mb-1.5 px-3 py-1 bg-[#191b24] hover:bg-[#272935] text-[#dfdfe2] font-extrabold text-xs rounded-lg border-2 border-[#11121a] comic-sticker-shadow cursor-pointer whitespace-nowrap\"\n            >\n              {isDockCollapsed ? \'Buka Panel\' : \'Tutup Panel\'}\n            </button>\n\n            {!isDockCollapsed && (\n              <div className=\"pointer-events-auto flex flex-wrap items-center justify-center gap-2 px-4 py-2.5 bg-[#191b24]/95 border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl comic-sticker-shadow max-w-[96vw]\">\n                {/* Add Red Crate [1] */}\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    handleAddCrateToPad(\'red\');\n                  }}\n                  className=\"px-3 py-1.5 bg-[#ff3b30] hover:bg-[#ff554a] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  Peti Merah\n                </button>\n\n                {/* Add Super Crate [2] */}\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    handleAddCrateToPad(\'super\');\n                  }}\n                  className=\"px-3 py-1.5 bg-[#00d2ff] hover:bg-[#33dbff] text-[#11121a] font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  Peti Super\n                </button>\n\n                {/* Kick / Craft Pad [F] */}\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    handleCraftPad();\n                  }}\n                  className=\"px-3 py-1.5 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  Rakit: {lastCraftedItem}\n                </button>\n\n                {/* Buddy Swap [Tab] */}\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    handleSwapBuddy();\n                  }}\n                  className=\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  Kelas: <span className=\"text-[#b8ff3c]\">{currentBuddySpec.name}</span>\n                </button>\n\n                {/* Team Command [V] */}\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    handleCycleCommand();\n                  }}\n                  className=\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  Komando: <span className=\"text-[#fec83e]\">{teamCommand}</span>\n                </button>\n\n                {/* Lighting Cycle [L] */}\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    handleCycleLighting();\n                  }}\n                  className=\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  Cuaca: <span className=\"text-[#fec83e] uppercase\">{lightingPreset}</span>\n                </button>\n\n                {/* Camera Toggle [C] */}\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    handleToggleFovMode();\n                  }}\n                  className=\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  Kamera:{\' \'}\n                  <span className=\"text-[#b8ff3c]\">\n                    {cameraFovMode === \'webgl35\' ? \'WebGL 35\' : \'Ortho 18\'}\n                  </span>\n                </button>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* =====================================================================\n          4. PAUSE MODAL CARD (gameState === \'paused\')\n         ===================================================================== */}\n      {gameState === \'paused\' && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-labelledby=\"pause-modal-title\"\n          className=\"fixed inset-0 z-30 flex items-center justify-center p-4 pointer-events-auto\"\n          style={{ backgroundColor: \'rgba(17, 18, 26, 0.82)\' }}\n        >\n          <div className=\"w-full max-w-md bg-[#191b24] border-4 border-[#11121a] ring-4 ring-white rounded-2xl p-6 comic-sticker-shadow-lg text-center space-y-5\">\n            <h2\n              id=\"pause-modal-title\"\n              className=\"text-3xl font-black tracking-wide text-[#b8ff3c]\"\n            >\n              Permainan Dijeda\n            </h2>\n\n            <div className=\"grid grid-cols-3 gap-2.5 text-center\">\n              <div className=\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\">\n                <div className=\"text-[10px] font-black text-[#8f93a5]\">SKOR</div>\n                <div className=\"text-lg font-black font-mono-tabular text-white\">{hud.score}</div>\n              </div>\n              <div className=\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\">\n                <div className=\"text-[10px] font-black text-[#8f93a5]\">KOMPONEN</div>\n                <div className=\"text-lg font-black font-mono-tabular text-[#fec83e]\">\n                  {hud.collectedItems.length}/4\n                </div>\n              </div>\n              <div className=\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\">\n                <div className=\"text-[10px] font-black text-[#8f93a5]\">MUSUH KO</div>\n                <div className=\"text-lg font-black font-mono-tabular text-[#b8ff3c]\">\n                  {hud.enemiesDefeated}/{hud.totalEnemies}\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-2.5\">\n              <button\n                type=\"button\"\n                onClick={handleTogglePause}\n                className=\"w-full py-3 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-base rounded-xl border-3 border-[#11121a] comic-sticker-shadow cursor-pointer\"\n              >\n                Lanjut Main\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  soundEngine.playUiClick();\n                  setIsReaModalOpen(true);\n                }}\n                className=\"w-full py-3 bg-[#fec83e] hover:bg-[#fee763] text-[#11121a] font-black text-sm rounded-xl border-3 border-[#11121a] comic-sticker-shadow cursor-pointer\"\n              >\n                Kode Luau\n              </button>\n              <div className=\"grid grid-cols-2 gap-2.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => handleStartGame(true)}\n                  className=\"py-2.5 bg-[#272935] hover:bg-[#393b49] text-white font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer\"\n                >\n                  Ulangi Arena\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    soundEngine.playUiClick();\n                    document.body.dataset.state = \'title\';\n                    setGameState(\'title\');\n                  }}\n                  className=\"py-2.5 bg-[#272935] hover:bg-[#393b49] text-white font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer\"\n                >\n                  Layar Utama\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* =====================================================================\n          5. VICTORY / GAME OVER MODAL CARD (gameState === \'gameover\')\n         ===================================================================== */}\n      {gameState === \'gameover\' && (\n        <div\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-labelledby=\"gameover-modal-title\"\n          className=\"fixed inset-0 z-30 flex items-center justify-center p-4 pointer-events-auto\"\n          style={{ backgroundColor: \'rgba(17, 18, 26, 0.85)\' }}\n        >\n          <div className=\"w-full max-w-md bg-[#191b24] border-4 border-[#11121a] ring-4 ring-white rounded-2xl p-6 comic-sticker-shadow-lg text-center space-y-5\">\n            <h2\n              id=\"gameover-modal-title\"\n              className={`text-3xl font-black tracking-wide ${\n                (finalRunStats?.outcome || hud.outcome) === \'victory\'\n                  ? \'text-[#b8ff3c]\'\n                  : \'text-[#f42f4c]\'\n              }`}\n            >\n              {(finalRunStats?.outcome || hud.outcome) === \'victory\'\n                ? \'Tim Menang\'\n                : \'Tank Hancur\'}\n            </h2>\n\n            <div className=\"grid grid-cols-3 gap-2.5 text-center\">\n              <div className=\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\">\n                <div className=\"text-[10px] font-black text-[#8f93a5]\">SKOR</div>\n                <div className=\"text-base font-black font-mono-tabular text-white\">\n                  {finalRunStats?.score ?? hud.score} / {finalRunStats?.bestScore ?? hud.bestScore}\n                </div>\n              </div>\n              <div className=\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\">\n                <div className=\"text-[10px] font-black text-[#8f93a5]\">WAKTU</div>\n                <div className=\"text-base font-black font-mono-tabular text-[#fec83e]\">\n                  {finalRunStats?.clearTimeSec ?? hud.clearTimeSec}s\n                </div>\n              </div>\n              <div className=\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\">\n                <div className=\"text-[10px] font-black text-[#8f93a5]\">MUSUH KO</div>\n                <div className=\"text-base font-black font-mono-tabular text-[#b8ff3c]\">\n                  {finalRunStats?.enemiesDefeated ?? hud.enemiesDefeated}/\n                  {finalRunStats?.totalEnemies ?? hud.totalEnemies}\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex flex-col gap-2.5\">\n              <button\n                type=\"button\"\n                data-start=\"true\"\n                onClick={() => handleStartGame(true)}\n                className=\"w-full py-3.5 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-lg rounded-xl border-3 border-[#11121a] comic-sticker-shadow cursor-pointer\"\n              >\n                Main Lagi\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  soundEngine.playUiClick();\n                  setIsReaModalOpen(true);\n                }}\n                className=\"w-full py-2.5 bg-[#fec83e] hover:bg-[#fee763] text-[#11121a] font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer\"\n              >\n                Kode Luau\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* =====================================================================\n          6. REA EXTRACTION REPORT & ROBLOX STUDIO (LUAU) CODE MODAL\n         ===================================================================== */}\n      <ReaLuauModal\n        isOpen={isReaModalOpen}\n        onClose={() => setIsReaModalOpen(false)}\n      />\n    </main>\n  );\n}\n"
