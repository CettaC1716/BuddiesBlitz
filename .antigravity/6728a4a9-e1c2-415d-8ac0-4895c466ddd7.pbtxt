    content: "        }\n      }\n\n      if (nearestCrate) {\n        playerUnit.carryingCrate = nearestCrate.kind;\n        playerUnit.overheadCrateBox.material =\n          nearestCrate.kind === \'super\' ? matSuperCrate : matRedCrate;\n        playerUnit.overheadCrateGroup.visible = true;\n        scene.remove(nearestCrate.mesh);\n        const idx = worldCrates.indexOf(nearestCrate);\n        if (idx !== -1) worldCrates.splice(idx, 1);\n        soundEngine.playPickup();\n      }\n    };\n\n    const handlePlayerKickOrCraft = () => {\n      const actorX = mountedTank ? mountedTank.x : playerUnit.x;\n      const actorZ = mountedTank ? mountedTank.z : playerUnit.z;\n\n      // 1. Check if near Blue Team Stacking Pad (within 8.5m) and pad has crates\n      const distToPad = Math.hypot(actorX - blueBase.padX, actorZ - blueBase.padZ);\n      const padEval = evaluateStackingPadRecipe(bluePadSlots);\n\n      if (distToPad <= 8.5 && padEval.totalCrates > 0) {\n        soundEngine.playPowerCore();\n        spawnBurstParticles(blueBase.padX, 2.0, blueBase.padZ, 18);\n\n        const spawnX = blueBase.padX + 3.6;\n        const spawnZ = blueBase.padZ - 1.5;\n\n        if (padEval.spawnType === \'tank\') {\n          // 8 Crates (2x2x2) -> Spawn 3D Lyo Tank or Super Tyrant Tank!\n          const newTank = createLyoTankVehicle(spawnX, spawnZ, padEval.isSuper, \'blue\');\n          tanks.push(newTank);\n          score += padEval.isSuper ? 500 : 350;\n        } else if (padEval.spawnType === \'buddy\') {\n          // 2 Vertical (1x1x2) or 4 Vertical (2x1x2) -> Spawn 3D Allied AI Buddy!\n          let chosenClass: BuddyClassId = BLUE_BUDDY_ROTATION[blueBuddyClassIdx % BLUE_BUDDY_ROTATION.length];\n          blueBuddyClassIdx++;\n          if (padEval.category === \'buddy_t2\') {\n            chosenClass = padEval.isSuper ? \'SuperBuddie\' : \'Cyborg\';\n          } else if (padEval.isSuper) {\n            chosenClass = \'Stealthy\';\n          }\n          const newBuddy = createBuddyCharacterUnit(\n            \'blue\',\n            false,\n            chosenClass,\n            spawnX + (Math.random() - 0.5) * 2,\n            spawnZ + (Math.random() - 0.5) * 2,\n          );\n          buddyUnits.push(newBuddy);\n          score += 220;\n        } else {\n          // 1x1x1, 2x1x1, or 2x2x1 -> Spawn 3D Weapon Pickup & also auto-equip player!\n          const wName = padEval.outputName;\n          spawnWorldPickup(\'weapon\', wName, spawnX, spawnZ);\n          playerUnit.weaponName = wName;\n          playerUnit.ammo = 200;\n          score += 140;\n        }\n\n        bluePadSlots = [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'];\n        syncPadVisuals(blueBase, bluePadSlots, \'BLUE\', blueBaseHp);\n        return;\n      }\n\n      // 2. Otherwise if near a loose crate outside the Pad -> Kick it open into Health + Ammo!\n      let nearestCrate: WorldCrate | null = null;\n      let bestDist = 4.2;\n      for (const c of worldCrates) {\n        if (c.state === \'grounded\') {\n          const d = Math.hypot(c.x - actorX, c.z - actorZ);\n          if (d < bestDist) {\n            bestDist = d;\n            nearestCrate = c;\n          }\n        }\n      }\n\n      if (nearestCrate) {\n        soundEngine.playHit();\n        spawnBurstParticles(nearestCrate.x, 0.9, nearestCrate.z, 10);\n        spawnWorldPickup(\'health\', \'Health +25\', nearestCrate.x - 0.9, nearestCrate.z);\n        spawnWorldPickup(\'ammo\', \'Ammo +50\', nearestCrate.x + 0.9, nearestCrate.z);\n        scene.remove(nearestCrate.mesh);\n        const idx = worldCrates.indexOf(nearestCrate);\n        if (idx !== -1) worldCrates.splice(idx, 1);\n      }\n    };\n\n    const handleToggleMountTank = () => {\n      // Dismount if currently riding a Tank\n      if (mountedTank) {\n        soundEngine.playUiClick();\n        mountedTank.occupiedByPlayer = false;\n        mountedTank.riderGroup.visible = false;\n        playerUnit.x = clamp(mountedTank.x - 2.6, -38, 38);\n        playerUnit.z = clamp(mountedTank.z + 1.2, -38, 38);\n        playerUnit.root.position.set(playerUnit.x, 0, playerUnit.z);\n        playerUnit.root.visible = true;\n        mountedTank = null;\n        return;\n      }\n\n      // Otherwise check if near any unoccupied Tank within 4.8m -> Mount into Open-Top Turret!\n      if (!playerUnit.alive) return;\n      let nearestTank: TankVehicle | null = null;\n      let bestDist = 4.8;\n      for (const t of tanks) {\n        if (!t.occupiedByPlayer && t.hp > 0) {\n          const d = Math.hypot(t.x - playerUnit.x, t.z - playerUnit.z);\n          if (d < bestDist) {\n            bestDist = d;\n            nearestTank = t;\n          }\n        }\n      }\n\n      if (nearestTank) {\n        soundEngine.playPickup();\n        // If player was carrying a crate, store it inside the tank!\n        if (playerUnit.carryingCrate !== \'none\' && nearestTank.storedCrates.length < 4) {\n          nearestTank.storedCrates.push(playerUnit.carryingCrate);\n          playerUnit.carryingCrate = \'none\';\n          playerUnit.overheadCrateGroup.visible = false;\n        }\n        mountedTank = nearestTank;\n        nearestTank.occupiedByPlayer = true;\n        nearestTank.riderGroup.visible = true;\n        playerUnit.root.visible = false;\n      }\n    };\n\n    const handleCycleBuildOrder = () => {\n      soundEngine.playUiClick();\n      const idx = BUILD_ORDER_CYCLE.indexOf(buildOrder);\n      buildOrder = BUILD_ORDER_CYCLE[(idx + 1) % BUILD_ORDER_CYCLE.length];\n    };\n\n    const handleCycleTeamCommand = () => {\n      soundEngine.playUiClick();\n      const idx = COMMAND_CYCLE.indexOf(teamCommand);\n      teamCommand = COMMAND_CYCLE[(idx + 1) % COMMAND_CYCLE.length];\n    };\n\n    const handleSwapBuddy = () => {\n      if (mountedTank) return;\n      const alliedPool = buddyUnits.filter((b) => b.team === \'blue\' && b.alive);\n      if (alliedPool.length <= 1) return;\n      soundEngine.playUiClick();\n      const currentIdx = alliedPool.indexOf(playerUnit);\n      const nextBuddy = alliedPool[(currentIdx + 1) % alliedPool.length];\n      playerUnit.isPlayer = false;\n      (playerUnit.teamRing.material as THREE.MeshBasicMaterial).color.setHex(0x2979ff);\n      nextBuddy.isPlayer = true;\n      (nextBuddy.teamRing.material as THREE.MeshBasicMaterial).color.setHex(0xb4ff39);\n      playerUnit = nextBuddy;\n    };\n\n    // =========================================================================\n    // 11. INPUT LISTENERS (WASD, MOUSE AIM, CLICK SHOOT, E/F/G/Q/V/TAB)\n    // =========================================================================\n    const keys: Record<string, boolean> = {};\n    const mouseNdc = new THREE.Vector2(0, 0);"
