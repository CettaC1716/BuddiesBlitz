            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // 9. Camera Follow Update (Exact 1:1 port of CQl67Veh.js)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const springStep = stepCriticalDampedSpring3D("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        cameraState.targetEased,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
