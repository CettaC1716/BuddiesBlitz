    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst path = require(\"path\");\nconst dir = \"extracted_lyo_assets/models\";\nconst files = fs.readdirSync(dir).filter(f => f.endsWith(\".glb\")).sort();\nfor (const f of files) {\n  const buf = fs.readFileSync(path.join(dir, f));\n  const jsonLen = buf.readUInt32LE(12);\n  const jsonStr = buf.slice(20, 20 + jsonLen).toString(\"utf8\");\n  const gltf = JSON.parse(jsonStr);\n  const nodes = (gltf.nodes || []).map(n => n.name).filter(Boolean);\n  const meshes = (gltf.meshes || []).map(m => m.name).filter(Boolean);\n  const materials = (gltf.materials || []).map(m => m.name).filter(Boolean);\n  const exts = gltf.extensionsUsed || [];\n  console.log(f, \"size:\", buf.length, \"exts:\", exts.join(\",\"), \"nodes:\", nodes.slice(0, 12).join(\",\"), \"mats:\", materials.join(\",\"));\n}\n\'"
    proposed_command_line: "node -e \'\nconst fs = require(\"fs\");\nconst path = require(\"path\");\nconst dir = \"extracted_lyo_assets/models\";\nconst files = fs.readdirSync(dir).filter(f => f.endsWith(\".glb\")).sort();\nfor (const f of files) {\n  const buf = fs.readFileSync(path.join(dir, f));\n  const jsonLen = buf.readUInt32LE(12);\n  const jsonStr = buf.slice(20, 20 + jsonLen).toString(\"utf8\");\n  const gltf = JSON.parse(jsonStr);\n  const nodes = (gltf.nodes || []).map(n => n.name).filter(Boolean);\n  const meshes = (gltf.meshes || []).map(m => m.name).filter(Boolean);\n  const materials = (gltf.materials || []).map(m => m.name).filter(Boolean);\n  const exts = gltf.extensionsUsed || [];\n  console.log(f, \"size:\", buf.length, \"exts:\", exts.join(\",\"), \"nodes:\", nodes.slice(0, 12).join(\",\"), \"mats:\", materials.join(\",\"));\n}\n\'"
    shell_name: "bash"
  }
}
