        replacement_content: "  return {\n    playerGltf,\n    bossGltf,\n    fodderGltf,\n    tree1aGltf,\n    tree1bGltf,\n    hydrantGltf,\n    explosiveBarrelGltf,\n    powerCoreGltf,\n    turbineGltf,\n    woodenBoxGltf,\n    metalBoxGltf,\n    playerTrackPoints,\n    treeFoliageTex,\n  };\n}\n\n/**\n * Extracts the reference prop (.REF or first visual mesh) from a Lyo .glb file\n * (such as turbine.glb, power-core.glb, hydrant.glb, explosive-barrel.glb),\n * applies Lyo\'s WorldMaterial + Stroke Outline, and scales/grounds it cleanly at (x, 0, z).\n */\nexport function spawnRealLyoPropFromGlb(\n  parent: THREE.Object3D,\n  gltf: GLTF | null,\n  x: number,\n  z: number,\n  rotY: number,\n  targetHeight: number,\n  windUniforms: LyoWindUniforms,\n  isSoftwareGl: boolean,\n): THREE.Group | null {\n  if (!gltf || !gltf.scene) return null;\n  gltf.scene.updateMatrixWorld(true);\n\n  let refNode: THREE.Object3D | null = null;\n  gltf.scene.traverse((obj) => {\n    if (!refNode && obj.name && (obj.name.endsWith(\'.REF\') || obj.name.endsWith(\'_ref\'))) {\n      refNode = obj;\n    }\n  });\n  if (!refNode) {\n    // Pick the first top-level child that has a renderable mesh\n    for (const ch of gltf.scene.children) {\n      let hasMesh = false;\n      ch.traverse((m) => {\n        if ((m as THREE.Mesh).isMesh && !isLyoColliderOrHelperNode(m)) hasMesh = true;\n      });\n      if (hasMesh) {\n        refNode = ch;\n        break;\n      }\n    }\n  }\n  const source = refNode || gltf.scene;\n  source.updateMatrixWorld(true);\n  const invMat = source.matrixWorld.clone().invert();\n\n  const propGroup = new THREE.Group();\n  source.traverse((child) => {\n    if ((child as THREE.Mesh).isMesh && !isLyoColliderOrHelperNode(child)) {\n      const srcMesh = child as THREE.Mesh;\n      const cloned = srcMesh.clone();\n      child.updateMatrixWorld(true);\n      const rel = new THREE.Matrix4().multiplyMatrices(invMat, child.matrixWorld);\n      rel.decompose(cloned.position, cloned.quaternion, cloned.scale);\n      cloned.castShadow = !isSoftwareGl;\n      cloned.receiveShadow = !isSoftwareGl;\n      upgradeMeshToLyoWorldMaterial(cloned, windUniforms);\n      const stroke = createLyoStrokeMesh(cloned.geometry, 0.028);\n      if (stroke) cloned.add(stroke);\n      propGroup.add(cloned);\n    }\n  });\n\n  if (propGroup.children.length === 0) return null;\n\n  const box = new THREE.Box3().setFromObject(propGroup);\n  const size = box.getSize(new THREE.Vector3());\n  const center = box.getCenter(new THREE.Vector3());\n  const scale = size.y > 0.05 ? targetHeight / size.y : 1.0;\n\n  const wrapper = new THREE.Group();\n  propGroup.position.set(-center.x * scale, -box.min.y * scale, -center.z * scale);\n  propGroup.scale.setScalar(scale);\n  wrapper.add(propGroup);\n  wrapper.position.set(x, 0, z);\n  wrapper.rotation.y = rotY;\n  parent.add(wrapper);\n  return wrapper;\n}\n"
        start_line: 765
        end_line: 783
      }
      use_global_match: true
