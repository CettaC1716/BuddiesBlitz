            }
            lines {
              text: "      let val = noise2D(tx, ty) * 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      val += noise2D(tx * 2, ty * 2) * 0.25;"
