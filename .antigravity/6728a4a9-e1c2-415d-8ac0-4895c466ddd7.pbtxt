            }
            lines {
              text: "local function makeCrossBar(size: UDim2): Frame"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal bar = Instance.new(\"Frame\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
