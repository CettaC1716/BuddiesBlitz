            lines {
              text: "        anchor.y = 0.0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        // Road & Stacking Pad / Base HQ grass-mask cutout so dirt roads and pads stay clean"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        // while keeping z > 14.2 lush with tall foreground grass blades in front of the low-angle camera"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float onNSRoad = (1.0 - smoothstep(2.6, 3.3, abs(anchor.x))) * (1.0 - smoothstep(13.6, 14.6, abs(anchor.z)));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float onEWRoad = (1.0 - smoothstep(20.0, 21.5, abs(anchor.x))) * (1.0 - smoothstep(2.5, 3.3, abs(anchor.z)));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float onCenterPad = 1.0 - smoothstep(3.6, 4.4, max(abs(anchor.x), abs(anchor.z)));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float onBluePad = 1.0 - smoothstep(2.4, 3.1, max(abs(anchor.x - (-6.0)), abs(anchor.z - 8.8)));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float onRedPad = 1.0 - smoothstep(2.4, 3.1, max(abs(anchor.x - 6.2), abs(anchor.z - (-16.5))));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float density = clamp(1.0 - max(max(onNSRoad, onEWRoad), max(onCenterPad, max(onBluePad, onRedPad))), 0.0, 1.0);"
