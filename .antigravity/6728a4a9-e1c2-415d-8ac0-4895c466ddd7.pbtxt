            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // 3. Build exact Lyo TreeLeaves geometry (planesPerCluster = 80, planeSize = 0.85, normalLerp = 0.85)"
