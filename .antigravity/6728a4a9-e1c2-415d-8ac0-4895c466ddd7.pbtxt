            }
            lines {
              text: "            let turn = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            if (keys[\'KeyW\'] || keys[\'ArrowUp\']) throttle += 1;"
