  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { LUAU_SCRIPTS, REA_ASSET_MANIFEST } from \'../data/reaAndLuauData\';\nimport { REA_CONSTANTS } from \'../game/rules\';\nimport { soundEngine } from \'../game/audio\';\n\ninterface ReaLuauModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const ReaLuauModal: React.FC<ReaLuauModalProps> = ({ isOpen, onClose }) => {\n  const [activeTab, setActiveTab] = useState<string>(\'rea-report\');\n  const [copiedId, setCopiedId] = useState<string | null>(null);\n\n  if (!isOpen) return null;\n\n  const handleCopy = (id: string, text: string) => {\n    soundEngine.playUiClick();\n    navigator.clipboard.writeText(text).catch(() => {});\n    setCopiedId(id);\n    window.setTimeout(() => setCopiedId(null), 1800);\n  };\n\n  const handleDownload = (filename: string, content: string) => {\n    soundEngine.playUiClick();\n    const blob = new Blob([content], { type: \'text/plain;charset=utf-8\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = filename;\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    URL.revokeObjectURL(url);\n  };\n\n  const currentScript = LUAU_SCRIPTS.find((s) => s.id === activeTab);\n\n  return (\n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"rea-modal-title\"\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 pointer-events-auto\"\n      style={{ backgroundColor: \'rgba(17, 18, 26, 0.88)\' }}\n    >\n      <div className=\"w-full max-w-6xl max-h-[90vh] flex flex-col bg-[#191b24] border-4 border-[#11121a] rounded-2xl comic-sticker-shadow-lg overflow-hidden text-white\">\n        {/* Modal Header */}\n        <div className=\"flex flex-wrap items-center justify-between gap-4 px-6 py-4 bg-[#272935] border-b-4 border-[#11121a]\">\n          <div>\n            <h2 id=\"rea-modal-title\" className=\"text-xl sm:text-2xl font-black tracking-tight text-[#b8ff3c]\">\n              REA DEOBFUSCATION REPORT &amp; ROBLOX STUDIO (LUAU) SUITE\n            </h2>\n            <p className=\"text-xs sm:text-sm text-[#dfdfe2] font-medium\">\n              Extracted 1:1 from https://longhoang-lyo.com/ (CQl67Veh.js \302\267 B1Nq4Kq6.js \302\267 BlAypStk.js \302\267 CJn-Xu8f.js)\n            </p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={() => {\n              soundEngine.playUiClick();\n              onClose();\n            }}\n            aria-label=\"Close REA and Luau Suite\"\n            className=\"px-4 py-2 bg-[#f42f4c] hover:bg-[#f6556d] text-white font-black text-sm rounded-lg border-2 border-[#11121a] comic-sticker-shadow transition-transform active:translate-y-0.5 cursor-pointer whitespace-nowrap shrink-0\"\n          >\n            CLOSE [ESC]\n          </button>\n        </div>\n\n        {/* Navigation Tabs */}\n        <div className=\"flex items-center gap-2 px-6 py-3 bg-[#11121a] overflow-x-auto border-b-2 border-[#272935]\">\n          <button\n            type=\"button\"\n            onClick={() => {\n              soundEngine.playUiClick();\n              setActiveTab(\'rea-report\');\n            }}\n            className={`px-3.5 py-2 text-xs sm:text-sm font-extrabold rounded-lg border-2 transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n              activeTab === \'rea-report\'\n                ? \'bg-[#b8ff3c] text-[#11121a] border-[#11121a]\'\n                : \'bg-[#272935] text-[#dfdfe2] border-[#393b49] hover:text-white\'\n            }`}\n          >\n            Laporan Hasil REA (Tahap 1)\n          </button>\n          {LUAU_SCRIPTS.map((script) => (\n            <button\n              key={script.id}\n              type=\"button\"\n              onClick={() => {\n                soundEngine.playUiClick();\n                setActiveTab(script.id);\n              }}\n              className={`px-3.5 py-2 text-xs sm:text-sm font-extrabold rounded-lg border-2 transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n                activeTab === script.id\n                  ? \'bg-[#b8ff3c] text-[#11121a] border-[#11121a]\'\n                  : \'bg-[#272935] text-[#dfdfe2] border-[#393b49] hover:text-white\'\n              }`}\n            >\n              {script.title}\n            </button>\n          ))}\n        </div>\n\n        {/* Tab Body */}\n        <div className=\"flex-1 overflow-y-auto p-6 space-y-6 select-text\">\n          {activeTab === \'rea-report\' ? (\n            <div className=\"space-y-6\">\n              {/* Explorer Folder Structure Guide */}\n              <div className=\"p-4 bg-[#11121a] border-2 border-[#393b49] rounded-xl\">\n                <h3 className=\"text-base font-black text-[#fec83e] mb-2\">\n                  Panduan Penempatan Folder di Explorer Roblox Studio (Kompatibel Rojo)\n                </h3>\n                <pre className=\"text-xs font-mono-tabular text-[#dfdfe2] leading-relaxed overflow-x-auto\">\n{`game\n\342\224\234\342\224\200\342\224\200 ReplicatedStorage\n\342\224\202   \342\224\234\342\224\200\342\224\200 LyoooEvents (Folder - otomatis dibuat script)\n\342\224\202   \342\224\202   \342\224\234\342\224\200\342\224\200 GameIntroComplete (BindableEvent)\n\342\224\202   \342\224\202   \342\224\234\342\224\200\342\224\200 BulletShoot (BindableEvent)\n\342\224\202   \342\224\202   \342\224\224\342\224\200\342\224\200 CameraShake (BindableEvent)\n\342\224\202   \342\224\224\342\224\200\342\224\200 LyoooRemotes (Folder - otomatis dibuat Server)\n\342\224\202       \342\224\234\342\224\200\342\224\200 FireCannon (RemoteEvent)\n\342\224\202       \342\224\224\342\224\200\342\224\200 GrabProp (RemoteEvent)\n\342\224\234\342\224\200\342\224\200 ServerScriptService\n\342\224\202   \342\224\234\342\224\200\342\224\200 TankBuilder.server.lua        [Script - Rig Tank 11-Part & Factory Playground]\n\342\224\202   \342\224\224\342\224\200\342\224\200 LightingSetup.server.lua      [Script - Highlight Ink Outline, Cel-Shading & Puff Smoke]\n\342\224\234\342\224\200\342\224\200 StarterGui\n\342\224\202   \342\224\224\342\224\200\342\224\200 LyoooPortfolioUI.client.lua   [LocalScript - Hexagon Mask Intro, Comic Sticker & HUD]\n\342\224\224\342\224\200\342\224\200 StarterPlayer\n    \342\224\224\342\224\200\342\224\200 StarterPlayerScripts\n        \342\224\234\342\224\200\342\224\200 IsometricCamera.client.lua [LocalScript - Spring Follow Cam, FOV 18\302\260, Mouse Pan & Recoil]\n        \342\224\224\342\224\200\342\224\200 TankController.client.lua  [LocalScript - Rapier 1:1 Drive, Turret Slerp & [G] Grab Mode]`}\n                </pre>\n              </div>\n\n              {/* Grid of Extracted Mathematical Constants */}\n              <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-4\">\n                {/* 1. Camera Constants */}\n                <div className=\"p-4 bg-[#272935] border-2 border-[#393b49] rounded-xl space-y-2\">\n                  <h4 className=\"text-sm font-black text-[#b8ff3c]\">\n                    1. Konfigurasi Kamera (CQl67Veh.js)\n                  </h4>\n                  <ul className=\"text-xs font-mono-tabular space-y-1.5 text-[#dfdfe2]\">\n                    <li>WebGL Camera: Perspective(FOV {REA_CONSTANTS.camera.fov}\302\260, 0.1..1000)</li>\n                    <li>Roblox Isometric Pseudo-Ortho: FOV {REA_CONSTANTS.camera.robloxPseudoOrthoFov}\302\260 (1.85x dist)</li>\n                    <li>Default Angle Offset: Vector3(4, 14, 8) (d = 16.61m)</li>\n                    <li>PlayerStart Angle: Vector3(0, 2, 14)</li>\n                    <li>Zoom: minDist = 9, amp = 12, val = 0.6 (16.2m)</li>\n                    <li>Spring Follow: smoothTime = lerp(0.18, 0.22, alpha)</li>\n                    <li>Spring Omega: \317\211 = 2 / smoothTime (11.11..9.09)</li>\n                    <li>Mouse Pan: sensitivity = 1.3, dampSpeed = 5.0</li>\n                    <li>Shoot Recoil Kick: 0.13m (maxRecoil = 0.37m)</li>\n                    <li>Player Spawn: (57.334, 10.068, 98.584)</li>\n                  </ul>\n                </div>\n\n                {/* 2. Rapier Physics Constants */}\n                <div className=\"p-4 bg-[#272935] border-2 border-[#393b49] rounded-xl space-y-2\">\n                  <h4 className=\"text-sm font-black text-[#b8ff3c]\">\n                    2. Parameter Fisika Rapier (B1Nq4Kq6.js)\n                  </h4>\n                  <ul className=\"text-xs font-mono-tabular space-y-1.5 text-[#dfdfe2]\">\n                    <li>Gravity: (0, -9.81, 0) \302\267 dt = 1/60s (max 5 substeps)</li>\n                    <li>Tank Damping: linear = 0.5, angular = 0.8</li>\n                    <li>Tank Collider: cuboid (friction = 0.3, restitution = 0.4)</li>\n                    <li>Drive Speed: 8.0 m/s \302\267 Boost: 1.9x (15.2 m/s)</li>\n                    <li>Rotation Speed: 3.12 rad/s (boost: 1.2x, lerp: 50)</li>\n                    <li>Lateral Friction: 20.0 \302\267 Forward Friction: 0.5</li>\n                    <li>Turret Slerp Damping: 0.06 * 60 = 3.6 rad/s</li>\n                    <li>Cannon: speed = 55 m/s, fireRate = 0.2s, recoil = 0.16m</li>\n                    <li>Grab Mode [G]: dist = 6m, spring = 180, damp = 16</li>\n                    <li>Terrain Trimesh: friction = 0.8, restitution = 0.0</li>\n                  </ul>\n                </div>\n\n                {/* 3. TSL Shaders & Palette */}\n                <div className=\"p-4 bg-[#272935] border-2 border-[#393b49] rounded-xl space-y-2\">\n                  <h4 className=\"text-sm font-black text-[#b8ff3c]\">\n                    3. TSL Shaders, Outline &amp; Palet Warna\n                  </h4>\n                  <ul className=\"text-xs font-mono-tabular space-y-1.5 text-[#dfdfe2]\">\n                    <li>Outline (Nn): strokeWidth = 0.018, maxDepth = 1.5</li>\n                    <li>Outline Ink Color: #17110f (RGB 23, 17, 15)</li>\n                    <li>Cross-Hatching (Kn): angle = 0.7854 rad (45\302\260), freq = 204</li>\n                    <li>Key Light: #ffe8d6 (intensity 2.0) @ (2, 25, -2)</li>\n                    <li>Day Shadow: #454778 \302\267 Night Shadow: #363636</li>\n                    <li>Brand Lime: #b8ff3c / #c7ff72 / #b4ff39</li>\n                    <li>Neutral Ink: #11121a \302\267 Surface: #191b24 / #272935</li>\n                    <li>Status Red: #f42f4c \302\267 Status Yellow: #fec83e</li>\n                    <li>Puff Smoke (Ji): velY 1.28..1.92, life 5.5..8.5s, scale 0.14-&gt;1.4</li>\n                  </ul>\n                </div>\n              </div>\n\n              {/* 4. Extracted 3D Asset Manifest */}\n              <div className=\"p-4 bg-[#272935] border-2 border-[#393b49] rounded-xl space-y-3\">\n                <h4 className=\"text-sm font-black text-[#fec83e]\">\n                  4. Daftar Aset 3D (.glb / .ktx2) yang Diekstrak dari BlAypStk.js &amp; B1Nq4Kq6.js\n                </h4>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n                  {REA_ASSET_MANIFEST.map((group) => (\n                    <div key={group.category} className=\"p-3 bg-[#11121a] rounded-lg border border-[#393b49]\">\n                      <div className=\"text-xs font-black text-[#b8ff3c] mb-1\">{group.category}</div>\n                      <ul className=\"text-xs font-mono-tabular text-[#dfdfe2] space-y-1\">\n                        {group.files.map((f, i) => (\n                          <li key={i}>{f}</li>\n                        ))}\n                      </ul>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n          ) : currentScript ? (\n            <div className=\"space-y-4\">\n              <div className=\"flex flex-wrap items-center justify-between gap-4 p-4 bg-[#272935] border-2 border-[#393b49] rounded-xl\">\n                <div>\n                  <div className=\"text-xs font-mono-tabular text-[#fec83e] font-bold\">\n                    {currentScript.scriptType} \302\267 {currentScript.robloxPath}\n                  </div>\n                  <p className=\"text-sm text-[#dfdfe2] mt-1\">{currentScript.summary}</p>\n                </div>\n                <div className=\"flex items-center gap-2 shrink-0\">\n                  <button\n                    type=\"button\"\n                    onClick={() => handleCopy(currentScript.id, currentScript.code)}\n                    className=\"px-4 py-2 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-xs rounded-lg border-2 border-[#11121a] comic-sticker-shadow cursor-pointer whitespace-nowrap\"\n                  >\n                    {copiedId === currentScript.id ? \'COPIED TO CLIPBOARD\' : \'COPY LUAU SCRIPT\'}\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() =>\n                      handleDownload(\n                        currentScript.robloxPath.split(\'/\').pop() || \'script.lua\',\n                        currentScript.code,\n                      )\n                    }\n                    className=\"px-4 py-2 bg-[#fec83e] hover:bg-[#fee763] text-[#11121a] font-black text-xs rounded-lg border-2 border-[#11121a] comic-sticker-shadow cursor-pointer whitespace-nowrap\"\n                  >\n                    DOWNLOAD .LUA\n                  </button>\n                </div>\n              </div>\n\n              <pre className=\"p-4 bg-[#11121a] border-2 border-[#393b49] rounded-xl text-xs font-mono-tabular text-[#dfdfe2] overflow-x-auto leading-relaxed max-h-[54vh]\">\n                <code>{currentScript.code}</code>\n              </pre>\n            </div>\n          ) : null}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
