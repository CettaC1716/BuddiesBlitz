            }
            lines {
              text: "export type TeamCommandMode = \'FOLLOW\' | \'HARVEST\' | \'ATTACK\' | \'DEFEND\' | \'MOUNT\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
