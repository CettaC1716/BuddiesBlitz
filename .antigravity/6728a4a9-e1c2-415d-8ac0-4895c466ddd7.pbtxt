            }
            lines {
              text: "            mountedTank.vx += (targetVx - mountedTank.vx) * Math.min(1, 10 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            mountedTank.vz += (targetVz - mountedTank.vz) * Math.min(1, 10 * dt);"
