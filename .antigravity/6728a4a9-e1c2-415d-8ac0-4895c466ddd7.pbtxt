    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst path = require(\"path\");\nfor (const f of [\"player.glb\", \"boss.glb\", \"fodder.glb\", \"tree-1a.glb\", \"tree-1b.glb\", \"wooden-box.glb\", \"hydrant.glb\"]) {\n  const buf = fs.readFileSync(path.join(\"extracted_lyo_assets/models\", f));\n  const jsonLen = buf.readUInt32LE(12);\n  const gltf = JSON.parse(buf.slice(20, 20 + jsonLen).toString(\"utf8\"));\n  console.log(\"=== \" + f + \" ===\");\n  console.log(\"images:\", JSON.stringify(gltf.images));\n  console.log(\"materials:\", JSON.stringify(gltf.materials));\n  console.log(\"all nodes:\", (gltf.nodes || []).map(n => n.name));\n}\n\'"
