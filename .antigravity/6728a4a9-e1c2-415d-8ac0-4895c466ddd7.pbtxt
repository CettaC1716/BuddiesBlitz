            }
            lines {
              text: "      \'Replikasi 1:1 dari CJn-Xu8f.js & BcJjgNcx.css: Layar Intro dengan Hexagon Viewport Cutout di kanan, tipografi stiker komik \"LYOOO\" + \"PORTFOLIO\" (#b4ff39), tombol miring \"LET\\\'S GO\" dengan animasi elastic GSAP, tombol Mute poligon, dan transisi tanpa jeda.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    code: `--!strict"
