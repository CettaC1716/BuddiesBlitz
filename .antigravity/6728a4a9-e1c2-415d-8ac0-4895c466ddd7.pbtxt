    content: "        float halfField = uFieldSize * 0.5;\n        vec3 anchor = vec3(0.0);\n        anchor.x = mod(aLocalAnchor.x - uViewPos.x + halfField, uFieldSize) - halfField + uViewPos.x;\n        anchor.z = mod(aLocalAnchor.y - uViewPos.z + halfField, uFieldSize) - halfField + uViewPos.z;\n        anchor.y = 0.0;\n\n        // Road & Stacking Pad / Base HQ grass-mask cutout so dirt roads and pads stay clean\n        // while keeping z > 14.2 lush with tall foreground grass blades in front of the low-angle camera\n        float onNSRoad = (1.0 - smoothstep(2.6, 3.3, abs(anchor.x))) * (1.0 - smoothstep(13.6, 14.6, abs(anchor.z)));\n        float onEWRoad = (1.0 - smoothstep(20.0, 21.5, abs(anchor.x))) * (1.0 - smoothstep(2.5, 3.3, abs(anchor.z)));\n        float onCenterPad = 1.0 - smoothstep(3.6, 4.4, max(abs(anchor.x), abs(anchor.z)));\n        float onBluePad = 1.0 - smoothstep(2.4, 3.1, max(abs(anchor.x - (-6.0)), abs(anchor.z - 8.8)));\n        float onRedPad = 1.0 - smoothstep(2.4, 3.1, max(abs(anchor.x - 6.2), abs(anchor.z - (-16.5))));\n        float density = clamp(1.0 - max(max(onNSRoad, onEWRoad), max(onCenterPad, max(onBluePad, onRedPad))), 0.0, 1.0);\n\n        float hScale = aBladeShape.x * density;\n        float wScale = aBladeShape.y * density;\n        float cosA = aBladeShape.z;"
