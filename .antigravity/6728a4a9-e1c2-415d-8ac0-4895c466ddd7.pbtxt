    replacement_infos {
      original_chunk {
        target_content: "    // Shared Materials + Ink Outline Material (#17110f, BackSide)\n    const inkOutlineMat = new THREE.MeshBasicMaterial({\n      color: 0x17110f,\n      side: THREE.BackSide,\n    });\n    const hoverOutlineMat = new THREE.MeshBasicMaterial({\n      color: 0xffaa00,\n      side: THREE.BackSide,\n    });\n    const flashWhiteMat = new THREE.MeshBasicMaterial({\n      color: 0xffffff,\n    });\n\n    const matTankLime = new THREE.MeshStandardMaterial({\n      color: 0xb8ff3c,\n      roughness: 0.42,\n      metalness: 0.12,\n    });\n    const matTankHighlight = new THREE.MeshStandardMaterial({\n      color: 0xc7ff72,\n      roughness: 0.25,\n      metalness: 0.15,\n    });\n    const matYellow = new THREE.MeshStandardMaterial({\n      color: 0xfec83e,\n      roughness: 0.35,\n      metalness: 0.2,\n    });\n    const matDarkSteel = new THREE.MeshStandardMaterial({\n      color: 0x272935,\n      roughness: 0.68,\n      metalness: 0.45,\n    });\n    const matGunmetal = new THREE.MeshStandardMaterial({\n      color: 0x393b49,\n      roughness: 0.4,\n      metalness: 0.65,\n    });\n    const matRedBarrel = new THREE.MeshStandardMaterial({\n      color: 0xf42f4c,\n      roughness: 0.38,\n      metalness: 0.2,\n    });\n    const matHazard = new THREE.MeshStandardMaterial({\n      color: 0xffffff,\n      map: hazardTex,\n      roughness: 0.5,\n      metalness: 0.15,\n    });\n    const matConcrete = new THREE.MeshStandardMaterial({\n      color: 0x686a77,\n      roughness: 0.85,\n      metalness: 0.05,\n    });\n    const matZebra = new THREE.MeshStandardMaterial({\n      color: 0xf2f4f8,\n      roughness: 0.6,\n      metalness: 0.05,\n      polygonOffset: true,\n      polygonOffsetFactor: -1,\n      polygonOffsetUnits: -1,\n    });\n\n    // Helper: Add mesh + BackSide hard ink outline (replicates Nn StrokeMaterial)\n    const addOutlinedPart = (\n      parent: THREE.Object3D,\n      geo: THREE.BufferGeometry,\n      mat: THREE.Material,\n      pos: [number, number, number],\n      rot: [number, number, number] = [0, 0, 0],\n      outlineScale = 1.06,\n      castShadow = true,\n    ): THREE.Mesh => {\n      const mesh = new THREE.Mesh(geo, mat);\n      mesh.position.set(pos[0], pos[1], pos[2]);\n      mesh.rotation.set(rot[0], rot[1], rot[2]);\n      mesh.castShadow = castShadow && !isSoftwareGl;\n      mesh.receiveShadow = !isSoftwareGl;\n      mesh.userData.baseMaterial = mat;\n\n      const outline = new THREE.Mesh(geo, inkOutlineMat);\n      outline.scale.setScalar(outlineScale);\n      outline.name = \'InkStroke\';\n      mesh.add(outline);\n\n      parent.add(mesh);\n      return mesh;\n    };\n\n    // Soft radial contact shadow geometry (shared)\n    const shadowDiscGeo = new THREE.CircleGeometry(1.4, 20);\n    shadowDiscGeo.rotateX(-Math.PI / 2);\n    const shadowDiscMat = new THREE.MeshBasicMaterial({\n      color: 0x090a10,\n      transparent: true,\n      opacity: 0.42,\n      depthWrite: false,\n    });\n\n    // 4. Ground, Crossroads, Zebra Crossings, Perimeter Hills & Factory Landmarks\n    const groundGeo = new THREE.PlaneGeometry(180, 180);\n    groundGeo.rotateX(-Math.PI / 2);\n    const groundMat = new THREE.MeshStandardMaterial({\n      color: 0xffffff,\n      map: asphaltTex,\n      roughness: 0.88,\n      metalness: 0.08,\n    });\n    const groundMesh = new THREE.Mesh(groundGeo, groundMat);\n    groundMesh.receiveShadow = !isSoftwareGl;\n    scene.add(groundMesh);\n\n    // Main Factory Road Crossings (offset by +0.02 on Y to prevent Z-fighting)\n    const roadMat = new THREE.MeshStandardMaterial({\n      color: 0x191b24,\n      roughness: 0.78,\n      metalness: 0.1,\n    });\n    const roadNS = new THREE.Mesh(new THREE.BoxGeometry(10, 0.03, 96), roadMat);\n    roadNS.position.set(0, 0.015, 0);\n    roadNS.receiveShadow = !isSoftwareGl;\n    scene.add(roadNS);\n\n    const roadEW = new THREE.Mesh(new THREE.BoxGeometry(96, 0.03, 10), roadMat);\n    roadEW.position.set(0, 0.016, 0);\n    roadEW.receiveShadow = !isSoftwareGl;\n    scene.add(roadEW);\n\n    // Zebra Crossings at 4 intersections\n    const stripeGeo = new THREE.BoxGeometry(2.4, 0.02, 0.55);\n    const zebraOffsets = [\n      { x: -9, z: 0, rotY: 0 },\n      { x: 9, z: 0, rotY: 0 },\n      { x: 0, z: -9, rotY: Math.PI / 2 },\n      { x: 0, z: 9, rotY: Math.PI / 2 },\n    ];\n    zebraOffsets.forEach((zo) => {\n      const zGroup = new THREE.Group();\n      zGroup.position.set(zo.x, 0.035, zo.z);\n      zGroup.rotation.y = zo.rotY;\n      for (let i = -3; i <= 3; i++) {\n        const s = new THREE.Mesh(stripeGeo, matZebra);\n        s.position.set(0, 0, i * 1.1);\n        zGroup.add(s);\n      }\n      scene.add(zGroup);\n    });\n\n    // Central Power Core Monument (Multi-part interactive landmark at (0, 0, -16))\n    const powerCoreGroup = new THREE.Group();\n    powerCoreGroup.position.set(0, 0, -16);\n    addOutlinedPart(powerCoreGroup, new THREE.CylinderGeometry(3.2, 3.6, 0.6, 8), matDarkSteel, [0, 0.3, 0], [0, 0, 0], 1.04);\n    addOutlinedPart(powerCoreGroup, new THREE.CylinderGeometry(2.2, 2.5, 0.5, 8), matHazard, [0, 0.85, 0], [0, 0, 0], 1.04);\n    const powerCoreOrbMat = new THREE.MeshStandardMaterial({\n      color: 0xb8ff3c,\n      emissive: 0xb8ff3c,\n      emissiveIntensity: 0.45,\n      roughness: 0.2,\n      metalness: 0.3,\n    });\n    const powerCoreOrb = addOutlinedPart(\n      powerCoreGroup,\n      new THREE.OctahedronGeometry(1.35, 1),\n      powerCoreOrbMat,\n      [0, 2.7, 0],\n      [0, 0, 0],\n      1.07,\n    );\n    const powerCoreRing = addOutlinedPart(\n      powerCoreGroup,\n      new THREE.TorusGeometry(1.9, 0.16, 10, 24),\n      matYellow,\n      [0, 2.7, 0],\n      [Math.PI / 3, 0, 0],\n      1.06,\n    );\n    scene.add(powerCoreGroup);\n\n    // Factory Smokestack Chimneys & Steam Manholes (emitters for Cartoon Puff Smoke)\n    const smokeEmitterPositions: THREE.Vector3[] = [];\n\n    const buildChimneyTower = (x: number, z: number) => {\n      const g = new THREE.Group();\n      g.position.set(x, 0, z);\n      addOutlinedPart(g, new THREE.BoxGeometry(4.2, 3.2, 4.2), matConcrete, [0, 1.6, 0]);\n      addOutlinedPart(g, new THREE.BoxGeometry(4.4, 0.45, 4.4), matHazard, [0, 3.3, 0]);\n      addOutlinedPart(g, new THREE.CylinderGeometry(0.95, 1.35, 6.5, 12), matDarkSteel, [-0.8, 6.5, -0.6]);\n      addOutlinedPart(g, new THREE.CylinderGeometry(1.1, 1.1, 0.4, 12), matRedBarrel, [-0.8, 9.7, -0.6]);\n      addOutlinedPart(g, new THREE.CylinderGeometry(0.75, 1.05, 5.2, 12), matGunmetal, [0.9, 5.8, 0.7]);\n      scene.add(g);\n      smokeEmitterPositions.push(new THREE.Vector3(x - 0.8, 10.0, z - 0.6));\n      smokeEmitterPositions.push(new THREE.Vector3(x + 0.9, 8.6, z + 0.7));\n    };\n    buildChimneyTower(-20, -20);\n    buildChimneyTower(22, -20);\n\n    // Steam Manholes on Factory Floor\n    const manholeCoords: [number, number][] = [\n      [-11, -6],\n      [11, 7],\n      [-8, 13],\n      [14, -9],\n    ];\n    manholeCoords.forEach(([mx, mz]) => {\n      const mh = new THREE.Group();\n      mh.position.set(mx, 0, mz);\n      addOutlinedPart(mh, new THREE.CylinderGeometry(1.15, 1.25, 0.16, 16), matGunmetal, [0, 0.08, 0]);\n      addOutlinedPart(mh, new THREE.CylinderGeometry(0.85, 0.85, 0.2, 12), matDarkSteel, [0, 0.11, 0]);\n      scene.add(mh);\n      smokeEmitterPositions.push(new THREE.Vector3(mx, 0.25, mz));\n    });\n\n    // Natural Perimeter Rock Outcrops & Stylized Trees (prevents floating indoor box walls)\n    const rockGeo = new THREE.DodecahedronGeometry(2.8, 1);\n    const trunkGeo = new THREE.CylinderGeometry(0.35, 0.55, 2.2, 8);\n    const foliageGeo = new THREE.IcosahedronGeometry(1.8, 1);\n    const foliageMat = new THREE.MeshStandardMaterial({\n      color: 0x7cd936,\n      roughness: 0.65,\n      metalness: 0.05,\n    });\n    const trunkMat = new THREE.MeshStandardMaterial({\n      color: 0x4b382a,\n      roughness: 0.85,\n      metalness: 0.05,\n    });\n\n    for (let i = 0; i < 24; i++) {\n      const angle = (i / 24) * Math.PI * 2;\n      const dist = 42 + (i % 3) * 4;\n      const rx = Math.cos(angle) * dist;\n      const rz = Math.sin(angle) * dist;\n      if (i % 2 === 0) {\n        const rockGroup = new THREE.Group();\n        rockGroup.position.set(rx, 0, rz);\n        const s = 0.85 + (i % 4) * 0.22;\n        rockGroup.scale.set(s * 1.2, s * 0.85, s);\n        addOutlinedPart(rockGroup, rockGeo, matConcrete, [0, 1.4, 0], [0.2 * i, 0.5 * i, 0], 1.05, false);\n        scene.add(rockGroup);\n      } else {\n        const treeGroup = new THREE.Group();\n        treeGroup.position.set(rx, 0, rz);\n        const s = 0.9 + (i % 3) * 0.15;\n        treeGroup.scale.setScalar(s);\n        addOutlinedPart(treeGroup, trunkGeo, trunkMat, [0, 1.1, 0], [0, 0, 0], 1.06, false);\n        addOutlinedPart(treeGroup, foliageGeo, foliageMat, [0, 3.1, 0], [0, i, 0], 1.05, false);\n        addOutlinedPart(treeGroup, foliageGeo, matTankLime, [0.6, 4.1, -0.4], [0, 0, 0], 1.05, false);\n        scene.add(treeGroup);\n      }\n    }\n\n    // 5. Build Composite 11-Part Neon-Green Player Tank (sr=class in B1Nq4Kq6.js)\n    const tankRoot = new THREE.Group();\n    tankRoot.name = \'PlayerTankRoot\';\n    scene.add(tankRoot);\n\n    const tankContactShadow = new THREE.Mesh(shadowDiscGeo, shadowDiscMat);\n    tankContactShadow.position.set(0, 0.02, 0);\n    tankContactShadow.scale.set(1.35, 1.15, 1);\n    tankRoot.add(tankContactShadow);\n\n    const tankBodyGroup = new THREE.Group();\n    tankRoot.add(tankBodyGroup);\n\n    // Part 1: Main Lower Hull\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(2.25, 0.68, 1.55), matTankLime, [0, 0.58, 0]);\n    // Part 2: Upper Sloped Glacis\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(1.75, 0.34, 1.32), matTankHighlight, [0.1, 0.98, 0]);\n    // Part 3 & 4: Left & Right Armored Track Pods\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(2.55, 0.56, 0.38), matDarkSteel, [0, 0.36, -0.88]);\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(2.55, 0.56, 0.38), matDarkSteel, [0, 0.36, 0.88]);\n    // Part 5 & 6: Left & Right Neon Lime Track Fenders\n    const leftFender = addOutlinedPart(\n      tankBodyGroup,\n      new THREE.BoxGeometry(2.65, 0.14, 0.46),\n      matTankLime,\n      [0, 0.68, -0.88],\n    );\n    const rightFender = addOutlinedPart(\n      tankBodyGroup,\n      new THREE.BoxGeometry(2.65, 0.14, 0.46),\n      matTankLime,\n      [0, 0.68, 0.88],\n    );\n    // Part 7: Rear Yellow Boost Grille\n    const boostGrilleMat = new THREE.MeshStandardMaterial({\n      color: 0xfec83e,\n      emissive: 0xfec83e,\n      emissiveIntensity: 0.35,\n      roughness: 0.3,\n    });\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(0.24, 0.42, 1.12), boostGrilleMat, [-1.14, 0.64, 0]);\n\n    // Part 8: Rotating Turret Group\n    const tankTurretGroup = new THREE.Group();\n    tankTurretGroup.position.set(-0.05, 1.15, 0);\n    tankBodyGroup.add(tankTurretGroup);\n\n    addOutlinedPart(tankTurretGroup, new THREE.BoxGeometry(1.32, 0.58, 1.24), matTankLime, [0, 0.25, 0]);\n    // Part 9: Commander Hatch & Yellow Periscope\n    addOutlinedPart(tankTurretGroup, new THREE.CylinderGeometry(0.32, 0.36, 0.22, 10), matYellow, [-0.18, 0.62, 0]);\n    // Part 10 & 11: Recoiling Cannon Barrel + Yellow Muzzle Brake\n    const tankBarrelGroup = new THREE.Group();\n    tankBarrelGroup.position.set(0.65, 0.26, 0);\n    tankTurretGroup.add(tankBarrelGroup);\n\n    addOutlinedPart(\n      tankBarrelGroup,\n      new THREE.CylinderGeometry(0.14, 0.16, 1.45, 12),\n      matGunmetal,\n      [0.65, 0, 0],\n      [0, 0, -Math.PI / 2],\n    );\n    addOutlinedPart(\n      tankBarrelGroup,\n      new THREE.CylinderGeometry(0.22, 0.22, 0.28, 12),\n      matYellow,\n      [1.38, 0, 0],\n      [0, 0, -Math.PI / 2],\n    );\n\n    // Muzzle Flash Mesh & Light\n    const muzzleFlashMesh = new THREE.Mesh(\n      new THREE.SphereGeometry(0.42, 10, 10),\n      new THREE.MeshBasicMaterial({ color: 0xb8ff3c }),\n    );\n    muzzleFlashMesh.position.set(1.62, 0, 0);\n    muzzleFlashMesh.visible = false;\n    tankBarrelGroup.add(muzzleFlashMesh);\n\n    // 6. Dynamic Factory Playground Props (ExplosiveBarrels, Hydrants, Crates, ConcreteFences)\n    const dynamicProps: DynamicProp[] = [];\n    const propsFolder = new THREE.Group();\n    scene.add(propsFolder);\n\n    const buildDynamicPropMesh = (kind: DynamicProp[\'kind\']): THREE.Group => {\n      const g = new THREE.Group();\n      const shadow = new THREE.Mesh(shadowDiscGeo, shadowDiscMat);\n      shadow.position.set(0, 0.02, 0);\n      shadow.scale.setScalar(0.75);\n      g.add(shadow);\n\n      if (kind === \'barrel\') {\n        addOutlinedPart(g, new THREE.CylinderGeometry(0.62, 0.62, 1.45, 14), matRedBarrel, [0, 0.75, 0]);\n        addOutlinedPart(g, new THREE.CylinderGeometry(0.66, 0.66, 0.16, 14), matYellow, [0, 1.1, 0]);\n        addOutlinedPart(g, new THREE.CylinderGeometry(0.66, 0.66, 0.16, 14), matYellow, [0, 0.4, 0]);\n      } else if (kind === \'hydrant\') {\n        addOutlinedPart(g, new THREE.CylinderGeometry(0.42, 0.48, 1.15, 12), matYellow, [0, 0.58, 0]);\n        addOutlinedPart(g, new THREE.SphereGeometry(0.44, 12, 10), matRedBarrel, [0, 1.18, 0]);\n        addOutlinedPart(\n          g,\n          new THREE.CylinderGeometry(0.18, 0.18, 0.95, 10),\n          matGunmetal,\n          [0, 0.82, 0],\n          [0, 0, Math.PI / 2],\n        );\n      } else if (kind === \'crate\') {\n        addOutlinedPart(g, new THREE.BoxGeometry(1.45, 1.45, 1.45), matHazard, [0, 0.74, 0]);\n        addOutlinedPart(g, new THREE.BoxGeometry(1.52, 0.22, 1.52), matDarkSteel, [0, 1.38, 0]);\n      } else {\n        addOutlinedPart(g, new THREE.BoxGeometry(2.6, 1.35, 0.55), matConcrete, [0, 0.68, 0]);\n        addOutlinedPart(g, new THREE.BoxGeometry(2.68, 0.26, 0.62), matHazard, [0, 1.28, 0]);\n      }\n      return g;\n    };\n\n    const initialPropSpecs: Array<{\n      name: string;\n      kind: DynamicProp[\'kind\'];\n      x: number;\n      z: number;\n      rotY?: number;\n    }> = [\n      { name: \'ExplosiveBarrel_01\', kind: \'barrel\', x: -7, z: -8 },\n      { name: \'ExplosiveBarrel_02\', kind: \'barrel\', x: -8.6, z: -6.8 },\n      { name: \'ExplosiveBarrel_03\', kind: \'barrel\', x: 8.5, z: -9.5 },\n      { name: \'ExplosiveBarrel_04\', kind: \'barrel\', x: 10.2, z: -8.2 },\n      { name: \'ExplosiveBarrel_05\', kind: \'barrel\', x: -12, z: 9 },\n      { name: \'ExplosiveBarrel_06\', kind: \'barrel\', x: 12, z: 10 },\n      { name: \'Hydrant_NW\', kind: \'hydrant\', x: -6.2, z: -6.2 },\n      { name: \'Hydrant_NE\', kind: \'hydrant\', x: 6.2, z: -6.2 },\n      { name: \'Hydrant_SW\', kind: \'hydrant\', x: -6.2, z: 6.2 },\n      { name: \'Hydrant_SE\', kind: \'hydrant\', x: 6.2, z: 6.2 },\n      { name: \'MetalBox_1A\', kind: \'crate\', x: -14, z: -2 },\n      { name: \'MetalBox_1B\', kind: \'crate\', x: -14, z: 0.2 },\n      { name: \'MetalBox_2A\', kind: \'crate\', x: 14, z: -2 },\n      { name: \'MetalBox_2B\', kind: \'crate\', x: 14, z: 0.4 },\n      { name: \'ConcreteFence_1A\', kind: \'fence\', x: -4.5, z: -12.5, rotY: 0.2 },\n      { name: \'ConcreteFence_1B\', kind: \'fence\', x: 4.5, z: -12.5, rotY: -0.2 },\n    ];"
        replacement_content: "    // Shared Materials + 3-Step Cel-Shading Gradient Map (replicates Yn Toon Shader + Nn StrokeMaterial)\n    const toonSteps = new Uint8Array([95, 195, 255]);\n    const toonGradientMap = new THREE.DataTexture(toonSteps, 3, 1, THREE.RedFormat);\n    toonGradientMap.minFilter = THREE.NearestFilter;\n    toonGradientMap.magFilter = THREE.NearestFilter;\n    toonGradientMap.needsUpdate = true;\n\n    const inkOutlineMat = new THREE.MeshBasicMaterial({\n      color: 0x17110f,\n      side: THREE.BackSide,\n    });\n    const hoverOutlineMat = new THREE.MeshBasicMaterial({\n      color: 0xffaa00,\n      side: THREE.BackSide,\n    });\n    const flashWhiteMat = new THREE.MeshBasicMaterial({\n      color: 0xffffff,\n    });\n\n    const matTankLime = new THREE.MeshToonMaterial({\n      color: 0x9ef01a,\n      gradientMap: toonGradientMap,\n    });\n    const matTankHighlight = new THREE.MeshToonMaterial({\n      color: 0xb8ff3c,\n      gradientMap: toonGradientMap,\n    });\n    const matYellow = new THREE.MeshToonMaterial({\n      color: 0xffbe18,\n      gradientMap: toonGradientMap,\n    });\n    const matDarkSteel = new THREE.MeshToonMaterial({\n      color: 0x222533,\n      gradientMap: toonGradientMap,\n    });\n    const matGunmetal = new THREE.MeshToonMaterial({\n      color: 0x3b3f52,\n      gradientMap: toonGradientMap,\n    });\n    const matRedBarrel = new THREE.MeshToonMaterial({\n      color: 0xf42f4c,\n      gradientMap: toonGradientMap,\n    });\n    const matHazard = new THREE.MeshToonMaterial({\n      color: 0xffffff,\n      map: hazardTex,\n      gradientMap: toonGradientMap,\n    });\n    const matConcrete = new THREE.MeshToonMaterial({\n      color: 0x62667a,\n      gradientMap: toonGradientMap,\n    });\n    const matZebra = new THREE.MeshStandardMaterial({\n      color: 0xf2f4f8,\n      roughness: 0.6,\n      metalness: 0.05,\n      polygonOffset: true,\n      polygonOffsetFactor: -1,\n      polygonOffsetUnits: -1,\n    });\n\n    // Helper: Add mesh + BackSide hard ink outline (replicates Nn StrokeMaterial)\n    const addOutlinedPart = (\n      parent: THREE.Object3D,\n      geo: THREE.BufferGeometry,\n      mat: THREE.Material,\n      pos: [number, number, number],\n      rot: [number, number, number] = [0, 0, 0],\n      outlineScale = 1.075,\n      castShadow = true,\n    ): THREE.Mesh => {\n      const mesh = new THREE.Mesh(geo, mat);\n      mesh.position.set(pos[0], pos[1], pos[2]);\n      mesh.rotation.set(rot[0], rot[1], rot[2]);\n      mesh.castShadow = castShadow && !isSoftwareGl;\n      mesh.receiveShadow = !isSoftwareGl;\n      mesh.userData.baseMaterial = mat;\n\n      const outline = new THREE.Mesh(geo, inkOutlineMat);\n      outline.scale.setScalar(outlineScale);\n      outline.name = \'InkStroke\';\n      mesh.add(outline);\n\n      parent.add(mesh);\n      return mesh;\n    };\n\n    // Soft radial contact shadow geometry (shared)\n    const shadowDiscGeo = new THREE.CircleGeometry(1.4, 20);\n    shadowDiscGeo.rotateX(-Math.PI / 2);\n    const shadowDiscMat = new THREE.MeshBasicMaterial({\n      color: 0x090a10,\n      transparent: true,\n      opacity: 0.42,\n      depthWrite: false,\n    });\n\n    // 4. Ground, Crossroads, Zebra Crossings, Perimeter Hills & Factory Landmarks\n    const groundGeo = new THREE.PlaneGeometry(180, 180);\n    groundGeo.rotateX(-Math.PI / 2);\n    const groundMat = new THREE.MeshStandardMaterial({\n      color: 0xffffff,\n      map: asphaltTex,\n      roughness: 0.88,\n      metalness: 0.08,\n    });\n    const groundMesh = new THREE.Mesh(groundGeo, groundMat);\n    groundMesh.receiveShadow = !isSoftwareGl;\n    scene.add(groundMesh);\n\n    // Main Factory Road Crossings (offset by +0.02 on Y to prevent Z-fighting)\n    const roadMat = new THREE.MeshStandardMaterial({\n      color: 0x191b24,\n      roughness: 0.78,\n      metalness: 0.1,\n    });\n    const roadNS = new THREE.Mesh(new THREE.BoxGeometry(10, 0.03, 96), roadMat);\n    roadNS.position.set(0, 0.015, 0);\n    roadNS.receiveShadow = !isSoftwareGl;\n    scene.add(roadNS);\n\n    const roadEW = new THREE.Mesh(new THREE.BoxGeometry(96, 0.03, 10), roadMat);\n    roadEW.position.set(0, 0.016, 0);\n    roadEW.receiveShadow = !isSoftwareGl;\n    scene.add(roadEW);\n\n    // Zebra Crossings at 4 intersections\n    const stripeGeo = new THREE.BoxGeometry(2.4, 0.02, 0.55);\n    const zebraOffsets = [\n      { x: -9, z: 0, rotY: 0 },\n      { x: 9, z: 0, rotY: 0 },\n      { x: 0, z: -9, rotY: Math.PI / 2 },\n      { x: 0, z: 9, rotY: Math.PI / 2 },\n    ];\n    zebraOffsets.forEach((zo) => {\n      const zGroup = new THREE.Group();\n      zGroup.position.set(zo.x, 0.035, zo.z);\n      zGroup.rotation.y = zo.rotY;\n      for (let i = -3; i <= 3; i++) {\n        const s = new THREE.Mesh(stripeGeo, matZebra);\n        s.position.set(0, 0, i * 1.1);\n        zGroup.add(s);\n      }\n      scene.add(zGroup);\n    });\n\n    // Central Power Core Monument (Multi-part interactive landmark at (0, 0, -14))\n    const powerCoreGroup = new THREE.Group();\n    powerCoreGroup.position.set(0, 0, -14);\n    addOutlinedPart(powerCoreGroup, new THREE.CylinderGeometry(3.2, 3.6, 0.6, 8), matDarkSteel, [0, 0.3, 0], [0, 0, 0], 1.04);\n    addOutlinedPart(powerCoreGroup, new THREE.CylinderGeometry(2.2, 2.5, 0.5, 8), matHazard, [0, 0.85, 0], [0, 0, 0], 1.04);\n    const powerCoreOrbMat = new THREE.MeshStandardMaterial({\n      color: 0xb8ff3c,\n      emissive: 0xb8ff3c,\n      emissiveIntensity: 0.45,\n      roughness: 0.2,\n      metalness: 0.3,\n    });\n    const powerCoreOrb = addOutlinedPart(\n      powerCoreGroup,\n      new THREE.OctahedronGeometry(1.35, 1),\n      powerCoreOrbMat,\n      [0, 2.7, 0],\n      [0, 0, 0],\n      1.07,\n    );\n    const powerCoreRing = addOutlinedPart(\n      powerCoreGroup,\n      new THREE.TorusGeometry(1.9, 0.16, 10, 24),\n      matYellow,\n      [0, 2.7, 0],\n      [Math.PI / 3, 0, 0],\n      1.06,\n    );\n    scene.add(powerCoreGroup);\n\n    // Factory Smokestack Chimneys & Steam Manholes (emitters for Cartoon Puff Smoke)\n    const smokeEmitterPositions: THREE.Vector3[] = [];\n\n    const buildChimneyTower = (x: number, z: number) => {\n      const g = new THREE.Group();\n      g.position.set(x, 0, z);\n      addOutlinedPart(g, new THREE.BoxGeometry(4.2, 3.2, 4.2), matConcrete, [0, 1.6, 0]);\n      addOutlinedPart(g, new THREE.BoxGeometry(4.4, 0.45, 4.4), matHazard, [0, 3.3, 0]);\n      addOutlinedPart(g, new THREE.CylinderGeometry(0.95, 1.35, 6.5, 12), matDarkSteel, [-0.8, 6.5, -0.6]);\n      addOutlinedPart(g, new THREE.CylinderGeometry(1.1, 1.1, 0.4, 12), matRedBarrel, [-0.8, 9.7, -0.6]);\n      addOutlinedPart(g, new THREE.CylinderGeometry(0.75, 1.05, 5.2, 12), matGunmetal, [0.9, 5.8, 0.7]);\n      scene.add(g);\n      smokeEmitterPositions.push(new THREE.Vector3(x - 0.8, 10.0, z - 0.6));\n      smokeEmitterPositions.push(new THREE.Vector3(x + 0.9, 8.6, z + 0.7));\n    };\n    buildChimneyTower(-18, -18);\n    buildChimneyTower(18, -18);\n\n    // Steam Manholes on Factory Floor (including near spawn vista!)\n    const manholeCoords: [number, number][] = [\n      [-3.8, 4.2],\n      [4.2, 2.5],\n      [-8, -5],\n      [9, -6],\n    ];\n    manholeCoords.forEach(([mx, mz]) => {\n      const mh = new THREE.Group();\n      mh.position.set(mx, 0, mz);\n      addOutlinedPart(mh, new THREE.CylinderGeometry(1.15, 1.25, 0.16, 16), matGunmetal, [0, 0.08, 0]);\n      addOutlinedPart(mh, new THREE.CylinderGeometry(0.85, 0.85, 0.2, 12), matDarkSteel, [0, 0.11, 0]);\n      scene.add(mh);\n      smokeEmitterPositions.push(new THREE.Vector3(mx, 0.25, mz));\n    });\n\n    // Natural Perimeter Rock Outcrops & Stylized Trees (prevents floating indoor box walls)\n    const rockGeo = new THREE.DodecahedronGeometry(2.8, 1);\n    const trunkGeo = new THREE.CylinderGeometry(0.35, 0.55, 2.2, 8);\n    const foliageGeo = new THREE.IcosahedronGeometry(1.8, 1);\n    const foliageMat = new THREE.MeshToonMaterial({\n      color: 0x7cd936,\n      gradientMap: toonGradientMap,\n    });\n    const trunkMat = new THREE.MeshToonMaterial({\n      color: 0x4b382a,\n      gradientMap: toonGradientMap,\n    });\n\n    for (let i = 0; i < 24; i++) {\n      const angle = (i / 24) * Math.PI * 2;\n      const dist = 42 + (i % 3) * 4;\n      const rx = Math.cos(angle) * dist;\n      const rz = Math.sin(angle) * dist;\n      if (i % 2 === 0) {\n        const rockGroup = new THREE.Group();\n        rockGroup.position.set(rx, 0, rz);\n        const s = 0.85 + (i % 4) * 0.22;\n        rockGroup.scale.set(s * 1.2, s * 0.85, s);\n        addOutlinedPart(rockGroup, rockGeo, matConcrete, [0, 1.4, 0], [0.2 * i, 0.5 * i, 0], 1.05, false);\n        scene.add(rockGroup);\n      } else {\n        const treeGroup = new THREE.Group();\n        treeGroup.position.set(rx, 0, rz);\n        const s = 0.9 + (i % 3) * 0.15;\n        treeGroup.scale.setScalar(s);\n        addOutlinedPart(treeGroup, trunkGeo, trunkMat, [0, 1.1, 0], [0, 0, 0], 1.06, false);\n        addOutlinedPart(treeGroup, foliageGeo, foliageMat, [0, 3.1, 0], [0, i, 0], 1.05, false);\n        addOutlinedPart(treeGroup, foliageGeo, matTankLime, [0.6, 4.1, -0.4], [0, 0, 0], 1.05, false);\n        scene.add(treeGroup);\n      }\n    }\n\n    // 5. Build Composite 11-Part Neon-Green Player Tank (sr=class in B1Nq4Kq6.js)\n    const tankRoot = new THREE.Group();\n    tankRoot.name = \'PlayerTankRoot\';\n    scene.add(tankRoot);\n\n    const tankContactShadow = new THREE.Mesh(shadowDiscGeo, shadowDiscMat);\n    tankContactShadow.position.set(0, 0.02, 0);\n    tankContactShadow.scale.set(1.35, 1.15, 1);\n    tankRoot.add(tankContactShadow);\n\n    const tankBodyGroup = new THREE.Group();\n    tankRoot.add(tankBodyGroup);\n\n    // Part 1: Main Lower Hull\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(2.25, 0.68, 1.55), matTankLime, [0, 0.58, 0]);\n    // Part 2: Upper Sloped Glacis\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(1.75, 0.34, 1.32), matTankHighlight, [0.1, 0.98, 0]);\n    // Part 3 & 4: Left & Right Armored Track Pods\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(2.55, 0.56, 0.38), matDarkSteel, [0, 0.36, -0.88]);\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(2.55, 0.56, 0.38), matDarkSteel, [0, 0.36, 0.88]);\n    // Part 5 & 6: Left & Right Neon Lime Track Fenders\n    const leftFender = addOutlinedPart(\n      tankBodyGroup,\n      new THREE.BoxGeometry(2.65, 0.14, 0.46),\n      matTankLime,\n      [0, 0.68, -0.88],\n    );\n    const rightFender = addOutlinedPart(\n      tankBodyGroup,\n      new THREE.BoxGeometry(2.65, 0.14, 0.46),\n      matTankLime,\n      [0, 0.68, 0.88],\n    );\n    // Part 7: Rear Yellow Boost Grille\n    const boostGrilleMat = new THREE.MeshStandardMaterial({\n      color: 0xfec83e,\n      emissive: 0xfec83e,\n      emissiveIntensity: 0.35,\n      roughness: 0.3,\n    });\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(0.24, 0.42, 1.12), boostGrilleMat, [-1.14, 0.64, 0]);\n\n    // Part 8: Rotating Turret Group\n    const tankTurretGroup = new THREE.Group();\n    tankTurretGroup.position.set(-0.05, 1.15, 0);\n    tankBodyGroup.add(tankTurretGroup);\n\n    addOutlinedPart(tankTurretGroup, new THREE.BoxGeometry(1.32, 0.58, 1.24), matTankLime, [0, 0.25, 0]);\n    // Part 9: Commander Hatch & Yellow Periscope\n    addOutlinedPart(tankTurretGroup, new THREE.CylinderGeometry(0.32, 0.36, 0.22, 10), matYellow, [-0.18, 0.62, 0]);\n    // Part 10 & 11: Recoiling Cannon Barrel + Yellow Muzzle Brake\n    const tankBarrelGroup = new THREE.Group();\n    tankBarrelGroup.position.set(0.65, 0.26, 0);\n    tankTurretGroup.add(tankBarrelGroup);\n\n    addOutlinedPart(\n      tankBarrelGroup,\n      new THREE.CylinderGeometry(0.14, 0.16, 1.45, 12),\n      matGunmetal,\n      [0.65, 0, 0],\n      [0, 0, -Math.PI / 2],\n    );\n    addOutlinedPart(\n      tankBarrelGroup,\n      new THREE.CylinderGeometry(0.22, 0.22, 0.28, 12),\n      matYellow,\n      [1.38, 0, 0],\n      [0, 0, -Math.PI / 2],\n    );\n\n    // Muzzle Flash Mesh & Light\n    const muzzleFlashMesh = new THREE.Mesh(\n      new THREE.SphereGeometry(0.42, 10, 10),\n      new THREE.MeshBasicMaterial({ color: 0xb8ff3c }),\n    );\n    muzzleFlashMesh.position.set(1.62, 0, 0);\n    muzzleFlashMesh.visible = false;\n    tankBarrelGroup.add(muzzleFlashMesh);\n\n    // 6. Dynamic Factory Playground Props (ExplosiveBarrels, Hydrants, Crates, ConcreteFences)\n    const dynamicProps: DynamicProp[] = [];\n    const propsFolder = new THREE.Group();\n    scene.add(propsFolder);\n\n    const buildDynamicPropMesh = (kind: DynamicProp[\'kind\']): THREE.Group => {\n      const g = new THREE.Group();\n      const shadow = new THREE.Mesh(shadowDiscGeo, shadowDiscMat);\n      shadow.position.set(0, 0.02, 0);\n      shadow.scale.setScalar(0.75);\n      g.add(shadow);\n\n      if (kind === \'barrel\') {\n        addOutlinedPart(g, new THREE.CylinderGeometry(0.62, 0.62, 1.45, 14), matRedBarrel, [0, 0.75, 0]);\n        addOutlinedPart(g, new THREE.CylinderGeometry(0.66, 0.66, 0.16, 14), matYellow, [0, 1.1, 0]);\n        addOutlinedPart(g, new THREE.CylinderGeometry(0.66, 0.66, 0.16, 14), matYellow, [0, 0.4, 0]);\n      } else if (kind === \'hydrant\') {\n        addOutlinedPart(g, new THREE.CylinderGeometry(0.42, 0.48, 1.15, 12), matYellow, [0, 0.58, 0]);\n        addOutlinedPart(g, new THREE.SphereGeometry(0.44, 12, 10), matRedBarrel, [0, 1.18, 0]);\n        addOutlinedPart(\n          g,\n          new THREE.CylinderGeometry(0.18, 0.18, 0.95, 10),\n          matGunmetal,\n          [0, 0.82, 0],\n          [0, 0, Math.PI / 2],\n        );\n      } else if (kind === \'crate\') {\n        addOutlinedPart(g, new THREE.BoxGeometry(1.45, 1.45, 1.45), matHazard, [0, 0.74, 0]);\n        addOutlinedPart(g, new THREE.BoxGeometry(1.52, 0.22, 1.52), matDarkSteel, [0, 1.38, 0]);\n      } else {\n        addOutlinedPart(g, new THREE.BoxGeometry(2.6, 1.35, 0.55), matConcrete, [0, 0.68, 0]);\n        addOutlinedPart(g, new THREE.BoxGeometry(2.68, 0.26, 0.62), matHazard, [0, 1.28, 0]);\n      }\n      return g;\n    };\n\n    const initialPropSpecs: Array<{\n      name: string;\n      kind: DynamicProp[\'kind\'];\n      x: number;\n      z: number;\n      rotY?: number;\n    }> = [\n      { name: \'ExplosiveBarrel_01\', kind: \'barrel\', x: -4.6, z: 2.2 },\n      { name: \'ExplosiveBarrel_02\', kind: \'barrel\', x: 4.8, z: 1.8 },\n      { name: \'ExplosiveBarrel_03\', kind: \'barrel\', x: 8.5, z: -9.5 },\n      { name: \'ExplosiveBarrel_04\', kind: \'barrel\', x: 10.2, z: -8.2 },\n      { name: \'ExplosiveBarrel_05\', kind: \'barrel\', x: -12, z: 9 },\n      { name: \'ExplosiveBarrel_06\', kind: \'barrel\', x: 12, z: 10 },\n      { name: \'Hydrant_NW\', kind: \'hydrant\', x: -5.5, z: -4.8 },\n      { name: \'Hydrant_NE\', kind: \'hydrant\', x: 5.5, z: -4.8 },\n      { name: \'Hydrant_SW\', kind: \'hydrant\', x: -5.5, z: 6.2 },\n      { name: \'Hydrant_SE\', kind: \'hydrant\', x: 5.5, z: 6.2 },\n      { name: \'MetalBox_1A\', kind: \'crate\', x: -6.5, z: 0.5 },\n      { name: \'MetalBox_1B\', kind: \'crate\', x: 6.8, z: -0.5 },\n      { name: \'MetalBox_2A\', kind: \'crate\', x: 14, z: -2 },\n      { name: \'MetalBox_2B\', kind: \'crate\', x: -14, z: -2 },\n      { name: \'ConcreteFence_1A\', kind: \'fence\', x: -4.2, z: -8.5, rotY: 0.2 },\n      { name: \'ConcreteFence_1B\', kind: \'fence\', x: 4.2, z: -8.5, rotY: -0.2 },\n    ];"
        start_line: 296
