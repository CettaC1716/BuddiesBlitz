              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\t\tif buddy:IsA(\"Model\") and buddy:GetAttribute(\"OwnerUserId\") == player.UserId and buddy.PrimaryPart then"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\t\t\tlocal playerCF = char:GetPivot()"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
