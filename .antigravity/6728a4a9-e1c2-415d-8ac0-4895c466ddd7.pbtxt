            lines {
              text: "      const ext = gl.getExtension(\'WEBGL_debug_renderer_info\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const param = ext ? ext.UNMASKED_RENDERER_WEBGL : gl.RENDERER;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const gpu = String(gl.getParameter(param));"
