              text: "            const totalYaw = mountedTank.hullYaw + mountedTank.turretYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            const sDir = new THREE.Vector3(Math.cos(totalYaw), 0, -Math.sin(totalYaw));"
