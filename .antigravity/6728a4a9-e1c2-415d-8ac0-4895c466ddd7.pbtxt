    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst path = require(\"path\");\nconst data = JSON.parse(fs.readFileSync(\"extracted_lyo_assets/network_captured.json\", \"utf8\"));\nconst uniqueUrls = [...new Set(data.urls.map(u => u.url))].filter(u => u.startsWith(\"https://longhoang-lyo.com/\"));\n\nfs.mkdirSync(\"extracted_lyo_assets/models\", { recursive: true });\nfs.mkdirSync(\"extracted_lyo_assets/textures\", { recursive: true });\nfs.mkdirSync(\"extracted_lyo_assets/scripts\", { recursive: true });\nfs.mkdirSync(\"public/extracted_lyo_assets/models\", { recursive: true });\nfs.mkdirSync(\"public/extracted_lyo_assets/textures\", { recursive: true });\nfs.mkdirSync(\"public/draco\", { recursive: true });\nfs.mkdirSync(\"public/basis\", { recursive: true });\n\nasync function run() {\n  let downloadedModels = [];\n  let downloadedTextures = [];\n  let downloadedScripts = [];\n\n  for (const url of uniqueUrls) {\n    const u = new URL(url);\n    const base = path.basename(u.pathname);\n    const ext = path.extname(u.pathname).toLowerCase();\n\n    if (![\".glb\", \".gltf\", \".bin\", \".ktx2\", \".webp\", \".png\", \".jpg\", \".hdr\", \".json\", \".js\", \".wasm\"].includes(ext)) {\n      continue;\n    }\n\n    try {\n      const res = await fetch(url);\n      if (!res.ok) continue;\n      const buf = Buffer.from(await res.arrayBuffer());\n\n      if (ext === \".glb\" || ext === \".gltf\" || u.pathname.startsWith(\"/model/robot/\")) {\n        if (ext === \".ktx2\") {\n          fs.writeFileSync(path.join(\"extracted_lyo_assets/textures\", base), buf);\n          fs.writeFileSync(path.join(\"public/extracted_lyo_assets/textures\", base), buf);\n          downloadedTextures.push(base);\n        } else {\n          fs.writeFileSync(path.join(\"extracted_lyo_assets/models\", base), buf);\n          fs.writeFileSync(path.join(\"public/extracted_lyo_assets/models\", base), buf);\n          downloadedModels.push(base);\n        }\n      } else if ([\".ktx2\", \".bin\", \".webp\", \".png\", \".jpg\", \".hdr\"].includes(ext)) {\n        fs.writeFileSync(path.join(\"extracted_lyo_assets/textures\", base), buf);\n        fs.writeFileSync(path.join(\"public/extracted_lyo_assets/textures\", base), buf);\n        downloadedTextures.push(base);\n      } else if (u.pathname.startsWith(\"/draco/\")) {\n        fs.writeFileSync(path.join(\"public/draco\", base), buf);\n        fs.writeFileSync(path.join(\"extracted_lyo_assets/scripts\", base), buf);\n        downloadedScripts.push(base);\n      } else if (u.pathname.startsWith(\"/basis/\")) {\n        fs.writeFileSync(path.join(\"public/basis\", base), buf);\n        fs.writeFileSync(path.join(\"extracted_lyo_assets/scripts\", base), buf);\n        downloadedScripts.push(base);\n      } else if (ext === \".js\") {\n        fs.writeFileSync(path.join(\"extracted_lyo_assets/scripts\", base), buf);\n        downloadedScripts.push(base);\n      }\n    } catch (e) {\n      console.error(\"Failed:\", url, e.message);\n    }\n  }\n\n  console.log(\"Downloaded Models (\" + downloadedModels.length + \"):\", downloadedModels.sort().join(\", \"));\n  console.log(\"Downloaded Textures (\" + downloadedTextures.length + \"):\", downloadedTextures.sort().join(\", \"));\n  console.log(\"Downloaded Scripts/WASM (\" + downloadedScripts.length + \"):\", downloadedScripts.sort().join(\", \"));\n}\nrun();\n\'"
    proposed_command_line: "node -e \'\nconst fs = require(\"fs\");\nconst path = require(\"path\");\nconst data = JSON.parse(fs.readFileSync(\"extracted_lyo_assets/network_captured.json\", \"utf8\"));\nconst uniqueUrls = [...new Set(data.urls.map(u => u.url))].filter(u => u.startsWith(\"https://longhoang-lyo.com/\"));\n\nfs.mkdirSync(\"extracted_lyo_assets/models\", { recursive: true });\nfs.mkdirSync(\"extracted_lyo_assets/textures\", { recursive: true });\nfs.mkdirSync(\"extracted_lyo_assets/scripts\", { recursive: true });\nfs.mkdirSync(\"public/extracted_lyo_assets/models\", { recursive: true });\nfs.mkdirSync(\"public/extracted_lyo_assets/textures\", { recursive: true });\nfs.mkdirSync(\"public/draco\", { recursive: true });\nfs.mkdirSync(\"public/basis\", { recursive: true });\n\nasync function run() {\n  let downloadedModels = [];\n  let downloadedTextures = [];\n  let downloadedScripts = [];\n\n  for (const url of uniqueUrls) {\n    const u = new URL(url);\n    const base = path.basename(u.pathname);\n    const ext = path.extname(u.pathname).toLowerCase();\n\n    if (![\".glb\", \".gltf\", \".bin\", \".ktx2\", \".webp\", \".png\", \".jpg\", \".hdr\", \".json\", \".js\", \".wasm\"].includes(ext)) {\n      continue;\n    }\n\n    try {\n      const res = await fetch(url);\n      if (!res.ok) continue;\n      const buf = Buffer.from(await res.arrayBuffer());\n\n      if (ext === \".glb\" || ext === \".gltf\" || u.pathname.startsWith(\"/model/robot/\")) {\n        if (ext === \".ktx2\") {\n          fs.writeFileSync(path.join(\"extracted_lyo_assets/textures\", base), buf);\n          fs.writeFileSync(path.join(\"public/extracted_lyo_assets/textures\", base), buf);\n          downloadedTextures.push(base);\n        } else {\n          fs.writeFileSync(path.join(\"extracted_lyo_assets/models\", base), buf);\n          fs.writeFileSync(path.join(\"public/extracted_lyo_assets/models\", base), buf);\n          downloadedModels.push(base);\n        }\n      } else if ([\".ktx2\", \".bin\", \".webp\", \".png\", \".jpg\", \".hdr\"].includes(ext)) {\n        fs.writeFileSync(path.join(\"extracted_lyo_assets/textures\", base), buf);\n        fs.writeFileSync(path.join(\"public/extracted_lyo_assets/textures\", base), buf);\n        downloadedTextures.push(base);\n      } else if (u.pathname.startsWith(\"/draco/\")) {\n        fs.writeFileSync(path.join(\"public/draco\", base), buf);\n        fs.writeFileSync(path.join(\"extracted_lyo_assets/scripts\", base), buf);\n        downloadedScripts.push(base);\n      } else if (u.pathname.startsWith(\"/basis/\")) {\n        fs.writeFileSync(path.join(\"public/basis\", base), buf);\n        fs.writeFileSync(path.join(\"extracted_lyo_assets/scripts\", base), buf);\n        downloadedScripts.push(base);\n      } else if (ext === \".js\") {\n        fs.writeFileSync(path.join(\"extracted_lyo_assets/scripts\", base), buf);\n        downloadedScripts.push(base);\n      }\n    } catch (e) {\n      console.error(\"Failed:\", url, e.message);\n    }\n  }\n\n  console.log(\"Downloaded Models (\" + downloadedModels.length + \"):\", downloadedModels.sort().join(\", \"));\n  console.log(\"Downloaded Textures (\" + downloadedTextures.length + \"):\", downloadedTextures.sort().join(\", \"));\n  console.log(\"Downloaded Scripts/WASM (\" + downloadedScripts.length + \"):\", downloadedScripts.sort().join(\", \"));\n}\nrun();\n\'"
