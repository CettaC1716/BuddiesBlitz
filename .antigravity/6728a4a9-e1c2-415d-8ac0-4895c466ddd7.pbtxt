            }
            lines {
              text: "  let randomSeed = 1431691;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const getRandom = () => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    randomSeed = (randomSeed * 1664525 + 1013904223) >>> 0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    return randomSeed / 4294967296;"
