    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "import {\n  REA_CONSTANTS,\n  LIGHTING_PRESETS,\n  LightingPresetKey,\n} from \'./game/rules\';\nimport { soundEngine } from \'./game/audio\';\nimport { ReaLuauModal } from \'./components/ReaLuauModal\';\n\nconst INITIAL_HUD: HudSnapshot = {\n  hp: 30,\n  maxHp: 30,\n  score: 0,\n  bestScore: 0,\n  speedKmh: 0,\n  isBoosting: false,\n  isGrabMode: false,\n  grabbedPropName: null,\n  collectedItems: [\'GEAR\', \'TOOLS\'],\n  powerCoreActivated: false,\n  enemiesDefeated: 0,\n  totalEnemies: 4,\n  lightingPreset: \'day\',\n  cameraFovMode: \'webgl35\',\n  outcome: null,\n  clearTimeSec: 0,\n  controlMode: \'buddy\',\n  activeClass: \'Infuntry\',\n  equippedWeapon: \'Uzi\',\n  ammo: 120,\n  carryingCrate: \'none\',\n  tankStoredCrates: 0,\n  padSlots: [\'red\', \'empty\', \'empty\', \'empty\', \'super\', \'empty\', \'empty\', \'empty\'],\n  padShape: \'1x1x2\',\n  padOutputName: \'Stealthy / Ninja\',\n  padIsMerged: true,\n  padIsSuper: true,\n  buildOrder: \'AUTO\',\n  teamCommand: \'HARVEST\',\n  alliedBuddiesCount: 2,\n  blueBaseHp: 2000,\n  redBaseHp: 2000,\n  contextHint: \'WASD Lari \302\267 [E] Ambil Peti \302\267 [G] Naik Tank\',\n};\n\nconst PRESET_ORDER: LightingPresetKey[] = [\'day\', \'dusk\', \'night\', \'dawn\'];\n\nexport default function App() {\n  const [gameState, setGameState] = useState<GameState>(() => {\n    if (typeof window !== \'undefined\') {\n      const params = new URLSearchParams(window.location.search);\n      if (params.get(\'autostart\') === \'1\') {\n        return \'playing\';\n      }\n    }\n    return \'title\';\n  });\n\n  const [hud, setHud] = useState<HudSnapshot>(INITIAL_HUD);\n  const [finalRunStats, setFinalRunStats] = useState<HudSnapshot | null>(null);\n  const [lightingPreset, setLightingPreset] = useState<LightingPresetKey>(\'day\');\n  const [cameraFovMode, setCameraFovMode] = useState<\'webgl35\' | \'roblox18\'>(\'webgl35\');\n  const [isMuted, setIsMuted] = useState<boolean>(false);\n  const [isReaModalOpen, setIsReaModalOpen] = useState<boolean>(false);\n  const [isDockCollapsed, setIsDockCollapsed] = useState<boolean>(false);\n  const [resetTrigger, setResetTrigger] = useState<number>(0);\n\n  const hexContainerRef = useRef<HTMLDivElement | null>(null);\n  const [hexRect, setHexRect] = useState<{ left: number; top: number; width: number; height: number }>({\n    left: 720,\n    top: 140,\n    width: 480,\n    height: 462,\n  });\n\n  useEffect(() => {\n    document.body.dataset.state = gameState;\n  }, [gameState]);\n\n  const syncHexBounds = useCallback(() => {\n    if (!hexContainerRef.current) return;\n    const r = hexContainerRef.current.getBoundingClientRect();\n    if (r.width > 0 && r.height > 0) {\n      setHexRect({\n        left: r.left,\n        top: r.top,\n        width: r.width,\n        height: r.height,\n      });\n    }\n  }, []);\n\n  useEffect(() => {\n    syncHexBounds();\n    window.addEventListener(\'resize\', syncHexBounds);\n    return () => window.removeEventListener(\'resize\', syncHexBounds);\n  }, [syncHexBounds, gameState]);\n\n  const dispatchBuddyAction = useCallback((actionName: string) => {\n    window.dispatchEvent(new CustomEvent(\'buddy-action\', { detail: actionName }));\n  }, []);\n\n  const handleStartGame = useCallback((shouldReset = false) => {\n    soundEngine.playUiClick();\n    if (document.activeElement instanceof HTMLElement) {\n      document.activeElement.blur();\n    }\n    if (shouldReset) {\n      setResetTrigger((prev) => prev + 1);\n      setFinalRunStats(null);\n    }\n    document.body.dataset.state = \'playing\';\n    setGameState(\'playing\');\n  }, []);\n\n  const handleToggleAudio = useCallback(() => {\n    const nextMuted = !soundEngine.muted;\n    soundEngine.muted = nextMuted;\n    setIsMuted(nextMuted);\n    if (!nextMuted) {\n      soundEngine.playUiClick();\n    }\n  }, []);\n\n  const handleCycleLighting = useCallback(() => {\n    soundEngine.playUiClick();\n    setLightingPreset((prev) => {\n      const idx = PRESET_ORDER.indexOf(prev);\n      return PRESET_ORDER[(idx + 1) % PRESET_ORDER.length];\n    });\n  }, []);\n\n  const handleToggleFovMode = useCallback(() => {\n    soundEngine.playUiClick();\n    setCameraFovMode((prev) => (prev === \'webgl35\' ? \'roblox18\' : \'webgl35\'));\n  }, []);\n\n  const handleTogglePause = useCallback(() => {\n    soundEngine.playUiClick();\n    setGameState((prev) => {\n      const next = prev === \'playing\' ? \'paused\' : prev === \'paused\' ? \'playing\' : prev;\n      document.body.dataset.state = next;\n      return next;\n    });\n  }, []);\n\n  const handleGameOver = useCallback(\n    (_outcome: \'victory\' | \'defeat\', snapshot: HudSnapshot) => {\n      setFinalRunStats(snapshot);\n      document.body.dataset.state = \'gameover\';\n      setGameState(\'gameover\');\n    },\n    [],\n  );\n\n  useEffect(() => {\n    const onKeyDown = (e: KeyboardEvent) => {\n      if (isReaModalOpen) {\n        if (e.code === \'Escape\') {\n          setIsReaModalOpen(false);\n        }\n        return;\n      }\n\n      if (gameState === \'title\' && (e.code === \'Enter\' || e.code === \'Space\')) {\n        e.preventDefault();\n        handleStartGame(false);\n        return;\n      }\n\n      if (e.code === \'KeyM\') {\n        handleToggleAudio();\n      } else if (e.code === \'KeyL\') {\n        handleCycleLighting();\n      } else if (e.code === \'KeyC\') {\n        handleToggleFovMode();\n      } else if (e.code === \'KeyH\') {\n        setIsDockCollapsed((prev) => !prev);\n      } else if (e.code === \'KeyR\' && gameState === \'playing\') {\n        soundEngine.playUiClick();\n        setIsReaModalOpen(true);\n      }\n    };\n\n    window.addEventListener(\'keydown\', onKeyDown);\n    return () => window.removeEventListener(\'keydown\', onKeyDown);\n  }, [\n    gameState,\n    isReaModalOpen,\n    handleStartGame,\n    handleToggleAudio,\n    handleCycleLighting,\n    handleToggleFovMode,\n  ]);\n\n  const currentPresetConfig = LIGHTING_PRESETS[lightingPreset];\n  const scaleX = hexRect.width / 500;\n  const scaleY = hexRect.height / 482;\n\n  return (\n    <main className=\"relative w-screen h-screen overflow-hidden select-none\">\n      {/* 1. 60FPS 3D Team Buddies x Lyo Grassland Arena */}\n      <FactoryPlaygroundCanvas\n        gameState={gameState}\n        lightingPreset={lightingPreset}\n        cameraFovMode={cameraFovMode}\n        resetTrigger={resetTrigger}\n        onHudUpdate={setHud}\n        onGameOver={handleGameOver}\n        onTogglePause={handleTogglePause}\n      />\n\n      {/* Atmospheric Viewport Color Tint Overlay */}\n      <div\n        aria-hidden=\"true\"\n        className=\"fixed inset-0 pointer-events-none z-10 transition-colors duration-700\"\n        style={{\n          backgroundColor: currentPresetConfig.viewportFilterColor,\n          opacity: currentPresetConfig.viewportFilterOpacity,\n        }}\n      />\n\n      {/* =====================================================================\n          2. TITLE SCREEN: HEXAGON CUTOUT & COMIC STICKER LOCKUP (CJn-Xu8f.js)\n         ===================================================================== */}\n      {gameState === \'title\' && (\n        <section\n          aria-label=\"LYOOO Portfolio Title Screen\"\n          className=\"fixed inset-0 z-20 flex flex-col justify-between pointer-events-none\"\n        >\n          <svg\n            className=\"fixed inset-0 w-full h-full pointer-events-none\"\n            width=\"100%\"\n            height=\"100%\"\n            preserveAspectRatio=\"none\"\n          >\n            <defs>\n              <mask\n                id=\"intro-mask-cutout\"\n                maskUnits=\"userSpaceOnUse\"\n                x=\"0\"\n                y=\"0\"\n                width=\"100%\"\n                height=\"100%\"\n              >\n                <rect width=\"100%\" height=\"100%\" fill=\"white\" />\n                <g\n                  transform={`translate(${hexRect.left}, ${hexRect.top}) scale(${scaleX}, ${scaleY})`}\n                >\n                  <path d={REA_CONSTANTS.introHexagonSvgPath} fill=\"black\" />\n                </g>\n              </mask>\n              <linearGradient id=\"intro-overlay-gradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                <stop offset=\"0%\" stopColor=\"#0b0c12\" stopOpacity=\"0.94\" />\n                <stop offset=\"52%\" stopColor=\"#11121a\" stopOpacity=\"0.86\" />\n                <stop offset=\"100%\" stopColor=\"#11121a\" stopOpacity=\"0.72\" />\n              </linearGradient>\n            </defs>\n            <rect\n              width=\"100%\"\n              height=\"100%\"\n              fill=\"url(#intro-overlay-gradient)\"\n              mask=\"url(#intro-mask-cutout)\"\n            />\n          </svg>\n\n          <div className=\"relative z-10 flex-1 grid grid-cols-1 lg:grid-cols-12 items-center px-6 sm:px-12 lg:px-16 pt-8 pb-4 gap-6\">\n            <div className=\"lg:col-span-6 flex flex-col items-start justify-end lg:justify-center space-y-5 pointer-events-auto\">\n              <svg\n                viewBox=\"0 0 560 225\"\n                className=\"w-full max-w-[510px] drop-shadow-[6px_8px_0px_#11121a]\"\n                role=\"img\"\n                aria-label=\"LYOOO PORTFOLIO\"\n              >\n                <g transform=\"rotate(-3 260 85)\">\n                  <rect\n                    x=\"10\"\n                    y=\"12\"\n                    width=\"455\"\n                    height=\"108\"\n                    rx=\"18\"\n                    fill=\"#ffffff\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"8\"\n                  />\n                  <text\n                    x=\"32\"\n                    y=\"94\"\n                    fontFamily=\"\'Barlow\', sans-serif\"\n                    fontWeight=\"900\"\n                    fontStyle=\"italic\"\n                    fontSize=\"94\"\n                    letterSpacing=\"2\"\n                    fill=\"#ffffff\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"16\"\n                    paintOrder=\"stroke fill\"\n                  >\n                    LYOOO\n                  </text>\n                </g>\n\n                <g transform=\"translate(24, 108) rotate(-1.5 220 45)\">\n                  <rect\n                    x=\"0\"\n                    y=\"0\"\n                    width=\"430\"\n                    height=\"84\"\n                    rx=\"14\"\n                    fill=\"#b4ff39\"\n                    stroke=\"#ffffff\"\n                    strokeWidth=\"10\"\n                  />\n                  <rect\n                    x=\"4\"\n                    y=\"4\"\n                    width=\"422\"\n                    height=\"76\"\n                    rx=\"11\"\n                    fill=\"#b4ff39\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"6\"\n                  />\n                  <text\n                    x=\"26\"\n                    y=\"61\"\n                    fontFamily=\"\'Barlow\', sans-serif\"\n                    fontWeight=\"900\"\n                    fontSize=\"58\"\n                    letterSpacing=\"4\"\n                    fill=\"#11121a\"\n                  >\n                    PORTFOLIO\n                  </text>\n                </g>\n              </svg>\n\n              <div className=\"flex flex-wrap items-center gap-3 pt-1\">\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    soundEngine.playUiClick();\n                    setIsReaModalOpen(true);\n                  }}\n                  className=\"px-4 py-2.5 bg-[#272935] hover:bg-[#393b49] text-[#b8ff3c] font-black text-xs sm:text-sm rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow transition-transform hover:-translate-y-0.5 cursor-pointer whitespace-nowrap\"\n                >\n                  Kode Luau\n                </button>\n              </div>\n            </div>\n\n            <div className=\"lg:col-span-6 flex items-center justify-center\">\n              <div\n                ref={hexContainerRef}\n                className=\"relative w-[330px] h-[318px] sm:w-[440px] sm:h-[424px] lg:w-[485px] lg:h-[468px] pointer-events-none\"\n              >\n                <svg\n                  width=\"100%\"\n                  height=\"100%\"\n                  viewBox=\"0 0 500 482\"\n                  fill=\"none\"\n                  className=\"absolute inset-0 w-full h-full\"\n                >\n                  <path\n                    d={REA_CONSTANTS.introHexagonSvgPath}\n                    fill=\"none\"\n                    stroke=\"rgba(255, 255, 255, 0.55)\"\n                    strokeWidth=\"3.5\"\n                  />\n                  <path\n                    d={REA_CONSTANTS.introHexagonSvgPath}\n                    fill=\"none\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"2\"\n                    strokeDasharray=\"10 6\"\n                  />\n                </svg>\n\n                <button\n                  type=\"button\"\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    handleToggleAudio();\n                  }}\n                  aria-label={isMuted ? \'Suara Mati\' : \'Suara Aktif\'}\n                  className=\"pointer-events-auto absolute top-3 right-6 w-14 h-14 flex items-center justify-center bg-white hover:bg-[#fec83e] text-[#11121a] font-black text-xs border-4 border-[#11121a] ring-2 ring-white rounded-2xl rotate-6 comic-sticker-shadow transition-transform hover:scale-105 active:scale-95 cursor-pointer\"\n                >\n                  {isMuted ? \'MUTE\' : \'SUARA\'}\n                </button>\n\n                <button\n                  type=\"button\"\n                  data-start=\"true\"\n                  onClick={() => handleStartGame(false)}\n                  aria-label=\"LET\'S GO\"\n                  className=\"pointer-events-auto absolute -bottom-3 left-1/2 -translate-x-1/2 -rotate-3 hover:-rotate-6 hover:scale-108 active:scale-95 px-9 py-4 bg-[#b4ff39] hover:bg-[#c7ff72] text-[#11121a] font-black text-2xl sm:text-3xl tracking-wider rounded-2xl border-4 border-[#11121a] ring-4 ring-white comic-sticker-shadow-lg transition-all duration-150 cursor-pointer whitespace-nowrap\"\n                >\n                  LET&apos;S GO\n                </button>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"relative z-10 pb-5 px-6 text-center text-xs sm:text-sm font-bold tracking-wide text-[#dfdfe2]/85\">\n            WASD Lari &nbsp;\302\267&nbsp; [E] Ambil/Lempar Peti &nbsp;\302\267&nbsp; [F] Rakit Pad &nbsp;\302\267&nbsp; [G] Naik Tank &nbsp;\302\267&nbsp; [Tab] Ganti Buddy\n          </div>\n        </section>\n      )}\n\n      {/* =====================================================================\n          3. PLAYING HUD: WORLD-MATCHED COMIC CLUSTERS (>= 85% CLEAR VIEWPORT)\n         ===================================================================== */}\n      {gameState === \'playing\' && (\n        <div className=\"fixed inset-0 z-20 pointer-events-none flex flex-col justify-between p-4 sm:p-6\">\n          {/* Top Row */}\n          <div className=\"flex items-start justify-between gap-4\">\n            {/* Top-Left Cluster: Buddy/Tank Status + 3D Stacking Pad 2x2x2 + Base HQ Bars */}\n            <div className=\"pointer-events-auto flex flex-wrap items-center gap-3 bg-[#191b24]/95 border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl px-4 py-2.5 comic-sticker-shadow\">\n              {/* Mode & HP */}\n              <div className=\"pr-3 border-r-2 border-[#393b49]\">\n                <div className=\"text-[10px] font-black uppercase tracking-wider text-[#b8ff3c]\">\n                  {hud.controlMode === \'tank\'\n                    ? `OPEN-TOP TANK (${hud.tankStoredCrates}/4 PETI)`\n                    : `BUDDY: ${hud.activeClass.toUpperCase()}`}\n                </div>\n                <div className=\"flex items-center gap-1 mt-0.5\">\n                  {Array.from({ length: 6 }).map((_, idx) => {\n                    const threshold = (idx + 1) * (hud.maxHp / 6);\n                    const full = hud.hp >= threshold;\n                    return (\n                      <span\n                        key={idx}\n                        className={`w-3.5 h-3.5 rounded-sm border-2 border-[#11121a] ${\n                          full ? \'bg-[#b8ff3c]\' : \'bg-[#272935]\'\n                        }`}\n                      />\n                    );\n                  })}\n                  <span className=\"ml-1.5 text-xs font-black font-mono-tabular text-white\">\n                    {hud.equippedWeapon}\n                  </span>\n                </div>\n              </div>\n\n              {/* 3D Stacking Pad 2x2x2 Live Status */}\n              <div className=\"pr-3 border-r-2 border-[#393b49]\">\n                <div className=\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\">\n                  PAD 2x2x2: {hud.padShape} {hud.padIsMerged ? \'\302\267 MERGED\' : \'\'}\n                </div>\n                <div className=\"flex items-center gap-1 mt-0.5\">\n                  {hud.padSlots.map((slot, idx) => (\n                    <span\n                      key={idx}\n                      className={`w-3 h-3 rounded-xs border border-[#11121a] ${\n                        slot === \'super\'\n                          ? \'bg-[#00d2ff]\'\n                          : slot === \'red\'\n                          ? \'bg-[#ff3b30]\'\n                          : \'bg-[#272935]\'\n                      }`}\n                    />\n                  ))}\n                  <span\n                    className={`ml-1.5 text-xs font-black ${\n                      hud.padIsSuper ? \'text-[#00d2ff]\' : \'text-[#fec83e]\'\n                    }`}\n                  >\n                    {hud.padOutputName}\n                  </span>\n                </div>\n              </div>\n\n              {/* Blue HQ vs Red HQ HP */}\n              <div>\n                <div className=\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\">\n                  BLUE HQ vs RED HQ\n                </div>\n                <div className=\"flex items-center gap-2 mt-0.5 text-xs font-black font-mono-tabular\">\n                  <span className=\"text-[#00d2ff]\">{hud.blueBaseHp}</span>\n                  <span className=\"text-[#8f93a5]\">/</span>\n                  <span className=\"text-[#ff3b30]\">{hud.redBaseHp}</span>\n                  <span className=\"ml-1 px-1.5 py-0.5 bg-[#272935] text-[#b8ff3c] text-[10px] rounded border border-[#11121a]\">\n                    TIM: {hud.alliedBuddiesCount}\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            {/* Top-Right Compact Utility Buttons */}\n            <div className=\"pointer-events-auto flex items-center gap-2\">\n              <button\n                type=\"button\"\n                tabIndex={-1}\n                onClick={(e) => {\n                  e.currentTarget.blur();\n                  soundEngine.playUiClick();\n                  setIsReaModalOpen(true);\n                }}\n                aria-label=\"Kode Luau\"\n                className=\"px-3.5 h-11 flex items-center gap-2 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white comic-sticker-shadow cursor-pointer whitespace-nowrap\"\n              >\n                <span>Kode Luau</span>\n              </button>\n\n              <button\n                type=\"button\"\n                tabIndex={-1}\n                onClick={(e) => {\n                  e.currentTarget.blur();\n                  handleToggleAudio();\n                }}\n                aria-label={isMuted ? \'Suara Mati\' : \'Suara Aktif\'}\n                className=\"w-14 h-11 flex items-center justify-center bg-[#191b24] hover:bg-[#272935] text-white font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow cursor-pointer\"\n              >\n                {isMuted ? \'MUTE\' : \'SUARA\'}\n              </button>\n\n              <button\n                type=\"button\"\n                tabIndex={-1}\n                onClick={(e) => {\n                  e.currentTarget.blur();\n                  handleTogglePause();\n                }}\n                aria-label=\"Jeda\"\n                className=\"w-14 h-11 flex items-center justify-center bg-[#191b24] hover:bg-[#272935] text-white font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow cursor-pointer\"\n              >\n                JEDA\n              </button>\n            </div>\n          </div>\n\n          {/* Bottom Context Prompt + Action Dock */}\n          <div className=\"flex flex-col items-center\">\n            <div className=\"mb-1.5 px-3.5 py-1 bg-[#11121a]/90 text-[#b4ff39] font-black text-xs rounded-lg border-2 border-[#11121a]\">\n              {hud.contextHint}\n            </div>\n\n            {!isDockCollapsed && (\n              <div className=\"pointer-events-auto flex flex-wrap items-center justify-center gap-2 px-4 py-2 bg-[#191b24]/95 border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl comic-sticker-shadow max-w-[96vw]\">\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    dispatchBuddyAction(\'pickupOrThrow\');\n                  }}\n                  className=\"px-3 py-1.5 bg-[#ff3b30] hover:bg-[#ff554a] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  {hud.carryingCrate !== \'none\' ? \'[E] Lempar Peti\' : \'[E] Ambil Peti\'}\n                </button>\n\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    dispatchBuddyAction(\'kickOrCraft\');\n                  }}\n                  className=\"px-3 py-1.5 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  [F] Rakit Pad\n                </button>\n\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    dispatchBuddyAction(\'mountOrDismount\');\n                  }}\n                  className=\"px-3 py-1.5 bg-[#fec83e] hover:bg-[#fee763] text-[#11121a] font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  {hud.controlMode === \'tank\' ? \'[G] Turun Tank\' : \'[G] Naik Tank\'}\n                </button>\n\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    dispatchBuddyAction(\'cycleBuildOrder\');\n                  }}\n                  className=\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  [Q] Pola: <span className=\"text-[#00d2ff]\">{hud.buildOrder}</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    dispatchBuddyAction(\'cycleCommand\');\n                  }}\n                  className=\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  [V] AI: <span className=\"text-[#fec83e]\">{hud.teamCommand}</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    dispatchBuddyAction(\'swapBuddy\');\n                  }}\n                  className=\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  [Tab] Ganti Buddy\n                </button>\n              </div>\n            )}\n          </div>\n        </div>\n      )}"
        replacement_content: "import {\n  REA_CONSTANTS,\n  LIGHTING_PRESETS,\n  LightingPresetKey,\n  getBuildOrderAllowedSlots,\n} from \'./game/rules\';\nimport { soundEngine } from \'./game/audio\';\nimport { ReaLuauModal } from \'./components/ReaLuauModal\';\n\nconst INITIAL_HUD: HudSnapshot = {\n  hp: 30,\n  maxHp: 30,\n  score: 0,\n  bestScore: 0,\n  speedKmh: 0,\n  isBoosting: false,\n  isGrabMode: false,\n  grabbedPropName: null,\n  collectedItems: [],\n  powerCoreActivated: false,\n  enemiesDefeated: 0,\n  totalEnemies: 4,\n  lightingPreset: \'day\',\n  cameraFovMode: \'webgl35\',\n  outcome: null,\n  clearTimeSec: 0,\n  controlMode: \'buddy\',\n  activeClass: \'Infuntry\',\n  equippedWeapon: \'Uzi\',\n  ammo: 120,\n  carryingCrate: \'none\',\n  tankStoredCrates: 0,\n  padSlots: [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'],\n  padShape: \'Empty\',\n  padOutputName: \'Pad Kosong\',\n  padIsMerged: false,\n  padIsSuper: false,\n  buildOrder: \'1x1x2\',\n  buildOrderLabel: \'Buddy T1\',\n  buildOrderTargetCrates: 2,\n  teamCommand: \'HARVEST\',\n  alliedBuddiesCount: 2,\n  blueBaseHp: 2000,\n  redBaseHp: 2000,\n  contextHint: \'WASD Lari \302\267 [E] Ambil Peti \302\267 [Q] Pola 1x1x2 \302\267 [V] Teropong AI\',\n  radarDots: [],\n};\n\nconst PRESET_ORDER: LightingPresetKey[] = [\'day\', \'dusk\', \'night\', \'dawn\'];\n\nexport default function App() {\n  const [gameState, setGameState] = useState<GameState>(() => {\n    if (typeof window !== \'undefined\') {\n      const params = new URLSearchParams(window.location.search);\n      if (params.get(\'autostart\') === \'1\') {\n        return \'playing\';\n      }\n    }\n    return \'title\';\n  });\n\n  const [hud, setHud] = useState<HudSnapshot>(INITIAL_HUD);\n  const [finalRunStats, setFinalRunStats] = useState<HudSnapshot | null>(null);\n  const [lightingPreset, setLightingPreset] = useState<LightingPresetKey>(\'day\');\n  const [cameraFovMode, setCameraFovMode] = useState<\'webgl35\' | \'roblox18\'>(\'webgl35\');\n  const [isMuted, setIsMuted] = useState<boolean>(false);\n  const [isReaModalOpen, setIsReaModalOpen] = useState<boolean>(false);\n  const [isDockCollapsed, setIsDockCollapsed] = useState<boolean>(false);\n  const [resetTrigger, setResetTrigger] = useState<number>(0);\n\n  const hexContainerRef = useRef<HTMLDivElement | null>(null);\n  const [hexRect, setHexRect] = useState<{ left: number; top: number; width: number; height: number }>({\n    left: 720,\n    top: 140,\n    width: 480,\n    height: 462,\n  });\n\n  useEffect(() => {\n    document.body.dataset.state = gameState;\n  }, [gameState]);\n\n  const syncHexBounds = useCallback(() => {\n    if (!hexContainerRef.current) return;\n    const r = hexContainerRef.current.getBoundingClientRect();\n    if (r.width > 0 && r.height > 0) {\n      setHexRect({\n        left: r.left,\n        top: r.top,\n        width: r.width,\n        height: r.height,\n      });\n    }\n  }, []);\n\n  useEffect(() => {\n    syncHexBounds();\n    window.addEventListener(\'resize\', syncHexBounds);\n    return () => window.removeEventListener(\'resize\', syncHexBounds);\n  }, [syncHexBounds, gameState]);\n\n  const dispatchBuddyAction = useCallback((actionName: string) => {\n    window.dispatchEvent(new CustomEvent(\'buddy-action\', { detail: actionName }));\n  }, []);\n\n  const handleStartGame = useCallback((shouldReset = false) => {\n    soundEngine.playUiClick();\n    if (document.activeElement instanceof HTMLElement) {\n      document.activeElement.blur();\n    }\n    if (shouldReset) {\n      setResetTrigger((prev) => prev + 1);\n      setFinalRunStats(null);\n    }\n    document.body.dataset.state = \'playing\';\n    setGameState(\'playing\');\n  }, []);\n\n  const handleToggleAudio = useCallback(() => {\n    const nextMuted = !soundEngine.muted;\n    soundEngine.muted = nextMuted;\n    setIsMuted(nextMuted);\n    if (!nextMuted) {\n      soundEngine.playUiClick();\n    }\n  }, []);\n\n  const handleCycleLighting = useCallback(() => {\n    soundEngine.playUiClick();\n    setLightingPreset((prev) => {\n      const idx = PRESET_ORDER.indexOf(prev);\n      return PRESET_ORDER[(idx + 1) % PRESET_ORDER.length];\n    });\n  }, []);\n\n  const handleToggleFovMode = useCallback(() => {\n    soundEngine.playUiClick();\n    setCameraFovMode((prev) => (prev === \'webgl35\' ? \'roblox18\' : \'webgl35\'));\n  }, []);\n\n  const handleTogglePause = useCallback(() => {\n    soundEngine.playUiClick();\n    setGameState((prev) => {\n      const next = prev === \'playing\' ? \'paused\' : prev === \'paused\' ? \'playing\' : prev;\n      document.body.dataset.state = next;\n      return next;\n    });\n  }, []);\n\n  const handleGameOver = useCallback(\n    (_outcome: \'victory\' | \'defeat\', snapshot: HudSnapshot) => {\n      setFinalRunStats(snapshot);\n      document.body.dataset.state = \'gameover\';\n      setGameState(\'gameover\');\n    },\n    [],\n  );\n\n  useEffect(() => {\n    const onKeyDown = (e: KeyboardEvent) => {\n      if (isReaModalOpen) {\n        if (e.code === \'Escape\') {\n          setIsReaModalOpen(false);\n        }\n        return;\n      }\n\n      if (gameState === \'title\' && (e.code === \'Enter\' || e.code === \'Space\')) {\n        e.preventDefault();\n        handleStartGame(false);\n        return;\n      }\n\n      if (e.code === \'KeyM\') {\n        handleToggleAudio();\n      } else if (e.code === \'KeyL\') {\n        handleCycleLighting();\n      } else if (e.code === \'KeyC\') {\n        handleToggleFovMode();\n      } else if (e.code === \'KeyH\') {\n        setIsDockCollapsed((prev) => !prev);\n      } else if (e.code === \'KeyR\' && gameState === \'playing\') {\n        soundEngine.playUiClick();\n        setIsReaModalOpen(true);\n      }\n    };\n\n    window.addEventListener(\'keydown\', onKeyDown);\n    return () => window.removeEventListener(\'keydown\', onKeyDown);\n  }, [\n    gameState,\n    isReaModalOpen,\n    handleStartGame,\n    handleToggleAudio,\n    handleCycleLighting,\n    handleToggleFovMode,\n  ]);\n\n  const currentPresetConfig = LIGHTING_PRESETS[lightingPreset];\n  const scaleX = hexRect.width / 500;\n  const scaleY = hexRect.height / 482;\n\n  return (\n    <main className=\"relative w-screen h-screen overflow-hidden select-none\">\n      {/* 1. 60FPS 3D Team Buddies x Lyo Grassland Arena */}\n      <FactoryPlaygroundCanvas\n        gameState={gameState}\n        lightingPreset={lightingPreset}\n        cameraFovMode={cameraFovMode}\n        resetTrigger={resetTrigger}\n        onHudUpdate={setHud}\n        onGameOver={handleGameOver}\n        onTogglePause={handleTogglePause}\n      />\n\n      {/* Atmospheric Viewport Color Tint Overlay */}\n      <div\n        aria-hidden=\"true\"\n        className=\"fixed inset-0 pointer-events-none z-10 transition-colors duration-700\"\n        style={{\n          backgroundColor: currentPresetConfig.viewportFilterColor,\n          opacity: currentPresetConfig.viewportFilterOpacity,\n        }}\n      />\n\n      {/* =====================================================================\n          2. TITLE SCREEN: HEXAGON CUTOUT & COMIC STICKER LOCKUP (CJn-Xu8f.js)\n         ===================================================================== */}\n      {gameState === \'title\' && (\n        <section\n          aria-label=\"LYOOO Portfolio Title Screen\"\n          className=\"fixed inset-0 z-20 flex flex-col justify-between pointer-events-none\"\n        >\n          <svg\n            className=\"fixed inset-0 w-full h-full pointer-events-none\"\n            width=\"100%\"\n            height=\"100%\"\n            preserveAspectRatio=\"none\"\n          >\n            <defs>\n              <mask\n                id=\"intro-mask-cutout\"\n                maskUnits=\"userSpaceOnUse\"\n                x=\"0\"\n                y=\"0\"\n                width=\"100%\"\n                height=\"100%\"\n              >\n                <rect width=\"100%\" height=\"100%\" fill=\"white\" />\n                <g\n                  transform={`translate(${hexRect.left}, ${hexRect.top}) scale(${scaleX}, ${scaleY})`}\n                >\n                  <path d={REA_CONSTANTS.introHexagonSvgPath} fill=\"black\" />\n                </g>\n              </mask>\n              <linearGradient id=\"intro-overlay-gradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                <stop offset=\"0%\" stopColor=\"#0b0c12\" stopOpacity=\"0.94\" />\n                <stop offset=\"52%\" stopColor=\"#11121a\" stopOpacity=\"0.86\" />\n                <stop offset=\"100%\" stopColor=\"#11121a\" stopOpacity=\"0.72\" />\n              </linearGradient>\n            </defs>\n            <rect\n              width=\"100%\"\n              height=\"100%\"\n              fill=\"url(#intro-overlay-gradient)\"\n              mask=\"url(#intro-mask-cutout)\"\n            />\n          </svg>\n\n          <div className=\"relative z-10 flex-1 grid grid-cols-1 lg:grid-cols-12 items-center px-6 sm:px-12 lg:px-16 pt-8 pb-4 gap-6\">\n            <div className=\"lg:col-span-6 flex flex-col items-start justify-end lg:justify-center space-y-5 pointer-events-auto\">\n              <svg\n                viewBox=\"0 0 560 225\"\n                className=\"w-full max-w-[510px] drop-shadow-[6px_8px_0px_#11121a]\"\n                role=\"img\"\n                aria-label=\"LYOOO PORTFOLIO\"\n              >\n                <g transform=\"rotate(-3 260 85)\">\n                  <rect\n                    x=\"10\"\n                    y=\"12\"\n                    width=\"455\"\n                    height=\"108\"\n                    rx=\"18\"\n                    fill=\"#ffffff\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"8\"\n                  />\n                  <text\n                    x=\"32\"\n                    y=\"94\"\n                    fontFamily=\"\'Barlow\', sans-serif\"\n                    fontWeight=\"900\"\n                    fontStyle=\"italic\"\n                    fontSize=\"94\"\n                    letterSpacing=\"2\"\n                    fill=\"#ffffff\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"16\"\n                    paintOrder=\"stroke fill\"\n                  >\n                    LYOOO\n                  </text>\n                </g>\n\n                <g transform=\"translate(24, 108) rotate(-1.5 220 45)\">\n                  <rect\n                    x=\"0\"\n                    y=\"0\"\n                    width=\"430\"\n                    height=\"84\"\n                    rx=\"14\"\n                    fill=\"#b4ff39\"\n                    stroke=\"#ffffff\"\n                    strokeWidth=\"10\"\n                  />\n                  <rect\n                    x=\"4\"\n                    y=\"4\"\n                    width=\"422\"\n                    height=\"76\"\n                    rx=\"11\"\n                    fill=\"#b4ff39\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"6\"\n                  />\n                  <text\n                    x=\"26\"\n                    y=\"61\"\n                    fontFamily=\"\'Barlow\', sans-serif\"\n                    fontWeight=\"900\"\n                    fontSize=\"58\"\n                    letterSpacing=\"4\"\n                    fill=\"#11121a\"\n                  >\n                    PORTFOLIO\n                  </text>\n                </g>\n              </svg>\n\n              <div className=\"flex flex-wrap items-center gap-3 pt-1\">\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    soundEngine.playUiClick();\n                    setIsReaModalOpen(true);\n                  }}\n                  className=\"px-4 py-2.5 bg-[#272935] hover:bg-[#393b49] text-[#b8ff3c] font-black text-xs sm:text-sm rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow transition-transform hover:-translate-y-0.5 cursor-pointer whitespace-nowrap\"\n                >\n                  Kode Luau\n                </button>\n              </div>\n            </div>\n\n            <div className=\"lg:col-span-6 flex items-center justify-center\">\n              <div\n                ref={hexContainerRef}\n                className=\"relative w-[330px] h-[318px] sm:w-[440px] sm:h-[424px] lg:w-[485px] lg:h-[468px] pointer-events-none\"\n              >\n                <svg\n                  width=\"100%\"\n                  height=\"100%\"\n                  viewBox=\"0 0 500 482\"\n                  fill=\"none\"\n                  className=\"absolute inset-0 w-full h-full\"\n                >\n                  <path\n                    d={REA_CONSTANTS.introHexagonSvgPath}\n                    fill=\"none\"\n                    stroke=\"rgba(255, 255, 255, 0.55)\"\n                    strokeWidth=\"3.5\"\n                  />\n                  <path\n                    d={REA_CONSTANTS.introHexagonSvgPath}\n                    fill=\"none\"\n                    stroke=\"#11121a\"\n                    strokeWidth=\"2\"\n                    strokeDasharray=\"10 6\"\n                  />\n                </svg>\n\n                <button\n                  type=\"button\"\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    handleToggleAudio();\n                  }}\n                  aria-label={isMuted ? \'Suara Mati\' : \'Suara Aktif\'}\n                  className=\"pointer-events-auto absolute top-3 right-6 w-14 h-14 flex items-center justify-center bg-white hover:bg-[#fec83e] text-[#11121a] font-black text-xs border-4 border-[#11121a] ring-2 ring-white rounded-2xl rotate-6 comic-sticker-shadow transition-transform hover:scale-105 active:scale-95 cursor-pointer\"\n                >\n                  {isMuted ? \'MUTE\' : \'SUARA\'}\n                </button>\n\n                <button\n                  type=\"button\"\n                  data-start=\"true\"\n                  onClick={() => handleStartGame(false)}\n                  aria-label=\"LET\'S GO\"\n                  className=\"pointer-events-auto absolute -bottom-3 left-1/2 -translate-x-1/2 -rotate-3 hover:-rotate-6 hover:scale-108 active:scale-95 px-9 py-4 bg-[#b4ff39] hover:bg-[#c7ff72] text-[#11121a] font-black text-2xl sm:text-3xl tracking-wider rounded-2xl border-4 border-[#11121a] ring-4 ring-white comic-sticker-shadow-lg transition-all duration-150 cursor-pointer whitespace-nowrap\"\n                >\n                  LET&apos;S GO\n                </button>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"relative z-10 pb-5 px-6 text-center text-xs sm:text-sm font-bold tracking-wide text-[#dfdfe2]/85\">\n            WASD Lari &nbsp;\302\267&nbsp; [E] Ambil/Lempar Peti &nbsp;\302\267&nbsp; [Q] Pola Ghost Pad &nbsp;\302\267&nbsp; [F] Rakit &nbsp;\302\267&nbsp; [V] Teropong AI\n          </div>\n        </section>\n      )}\n\n      {/* =====================================================================\n          3. PLAYING HUD: WORLD-MATCHED COMIC CLUSTERS + TEAM BUDDIES MINI-RADAR\n         ===================================================================== */}\n      {gameState === \'playing\' && (\n        <div className=\"fixed inset-0 z-20 pointer-events-none flex flex-col justify-between p-4 sm:p-6\">\n          {/* Top Row */}\n          <div className=\"flex items-start justify-between gap-4\">\n            {/* Top-Left Cluster: Buddy/Tank Status + 3D Stacking Pad 2x2x2 + Base HQ Bars */}\n            <div className=\"pointer-events-auto flex flex-wrap items-center gap-3 bg-[#191b24]/95 border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl px-4 py-2.5 comic-sticker-shadow\">\n              {/* Mode & HP */}\n              <div className=\"pr-3 border-r-2 border-[#393b49]\">\n                <div className=\"text-[10px] font-black uppercase tracking-wider text-[#b8ff3c]\">\n                  {hud.controlMode === \'tank\'\n                    ? `OPEN-TOP TANK (${hud.tankStoredCrates}/4 PETI)`\n                    : `BUDDY: ${hud.activeClass.toUpperCase()}`}\n                </div>\n                <div className=\"flex items-center gap-1 mt-0.5\">\n                  {Array.from({ length: 6 }).map((_, idx) => {\n                    const threshold = (idx + 1) * (hud.maxHp / 6);\n                    const full = hud.hp >= threshold;\n                    return (\n                      <span\n                        key={idx}\n                        className={`w-3.5 h-3.5 rounded-sm border-2 border-[#11121a] ${\n                          full ? \'bg-[#b8ff3c]\' : \'bg-[#272935]\'\n                        }`}\n                      />\n                    );\n                  })}\n                  <span className=\"ml-1.5 text-xs font-black font-mono-tabular text-white\">\n                    {hud.equippedWeapon}\n                  </span>\n                </div>\n              </div>\n\n              {/* 3D Stacking Pad 2x2x2 Live Status + [Q] Ghost Wireframe Slots */}\n              <div className=\"pr-3 border-r-2 border-[#393b49]\">\n                <div className=\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\">\n                  PAD [Q] {hud.buildOrder}: {hud.buildOrderLabel.toUpperCase()}{\' \'}\n                  {hud.padIsMerged ? \'\302\267 MERGED\' : \'\'}\n                </div>\n                <div className=\"flex items-center gap-1 mt-0.5\">\n                  {hud.padSlots.map((slot, idx) => {\n                    const isGhostAllowed = getBuildOrderAllowedSlots(hud.buildOrder).includes(idx);\n                    return (\n                      <span\n                        key={idx}\n                        className={`w-3 h-3 rounded-xs border ${\n                          slot === \'super\'\n                            ? \'bg-[#00d2ff] border-[#11121a]\'\n                            : slot === \'red\'\n                            ? \'bg-[#ff3b30] border-[#11121a]\'\n                            : isGhostAllowed\n                            ? \'bg-[#191b24] border-[#00d2ff] border-dashed\'\n                            : \'bg-[#272935]/50 border-[#11121a]\'\n                        }`}\n                      />\n                    );\n                  })}\n                  <span\n                    className={`ml-1.5 text-xs font-black ${\n                      hud.padIsSuper ? \'text-[#00d2ff]\' : \'text-[#fec83e]\'\n                    }`}\n                  >\n                    {hud.padOutputName}\n                  </span>\n                </div>\n              </div>\n\n              {/* Blue HQ vs Red HQ HP */}\n              <div>\n                <div className=\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\">\n                  BLUE HQ vs RED HQ\n                </div>\n                <div className=\"flex items-center gap-2 mt-0.5 text-xs font-black font-mono-tabular\">\n                  <span className=\"text-[#00d2ff]\">{hud.blueBaseHp}</span>\n                  <span className=\"text-[#8f93a5]\">/</span>\n                  <span className=\"text-[#ff3b30]\">{hud.redBaseHp}</span>\n                  <span className=\"ml-1 px-1.5 py-0.5 bg-[#272935] text-[#b8ff3c] text-[10px] rounded border border-[#11121a]\">\n                    TIM: {hud.alliedBuddiesCount}\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            {/* Top-Right Cluster: Team Buddies Mini-Radar + Compact Utility Buttons */}\n            <div className=\"pointer-events-auto flex items-start gap-2.5\">\n              {/* Team Buddies Tactical Mini-Radar */}\n              <div\n                aria-label=\"Mini Radar Arena\"\n                className=\"relative w-24 h-24 sm:w-28 sm:h-28 bg-[#285918] border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl overflow-hidden comic-sticker-shadow shrink-0\"\n              >\n                {/* Dirt Crossroad Paths */}\n                <div className=\"absolute inset-y-0 left-1/2 -translate-x-1/2 w-3.5 bg-[#c28348]/85\" />\n                <div className=\"absolute inset-x-0 top-1/2 -translate-y-1/2 h-3 bg-[#c28348]/85\" />\n                {/* Central Drop Zone Ring */}\n                <div className=\"absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-5 h-5 rounded-full border-2 border-[#ff3b30]/80\" />\n                {/* Red Base HQ (Top, z = -22) & Red Pad */}\n                <div className=\"absolute left-1/2 top-1.5 -translate-x-1/2 w-3.5 h-2 bg-[#ff3b30] border border-[#11121a] rounded-xs\" />\n                {/* Blue Base HQ (Bottom, z = +22) & Blue Pad */}\n                <div className=\"absolute left-1/2 bottom-1.5 -translate-x-1/2 w-3.5 h-2 bg-[#00d2ff] border border-[#11121a] rounded-xs\" />\n\n                {/* Live 3D Entities (Player, Allies, Red Enemies, Crates, Tanks) */}\n                {hud.radarDots.map((dot) => {\n                  const leftPct = Math.max(6, Math.min(94, ((dot.x + 42) / 84) * 100));\n                  const topPct = Math.max(6, Math.min(94, ((dot.z + 42) / 84) * 100));\n                  let dotStyle = \'w-2 h-2 bg-[#ff3b30] rounded-xs\';\n                  if (dot.kind === \'player\') {\n                    dotStyle = \'w-3 h-3 bg-[#b8ff3c] rounded-full ring-2 ring-[#11121a] z-10\';\n                  } else if (dot.kind === \'ally\') {\n                    dotStyle = \'w-2.5 h-2.5 bg-[#2979ff] rounded-full border border-white\';\n                  } else if (dot.kind === \'enemy\') {\n                    dotStyle = \'w-2.5 h-2.5 bg-[#ff3b30] rounded-full border border-[#11121a]\';\n                  } else if (dot.kind === \'crate_super\') {\n                    dotStyle = \'w-2 h-2 bg-[#00d2ff] border border-[#11121a]\';\n                  } else if (dot.kind === \'crate_red\') {\n                    dotStyle = \'w-1.5 h-1.5 bg-[#ff3b30] border border-[#11121a]\';\n                  } else if (dot.kind === \'tank_blue\' || dot.kind === \'tank_red\') {\n                    dotStyle = \'w-3 h-2.5 bg-[#fec83e] border border-[#11121a] rounded-xs\';\n                  }\n                  return (\n                    <span\n                      key={dot.id}\n                      style={{ left: `${leftPct}%`, top: `${topPct}%` }}\n                      className={`absolute -translate-x-1/2 -translate-y-1/2 ${dotStyle}`}\n                    />\n                  );\n                })}\n                <div className=\"absolute bottom-0.5 right-1.5 text-[8px] font-black tracking-wider text-white/90 drop-shadow\">\n                  RADAR\n                </div>\n              </div>\n\n              <button\n                type=\"button\"\n                tabIndex={-1}\n                onClick={(e) => {\n                  e.currentTarget.blur();\n                  soundEngine.playUiClick();\n                  setIsReaModalOpen(true);\n                }}\n                aria-label=\"Kode Luau\"\n                className=\"px-3.5 h-11 flex items-center gap-2 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white comic-sticker-shadow cursor-pointer whitespace-nowrap\"\n              >\n                <span>Kode Luau</span>\n              </button>\n\n              <button\n                type=\"button\"\n                tabIndex={-1}\n                onClick={(e) => {\n                  e.currentTarget.blur();\n                  handleToggleAudio();\n                }}\n                aria-label={isMuted ? \'Suara Mati\' : \'Suara Aktif\'}\n                className=\"w-14 h-11 flex items-center justify-center bg-[#191b24] hover:bg-[#272935] text-white font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow cursor-pointer\"\n              >\n                {isMuted ? \'MUTE\' : \'SUARA\'}\n              </button>\n\n              <button\n                type=\"button\"\n                tabIndex={-1}\n                onClick={(e) => {\n                  e.currentTarget.blur();\n                  handleTogglePause();\n                }}\n                aria-label=\"Jeda\"\n                className=\"w-14 h-11 flex items-center justify-center bg-[#191b24] hover:bg-[#272935] text-white font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow cursor-pointer\"\n              >\n                JEDA\n              </button>\n            </div>\n          </div>\n\n          {/* Bottom Context Prompt + Action Dock */}\n          <div className=\"flex flex-col items-center\">\n            <div className=\"mb-1.5 px-3.5 py-1 bg-[#11121a]/90 text-[#b4ff39] font-black text-xs rounded-lg border-2 border-[#11121a]\">\n              {hud.contextHint}\n            </div>\n\n            {!isDockCollapsed && (\n              <div className=\"pointer-events-auto flex flex-wrap items-center justify-center gap-2 px-4 py-2 bg-[#191b24]/95 border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl comic-sticker-shadow max-w-[96vw]\">\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    dispatchBuddyAction(\'pickupOrThrow\');\n                  }}\n                  className=\"px-3 py-1.5 bg-[#ff3b30] hover:bg-[#ff554a] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  {hud.carryingCrate !== \'none\' ? \'[E] Lempar Peti\' : \'[E] Ambil Peti\'}\n                </button>\n\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    dispatchBuddyAction(\'kickOrCraft\');\n                  }}\n                  className=\"px-3 py-1.5 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  [F] Rakit Pad\n                </button>\n\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    dispatchBuddyAction(\'mountOrDismount\');\n                  }}\n                  className=\"px-3 py-1.5 bg-[#fec83e] hover:bg-[#fee763] text-[#11121a] font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  {hud.controlMode === \'tank\' ? \'[G] Turun Tank\' : \'[G] Naik Tank\'}\n                </button>\n\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    dispatchBuddyAction(\'cycleBuildOrder\');\n                  }}\n                  className=\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  [Q] Pola: <span className=\"text-[#00d2ff]\">{hud.buildOrder}</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    dispatchBuddyAction(\'cycleCommand\');\n                  }}\n                  className=\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  [V] AI: <span className=\"text-[#fec83e]\">{hud.teamCommand}</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  tabIndex={-1}\n                  onClick={(e) => {\n                    e.currentTarget.blur();\n                    dispatchBuddyAction(\'swapBuddy\');\n                  }}\n                  className=\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\"\n                >\n                  [Tab] Ganti Buddy\n                </button>\n              </div>\n            )}\n          </div>\n        </div>\n      )}"
        start_line: 7
        end_line: 625
      }
      num_matches: 1
    }
