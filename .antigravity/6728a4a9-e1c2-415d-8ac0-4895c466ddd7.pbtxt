      thinking_signature: "\022\262\v\n\257\v\001i\024}\023\026\300A\316o%\230\"b\371\213\n\220\232\242!\326f\273\206 \004\372\021?\016\331\356\360\"{\204\362\"Q\253\347\016\204\200i\200*T\225\263\267@\346W\322\216y\3212P;T\200Vh\031{\310\277Z\244\235\257\375)\003\321\253T\n\315\375\035\243F\207V\a\270v\267V<yK\236\356\017`g\252P\312\363\320\002\223\330\271\t\017\366\300\246\264\352\327}R\253\312\016\302!\202\0069\'\024\217Xf\325\226B2\307b\221\267t\206\021\232\337\032\034G\333\313\372\343\347\337\373\323\032\347$\365\204 no\316\271B\036\234M\025\256\254~\fk\001g&S%N\032<\023\315?4\334\356 \\|\371\341\345\t\374\210\246kn?t\340\2166\vn\212T\210\244\v\024t\200\026\366L\213\264\243\270\323c\000\273\034\003lL\t\244\366\330\212!;z\2611\320\311\231\211UJ\224\3552\357$\265\217\246^W\347F\003\2207\336F\210\333\223\2619i\201\\\371\"\bF\213\031\317N\207j\274\374Z\375rR\210Vu\337.\020\024T\315W\276\301\002\345\342\311\350y\305\004\266\337\246v\341\276\327c\335\262\216\203\311\024\224\331\255?\341x]\354\316x{\262%\311W\373PF\275\211\031\316\353\323*\312Y\353_\tyd\\\203\256\250\252#\266\251\005\025w\025\005\"\335\027e\241P\317\3076_Tr2I\306&\236\343\350Z\276\224\0217v\373\335\032\346\272)\262+\271Y\030\220\215\314\025m\2348\b\037\027\2430\236k\276\003\227\337\"\b\243\033\004\301.\200\237\314\211\344\363\241\246\374c}\216Bia7\224\260F\273\273\356\200\354T\245\324\335\230L\322\324\266\273\n\350J\267\364Qd\313\254?\334M\2259\230\305\314\302\224m\377\t,\255`\317\316\177@\260\363\023K\253\341+\375\272\375Cmy\325=\361{\345\202\253\372]\360\235\303\356\033Zp~t8\004\'sj;\202\203\233\376\220C\2770X\003~\021\374\310\tdq\270Wh\241\375\222s\325=\300\272\236\344w\235\200Y>\024S\2441U\360I\262\331`?a9/\360\266p\a\246F\376Nb}\215\221\372g0\b\261\337\223`\300\3350\207]l\036y\177y\354\2228\377Z\227l;\344|Xx\210\036~X\316^\224\360\224j\274\tt\tPr\037\262\252-\267\025\202\313\217\313v\270\257\347\350i?\340\a\220\nx\226\373\377>\326?m\232\016\376\000\330\035T\277\243\375\302%|2\266\3640\030\026W9\351q\312\003\360\312a#\244\371\301DP\004\004\366!t\307\346\006\235L\367L*A\205^P\250\323\272%\202\244j\246\267\025\026\374\025\202\016\277\337\027\005I\033\027\274hy~N\246\vA\364\365\261G\331\023+l\244p\232\330\006\202U\177^h\2603\"\302\331u\036\241\345\252\017\025*\030\364\360{\207\361\257\256*\221 \320\362h\312K\016\304&\366\356X\364pL\344;\003\313\216\226\273t\212l\030\004.\332-\035X\245PPM\237\346\233&4\000\262\222\001s\\\004\312J\246\206\234w\376\f\376\bL\000\300\363\230x\275{\200\024\360\377J\263Q\252\203\213l\206\336\257(X\351\305\232\315\301r\256P\357\316F\210WVm\337,\033)%Nx>\341o\241\v\004\307\\?\376ZV\211L}\217\264\232\363\325\323X\025\376\2560\230\314\032\335\376p\002{\220\374)2\230JR\375\333\263\357\315\250\235\245\331r\204\214\314\316\316Z\272Z\303Jp$o\016\217*\033\236\002\032\357\327\020\265l\333\375(\370U\213\"}\305\003\022\006?*\272>\237\035\210+\206vsv\247?a\356\t\257\033V\247\372\036`\000f\225g\323q)s\\\2536\226\353\240\255p6\301(\2026\205\332\361\256\271$\036\020\361\b\006\023\260(\250\252\016\313\264\364\023_\215\301c\260\302\322 ME\033\350\363g^w\235\2345\034<\032\325s\352\314\220\3029?\033E\325\233\245\244\004C\205\037J\263\316\f\312m\201y\005P`\206 \017g9\312r}\261\3561\t\271\030\357\237\242\360\326)\270v\277{\272>\261\261c\256id\242w\226\320A\341\233\034\334\315\362\344\311\231X\264\227\b\322\370\250\n\273\313\302w\va\333-\311\vc\323\213\017\322\322\031D\272a\211\2752\223\371\344g/b8S\336\217\317)\3437,\b\"\250\035\2536\037\243\333\317\'\302\321|G@\241\206b\224\a\330\320\026\263\363\302=2\t\320\267\2623\235\361v\333ko;h\363\230\203\257\022\200\276&\035\313\365\231m\302+\023K\235\037\001T5(W\222\370(\201\230dx\233\016\341\254\317\v\227\255\033\000\375\311\270\a\370\203\321\204\321\253+\267\260\343?\352\027\377Iq}~\232e\016>\357\030t\263\337\322b\273\017\f\376\345\202\036\027\226\003g\306\237!\022\265u\370\213QW\253\230\027\236\2707\022\203y\265\215\000d\354/\363\025\216\361\322 Oj\326\306\303\177\365\261_\310Ii\037Y\017\376a=\024K\270\r1\345\2