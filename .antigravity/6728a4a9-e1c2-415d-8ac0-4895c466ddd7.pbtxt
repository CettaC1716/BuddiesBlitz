      full: "Downloaded Models (52): barrel-1c.glb, barricade-1a.glb, bench.glb, boss-track-01.json, boss-track-02.json, boss.glb, brick.glb, bridge.glb, bts.glb, bullet.glb, chimney.glb, circuit.glb, concrete-fence-1a.glb, concrete-fence-1b.glb, concrete-pipe.glb, contact.glb, crane.glb, debris.glb, dump-truck.glb, explosive-barrel.glb, floor.glb, fodder-track.json, fodder.glb, forklift.glb, fuel.glb, gear.glb, giant-pipe-1a.glb, giant-pipe-1b.glb, giant-tank.glb, h-beam.glb, hydrant.glb, lamppost-1a.glb, lamppost-1b.glb, metal-box-1a.glb, metal-box-1b.glb, pallet-1a.glb, pipe-cluster-1a.glb, pipe-cluster-1b.glb, player-track.json, player.glb, power-core.glb, recycle-bin.glb, tank-1a.glb, tank-1b.glb, tools.glb, traffic-cone.glb, tree-1a.glb, tree-1b.glb, turbine.glb, wheelbarrow.glb, wooden-box.glb, zone.glbDownloaded Textures (40): 00-thumbnail.webp, 01-overview.webp, 02-the-bottleneck.webp, 03-strategic-impact.webp, 04-design-process.webp, 05-phase-1-discover.webp, art-mail-desktop.webp, art-mail-mobile.webp, circuit.webp, debris.ktx2, decal-01.ktx2, decal-02.ktx2, flash.ktx2, fodder-right-active.webp, fuel.webp, game-texture.ktx2, gear.webp, grass-mask-128.bin, grass-mask.ktx2, locked-thumb.ktx2, map-light.ktx2, map-light.webp, map.webp, player-left-active.webp, player-right-inactive.webp, ring.ktx2, smoke.ktx2, soil-mask.ktx2, soil.ktx2, sphere.ktx2, star-01.ktx2, star-02.ktx2, star-burst.ktx2, stunned-effect.ktx2, tile-mask.ktx2, tile.ktx2, toolbox.webp, tools.webp, track-mark.ktx2, tree-foliage.ktx2Downloaded Scripts/WASM (32): 2ZE6MGkB.js, B1Nq4Kq6.js, BAJRzIjM.js, BG4xpC7h.js, BN-EMi2W.js, BW6YWG0R.js, BlAypStk.js, C0xwqhbh.js, C2vT0KxV.js, C47JuxvO.js, C4YGIT9J.js, C6MU3C_D.js, CJn-Xu8f.js, CQl67Veh.js, CZejaJVW.js, Co_82n2H.js, CozVMRND.js, D9JAKPuk.js, DADMk73e.js, DPqB0RfP.js, DjQoCJ1T.js, DrDnj3Lb.js, DzAfcUb9.js, ZmZwzdCV.js, basis_transcoder.js, basis_transcoder.wasm, draco_decoder.wasm, draco_wasm_wrapper.js, pr2JiyVy.js, t1WzwXnd.js, vYUQZzfX.js, ypjPflCr.js"
