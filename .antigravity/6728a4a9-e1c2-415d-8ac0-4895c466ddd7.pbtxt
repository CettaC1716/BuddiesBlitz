              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local POWERUP_TYPES = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\"Shield\", \"GunFrenzy\", \"RocketBoots\", \"Jetpack\", \"BaseRepair\", \"PumpedUp\", \"Phreak\","
