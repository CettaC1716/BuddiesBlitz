              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tmodel:SetAttribute(\"OwnerUserId\", owner.UserId)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tmodel:SetAttribute(\"BuddyClass\", classKey)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tmodel:SetAttribute(\"AIMode\", \"FOLLOW\")"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
