            }
            lines {
              text: "\t\t\telse"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\tresolvedMode = \"ATTACK\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\telse"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tresolvedMode = \"ATTACK\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tfor _, buddy in ipairs(BuddiesFolder:GetChildren()) do"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
