              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
