            lines {
              text: "    const strokeMat = new THREE.ShaderMaterial({"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uniforms: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
