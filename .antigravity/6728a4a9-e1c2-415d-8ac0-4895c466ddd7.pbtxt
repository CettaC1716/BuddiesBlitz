  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect, useRef } from \'react\';\nimport * as THREE from \'three\';\nimport { RoomEnvironment } from \'three/addons/environments/RoomEnvironment.js\';\nimport {\n  REA_CONSTANTS,\n  LIGHTING_PRESETS,\n  LightingPresetKey,\n  Vec3,\n  clamp,\n  lerp,\n  stepCriticalDampedSpring3D,\n  computeTankSpeedStep,\n  stepTurretYaw,\n} from \'./rules\';\nimport { soundEngine } from \'./audio\';\n\nexport type GameState = \'title\' | \'playing\' | \'paused\' | \'gameover\';\n\nexport interface HudSnapshot {\n  hp: number;\n  maxHp: number;\n  score: number;\n  bestScore: number;\n  speedKmh: number;\n  isBoosting: boolean;\n  isGrabMode: boolean;\n  grabbedPropName: string | null;\n  collectedItems: string[];\n  powerCoreActivated: boolean;\n  enemiesDefeated: number;\n  totalEnemies: number;\n  lightingPreset: LightingPresetKey;\n  cameraFovMode: \'webgl35\' | \'roblox18\';\n  outcome: \'victory\' | \'defeat\' | null;\n  clearTimeSec: number;\n}\n\ninterface FactoryPlaygroundCanvasProps {\n  gameState: GameState;\n  lightingPreset: LightingPresetKey;\n  cameraFovMode: \'webgl35\' | \'roblox18\';\n  resetTrigger: number;\n  onHudUpdate: (snapshot: HudSnapshot) => void;\n  onGameOver: (outcome: \'victory\' | \'defeat\', finalSnapshot: HudSnapshot) => void;\n  onTogglePause: () => void;\n}\n\ninterface DynamicProp {\n  id: string;\n  name: string;\n  kind: \'barrel\' | \'hydrant\' | \'crate\' | \'fence\';\n  mesh: THREE.Group;\n  pos: THREE.Vector3;\n  vel: THREE.Vector3;\n  rotY: number;\n  angVelY: number;\n  radius: number;\n  halfHeight: number;\n  mass: number;\n  hp: number;\n  destroyed: boolean;\n  geyserTimer: number;\n  flashTimer: number;\n}\n\ninterface EnemyBot {\n  id: string;\n  archetype: \'chaser\' | \'kiter\' | \'boss\';\n  mesh: THREE.Group;\n  turret: THREE.Object3D;\n  telegraphRing: THREE.Mesh;\n  telegraphLine: THREE.Mesh;\n  pos: THREE.Vector3;\n  vel: THREE.Vector3;\n  rotY: number;\n  hp: number;\n  maxHp: number;\n  radius: number;\n  state: \'patrol\' | \'windup\' | \'recover\' | \'ko\';\n  stateTimer: number;\n  cooldownTimer: number;\n  flashTimer: number;\n  koTimer: number;\n}\n\ninterface Projectile {\n  active: boolean;\n  isEnemy: boolean;\n  mesh: THREE.Mesh;\n  pos: THREE.Vector3;\n  vel: THREE.Vector3;\n  life: number;\n  damage: number;\n}\n\ninterface SmokePuff {\n  active: boolean;\n  mesh: THREE.Mesh;\n  pos: THREE.Vector3;\n  vel: THREE.Vector3;\n  age: number;\n  lifetime: number;\n  startScale: number;\n  endScale: number;\n  peakOpacity: number;\n  swayPhaseX: number;\n  swayPhaseZ: number;\n  swayFreqX: number;\n  swayFreqZ: number;\n  swayAmp: number;\n  colorHex: number;\n}\n\ninterface CollectibleNode {\n  id: string;\n  label: string;\n  mesh: THREE.Group;\n  pos: THREE.Vector3;\n  collected: boolean;\n}\n\nexport const FactoryPlaygroundCanvas: React.FC<FactoryPlaygroundCanvasProps> = ({\n  gameState,\n  lightingPreset,\n  cameraFovMode,\n  resetTrigger,\n  onHudUpdate,\n  onGameOver,\n  onTogglePause,\n}) => {\n  const mountRef = useRef<HTMLDivElement | null>(null);\n\n  // Store latest React props/callbacks in refs so canvas never unmounts\n  const gameStateRef = useRef<GameState>(gameState);\n  const lightingPresetRef = useRef<LightingPresetKey>(lightingPreset);\n  const cameraFovModeRef = useRef<\'webgl35\' | \'roblox18\'>(cameraFovMode);\n  const onHudUpdateRef = useRef(onHudUpdate);\n  const onGameOverRef = useRef(onGameOver);\n  const onTogglePauseRef = useRef(onTogglePause);\n  const resetWorldRef = useRef<(() => void) | null>(null);\n  const applyLightingRef = useRef<((preset: LightingPresetKey) => void) | null>(null);\n  const applyFovModeRef = useRef<((mode: \'webgl35\' | \'roblox18\') => void) | null>(null);\n\n  useEffect(() => {\n    gameStateRef.current = gameState;\n  }, [gameState]);\n\n  useEffect(() => {\n    lightingPresetRef.current = lightingPreset;\n    applyLightingRef.current?.(lightingPreset);\n  }, [lightingPreset]);\n\n  useEffect(() => {\n    cameraFovModeRef.current = cameraFovMode;\n    applyFovModeRef.current?.(cameraFovMode);\n  }, [cameraFovMode]);\n\n  useEffect(() => {\n    onHudUpdateRef.current = onHudUpdate;\n    onGameOverRef.current = onGameOver;\n    onTogglePauseRef.current = onTogglePause;\n  }, [onHudUpdate, onGameOver, onTogglePause]);\n\n  useEffect(() => {\n    if (resetTrigger > 0) {\n      resetWorldRef.current?.();\n    }\n  }, [resetTrigger]);\n\n  useEffect(() => {\n    const container = mountRef.current;\n    if (!container) return;\n\n    // 1. Software-WebGL Detection (exact pattern from threejs skill)\n    const isSoftwareGl = (() => {\n      const gl = document.createElement(\'canvas\').getContext(\'webgl2\');\n      if (!gl) return true;\n      const ext = gl.getExtension(\'WEBGL_debug_renderer_info\');\n      const param = ext ? ext.UNMASKED_RENDERER_WEBGL : gl.RENDERER;\n      const gpu = String(gl.getParameter(param));\n      gl.getExtension(\'WEBGL_lose_context\')?.loseContext();\n      return /SwiftShader|llvmpipe|softpipe|Software|Basic Render/i.test(gpu);\n    })();\n\n    const renderer = new THREE.WebGLRenderer({\n      antialias: !isSoftwareGl,\n      powerPreference: \'high-performance\',\n    });\n    renderer.outputColorSpace = THREE.SRGBColorSpace;\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\n    renderer.toneMappingExposure = 1.1;\n    renderer.setPixelRatio(isSoftwareGl ? 1 : Math.min(window.devicePixelRatio, 2));\n    renderer.setSize(container.clientWidth || window.innerWidth, container.clientHeight || window.innerHeight);\n    renderer.shadowMap.enabled = !isSoftwareGl;\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n    container.appendChild(renderer.domElement);\n\n    const scene = new THREE.Scene();\n    scene.background = new THREE.Color(\'#1c2033\');\n    scene.fog = new THREE.FogExp2(\'#1c2033\', 0.011);\n\n    // Studio Environment Reflection (RoomEnvironment)\n    const pmremGenerator = new THREE.PMREMGenerator(renderer);\n    scene.environment = pmremGenerator.fromScene(new RoomEnvironment(), 0.04).texture;\n    pmremGenerator.dispose();\n\n    const aspect = (container.clientWidth || window.innerWidth) / Math.max(1, container.clientHeight || window.innerHeight);\n    const camera = new THREE.PerspectiveCamera(REA_CONSTANTS.camera.fov, aspect, 0.1, 1000);\n    scene.add(camera);\n\n    // 2. Three-Point Cel-Shaded Lighting Rig (matches eo.initLighting + Di presets)\n    const hemiLight = new THREE.HemisphereLight(\'#c2d6ff\', \'#272935\', 0.85);\n    scene.add(hemiLight);\n\n    const dirLight = new THREE.DirectionalLight(\'#ffe8d6\', 2.0);\n    dirLight.position.set(20, 42, -18);\n    dirLight.castShadow = !isSoftwareGl;\n    dirLight.shadow.mapSize.width = 1024;\n    dirLight.shadow.mapSize.height = 1024;\n    dirLight.shadow.camera.near = 2;\n    dirLight.shadow.camera.far = 120;\n    const d = 48;\n    dirLight.shadow.camera.left = -d;\n    dirLight.shadow.camera.right = d;\n    dirLight.shadow.camera.top = d;\n    dirLight.shadow.camera.bottom = -d;\n    dirLight.shadow.bias = -0.0005;\n    dirLight.shadow.normalBias = 0.02;\n    scene.add(dirLight);\n    scene.add(dirLight.target);\n\n    const rimLight = new THREE.DirectionalLight(\'#b8ff3c\', 0.55);\n    rimLight.position.set(-24, 14, -22);\n    scene.add(rimLight);\n\n    // Apply Lighting Preset helper\n    const applyLightingPreset = (presetKey: LightingPresetKey) => {\n      const p = LIGHTING_PRESETS[presetKey] || LIGHTING_PRESETS.day;\n      dirLight.color.set(p.lightColor);\n      dirLight.intensity = p.lightIntensity;\n      hemiLight.groundColor.set(p.shadowColor);\n      hemiLight.color.set(p.revealColor);\n      const bgCol = new THREE.Color(p.shadowColor).lerp(new THREE.Color(p.fogColorA), 0.35);\n      scene.background = bgCol;\n      if (scene.fog instanceof THREE.FogExp2) {\n        scene.fog.color.copy(bgCol);\n      }\n    };\n    applyLightingRef.current = applyLightingPreset;\n    applyLightingPreset(lightingPresetRef.current);\n\n    const applyFovMode = (mode: \'webgl35\' | \'roblox18\') => {\n      camera.fov = mode === \'roblox18\' ? REA_CONSTANTS.camera.robloxPseudoOrthoFov : REA_CONSTANTS.camera.fov;\n      camera.updateProjectionMatrix();\n    };\n    applyFovModeRef.current = applyFovMode;\n\n    // 3. Procedural Textures & Materials Library\n    const maxAniso = renderer.capabilities.getMaxAnisotropy();\n\n    const createCrossHatchAsphaltTexture = (): THREE.CanvasTexture => {\n      const c = document.createElement(\'canvas\');\n      c.width = 256;\n      c.height = 256;\n      const ctx = c.getContext(\'2d\')!;\n      ctx.fillStyle = \'#232634\';\n      ctx.fillRect(0, 0, 256, 256);\n      // Subtle 45-degree comic cross-hatching lines (replicates Kn in B1Nq4Kq6.js)\n      ctx.strokeStyle = \'rgba(17, 18, 26, 0.42)\';\n      ctx.lineWidth = 2;\n      for (let i = -256; i < 512; i += 16) {\n        ctx.beginPath();\n        ctx.moveTo(i, 0);\n        ctx.lineTo(i + 256, 256);\n        ctx.stroke();\n      }\n      ctx.strokeStyle = \'rgba(255, 255, 255, 0.04)\';\n      for (let i = 0; i < 256; i += 64) {\n        ctx.strokeRect(i, 0, 64, 256);\n        ctx.strokeRect(0, i, 256, 64);\n      }\n      const tex = new THREE.CanvasTexture(c);\n      tex.colorSpace = THREE.SRGBColorSpace;\n      tex.wrapS = THREE.RepeatWrapping;\n      tex.wrapT = THREE.RepeatWrapping;\n      tex.repeat.set(22, 22);\n      tex.anisotropy = maxAniso;\n      return tex;\n    };\n\n    const createHazardStripeTexture = (): THREE.CanvasTexture => {\n      const c = document.createElement(\'canvas\');\n      c.width = 128;\n      c.height = 128;\n      const ctx = c.getContext(\'2d\')!;\n      ctx.fillStyle = \'#fec83e\';\n      ctx.fillRect(0, 0, 128, 128);\n      ctx.fillStyle = \'#11121a\';\n      for (let i = -128; i < 256; i += 32) {\n        ctx.beginPath();\n        ctx.moveTo(i, 0);\n        ctx.lineTo(i + 16, 0);\n        ctx.lineTo(i + 144, 128);\n        ctx.lineTo(i + 128, 128);\n        ctx.closePath();\n        ctx.fill();\n      }\n      const tex = new THREE.CanvasTexture(c);\n      tex.colorSpace = THREE.SRGBColorSpace;\n      tex.wrapS = THREE.RepeatWrapping;\n      tex.wrapT = THREE.RepeatWrapping;\n      tex.anisotropy = maxAniso;\n      return tex;\n    };\n\n    const asphaltTex = createCrossHatchAsphaltTexture();\n    const hazardTex = createHazardStripeTexture();\n\n    // Shared Materials + Ink Outline Material (#17110f, BackSide)\n    const inkOutlineMat = new THREE.MeshBasicMaterial({\n      color: 0x17110f,\n      side: THREE.BackSide,\n    });\n    const hoverOutlineMat = new THREE.MeshBasicMaterial({\n      color: 0xffaa00,\n      side: THREE.BackSide,\n    });\n    const flashWhiteMat = new THREE.MeshBasicMaterial({\n      color: 0xffffff,\n    });\n\n    const matTankLime = new THREE.MeshStandardMaterial({\n      color: 0xb8ff3c,\n      roughness: 0.42,\n      metalness: 0.12,\n    });\n    const matTankHighlight = new THREE.MeshStandardMaterial({\n      color: 0xc7ff72,\n      roughness: 0.25,\n      metalness: 0.15,\n    });\n    const matYellow = new THREE.MeshStandardMaterial({\n      color: 0xfec83e,\n      roughness: 0.35,\n      metalness: 0.2,\n    });\n    const matDarkSteel = new THREE.MeshStandardMaterial({\n      color: 0x272935,\n      roughness: 0.68,\n      metalness: 0.45,\n    });\n    const matGunmetal = new THREE.MeshStandardMaterial({\n      color: 0x393b49,\n      roughness: 0.4,\n      metalness: 0.65,\n    });\n    const matRedBarrel = new THREE.MeshStandardMaterial({\n      color: 0xf42f4c,\n      roughness: 0.38,\n      metalness: 0.2,\n    });\n    const matHazard = new THREE.MeshStandardMaterial({\n      color: 0xffffff,\n      map: hazardTex,\n      roughness: 0.5,\n      metalness: 0.15,\n    });\n    const matConcrete = new THREE.MeshStandardMaterial({\n      color: 0x686a77,\n      roughness: 0.85,\n      metalness: 0.05,\n    });\n    const matZebra = new THREE.MeshStandardMaterial({\n      color: 0xf2f4f8,\n      roughness: 0.6,\n      metalness: 0.05,\n      polygonOffset: true,\n      polygonOffsetFactor: -1,\n      polygonOffsetUnits: -1,\n    });\n\n    // Helper: Add mesh + BackSide hard ink outline (replicates Nn StrokeMaterial)\n    const addOutlinedPart = (\n      parent: THREE.Object3D,\n      geo: THREE.BufferGeometry,\n      mat: THREE.Material,\n      pos: [number, number, number],\n      rot: [number, number, number] = [0, 0, 0],\n      outlineScale = 1.06,\n      castShadow = true,\n    ): THREE.Mesh => {\n      const mesh = new THREE.Mesh(geo, mat);\n      mesh.position.set(pos[0], pos[1], pos[2]);\n      mesh.rotation.set(rot[0], rot[1], rot[2]);\n      mesh.castShadow = castShadow && !isSoftwareGl;\n      mesh.receiveShadow = !isSoftwareGl;\n      mesh.userData.baseMaterial = mat;\n\n      const outline = new THREE.Mesh(geo, inkOutlineMat);\n      outline.scale.setScalar(outlineScale);\n      outline.name = \'InkStroke\';\n      mesh.add(outline);\n\n      parent.add(mesh);\n      return mesh;\n    };\n\n    // Soft radial contact shadow geometry (shared)\n    const shadowDiscGeo = new THREE.CircleGeometry(1.4, 20);\n    shadowDiscGeo.rotateX(-Math.PI / 2);\n    const shadowDiscMat = new THREE.MeshBasicMaterial({\n      color: 0x090a10,\n      transparent: true,\n      opacity: 0.42,\n      depthWrite: false,\n    });\n\n    // 4. Ground, Crossroads, Zebra Crossings, Perimeter Hills & Factory Landmarks\n    const groundGeo = new THREE.PlaneGeometry(180, 180);\n    groundGeo.rotateX(-Math.PI / 2);\n    const groundMat = new THREE.MeshStandardMaterial({\n      color: 0xffffff,\n      map: asphaltTex,\n      roughness: 0.88,\n      metalness: 0.08,\n    });\n    const groundMesh = new THREE.Mesh(groundGeo, groundMat);\n    groundMesh.receiveShadow = !isSoftwareGl;\n    scene.add(groundMesh);\n\n    // Main Factory Road Crossings (offset by +0.02 on Y to prevent Z-fighting)\n    const roadMat = new THREE.MeshStandardMaterial({\n      color: 0x191b24,\n      roughness: 0.78,\n      metalness: 0.1,\n    });\n    const roadNS = new THREE.Mesh(new THREE.BoxGeometry(10, 0.03, 96), roadMat);\n    roadNS.position.set(0, 0.015, 0);\n    roadNS.receiveShadow = !isSoftwareGl;\n    scene.add(roadNS);\n\n    const roadEW = new THREE.Mesh(new THREE.BoxGeometry(96, 0.03, 10), roadMat);\n    roadEW.position.set(0, 0.016, 0);\n    roadEW.receiveShadow = !isSoftwareGl;\n    scene.add(roadEW);\n\n    // Zebra Crossings at 4 intersections\n    const stripeGeo = new THREE.BoxGeometry(2.4, 0.02, 0.55);\n    const zebraOffsets = [\n      { x: -9, z: 0, rotY: 0 },\n      { x: 9, z: 0, rotY: 0 },\n      { x: 0, z: -9, rotY: Math.PI / 2 },\n      { x: 0, z: 9, rotY: Math.PI / 2 },\n    ];\n    zebraOffsets.forEach((zo) => {\n      const zGroup = new THREE.Group();\n      zGroup.position.set(zo.x, 0.035, zo.z);\n      zGroup.rotation.y = zo.rotY;\n      for (let i = -3; i <= 3; i++) {\n        const s = new THREE.Mesh(stripeGeo, matZebra);\n        s.position.set(0, 0, i * 1.1);\n        zGroup.add(s);\n      }\n      scene.add(zGroup);\n    });\n\n    // Central Power Core Monument (Multi-part interactive landmark at (0, 0, -16))\n    const powerCoreGroup = new THREE.Group();\n    powerCoreGroup.position.set(0, 0, -16);\n    addOutlinedPart(powerCoreGroup, new THREE.CylinderGeometry(3.2, 3.6, 0.6, 8), matDarkSteel, [0, 0.3, 0], [0, 0, 0], 1.04);\n    addOutlinedPart(powerCoreGroup, new THREE.CylinderGeometry(2.2, 2.5, 0.5, 8), matHazard, [0, 0.85, 0], [0, 0, 0], 1.04);\n    const powerCoreOrbMat = new THREE.MeshStandardMaterial({\n      color: 0xb8ff3c,\n      emissive: 0xb8ff3c,\n      emissiveIntensity: 0.45,\n      roughness: 0.2,\n      metalness: 0.3,\n    });\n    const powerCoreOrb = addOutlinedPart(\n      powerCoreGroup,\n      new THREE.OctahedronGeometry(1.35, 1),\n      powerCoreOrbMat,\n      [0, 2.7, 0],\n      [0, 0, 0],\n      1.07,\n    );\n    const powerCoreRing = addOutlinedPart(\n      powerCoreGroup,\n      new THREE.TorusGeometry(1.9, 0.16, 10, 24),\n      matYellow,\n      [0, 2.7, 0],\n      [Math.PI / 3, 0, 0],\n      1.06,\n    );\n    scene.add(powerCoreGroup);\n\n    // Factory Smokestack Chimneys & Steam Manholes (emitters for Cartoon Puff Smoke)\n    const smokeEmitterPositions: THREE.Vector3[] = [];\n\n    const buildChimneyTower = (x: number, z: number) => {\n      const g = new THREE.Group();\n      g.position.set(x, 0, z);\n      addOutlinedPart(g, new THREE.BoxGeometry(4.2, 3.2, 4.2), matConcrete, [0, 1.6, 0]);\n      addOutlinedPart(g, new THREE.BoxGeometry(4.4, 0.45, 4.4), matHazard, [0, 3.3, 0]);\n      addOutlinedPart(g, new THREE.CylinderGeometry(0.95, 1.35, 6.5, 12), matDarkSteel, [-0.8, 6.5, -0.6]);\n      addOutlinedPart(g, new THREE.CylinderGeometry(1.1, 1.1, 0.4, 12), matRedBarrel, [-0.8, 9.7, -0.6]);\n      addOutlinedPart(g, new THREE.CylinderGeometry(0.75, 1.05, 5.2, 12), matGunmetal, [0.9, 5.8, 0.7]);\n      scene.add(g);\n      smokeEmitterPositions.push(new THREE.Vector3(x - 0.8, 10.0, z - 0.6));\n      smokeEmitterPositions.push(new THREE.Vector3(x + 0.9, 8.6, z + 0.7));\n    };\n    buildChimneyTower(-20, -20);\n    buildChimneyTower(22, -20);\n\n    // Steam Manholes on Factory Floor\n    const manholeCoords: [number, number][] = [\n      [-11, -6],\n      [11, 7],\n      [-8, 13],\n      [14, -9],\n    ];\n    manholeCoords.forEach(([mx, mz]) => {\n      const mh = new THREE.Group();\n      mh.position.set(mx, 0, mz);\n      addOutlinedPart(mh, new THREE.CylinderGeometry(1.15, 1.25, 0.16, 16), matGunmetal, [0, 0.08, 0]);\n      addOutlinedPart(mh, new THREE.CylinderGeometry(0.85, 0.85, 0.2, 12), matDarkSteel, [0, 0.11, 0]);\n      scene.add(mh);\n      smokeEmitterPositions.push(new THREE.Vector3(mx, 0.25, mz));\n    });\n\n    // Natural Perimeter Rock Outcrops & Stylized Trees (prevents floating indoor box walls)\n    const rockGeo = new THREE.DodecahedronGeometry(2.8, 1);\n    const trunkGeo = new THREE.CylinderGeometry(0.35, 0.55, 2.2, 8);\n    const foliageGeo = new THREE.IcosahedronGeometry(1.8, 1);\n    const foliageMat = new THREE.MeshStandardMaterial({\n      color: 0x7cd936,\n      roughness: 0.65,\n      metalness: 0.05,\n    });\n    const trunkMat = new THREE.MeshStandardMaterial({\n      color: 0x4b382a,\n      roughness: 0.85,\n      metalness: 0.05,\n    });\n\n    for (let i = 0; i < 24; i++) {\n      const angle = (i / 24) * Math.PI * 2;\n      const dist = 42 + (i % 3) * 4;\n      const rx = Math.cos(angle) * dist;\n      const rz = Math.sin(angle) * dist;\n      if (i % 2 === 0) {\n        const rockGroup = new THREE.Group();\n        rockGroup.position.set(rx, 0, rz);\n        const s = 0.85 + (i % 4) * 0.22;\n        rockGroup.scale.set(s * 1.2, s * 0.85, s);\n        addOutlinedPart(rockGroup, rockGeo, matConcrete, [0, 1.4, 0], [0.2 * i, 0.5 * i, 0], 1.05, false);\n        scene.add(rockGroup);\n      } else {\n        const treeGroup = new THREE.Group();\n        treeGroup.position.set(rx, 0, rz);\n        const s = 0.9 + (i % 3) * 0.15;\n        treeGroup.scale.setScalar(s);\n        addOutlinedPart(treeGroup, trunkGeo, trunkMat, [0, 1.1, 0], [0, 0, 0], 1.06, false);\n        addOutlinedPart(treeGroup, foliageGeo, foliageMat, [0, 3.1, 0], [0, i, 0], 1.05, false);\n        addOutlinedPart(treeGroup, foliageGeo, matTankLime, [0.6, 4.1, -0.4], [0, 0, 0], 1.05, false);\n        scene.add(treeGroup);\n      }\n    }\n\n    // 5. Build Composite 11-Part Neon-Green Player Tank (sr=class in B1Nq4Kq6.js)\n    const tankRoot = new THREE.Group();\n    tankRoot.name = \'PlayerTankRoot\';\n    scene.add(tankRoot);\n\n    const tankContactShadow = new THREE.Mesh(shadowDiscGeo, shadowDiscMat);\n    tankContactShadow.position.set(0, 0.02, 0);\n    tankContactShadow.scale.set(1.35, 1.15, 1);\n    tankRoot.add(tankContactShadow);\n\n    const tankBodyGroup = new THREE.Group();\n    tankRoot.add(tankBodyGroup);\n\n    // Part 1: Main Lower Hull\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(2.25, 0.68, 1.55), matTankLime, [0, 0.58, 0]);\n    // Part 2: Upper Sloped Glacis\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(1.75, 0.34, 1.32), matTankHighlight, [0.1, 0.98, 0]);\n    // Part 3 & 4: Left & Right Armored Track Pods\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(2.55, 0.56, 0.38), matDarkSteel, [0, 0.36, -0.88]);\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(2.55, 0.56, 0.38), matDarkSteel, [0, 0.36, 0.88]);\n    // Part 5 & 6: Left & Right Neon Lime Track Fenders\n    const leftFender = addOutlinedPart(\n      tankBodyGroup,\n      new THREE.BoxGeometry(2.65, 0.14, 0.46),\n      matTankLime,\n      [0, 0.68, -0.88],\n    );\n    const rightFender = addOutlinedPart(\n      tankBodyGroup,\n      new THREE.BoxGeometry(2.65, 0.14, 0.46),\n      matTankLime,\n      [0, 0.68, 0.88],\n    );\n    // Part 7: Rear Yellow Boost Grille\n    const boostGrilleMat = new THREE.MeshStandardMaterial({\n      color: 0xfec83e,\n      emissive: 0xfec83e,\n      emissiveIntensity: 0.35,\n      roughness: 0.3,\n    });\n    addOutlinedPart(tankBodyGroup, new THREE.BoxGeometry(0.24, 0.42, 1.12), boostGrilleMat, [-1.14, 0.64, 0]);\n\n    // Part 8: Rotating Turret Group\n    const tankTurretGroup = new THREE.Group();\n    tankTurretGroup.position.set(-0.05, 1.15, 0);\n    tankBodyGroup.add(tankTurretGroup);\n\n    addOutlinedPart(tankTurretGroup, new THREE.BoxGeometry(1.32, 0.58, 1.24), matTankLime, [0, 0.25, 0]);\n    // Part 9: Commander Hatch & Yellow Periscope\n    addOutlinedPart(tankTurretGroup, new THREE.CylinderGeometry(0.32, 0.36, 0.22, 10), matYellow, [-0.18, 0.62, 0]);\n    // Part 10 & 11: Recoiling Cannon Barrel + Yellow Muzzle Brake\n    const tankBarrelGroup = new THREE.Group();\n    tankBarrelGroup.position.set(0.65, 0.26, 0);\n    tankTurretGroup.add(tankBarrelGroup);\n\n    addOutlinedPart(\n      tankBarrelGroup,\n      new THREE.CylinderGeometry(0.14, 0.16, 1.45, 12),\n      matGunmetal,\n      [0.65, 0, 0],\n      [0, 0, -Math.PI / 2],\n    );\n    addOutlinedPart(\n      tankBarrelGroup,\n      new THREE.CylinderGeometry(0.22, 0.22, 0.28, 12),\n      matYellow,\n      [1.38, 0, 0],\n      [0, 0, -Math.PI / 2],\n    );\n\n    // Muzzle Flash Mesh & Light\n    const muzzleFlashMesh = new THREE.Mesh(\n      new THREE.SphereGeometry(0.42, 10, 10),\n      new THREE.MeshBasicMaterial({ color: 0xb8ff3c }),\n    );\n    muzzleFlashMesh.position.set(1.62, 0, 0);\n    muzzleFlashMesh.visible = false;\n    tankBarrelGroup.add(muzzleFlashMesh);\n\n    // 6. Dynamic Factory Playground Props (ExplosiveBarrels, Hydrants, Crates, ConcreteFences)\n    const dynamicProps: DynamicProp[] = [];\n    const propsFolder = new THREE.Group();\n    scene.add(propsFolder);\n\n    const buildDynamicPropMesh = (kind: DynamicProp[\'kind\']): THREE.Group => {\n      const g = new THREE.Group();\n      const shadow = new THREE.Mesh(shadowDiscGeo, shadowDiscMat);\n      shadow.position.set(0, 0.02, 0);\n      shadow.scale.setScalar(0.75);\n      g.add(shadow);\n\n      if (kind === \'barrel\') {\n        addOutlinedPart(g, new THREE.CylinderGeometry(0.62, 0.62, 1.45, 14), matRedBarrel, [0, 0.75, 0]);\n        addOutlinedPart(g, new THREE.CylinderGeometry(0.66, 0.66, 0.16, 14), matYellow, [0, 1.1, 0]);\n        addOutlinedPart(g, new THREE.CylinderGeometry(0.66, 0.66, 0.16, 14), matYellow, [0, 0.4, 0]);\n      } else if (kind === \'hydrant\') {\n        addOutlinedPart(g, new THREE.CylinderGeometry(0.42, 0.48, 1.15, 12), matYellow, [0, 0.58, 0]);\n        addOutlinedPart(g, new THREE.SphereGeometry(0.44, 12, 10), matRedBarrel, [0, 1.18, 0]);\n        addOutlinedPart(\n          g,\n          new THREE.CylinderGeometry(0.18, 0.18, 0.95, 10),\n          matGunmetal,\n          [0, 0.82, 0],\n          [0, 0, Math.PI / 2],\n        );\n      } else if (kind === \'crate\') {\n        addOutlinedPart(g, new THREE.BoxGeometry(1.45, 1.45, 1.45), matHazard, [0, 0.74, 0]);\n        addOutlinedPart(g, new THREE.BoxGeometry(1.52, 0.22, 1.52), matDarkSteel, [0, 1.38, 0]);\n      } else {\n        addOutlinedPart(g, new THREE.BoxGeometry(2.6, 1.35, 0.55), matConcrete, [0, 0.68, 0]);\n        addOutlinedPart(g, new THREE.BoxGeometry(2.68, 0.26, 0.62), matHazard, [0, 1.28, 0]);\n      }\n      return g;\n    };\n\n    const initialPropSpecs: Array<{\n      name: string;\n      kind: DynamicProp[\'kind\'];\n      x: number;\n      z: number;\n      rotY?: number;\n    }> = [\n      { name: \'ExplosiveBarrel_01\', kind: \'barrel\', x: -7, z: -8 },\n      { name: \'ExplosiveBarrel_02\', kind: \'barrel\', x: -8.6, z: -6.8 },\n      { name: \'ExplosiveBarrel_03\', kind: \'barrel\', x: 8.5, z: -9.5 },\n      { name: \'ExplosiveBarrel_04\', kind: \'barrel\', x: 10.2, z: -8.2 },\n      { name: \'ExplosiveBarrel_05\', kind: \'barrel\', x: -12, z: 9 },\n      { name: \'ExplosiveBarrel_06\', kind: \'barrel\', x: 12, z: 10 },\n      { name: \'Hydrant_NW\', kind: \'hydrant\', x: -6.2, z: -6.2 },\n      { name: \'Hydrant_NE\', kind: \'hydrant\', x: 6.2, z: -6.2 },\n      { name: \'Hydrant_SW\', kind: \'hydrant\', x: -6.2, z: 6.2 },\n      { name: \'Hydrant_SE\', kind: \'hydrant\', x: 6.2, z: 6.2 },\n      { name: \'MetalBox_1A\', kind: \'crate\', x: -14, z: -2 },\n      { name: \'MetalBox_1B\', kind: \'crate\', x: -14, z: 0.2 },\n      { name: \'MetalBox_2A\', kind: \'crate\', x: 14, z: -2 },\n      { name: \'MetalBox_2B\', kind: \'crate\', x: 14, z: 0.4 },\n      { name: \'ConcreteFence_1A\', kind: \'fence\', x: -4.5, z: -12.5, rotY: 0.2 },\n      { name: \'ConcreteFence_1B\', kind: \'fence\', x: 4.5, z: -12.5, rotY: -0.2 },\n    ];\n\n    // 7. Collectibles (Gear, Tools, Circuit, Fuel)\n    const collectibles: CollectibleNode[] = [];\n    const collectiblesFolder = new THREE.Group();\n    scene.add(collectiblesFolder);\n\n    const collectibleSpecs = [\n      { id: \'gear\', label: \'GEAR\', x: -16, z: -12, color: 0xfec83e },\n      { id: \'tools\', label: \'TOOLS\', x: 16, z: -12, color: 0xb8ff3c },\n      { id: \'circuit\', label: \'CIRCUIT\', x: -16, z: 14, color: 0x00ff66 },\n      { id: \'fuel\', label: \'FUEL\', x: 16, z: 14, color: 0xf42f4c },\n    ];\n\n    // 8. Enemy Robots (3 Distinct Archetypes: Chaser Scout, Kiter Sniper, Boss Tank)\n    const enemies: EnemyBot[] = [];\n    const enemiesFolder = new THREE.Group();\n    scene.add(enemiesFolder);\n\n    const buildEnemyBotMesh = (archetype: EnemyBot[\'archetype\']) => {\n      const g = new THREE.Group();\n      const scale = archetype === \'boss\' ? 1.45 : archetype === \'kiter\' ? 0.95 : 0.85;\n      const shadow = new THREE.Mesh(shadowDiscGeo, shadowDiscMat);\n      shadow.position.set(0, 0.02, 0);\n      shadow.scale.setScalar(scale);\n      g.add(shadow);\n\n      const primaryMat =\n        archetype === \'boss\' ? matRedBarrel : archetype === \'kiter\' ? matYellow : matGunmetal;\n      addOutlinedPart(g, new THREE.BoxGeometry(1.8 * scale, 0.65 * scale, 1.5 * scale), primaryMat, [0, 0.55 * scale, 0]);\n      addOutlinedPart(g, new THREE.BoxGeometry(2.0 * scale, 0.45 * scale, 0.34 * scale), matDarkSteel, [0, 0.32 * scale, -0.78 * scale]);\n      addOutlinedPart(g, new THREE.BoxGeometry(2.0 * scale, 0.45 * scale, 0.34 * scale), matDarkSteel, [0, 0.32 * scale, 0.78 * scale]);\n\n      const turret = new THREE.Group();\n      turret.position.set(0, 1.0 * scale, 0);\n      g.add(turret);\n      addOutlinedPart(turret, new THREE.CylinderGeometry(0.55 * scale, 0.65 * scale, 0.5 * scale, 10), primaryMat, [0, 0.2 * scale, 0]);\n      addOutlinedPart(\n        turret,\n        new THREE.CylinderGeometry(0.14 * scale, 0.16 * scale, 1.3 * scale, 10),\n        matDarkSteel,\n        [0.65 * scale, 0.2 * scale, 0],\n        [0, 0, -Math.PI / 2],\n      );\n\n      // Windup Telegraph Ring & Sight Line (visible + audible telegraph before firing)\n      const ringGeo = new THREE.RingGeometry(1.1 * scale, 1.45 * scale, 24);\n      ringGeo.rotateX(-Math.PI / 2);\n      const ringMat = new THREE.MeshBasicMaterial({\n        color: 0xf42f4c,\n        side: THREE.DoubleSide,\n        transparent: true,\n        opacity: 0.85,\n      });\n      const telegraphRing = new THREE.Mesh(ringGeo, ringMat);\n      telegraphRing.position.set(0, 0.05, 0);\n      telegraphRing.visible = false;\n      g.add(telegraphRing);\n\n      const lineGeo = new THREE.BoxGeometry(10, 0.06, 0.12);\n      lineGeo.translate(5, 0, 0);\n      const lineMat = new THREE.MeshBasicMaterial({\n        color: 0xf42f4c,\n        transparent: true,\n        opacity: 0.75,\n      });\n      const telegraphLine = new THREE.Mesh(lineGeo, lineMat);\n      telegraphLine.position.set(0, 0.2 * scale, 0);\n      telegraphLine.visible = false;\n      turret.add(telegraphLine);\n\n      return { group: g, turret, telegraphRing, telegraphLine };\n    };\n\n    // 9. Pooled Projectiles & Pooled Cartoon Puff Smoke Ring Buffers (Zero GC in rAF)\n    const projectiles: Projectile[] = [];\n    const projGeo = new THREE.SphereGeometry(0.24, 10, 10);\n    const playerProjMat = new THREE.MeshBasicMaterial({ color: 0xb8ff3c });\n    const enemyProjMat = new THREE.MeshBasicMaterial({ color: 0xf42f4c });\n    for (let i = 0; i < 40; i++) {\n      const m = new THREE.Mesh(projGeo, playerProjMat);\n      m.visible = false;\n      scene.add(m);\n      projectiles.push({\n        active: false,\n        isEnemy: false,\n        mesh: m,\n        pos: new THREE.Vector3(),\n        vel: new THREE.Vector3(),\n        life: 0,\n        damage: 7,\n      });\n    }\n\n    const smokePool: SmokePuff[] = [];\n    const puffGeo = new THREE.DodecahedronGeometry(0.55, 1);\n    let smokeCursor = 0;\n    for (let i = 0; i < 90; i++) {\n      const mat = new THREE.MeshBasicMaterial({\n        color: 0xffffff,\n        transparent: true,\n        opacity: 0,\n        depthWrite: false,\n      });\n      const m = new THREE.Mesh(puffGeo, mat);\n      m.visible = false;\n      scene.add(m);\n      smokePool.push({\n        active: false,\n        mesh: m,\n        pos: new THREE.Vector3(),\n        vel: new THREE.Vector3(),\n        age: 0,\n        lifetime: 3.0,\n        startScale: 0.2,\n        endScale: 1.2,\n        peakOpacity: 0.85,\n        swayPhaseX: 0,\n        swayPhaseZ: 0,\n        swayFreqX: 0.6,\n        swayFreqZ: 0.8,\n        swayAmp: 0.1,\n        colorHex: 0xffffff,\n      });\n    }\n\n    const spawnPuff = (\n      origin: THREE.Vector3,\n      velYMin = 1.3,\n      velYMax = 2.0,\n      scaleStart = 0.22,\n      scaleEnd = 1.25,\n      colorHex = 0xffffff,\n      lifeMin = 2.6,\n      lifeMax = 4.2,\n      spread = 0.3,\n    ) => {\n      const p = smokePool[smokeCursor];\n      smokeCursor = (smokeCursor + 1) % smokePool.length;\n      const angle = Math.random() * Math.PI * 2;\n      const rad = Math.random() * 0.18;\n      p.pos.set(origin.x + Math.cos(angle) * rad, origin.y + 0.05, origin.z + Math.sin(angle) * rad);\n      p.vel.set(\n        (Math.random() - 0.5) * spread,\n        velYMin + Math.random() * (velYMax - velYMin),\n        (Math.random() - 0.5) * spread,\n      );\n      p.active = true;\n      p.age = 0;\n      p.lifetime = lifeMin + Math.random() * (lifeMax - lifeMin);\n      p.startScale = scaleStart;\n      p.endScale = scaleEnd;\n      p.peakOpacity = 0.78 + Math.random() * 0.16;\n      p.swayPhaseX = Math.random() * Math.PI * 2;\n      p.swayPhaseZ = Math.random() * Math.PI * 2;\n      p.swayFreqX = 0.44 + Math.random() * 0.44;\n      p.swayFreqZ = 0.58 + Math.random() * 0.54;\n      p.swayAmp = 0.06 + Math.random() * 0.08;\n      p.colorHex = colorHex;\n      const mat = p.mesh.material as THREE.MeshBasicMaterial;\n      mat.color.setHex(colorHex);\n      mat.opacity = 0;\n      p.mesh.position.copy(p.pos);\n      p.mesh.scale.setScalar(p.startScale);\n      p.mesh.visible = true;\n    };\n\n    // 10. [G] Grab Mode Telekinesis Curved Laser Beam (fi=class in B1Nq4Kq6.js)\n    const grabBeamPoints = Array.from({ length: 12 }, () => new THREE.Vector3());\n    const grabBeamGeo = new THREE.BufferGeometry().setFromPoints(grabBeamPoints);\n    const grabBeamMat = new THREE.LineBasicMaterial({ color: 0xffaa00, linewidth: 3 });\n    const grabBeamLine = new THREE.Line(grabBeamGeo, grabBeamMat);\n    grabBeamLine.visible = false;\n    scene.add(grabBeamLine);\n\n    // 11. Mutable Simulation State\n    const playerState = {\n      pos: new THREE.Vector3(0, 0, 8),\n      vel: new THREE.Vector3(),\n      yaw: -Math.PI / 2,\n      angVelY: 0,\n      turretYaw: 0,\n      currentSpeed: REA_CONSTANTS.physics.drive.speed,\n      hp: REA_CONSTANTS.physics.enemyBody.playerMaxHealth,\n      maxHp: REA_CONSTANTS.physics.enemyBody.playerMaxHealth,\n      score: 0,\n      bestScore: 0,\n      shootCooldown: 0,\n      recoilOffset: 0,\n      recoilVel: 0,\n      isGrabMode: false,\n      grabbedProp: null as DynamicProp | null,\n      collectedItems: [] as string[],\n      powerCoreActivated: false,\n      enemiesDefeated: 0,\n      totalEnemies: 4,\n      outcome: null as \'victory\' | \'defeat\' | null,\n      playTimeSec: 0,\n    };\n\n    const cameraState = {\n      targetEased: new Vec3Adapter(0, 0, 8),\n      targetVelocity: new Vec3Adapter(0, 0, 0),\n      mousePanOffset: new THREE.Vector3(),\n      targetMousePan: new THREE.Vector3(),\n      recoilOffset: new THREE.Vector3(),\n      zoomScale: 1.5,\n      trauma: 0,\n      hitstopTimer: 0,\n    };\n\n    function Vec3Adapter(x: number, y: number, z: number): Vec3 {\n      return { x, y, z };\n    }\n\n    // Populate / Reset World Entities\n    const populateWorld = () => {\n      // Clear previous dynamic props\n      while (propsFolder.children.length > 0) {\n        propsFolder.remove(propsFolder.children[0]);\n      }\n      dynamicProps.length = 0;\n\n      initialPropSpecs.forEach((spec, idx) => {\n        const mesh = buildDynamicPropMesh(spec.kind);\n        mesh.position.set(spec.x, 0, spec.z);\n        mesh.rotation.y = spec.rotY || 0;\n        propsFolder.add(mesh);\n        dynamicProps.push({\n          id: `prop_${idx}`,\n          name: spec.name,\n          kind: spec.kind,\n          mesh,\n          pos: new THREE.Vector3(spec.x, 0, spec.z),\n          vel: new THREE.Vector3(),\n          rotY: spec.rotY || 0,\n          angVelY: 0,\n          radius: spec.kind === \'fence\' ? 1.3 : 0.85,\n          halfHeight: 0.75,\n          mass: spec.kind === \'fence\' ? 2.8 : spec.kind === \'crate\' ? 1.6 : 1.0,\n          hp: spec.kind === \'barrel\' ? 1 : 99,\n          destroyed: false,\n          geyserTimer: 0,\n          flashTimer: 0,\n        });\n      });\n\n      // Collectibles\n      while (collectiblesFolder.children.length > 0) {\n        collectiblesFolder.remove(collectiblesFolder.children[0]);\n      }\n      collectibles.length = 0;\n      collectibleSpecs.forEach((cs) => {\n        const g = new THREE.Group();\n        g.position.set(cs.x, 0, cs.z);\n        const colMat = new THREE.MeshStandardMaterial({\n          color: cs.color,\n          emissive: cs.color,\n          emissiveIntensity: 0.35,\n          roughness: 0.25,\n          metalness: 0.3,\n        });\n        addOutlinedPart(g, new THREE.OctahedronGeometry(0.68, 0), colMat, [0, 1.1, 0]);\n        addOutlinedPart(g, new THREE.TorusGeometry(0.92, 0.09, 8, 18), matYellow, [0, 1.1, 0], [Math.PI / 2, 0, 0]);\n        collectiblesFolder.add(g);\n        collectibles.push({\n          id: cs.id,\n          label: cs.label,\n          mesh: g,\n          pos: new THREE.Vector3(cs.x, 0, cs.z),\n          collected: false,\n        });\n      });\n\n      // Enemies (3 distinct archetypes)\n      while (enemiesFolder.children.length > 0) {\n        enemiesFolder.remove(enemiesFolder.children[0]);\n      }\n      enemies.length = 0;\n      const enemySpawns: Array<{ archetype: EnemyBot[\'archetype\']; x: number; z: number }> = [\n        { archetype: \'chaser\', x: -18, z: -5 },\n        { archetype: \'chaser\', x: 18, z: 5 },\n        { archetype: \'kiter\', x: -14, z: -22 },\n        { archetype: \'boss\', x: 0, z: -27 },\n      ];\n      enemySpawns.forEach((es, idx) => {\n        const built = buildEnemyBotMesh(es.archetype);\n        built.group.position.set(es.x, 0, es.z);\n        enemiesFolder.add(built.group);\n        const maxHp =\n          es.archetype === \'boss\'\n            ? REA_CONSTANTS.physics.enemyBody.bossHealth\n            : REA_CONSTANTS.physics.enemyBody.fodderHealth;\n        enemies.push({\n          id: `enemy_${idx}`,\n          archetype: es.archetype,\n          mesh: built.group,\n          turret: built.turret,\n          telegraphRing: built.telegraphRing,\n          telegraphLine: built.telegraphLine,\n          pos: new THREE.Vector3(es.x, 0, es.z),\n          vel: new THREE.Vector3(),\n          rotY: 0,\n          hp: maxHp,\n          maxHp,\n          radius: es.archetype === \'boss\' ? 1.55 : 1.05,\n          state: \'patrol\',\n          stateTimer: 0,\n          cooldownTimer: 1.5 + idx * 0.4,\n          flashTimer: 0,\n          koTimer: 0,\n        });\n      });\n\n      // Reset Player\n      playerState.pos.set(0, 0, 8);\n      playerState.vel.set(0, 0, 0);\n      playerState.yaw = -Math.PI / 2;\n      playerState.angVelY = 0;\n      playerState.turretYaw = 0;\n      playerState.currentSpeed = REA_CONSTANTS.physics.drive.speed;\n      playerState.hp = playerState.maxHp;\n      playerState.score = 0;\n      playerState.shootCooldown = 0;\n      playerState.recoilOffset = 0;\n      playerState.isGrabMode = false;\n      playerState.grabbedProp = null;\n      playerState.collectedItems = [];\n      playerState.powerCoreActivated = false;\n      playerState.enemiesDefeated = 0;\n      playerState.totalEnemies = enemies.length;\n      playerState.outcome = null;\n      playerState.playTimeSec = 0;\n\n      cameraState.targetEased = { x: 0, y: 0, z: 8 };\n      cameraState.targetVelocity = { x: 0, y: 0, z: 0 };\n      cameraState.trauma = 0;\n      cameraState.hitstopTimer = 0;\n      grabBeamLine.visible = false;\n    };\n\n    resetWorldRef.current = populateWorld;\n    populateWorld();\n\n    // Pre-warm shaders on GPU\n    if (!isSoftwareGl) {\n      renderer.compile(scene, camera);\n    }\n\n    // 12. Unified Input Hygiene (held vs justPressed + focus-loss key release)\n    const keysHeld = new Set<string>();\n    const keysJustPressed = new Set<string>();\n    const mouseNormalized = new THREE.Vector2(0, 0);\n    const raycaster = new THREE.Raycaster();\n    const groundPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -1.15);\n    const aimPointWorld = new THREE.Vector3(0, 1.15, 0);\n    let mouseDownHeld = false;\n    let mouseJustPressed = false;\n\n    const updatePointerCoords = (clientX: number, clientY: number) => {\n      const rect = renderer.domElement.getBoundingClientRect();\n      if (rect.width <= 0 || rect.height <= 0) return;\n      mouseNormalized.x = ((clientX - rect.left) / rect.width) * 2 - 1;\n      mouseNormalized.y = -((clientY - rect.top) / rect.height) * 2 + 1;\n    };\n\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (!keysHeld.has(e.code)) {\n        keysJustPressed.add(e.code);\n      }\n      keysHeld.add(e.code);\n\n      if ((e.code === \'Escape\' || e.code === \'KeyP\') && gameStateRef.current === \'playing\') {\n        onTogglePauseRef.current();\n      }\n    };\n\n    const handleKeyUp = (e: KeyboardEvent) => {\n      keysHeld.delete(e.code);\n    };\n\n    const handlePointerMove = (e: PointerEvent) => {\n      updatePointerCoords(e.clientX, e.clientY);\n    };\n\n    const handlePointerDown = (e: PointerEvent) => {\n      if (e.button !== 0) return;\n      // Only fire/grab when clicking the canvas or non-button overlay\n      const targetEl = e.target as HTMLElement | null;\n      if (targetEl && (targetEl.tagName === \'BUTTON\' || targetEl.closest(\'button\') || targetEl.closest(\'[role=\"dialog\"]\'))) {\n        return;\n      }\n      updatePointerCoords(e.clientX, e.clientY);\n      mouseDownHeld = true;\n      mouseJustPressed = true;\n    };\n\n    const handlePointerUp = () => {\n      mouseDownHeld = false;\n    };\n\n    const clearAllInputs = () => {\n      keysHeld.clear();\n      keysJustPressed.clear();\n      mouseDownHeld = false;\n      mouseJustPressed = false;\n    };\n\n    window.addEventListener(\'keydown\', handleKeyDown);\n    window.addEventListener(\'keyup\', handleKeyUp);\n    window.addEventListener(\'pointermove\', handlePointerMove);\n    window.addEventListener(\'pointerdown\', handlePointerDown);\n    window.addEventListener(\'pointerup\', handlePointerUp);\n    window.addEventListener(\'blur\', clearAllInputs);\n\n    const handleResize = () => {\n      if (!container) return;\n      const w = container.clientWidth || window.innerWidth;\n      const h = container.clientHeight || window.innerHeight;\n      camera.aspect = w / Math.max(1, h);\n      camera.updateProjectionMatrix();\n      renderer.setSize(w, h);\n    };\n    window.addEventListener(\'resize\', handleResize);\n\n    // Helper: Fire Projectile\n    const spawnProjectile = (\n      origin: THREE.Vector3,\n      dir: THREE.Vector3,\n      isEnemy: boolean,\n      speed: number,\n      damage: number,\n    ) => {\n      const slot = projectiles.find((p) => !p.active);\n      if (!slot) return;\n      slot.active = true;\n      slot.isEnemy = isEnemy;\n      slot.pos.copy(origin);\n      slot.vel.copy(dir).multiplyScalar(speed);\n      slot.life = isEnemy ? 1.6 : REA_CONSTANTS.physics.cannon.projectileLife;\n      slot.damage = damage;\n      slot.mesh.material = isEnemy ? enemyProjMat : playerProjMat;\n      slot.mesh.position.copy(origin);\n      slot.mesh.visible = true;\n    };\n\n    // Helper: Trigger Explosive Barrel Detonation\n    const detonateBarrel = (prop: DynamicProp) => {\n      if (prop.destroyed) return;\n      prop.destroyed = true;\n      prop.mesh.visible = false;\n      soundEngine.playExplosion();\n      cameraState.trauma = Math.min(1.0, cameraState.trauma + 0.65);\n      cameraState.hitstopTimer = 0.055;\n      playerState.score += 150;\n\n      for (let i = 0; i < 18; i++) {\n        spawnPuff(\n          prop.pos,\n          2.2,\n          5.5,\n          0.45,\n          1.9,\n          i % 2 === 0 ? 0xf42f4c : 0xfec83e,\n          0.6,\n          1.2,\n          5.5,\n        );\n      }\n\n      // Blast nearby enemies and props\n      enemies.forEach((en) => {\n        if (en.state === \'ko\') return;\n        const dSq = en.pos.distanceToSquared(prop.pos);\n        if (dSq < 42) {\n          en.hp -= 18;\n          en.flashTimer = 0.12;\n          if (en.hp <= 0) {\n            en.state = \'ko\';\n            en.koTimer = 0.45;\n            playerState.enemiesDefeated += 1;\n            playerState.score += en.archetype === \'boss\' ? 500 : 200;\n          }\n        }\n      });\n    };\n\n    //Scratch vectors outside loop\n    const _forward = new THREE.Vector3();\n    const _right = new THREE.Vector3();\n    const _camOffset = new THREE.Vector3();\n    const _muzzleWorld = new THREE.Vector3();\n    const _shootDir = new THREE.Vector3();\n    const _diff = new THREE.Vector3();\n\n    let lastTime = performance.now();\n    let hudAccumulator = 0;\n    let smokeEmitAccumulator = 0;\n    let frameId = 0;\n    let isDisposed = false;\n\n    const emitHudSnapshot = (): HudSnapshot => {\n      playerState.bestScore = Math.max(playerState.bestScore, playerState.score);\n      const planarSpeed = Math.hypot(playerState.vel.x, playerState.vel.z);\n      const snap: HudSnapshot = {\n        hp: Math.max(0, Math.round(playerState.hp)),\n        maxHp: playerState.maxHp,\n        score: Math.round(playerState.score),\n        bestScore: Math.round(playerState.bestScore),\n        speedKmh: Math.round(planarSpeed * 4.5),\n        isBoosting:\n          keysHeld.has(\'ShiftLeft\') ||\n          keysHeld.has(\'ShiftRight\'),\n        isGrabMode: playerState.isGrabMode,\n        grabbedPropName: playerState.grabbedProp ? playerState.grabbedProp.name : null,\n        collectedItems: [...playerState.collectedItems],\n        powerCoreActivated: playerState.powerCoreActivated,\n        enemiesDefeated: playerState.enemiesDefeated,\n        totalEnemies: playerState.totalEnemies,\n        lightingPreset: lightingPresetRef.current,\n        cameraFovMode: cameraFovModeRef.current,\n        outcome: playerState.outcome,\n        clearTimeSec: Math.round(playerState.playTimeSec),\n      };\n      onHudUpdateRef.current(snap);\n      return snap;\n    };\n\n    // Software-WebGL Pacing Helper (exact pattern from threejs skill)\n    function afterDraw(cb: () => void) {\n      if (isDisposed) return;\n      const gl = renderer.getContext() as WebGL2RenderingContext;\n      const sync = gl.fenceSync ? gl.fenceSync(gl.SYNC_GPU_COMMANDS_COMPLETE, 0) : null;\n      gl.flush();\n      const poll = () => {\n        if (isDisposed) return;\n        const state = sync && gl.getSyncParameter(sync, gl.SYNC_STATUS);\n        if (sync && state === gl.UNSIGNALED) {\n          frameId = window.setTimeout(poll, 5);\n        } else {\n          if (sync) gl.deleteSync(sync);\n          frameId = window.setTimeout(cb, 80);\n        }\n      };\n      frameId = window.setTimeout(poll, 5);\n    }\n\n    function tick() {\n      if (isDisposed) return;\n      const now = performance.now();\n      const rawDt = (now - lastTime) / 1000;\n      lastTime = now;\n      const dt = Math.min(rawDt, 0.05);\n\n      const state = gameStateRef.current;\n\n      // Update Raycaster for Turret Aim & Grab Target\n      raycaster.setFromCamera(mouseNormalized, camera);\n      raycaster.ray.intersectPlane(groundPlane, aimPointWorld);\n\n      // Ambient Cartoon Puff Smoke from Manholes & Chimneys (runs in title & playing)\n      smokeEmitAccumulator += dt;\n      if (smokeEmitAccumulator >= 0.14) {\n        smokeEmitAccumulator = 0;\n        const emitterOrigin =\n          smokeEmitterPositions[Math.floor(Math.random() * smokeEmitterPositions.length)];\n        if (emitterOrigin) {\n          spawnPuff(emitterOrigin, 1.35, 1.95, 0.2, 1.25, 0xffffff, 2.8, 4.5, 0.25);\n        }\n      }\n\n      // Update Active Smoke Puffs\n      for (let i = 0; i < smokePool.length; i++) {\n        const s = smokePool[i];\n        if (!s.active) continue;\n        s.age += dt;\n        if (s.age >= s.lifetime) {\n          s.active = false;\n          s.mesh.visible = false;\n          continue;\n        }\n        const t = s.age / s.lifetime;\n        s.pos.addScaledVector(s.vel, dt);\n        const swayX = Math.sin(s.age * s.swayFreqX * Math.PI * 2 + s.swayPhaseX) * s.swayAmp;\n        const swayZ = Math.cos(s.age * s.swayFreqZ * Math.PI * 2 + s.swayPhaseZ) * s.swayAmp;\n        s.mesh.position.set(s.pos.x + swayX, s.pos.y, s.pos.z + swayZ);\n        const sc = lerp(s.startScale, s.endScale, Math.pow(t, 0.65));\n        s.mesh.scale.setScalar(sc);\n        const mat = s.mesh.material as THREE.MeshBasicMaterial;\n        mat.opacity =\n          t < 0.2 ? (t / 0.2) * s.peakOpacity : (1 - (t - 0.2) / 0.8) * s.peakOpacity;\n      }\n\n      // Rotate Power Core & Collectibles\n      powerCoreOrb.rotation.y += dt * (playerState.powerCoreActivated ? 3.2 : 1.1);\n      powerCoreRing.rotation.z += dt * (playerState.powerCoreActivated ? 2.4 : 0.8);\n      collectibles.forEach((col, idx) => {\n        if (!col.collected) {\n          col.mesh.rotation.y += dt * 1.8;\n          col.mesh.position.y = Math.sin(now * 0.004 + idx) * 0.16;\n        }\n      });\n\n      if (state === \'title\') {\n        // Title Screen Idle Animation & Turret Gaze Tracking inside Hexagon Cutout\n        const idleBob = Math.sin(now * 0.006) * 0.04;\n        tankBodyGroup.position.y = idleBob;\n        leftFender.rotation.x = Math.sin(now * 0.012) * 0.08;\n        rightFender.rotation.x = -Math.sin(now * 0.012) * 0.08;\n\n        const targetAngle = Math.atan2(\n          -(aimPointWorld.z - playerState.pos.z),\n          aimPointWorld.x - playerState.pos.x,\n        );\n        playerState.turretYaw = stepTurretYaw(\n          playerState.turretYaw,\n          targetAngle - playerState.yaw,\n          dt,\n        );\n        tankTurretGroup.rotation.y = playerState.turretYaw;\n        cameraState.zoomScale = lerp(cameraState.zoomScale, 1.45, 1 - Math.exp(-5 * dt));\n      } else if (state === \'playing\') {\n        playerState.playTimeSec += dt;\n        cameraState.zoomScale = lerp(cameraState.zoomScale, 1.0, 1 - Math.exp(-5 * dt));\n\n        // Handle Hitstop freeze timer (rendering + shake continue, physics pauses for 30-60ms)\n        const simDt = cameraState.hitstopTimer > 0 ? 0 : dt;\n        if (cameraState.hitstopTimer > 0) {\n          cameraState.hitstopTimer = Math.max(0, cameraState.hitstopTimer - dt);\n        }\n\n        // Toggle [G] Grab Mode (edge-triggered)\n        if (keysJustPressed.has(\'KeyG\')) {\n          soundEngine.playUiClick();\n          playerState.isGrabMode = !playerState.isGrabMode;\n          if (!playerState.isGrabMode && playerState.grabbedProp) {\n            // Hurl grabbed prop forward on release\n            _shootDir.set(Math.cos(playerState.yaw + playerState.turretYaw), 0, -Math.sin(playerState.yaw + playerState.turretYaw));\n            playerState.grabbedProp.vel.copy(_shootDir).multiplyScalar(22);\n            playerState.grabbedProp = null;\n          } else if (playerState.isGrabMode) {\n            // Find nearest dynamic prop to aim point or tank\n            let bestProp: DynamicProp | null = null;\n            let bestDist = 14;\n            dynamicProps.forEach((dp) => {\n              if (dp.destroyed) return;\n              const d = dp.pos.distanceTo(aimPointWorld);\n              if (d < bestDist) {\n                bestDist = d;\n                bestProp = dp;\n              }\n            });\n            playerState.grabbedProp = bestProp;\n          }\n        }\n\n        if (simDt > 0) {\n          // 1. Tank Drive & Boost Kinematics (1:1 port of ur.handlePhysics)\n          const forwardInput =\n            (keysHeld.has(\'KeyW\') || keysHeld.has(\'ArrowUp\') ? 1 : 0) -\n            (keysHeld.has(\'KeyS\') || keysHeld.has(\'ArrowDown\') ? 1 : 0);\n          const turnInput =\n            (keysHeld.has(\'KeyA\') || keysHeld.has(\'ArrowLeft\') ? 1 : 0) -\n            (keysHeld.has(\'KeyD\') || keysHeld.has(\'ArrowRight\') ? 1 : 0);\n          const isBoosting = keysHeld.has(\'ShiftLeft\') || keysHeld.has(\'ShiftRight\');\n\n          playerState.currentSpeed = computeTankSpeedStep(\n            playerState.currentSpeed,\n            isBoosting,\n            simDt,\n          );\n\n          if (Math.abs(turnInput) > 0.01) {\n            const boostMult = isBoosting\n              ? REA_CONSTANTS.physics.drive.boostRotationMultiplier\n              : 1.0;\n            const targetYawVel =\n              turnInput * REA_CONSTANTS.physics.drive.rotationSpeed * boostMult;\n            playerState.angVelY = lerp(\n              playerState.angVelY,\n              targetYawVel,\n              1 - Math.exp(-REA_CONSTANTS.physics.drive.rotationLerpRate * simDt),\n            );\n          } else {\n            const dampRate = REA_CONSTANTS.physics.drive.rotationDampingFactor * 60;\n            playerState.angVelY *= Math.exp(-dampRate * simDt);\n          }\n          playerState.yaw += playerState.angVelY * simDt;\n\n          _forward.set(Math.cos(playerState.yaw), 0, -Math.sin(playerState.yaw));\n          _right.set(-_forward.z, 0, _forward.x);\n\n          if (Math.abs(forwardInput) > 0.01) {\n            const targetVelX = _forward.x * forwardInput * playerState.currentSpeed;\n            const targetVelZ = _forward.z * forwardInput * playerState.currentSpeed;\n            const driveAlpha = 1 - Math.exp(-REA_CONSTANTS.physics.drive.driveLerpRate * simDt);\n            playerState.vel.x = lerp(playerState.vel.x, targetVelX, driveAlpha);\n            playerState.vel.z = lerp(playerState.vel.z, targetVelZ, driveAlpha);\n          } else {\n            // Anisotropic forward & lateral friction (applyMoveFriction)\n            const forwardSpeed = playerState.vel.dot(_forward);\n            const lateralSpeed = playerState.vel.dot(_right);\n            const decel =\n              playerState.currentSpeed *\n              REA_CONSTANTS.physics.drive.forwardFrictionFactor *\n              simDt;\n            const nextForward =\n              Math.abs(forwardSpeed) > 0.001\n                ? Math.sign(forwardSpeed) * Math.max(0, Math.abs(forwardSpeed) - decel)\n                : 0;\n            const nextLateral =\n              lateralSpeed *\n              Math.exp(-REA_CONSTANTS.physics.drive.lateralFrictionFactor * simDt);\n            playerState.vel\n              .copy(_forward)\n              .multiplyScalar(nextForward)\n              .addScaledVector(_right, nextLateral);\n          }\n\n          playerState.pos.addScaledVector(playerState.vel, simDt);\n          playerState.pos.x = clamp(playerState.pos.x, -36, 36);\n          playerState.pos.z = clamp(playerState.pos.z, -36, 36);\n\n          // Collision check against Central Power Core pedestal\n          const distToCore = Math.hypot(playerState.pos.x - 0, playerState.pos.z - -16);\n          if (distToCore < 4.4 && distToCore > 0.001) {\n            const nx = playerState.pos.x / distToCore;\n            const nz = (playerState.pos.z - -16) / distToCore;\n            playerState.pos.x = nx * 4.4;\n            playerState.pos.z = -16 + nz * 4.4;\n          }\n\n          // Gait-synced suspension bob & boost exhaust puffs\n          const speedMag = Math.hypot(playerState.vel.x, playerState.vel.z);\n          tankBodyGroup.position.y = Math.sin(now * 0.018) * Math.min(0.05, speedMag * 0.004);\n          tankBodyGroup.rotation.z =\n            (forwardInput * -0.035) + (playerState.recoilOffset * 0.25);\n\n          if (isBoosting && speedMag > 4 && Math.random() < 0.45) {\n            const exhaustPos = _diff\n              .copy(playerState.pos)\n              .addScaledVector(_forward, -1.35)\n              .setY(0.5);\n            spawnPuff(exhaustPos, 0.8, 1.4, 0.18, 0.75, 0xb8ff3c, 0.45, 0.8, 1.2);\n          }\n\n          // 2. Turret Aiming toward Pointer\n          const worldAimYaw = Math.atan2(\n            -(aimPointWorld.z - playerState.pos.z),\n            aimPointWorld.x - playerState.pos.x,\n          );\n          playerState.turretYaw = stepTurretYaw(\n            playerState.turretYaw,\n            worldAimYaw - playerState.yaw,\n            simDt,\n          );\n          tankTurretGroup.rotation.y = playerState.turretYaw;\n\n          // 3. Cannon Firing & Recoil (fireRate = 0.2s, projectileSpeed = 55 m/s)\n          playerState.shootCooldown = Math.max(0, playerState.shootCooldown - simDt);\n          const wantsShoot =\n            keysJustPressed.has(\'Space\') ||\n            mouseJustPressed ||\n            ((keysHeld.has(\'Space\') || mouseDownHeld) && !playerState.isGrabMode);\n\n          if (wantsShoot && playerState.shootCooldown <= 0) {\n            playerState.shootCooldown = REA_CONSTANTS.physics.cannon.fireRate;\n            const totalYaw = playerState.yaw + playerState.turretYaw;\n            _shootDir.set(Math.cos(totalYaw), 0, -Math.sin(totalYaw)).normalize();\n            _muzzleWorld\n              .copy(playerState.pos)\n              .addScaledVector(_shootDir, 2.05)\n              .setY(1.42);\n\n            spawnProjectile(\n              _muzzleWorld,\n              _shootDir,\n              false,\n              REA_CONSTANTS.physics.cannon.projectileSpeed,\n              7,\n            );\n            soundEngine.playShoot();\n\n            // Barrel Recoil & Camera Kick (recoilKickDistance = 0.13)\n            playerState.recoilOffset = REA_CONSTANTS.physics.cannon.barrelRecoilDistance;\n            cameraState.recoilOffset.addScaledVector(\n              _shootDir,\n              -REA_CONSTANTS.camera.recoil.kickDistance,\n            );\n            if (\n              cameraState.recoilOffset.length() >\n              REA_CONSTANTS.camera.recoil.maxRecoilDistance\n            ) {\n              cameraState.recoilOffset\n                .normalize()\n                .multiplyScalar(REA_CONSTANTS.camera.recoil.maxRecoilDistance);\n            }\n            cameraState.trauma = Math.min(1.0, cameraState.trauma + 0.18);\n            muzzleFlashMesh.visible = true;\n            window.setTimeout(() => {\n              muzzleFlashMesh.visible = false;\n            }, 45);\n          }\n\n          // Decay Barrel Recoil\n          playerState.recoilOffset = lerp(\n            playerState.recoilOffset,\n            0,\n            1 - Math.exp(-12 * simDt),\n          );\n          tankBarrelGroup.position.x = 0.65 - playerState.recoilOffset * 2.2;\n\n          // 4. [G] Grab Mode Telekinesis Spring Simulation\n          if (playerState.isGrabMode && playerState.grabbedProp && !playerState.grabbedProp.destroyed) {\n            const gp = playerState.grabbedProp;\n            const holdTargetX = clamp(aimPointWorld.x, -34, 34);\n            const holdTargetZ = clamp(aimPointWorld.z, -34, 34);\n            const dx = holdTargetX - gp.pos.x;\n            const dz = holdTargetZ - gp.pos.z;\n            gp.vel.x = dx * 10;\n            gp.vel.z = dz * 10;\n            gp.mesh.position.y = lerp(gp.mesh.position.y, 1.6, 1 - Math.exp(-10 * simDt));\n            gp.rotY += simDt * 2.2;\n\n            // Update Curved Spring Laser Beam (fi=class)\n            grabBeamLine.visible = true;\n            const startX = playerState.pos.x;\n            const startY = 1.5;\n            const startZ = playerState.pos.z;\n            for (let i = 0; i < grabBeamPoints.length; i++) {\n              const u = i / (grabBeamPoints.length - 1);\n              const arc = Math.sin(u * Math.PI) * 1.8;\n              grabBeamPoints[i].set(\n                lerp(startX, gp.pos.x, u),\n                lerp(startY, gp.mesh.position.y + 0.8, u) + arc,\n                lerp(startZ, gp.pos.z, u),\n              );\n            }\n            grabBeamGeo.setFromPoints(grabBeamPoints);\n          } else {\n            grabBeamLine.visible = false;\n          }\n\n          // 5. Update Dynamic Props (Collisions with Tank, Boundaries & Hydrant Geysers)\n          dynamicProps.forEach((dp) => {\n            if (dp.destroyed) return;\n            if (dp !== playerState.grabbedProp) {\n              dp.mesh.position.y = lerp(dp.mesh.position.y, 0, 1 - Math.exp(-12 * simDt));\n              dp.vel.multiplyScalar(Math.exp(-3.5 * simDt));\n            }\n            dp.pos.addScaledVector(dp.vel, simDt);\n            dp.pos.x = clamp(dp.pos.x, -35, 35);\n            dp.pos.z = clamp(dp.pos.z, -35, 35);\n            dp.rotY += dp.angVelY * simDt;\n            dp.angVelY *= Math.exp(-4 * simDt);\n\n            dp.mesh.position.x = dp.pos.x;\n            dp.mesh.position.z = dp.pos.z;\n            dp.mesh.rotation.y = dp.rotY;\n\n            // Outline highlight when grabbed\n            dp.mesh.traverse((child) => {\n              if ((child as THREE.Mesh).isMesh && child.name === \'InkStroke\') {\n                (child as THREE.Mesh).material =\n                  dp === playerState.grabbedProp ? hoverOutlineMat : inkOutlineMat;\n              }\n            });\n\n            // Tank vs Dynamic Prop Collision\n            const dist = dp.pos.distanceTo(playerState.pos);\n            const minSep = dp.radius + 1.35;\n            if (dist < minSep && dist > 0.001 && dp !== playerState.grabbedProp) {\n              const nx = (dp.pos.x - playerState.pos.x) / dist;\n              const nz = (dp.pos.z - playerState.pos.z) / dist;\n              const overlap = minSep - dist;\n              dp.pos.x += nx * overlap * 0.8;\n              dp.pos.z += nz * overlap * 0.8;\n              const pushSpeed = Math.max(4, playerState.vel.length() * 1.15);\n              dp.vel.x += nx * pushSpeed;\n              dp.vel.z += nz * pushSpeed;\n              dp.angVelY += (Math.random() - 0.5) * 6;\n              playerState.score += 10;\n              if (dp.kind === \'hydrant\') {\n                dp.geyserTimer = 3.5;\n              }\n            }\n\n            if (dp.geyserTimer > 0) {\n              dp.geyserTimer -= simDt;\n              if (Math.random() < 0.6) {\n                spawnPuff(dp.pos, 3.8, 6.4, 0.25, 0.95, 0x99e6ff, 0.5, 0.9, 1.5);\n              }\n            }\n          });\n\n          // 6. Collectibles Pickup & Power Core Activation\n          collectibles.forEach((col) => {\n            if (col.collected) return;\n            if (col.pos.distanceTo(playerState.pos) < 2.2) {\n              col.collected = true;\n              col.mesh.visible = false;\n              playerState.collectedItems.push(col.label);\n              playerState.score += 250;\n              playerState.hp = Math.min(playerState.maxHp, playerState.hp + 5);\n              soundEngine.playPickup();\n            }\n          });\n\n          if (\n            !playerState.powerCoreActivated &&\n            playerState.collectedItems.length >= collectibles.length &&\n            Math.hypot(playerState.pos.x - 0, playerState.pos.z - -16) < 6.8\n          ) {\n            playerState.powerCoreActivated = true;\n            playerState.score += 1000;\n            soundEngine.playVictory();\n            cameraState.trauma = 0.55;\n          }\n\n          // 7. Enemy Archetype AI & Attack Token Pool (max 2 concurrent windups)\n          let activeWindups = enemies.filter((e) => e.state === \'windup\').length;\n          enemies.forEach((en) => {\n            if (en.state === \'ko\') {\n              en.koTimer = Math.max(0, en.koTimer - simDt);\n              en.mesh.rotation.z = lerp(en.mesh.rotation.z, Math.PI / 2.2, 1 - Math.exp(-8 * simDt));\n              en.mesh.scale.setScalar(Math.max(0.01, en.koTimer / 0.45));\n              if (en.koTimer <= 0) {\n                en.mesh.visible = false;\n              }\n              return;\n            }\n\n            // Flash white on hit\n            if (en.flashTimer > 0) {\n              en.flashTimer -= simDt;\n              en.mesh.traverse((c) => {\n                if ((c as THREE.Mesh).isMesh && c.userData.baseMaterial) {\n                  (c as THREE.Mesh).material =\n                    en.flashTimer > 0 ? flashWhiteMat : c.userData.baseMaterial;\n                }\n              });\n            }\n\n            const toPlayerX = playerState.pos.x - en.pos.x;\n            const toPlayerZ = playerState.pos.z - en.pos.z;\n            const distToPlayer = Math.hypot(toPlayerX, toPlayerZ);\n            const angleToPlayer = Math.atan2(-toPlayerZ, toPlayerX);\n            en.turret.rotation.y = angleToPlayer - en.rotY;\n\n            // Distinct movement policy per archetype\n            if (en.state === \'patrol\') {\n              if (en.archetype === \'chaser\') {\n                // Policy 1: Swarmer/Chaser closes in to 7.5m and orbits\n                const desiredDist = 7.5;\n                const moveSign = distToPlayer > desiredDist ? 1 : -0.4;\n                en.rotY = stepTurretYaw(en.rotY, angleToPlayer, simDt * 0.8);\n                en.vel.x = (toPlayerX / Math.max(1, distToPlayer)) * 4.6 * moveSign;\n                en.vel.z = (toPlayerZ / Math.max(1, distToPlayer)) * 4.6 * moveSign;\n              } else if (en.archetype === \'kiter\') {\n                // Policy 2: Ranged Kiter retreats if player < 11m, strafes sideways\n                const strafeX = -toPlayerZ / Math.max(1, distToPlayer);\n                const strafeZ = toPlayerX / Math.max(1, distToPlayer);\n                const retreat = distToPlayer < 11 ? -1.0 : distToPlayer > 18 ? 0.6 : 0;\n                en.vel.x =\n                  (toPlayerX / Math.max(1, distToPlayer)) * 4.2 * retreat + strafeX * 3.2;\n                en.vel.z =\n                  (toPlayerZ / Math.max(1, distToPlayer)) * 4.2 * retreat + strafeZ * 3.2;\n                en.rotY = stepTurretYaw(en.rotY, angleToPlayer, simDt * 0.7);\n              } else {\n                // Policy 3: Boss Heavy Tank patrols around Power Core & charges line-of-sight\n                en.rotY = stepTurretYaw(en.rotY, angleToPlayer, simDt * 0.5);\n                if (distToPlayer > 10 && distToPlayer < 26) {\n                  en.vel.x = (toPlayerX / distToPlayer) * 3.1;\n                  en.vel.z = (toPlayerZ / distToPlayer) * 3.1;\n                } else {\n                  en.vel.multiplyScalar(0.9);\n                }\n              }\n\n              en.pos.addScaledVector(en.vel, simDt);\n              en.pos.x = clamp(en.pos.x, -34, 34);\n              en.pos.z = clamp(en.pos.z, -34, 34);\n\n              en.cooldownTimer -= simDt;\n              if (en.cooldownTimer <= 0 && distToPlayer < 24 && activeWindups < 2) {\n                en.state = \'windup\';\n                en.stateTimer = 0.55; // Visible 0.55s telegraph windup before firing\n                en.telegraphRing.visible = true;\n                en.telegraphLine.visible = true;\n                activeWindups += 1;\n              }\n            } else if (en.state === \'windup\') {\n              en.stateTimer -= simDt;\n              const pulse = 1 + Math.sin(en.stateTimer * 35) * 0.18;\n              en.telegraphRing.scale.setScalar(pulse);\n              if (en.stateTimer <= 0) {\n                en.telegraphRing.visible = false;\n                en.telegraphLine.visible = false;\n                const shootAngle = en.rotY + en.turret.rotation.y;\n                _shootDir.set(Math.cos(shootAngle), 0, -Math.sin(shootAngle)).normalize();\n                _muzzleWorld.copy(en.pos).addScaledVector(_shootDir, 1.6).setY(1.1);\n                spawnProjectile(\n                  _muzzleWorld,\n                  _shootDir,\n                  true,\n                  21,\n                  en.archetype === \'boss\' ? 6 : 4,\n                );\n                en.state = \'recover\';\n                en.stateTimer = 0.4;\n                en.cooldownTimer = en.archetype === \'boss\' ? 1.8 : 2.5;\n              }\n            } else if (en.state === \'recover\') {\n              en.stateTimer -= simDt;\n              if (en.stateTimer <= 0) {\n                en.state = \'patrol\';\n              }\n            }\n\n            en.mesh.position.copy(en.pos);\n            en.mesh.rotation.y = en.rotY;\n          });\n\n          // 8. Update Projectiles & Hit Detection\n          for (let i = 0; i < projectiles.length; i++) {\n            const pr = projectiles[i];\n            if (!pr.active) continue;\n            pr.life -= simDt;\n            if (pr.life <= 0) {\n              pr.active = false;\n              pr.mesh.visible = false;\n              continue;\n            }\n            pr.pos.addScaledVector(pr.vel, simDt);\n            pr.mesh.position.copy(pr.pos);\n\n            if (!pr.isEnemy) {\n              // Check hit against Dynamic Props\n              for (let j = 0; j < dynamicProps.length; j++) {\n                const dp = dynamicProps[j];\n                if (dp.destroyed) continue;\n                if (\n                  Math.hypot(pr.pos.x - dp.pos.x, pr.pos.z - dp.pos.z) <\n                  dp.radius + 0.35\n                ) {\n                  pr.active = false;\n                  pr.mesh.visible = false;\n                  if (dp.kind === \'barrel\') {\n                    detonateBarrel(dp);\n                  } else {\n                    soundEngine.playHit();\n                    const dirNorm = pr.vel.clone().normalize();\n                    dp.vel.addScaledVector(dirNorm, 14 / dp.mass);\n                    dp.angVelY += (Math.random() - 0.5) * 9;\n                    playerState.score += 25;\n                    if (dp.kind === \'hydrant\') {\n                      dp.geyserTimer = 4.0;\n                    }\n                  }\n                  break;\n                }\n              }\n\n              // Check hit against Enemies\n              if (pr.active) {\n                for (let j = 0; j < enemies.length; j++) {\n                  const en = enemies[j];\n                  if (en.state === \'ko\') continue;\n                  if (\n                    Math.hypot(pr.pos.x - en.pos.x, pr.pos.z - en.pos.z) <\n                    en.radius + 0.35\n                  ) {\n                    pr.active = false;\n                    pr.mesh.visible = false;\n                    en.hp -= pr.damage;\n                    en.flashTimer = 0.08;\n                    soundEngine.playHit();\n                    spawnPuff(pr.pos, 1.5, 3.2, 0.25, 0.9, 0xfec83e, 0.35, 0.6, 2.5);\n                    if (en.hp <= 0) {\n                      en.state = \'ko\';\n                      en.koTimer = 0.45;\n                      en.telegraphRing.visible = false;\n                      en.telegraphLine.visible = false;\n                      playerState.enemiesDefeated += 1;\n                      playerState.score += en.archetype === \'boss\' ? 500 : 200;\n                      cameraState.hitstopTimer = 0.05;\n                      cameraState.trauma = Math.min(1.0, cameraState.trauma + 0.45);\n                      soundEngine.playExplosion();\n                    }\n                    break;\n                  }\n                }\n              }\n            } else {\n              // Enemy Projectile hitting Player Tank\n              if (\n                Math.hypot(\n                  pr.pos.x - playerState.pos.x,\n                  pr.pos.z - playerState.pos.z,\n                ) < 1.35\n              ) {\n                pr.active = false;\n                pr.mesh.visible = false;\n                playerState.hp = Math.max(0, playerState.hp - pr.damage);\n                cameraState.trauma = Math.min(1.0, cameraState.trauma + 0.38);\n                cameraState.hitstopTimer = 0.04;\n                soundEngine.playHit();\n                if (playerState.hp <= 0 && !playerState.outcome) {\n                  playerState.outcome = \'defeat\';\n                  soundEngine.playDefeat();\n                  const snap = emitHudSnapshot();\n                  onGameOverRef.current(\'defeat\', snap);\n                }\n              }\n            }\n          }\n\n          // Check Victory Condition (All enemies defeated AND Power Core activated, or all 4enemies defeated + all 4 items collected)\n          if (\n            !playerState.outcome &&\n            playerState.enemiesDefeated >= playerState.totalEnemies &&\n            playerState.powerCoreActivated\n          ) {\n            playerState.outcome = \'victory\';\n            playerState.score += 1500;\n            soundEngine.playVictory();\n            const snap = emitHudSnapshot();\n            onGameOverRef.current(\'victory\', snap);\n          }\n        }\n      }\n\n      // Sync Player Tank Visual Transform\n      tankRoot.position.set(playerState.pos.x, 0, playerState.pos.z);\n      tankRoot.rotation.y = playerState.yaw;\n\n      // 9. Camera Follow Update (Exact 1:1 port of CQl67Veh.js)\n      const springStep = stepCriticalDampedSpring3D(\n        cameraState.targetEased,\n        { x: playerState.pos.x, y: 0, z: playerState.pos.z },\n        cameraState.targetVelocity,\n        playerState.currentSpeed,\n        dt,\n      );\n      cameraState.targetEased = springStep.position;\n      cameraState.targetVelocity = springStep.velocity;\n\n      const angleCfg = REA_CONSTANTS.camera.defaultAngleOffset;\n      const distMult = cameraFovModeRef.current === \'roblox18\' ? 1.85 : 1.0;\n      _camOffset\n        .set(angleCfg.x, angleCfg.y, angleCfg.z)\n        .multiplyScalar(distMult / Math.max(0.6, cameraState.zoomScale));\n\n      // Mouse Pan in Gameplay\n      _forward.set(-angleCfg.x, 0, -angleCfg.z).normalize();\n      _right.set(-_forward.z, 0, _forward.x).normalize();\n      if (state === \'playing\') {\n        cameraState.targetMousePan\n          .copy(_right)\n          .multiplyScalar(mouseNormalized.x * REA_CONSTANTS.camera.mousePan.sensitivity)\n          .addScaledVector(\n            _forward,\n            mouseNormalized.y * REA_CONSTANTS.camera.mousePan.sensitivity,\n          );\n      } else {\n        cameraState.targetMousePan.set(0, 0, 0);\n      }\n      cameraState.mousePanOffset.lerp(\n        cameraState.targetMousePan,\n        1 - Math.exp(-REA_CONSTANTS.camera.mousePan.dampSpeed * dt),\n      );\n\n      // Decay Recoil & Trauma Shake\n      cameraState.recoilOffset.lerp(new THREE.Vector3(), 1 - Math.exp(-10 * dt));\n      cameraState.trauma = Math.max(0, cameraState.trauma - dt * 2.4);\n      const shakeMag = cameraState.trauma * cameraState.trauma * 0.45;\n      const shakeX = Math.sin(now * 0.047) * shakeMag;\n      const shakeY = Math.cos(now * 0.053) * shakeMag * 0.6;\n      const shakeZ = Math.sin(now * 0.041) * shakeMag;\n\n      // Intro Hexagon Offset (places Tank on the right half inside the Hexagon Cutout)\n      let introShiftX = 0;\n      let introShiftZ = 0;\n      if (state === \'title\' || cameraState.zoomScale > 1.02) {\n        const blend = clamp((cameraState.zoomScale - 1.0) / 0.45, 0, 1);\n        introShiftX = -_right.x * 3.1 * blend;\n        introShiftZ = -_right.z * 3.1 * blend;\n      }\n\n      const focusX =\n        cameraState.targetEased.x +\n        cameraState.mousePanOffset.x +\n        cameraState.recoilOffset.x +\n        introShiftX +\n        shakeX;\n      const focusY =\n        cameraState.targetEased.y + 0.6 + shakeY;\n      const focusZ =\n        cameraState.targetEased.z +\n        cameraState.mousePanOffset.z +\n        cameraState.recoilOffset.z +\n        introShiftZ +\n        shakeZ;\n\n      camera.position.set(\n        focusX + _camOffset.x,\n        focusY + _camOffset.y,\n        focusZ + _camOffset.z,\n      );\n      camera.lookAt(focusX, focusY, focusZ);\n\n      // Keep Directional Light shadow frustum centered on player\n      dirLight.position.set(focusX + 20, 42, focusZ - 18);\n      dirLight.target.position.set(focusX, 0, focusZ);\n\n      // Clear single-frame edge triggers\n      keysJustPressed.clear();\n      mouseJustPressed = false;\n\n      // Throttle React HUD state updates to <= 10Hz\n      hudAccumulator += dt;\n      if (hudAccumulator >= 0.1) {\n        hudAccumulator = 0;\n        emitHudSnapshot();\n      }\n\n      renderer.render(scene, camera);\n\n      if (isSoftwareGl) {\n        afterDraw(tick);\n      } else {\n        frameId = window.requestAnimationFrame(tick);\n      }\n    }\n\n    emitHudSnapshot();\n    frameId = window.requestAnimationFrame(tick);\n\n    return () => {\n      isDisposed = true;\n      window.cancelAnimationFrame(frameId);\n      window.clearTimeout(frameId);\n      window.removeEventListener(\'keydown\', handleKeyDown);\n      window.removeEventListener(\'keyup\', handleKeyUp);\n      window.removeEventListener(\'pointermove\', handlePointerMove);\n      window.removeEventListener(\'pointerdown\', handlePointerDown);\n      window.removeEventListener(\'pointerup\', handlePointerUp);\n      window.removeEventListener(\'blur\', clearAllInputs);\n      window.removeEventListener(\'resize\', handleResize);\n      asphaltTex.dispose();\n      hazardTex.dispose();\n      renderer.dispose();\n      if (renderer.domElement.parentNode === container) {\n        container.removeChild(renderer.domElement);\n      }\n    };\n  }, []);\n\n  return (\n    <div\n      ref={mountRef}\n      data-testid=\"factory-playground-canvas\"\n      className=\"fixed inset-0 w-full h-full z-0\"\n    />\n  );\n};\n"
