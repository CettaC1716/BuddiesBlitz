            }
            lines {
              text: "          mountedTank.turretGroup.rotation.y = mountedTank.turretYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          // Team Buddies Feature: Crate Run-Over (Carry up to 4 crates by driving over them!)"
