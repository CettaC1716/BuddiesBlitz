            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Handler Tombol [V]: Teropong Perintah AI Berdasarkan Target Kursor (Crate=HARVEST, Enemy=ATTACK, Base=DEFEND, Tank=MOUNT)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "IssueCommandRemote.OnServerEvent:Connect(function(player: Player, cursorWorldPos: Vector3, hitInstance: Instance?)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal resolvedMode = \"HARVEST\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tif hitInstance then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tif hitInstance.Parent and hitInstance.Parent.Name == \"WorldCrates\" then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tresolvedMode = \"HARVEST\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\telseif hitInstance:FindFirstAncestor(\"Vehicles\") then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tresolvedMode = \"MOUNT\""
