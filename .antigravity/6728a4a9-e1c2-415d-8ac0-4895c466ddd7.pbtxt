              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tseat.Parent = turret"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal seatWeld = Instance.new(\"WeldConstraint\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tseatWeld.Part0 = turret"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tseatWeld.Part1 = seat"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tseatWeld.Parent = seat"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- Laras Meriam (Tunggal untuk Lyo Tank, Ganda untuk Super Tyrant Tank)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal barrelOffsets = isSuperTyrant and { -1.1, 1.1 } or { 0.0 }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tfor idx, xOff in ipairs(barrelOffsets) do"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal barrel = Instance.new(\"Part\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tbarrel.Name = \"Barrel_\" .. idx"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tbarrel.Size = Vector3.new(0.95, 0.95, 5.2)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tbarrel.Color = Color3.fromRGB(32, 35, 48)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tbarrel.CanCollide = false"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tbarrel.CFrame = turret.CFrame * CFrame.new(xOff, 0.1, -3.6)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tbarrel.Parent = turret"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tlocal bw = Instance.new(\"WeldConstraint\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tbw.Part0 = turret"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tbw.Part1 = barrel"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tbw.Parent = barrel"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal hl = Instance.new(\"Highlight\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\thl.FillTransparency = 1"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\thl.OutlineColor = Color3.fromRGB(18, 18, 30)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\thl.Parent = tank"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- Fitur Asli Team Buddies: Melindas Peti (Crate Run-Over, angkut maks 4 peti)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\thull.Touched:Connect(function(hit: BasePart)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tif hit.Parent and hit.Parent.Name == \"WorldCrates\" and hit:GetAttribute(\"OnPad\") ~= true then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tlocal stored = tonumber(tank:GetAttribute(\"StoredCrates\")) or 0"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tif stored < 4 then"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\ttank:SetAttribute(\"StoredCrates\", stored + 1)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\thit:Destroy()"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tend"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tend)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\ttank.Parent = VehiclesFolder"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\treturn tank"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "end"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "-- Spawn 1 Lyo Tank contoh di dekat markas Biru & Merah saat pertandingan dimulai"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "spawnOpenTopLyoTank(Vector3.new(-86, 3.5, -92), false, Color3.fromHex(\"#2979ff\"))"
