            }
            lines {
              text: "  const leafLocalPos = new Float32Array(planesPerCluster * 4 * 3);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const leafPlaneSeed = new Float32Array(planesPerCluster * 4);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  for (let a = 0; a < planesPerCluster; a++) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const plane = new THREE.PlaneGeometry(planeSize, planeSize);"
