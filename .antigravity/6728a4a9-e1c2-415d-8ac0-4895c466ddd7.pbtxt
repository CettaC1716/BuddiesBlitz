        target_content: "export function populateRealLyoTreeFromGlb(\n  targetGroup: THREE.Group,\n  treeGltfScene: THREE.Group,\n  isPurpleTree: boolean,\n  leafMaskTexture: THREE.Texture,\n  windUniforms: LyoWindUniforms,\n  isSoftwareGl: boolean,\n) {\n  // Remove placeholder primitives inside targetGroup except the contact shadow disc\n  for (let i = targetGroup.children.length - 1; i >= 0; i--) {\n    const ch = targetGroup.children[i];\n    if (ch.name !== \'ContactShadowDisc\') {\n      targetGroup.remove(ch);\n    }\n  }\n\n  treeGltfScene.updateMatrixWorld(true);\n\n  // Locate ONLY the single reference tree root (Tree_1B.REF / Tree_1B_REF or Tree_1A.REF / Tree_1A_REF)\n  let refRoot: THREE.Object3D | null = null;\n  treeGltfScene.traverse((obj) => {\n    const n = (obj.name || \'\').toLowerCase();\n    if (!refRoot && (n.endsWith(\'.ref\') || n.endsWith(\'_ref\'))) {\n      refRoot = obj;\n    }\n  });\n  const sourceRoot = (refRoot || treeGltfScene.children[0] || treeGltfScene) as THREE.Object3D;\n\n  const trunkGroup = new THREE.Group();\n  trunkGroup.name = \'RealGlbTreeTrunk\';\n  const refScale = sourceRoot.scale.x > 0.01 ? sourceRoot.scale.x : 0.4362676;\n\n  // 1. Clone ONLY the reference trunk mesh itself (sourceRoot is a Mesh in tree-1b.glb / tree-1a.glb)\n  if ((sourceRoot as THREE.Mesh).isMesh) {\n    const srcTrunk = sourceRoot as THREE.Mesh;\n    const trunkMesh = new THREE.Mesh(srcTrunk.geometry, srcTrunk.material);\n    trunkMesh.name = srcTrunk.name;\n    trunkMesh.scale.setScalar(refScale);\n    trunkMesh.castShadow = !isSoftwareGl;\n    trunkMesh.receiveShadow = !isSoftwareGl;\n    upgradeMeshToLyoWorldMaterial(trunkMesh, windUniforms);\n    const stroke = createLyoStrokeMesh(trunkMesh.geometry, 0.045);\n    if (stroke) trunkMesh.add(stroke);\n    trunkGroup.add(trunkMesh);\n  }\n\n  // 2. Collect the Tree_Foliage.* cluster marker transforms from sourceRoot\'s direct children\n  const foliageMarkerMatrices: THREE.Matrix4[] = [];\n  sourceRoot.children.forEach((child) => {\n    const lower = (child.name || \'\').toLowerCase();\n    if (lower.startsWith(\'tree_foliage\') || lower.includes(\'foliage\')) {\n      const m = new THREE.Matrix4();\n      const pos = child.position.clone().multiplyScalar(refScale);\n      const scl = child.scale.clone().multiplyScalar(refScale);\n      m.compose(pos, child.quaternion, scl);\n      foliageMarkerMatrices.push(m);\n    }\n  });\n\n  // Ground trunk cleanly at y = 0\n  const box = new THREE.Box3().setFromObject(trunkGroup);\n  if (!box.isEmpty()) {\n    trunkGroup.position.y = -box.min.y;\n  }\n  targetGroup.add(trunkGroup);\n\n  // 3. Build exact Lyo TreeLeaves geometry (planesPerCluster = 80, planeSize = 0.8, normalLerp = 0.85)\n  const planesPerCluster = isSoftwareGl ? 56 : 80;\n  const planeSize = 0.8;\n  const normalLerp = 0.85;\n  let randomSeed = 1431691;\n  const getRandom = () => {\n    randomSeed = (randomSeed * 1664525 + 1013904223) >>> 0;\n    return randomSeed / 4294967296;\n  };\n\n  const clusterGeos: THREE.BufferGeometry[] = [];\n  const leafCenters = new Float32Array(planesPerCluster * 4 * 3);\n  const leafLocalPos = new Float32Array(planesPerCluster * 4 * 3);\n  const leafPlaneSeed = new Float32Array(planesPerCluster * 4);\n\n  for (let a = 0; a < planesPerCluster; a++) {\n    const plane = new THREE.PlaneGeometry(planeSize, planeSize);\n    const seed = getRandom();\n    const radius = 1 - Math.pow(getRandom(), 3);\n    const phi = Math.PI * 2 * getRandom();\n    const theta = Math.PI * getRandom();\n    const sph = new THREE.Spherical(radius, theta, phi);\n    const center = new THREE.Vector3().setFromSpherical(sph);\n    const radialNormal = center.clone().normalize();\n\n    const posAttr = plane.attributes.position;\n    const normAttr = plane.attributes.normal;\n    for (let v = 0; v < 4; v++) {\n      const vertIdx = a * 4 + v;\n      const s3 = v * 3;\n      const f3 = vertIdx * 3;\n      const p = new THREE.Vector3(posAttr.array[s3], posAttr.array[s3 + 1], posAttr.array[s3 + 2]);\n      leafCenters[f3] = center.x;\n      leafCenters[f3 + 1] = center.y;\n      leafCenters[f3 + 2] = center.z;\n      leafLocalPos[f3] = p.x;\n      leafLocalPos[f3 + 1] = p.y;\n      leafLocalPos[f3 + 2] = p.z;\n      leafPlaneSeed[vertIdx] = seed;\n\n      const blendedNormal = p.clone().lerp(radialNormal, normalLerp).normalize();\n      normAttr.array[s3] = blendedNormal.x;\n      normAttr.array[s3 + 1] = blendedNormal.y;\n      normAttr.array[s3 + 2] = blendedNormal.z;\n    }\n    clusterGeos.push(plane);\n  }\n\n  const mergedClusterGeo = mergeGeometries(clusterGeos, false);\n  clusterGeos.forEach((g) => g.dispose());\n  mergedClusterGeo.setAttribute(\'aLeafCenter\', new THREE.BufferAttribute(leafCenters, 3));\n  mergedClusterGeo.setAttribute(\'aLeafLocalPos\', new THREE.BufferAttribute(leafLocalPos, 3));\n  mergedClusterGeo.setAttribute(\'aLeafPlaneSeed\', new THREE.BufferAttribute(leafPlaneSeed, 1));\n\n  // Exact colors from Ri.prototype.instanceObjectOverrides (B1Nq4Kq6.js:442500):\n  // Tree_1B: colorA = \'#5e57a5\', colorB = \'#775cf6\', leafScale = 2.2\n  // Tree_1A: colorA = \'#eab308\', colorB = \'#facc15\', leafScale = 2.2\n  const colorA = new THREE.Color(isPurpleTree ? \'#5e57a5\' : \'#eab308\');\n  const colorB = new THREE.Color(isPurpleTree ? \'#775cf6\' : \'#facc15\');\n\n  const foliageMaterial = new THREE.ShaderMaterial({\n    uniforms: {\n      uLeafTex: { value: leafMaskTexture },\n      uColorA: { value: colorA },\n      uColorB: { value: colorB },\n      uLeafScale: { value: 2.2 },\n      uAlphaThreshold: { value: 0.3 },\n      uLightDirection: windUniforms.uLightDirection,\n      uWindPhase: windUniforms.uWindPhase,\n      uWindDirection: windUniforms.uWindDirection,\n      uWindStrength: windUniforms.uWindStrength,\n      uWindGust: windUniforms.uWindGust,\n    },\n    vertexShader: /* glsl */ `\n      attribute vec3 aLeafCenter;\n      attribute vec3 aLeafLocalPos;\n      attribute float aLeafPlaneSeed;\n\n      uniform float uLeafScale;\n      uniform float uWindPhase;\n      uniform vec2 uWindDirection;\n      uniform float uWindStrength;\n      uniform float uWindGust;\n\n      varying vec2 vUv;\n      varying vec3 vSphereNormal;\n\n      // Exact billboard + wind sway vertex node from Li.prototype.initPositionNode (B1Nq4Kq6.js:436500)\n      void main() {\n        vUv = uv;\n        float angle = aLeafPlaneSeed * 6.2831853;\n        float s = sin(angle);\n        float c = cos(angle);\n        vec3 scaledLocal = aLeafLocalPos * uLeafScale;\n        float rotX = scaledLocal.x * c - scaledLocal.y * s;\n        float rotY = scaledLocal.x * s + scaledLocal.y * c;\n\n        mat4 mv = viewMatrix * modelMatrix * instanceMatrix;\n        vec3 camRight = normalize(vec3(mv[0][0], mv[1][0], mv[2][0]));\n        vec3 camUp = normalize(vec3(mv[0][1], mv[1][1], mv[2][1]));\n        vec3 camFwd = normalize(vec3(mv[0][2], mv[1][2], mv[2][2]));\n\n        float swayFactor = smoothstep(-0.75, 1.0, aLeafCenter.y);\n        float phase = uWindPhase + aLeafPlaneSeed * 6.2831853;\n        float sway = (sin(phase) * 0.46 + uWindGust * 0.28) * uWindStrength * swayFactor;\n        vec3 windDisp = vec3(uWindDirection.x * sway, sin(phase * 0.73) * 0.1 * uWindStrength * swayFactor, uWindDirection.y * sway);\n\n        vec3 localPos = aLeafCenter + camRight * rotX + camUp * rotY + camFwd * ((aLeafPlaneSeed - 0.5) * 0.02) + windDisp;\n        vSphereNormal = normalize(mat3(modelMatrix * instanceMatrix) * normalize(aLeafCenter + vec3(0.0, 0.35, 0.0)));\n\n        gl_Position = projectionMatrix * viewMatrix * modelMatrix * instanceMatrix * vec4(localPos, 1.0);\n      }\n    `,\n    fragmentShader: /* glsl */ `\n      uniform sampler2D uLeafTex;\n      uniform vec3 uColorA;\n      uniform vec3 uColorB;\n      uniform float uAlphaThreshold;\n      uniform vec3 uLightDirection;\n\n      varying vec2 vUv;\n      varying vec3 vSphereNormal;\n\n      float lyoHalftone(vec2 coord, float scale, float radius) {\n        float c = cos(0.785398);\n        float s = sin(0.785398);\n        vec2 rot = vec2(coord.x * c - coord.y * s, coord.x * s + coord.y * c) * scale;\n        float dist = length(fract(rot) - 0.5);\n        float r = radius * 0.7071;\n        return smoothstep(r - 0.08, r + 0.08, dist);\n      }\n\n      void main() {\n        float mask = texture2D(uLeafTex, vUv).r;\n        if (mask < uAlphaThreshold) discard;\n\n        float ndl = smoothstep(0.0, 1.0, dot(normalize(vSphereNormal), normalize(uLightDirection)));\n        vec3 baseCol = mix(uColorA, uColorB, ndl);\n\n        // Subtle halftone in lower canopy shadow matching WorldMaterial (Yn)\n        float shadowAmt = clamp(1.0 - ndl, 0.0, 1.0);\n        float dots = lyoHalftone(gl_FragCoord.xy * 0.0045, 18.0, shadowAmt * 0.55);\n        vec3 darkCanopy = uColorA * 0.58;\n        vec3 finalCol = mix(baseCol, darkCanopy, shadowAmt * (1.0 - dots * 0.45) * 0.55);\n\n        gl_FragColor = vec4(finalCol, 1.0);\n        #include <tonemapping_fragment>\n        #include <colorspace_fragment>\n      }\n    `,\n    side: THREE.DoubleSide,\n  });\n\n  const markers =\n    foliageMarkerMatrices.length > 0\n      ? foliageMarkerMatrices\n      : [new THREE.Matrix4().makeTranslation(0, 3.0, 0)];\n\n  const foliageInstanced = new THREE.InstancedMesh(\n    mergedClusterGeo,\n    foliageMaterial,\n    markers.length,\n  );\n  foliageInstanced.name = \'RealGlbTreeLeaves\';\n  foliageInstanced.frustumCulled = false;\n  foliageInstanced.castShadow = !isSoftwareGl;\n  foliageInstanced.receiveShadow = !isSoftwareGl;\n\n  markers.forEach((m, idx) => {\n    foliageInstanced.setMatrixAt(idx, m);\n  });\n  foliageInstanced.instanceMatrix.needsUpdate = true;\n  trunkGroup.add(foliageInstanced);\n}\n\n/**\n * Exact port of Lyo\'s Robot Model Assembly (B1Nq4Kq6.js:100500-103500 & tr track curve):\n * Populates a TankVehicle\'s bodyGroup, turretGroup, and barrelGroup with the REAL meshes\n * from /extracted_lyo_assets/models/player.glb + player-track.json!\n */\nexport function populateRealLyoTankFromGlb(\n  bodyGroup: THREE.Group,\n  turretGroup: THREE.Group,\n  barrelGroup: THREE.Group,\n  riderGroup: THREE.Group,\n  muzzleFlash: THREE.Mesh,\n  playerGltfScene: THREE.Group,\n  trackPoints: { x: number; y: number; z: number }[] | null,\n  windUniforms: LyoWindUniforms,\n  isSuper: boolean,\n  isSoftwareGl: boolean,\n) {\n  // Clear procedural placeholder meshes from bodyGroup, turretGroup, barrelGroup\n  for (let i = bodyGroup.children.length - 1; i >= 0; i--) {\n    const ch = bodyGroup.children[i];\n    if (ch !== turretGroup) bodyGroup.remove(ch);\n  }\n  for (let i = turretGroup.children.length - 1; i >= 0; i--) {\n    const ch = turretGroup.children[i];\n    if (ch !== barrelGroup && ch !== riderGroup) turretGroup.remove(ch);\n  }\n  for (let i = barrelGroup.children.length - 1; i >= 0; i--) {\n    const ch = barrelGroup.children[i];\n    if (ch !== muzzleFlash) barrelGroup.remove(ch);\n  }\n\n  const clonedRoot = playerGltfScene.clone(true);\n  clonedRoot.updateMatrixWorld(true);\n\n  const findByName = (names: string[]): THREE.Object3D | null => {\n    const keys = names.map((s) => s.toLowerCase().replace(/[^a-z0-9]/g, \'\'));\n    let found: THREE.Object3D | null = null;\n    clonedRoot.traverse((obj) => {\n      if (found || !obj.name) return;\n      const k = obj.name.toLowerCase().replace(/[^a-z0-9]/g, \'\');\n      if (keys.some((target) => k === target || k.startsWith(target))) {\n        found = obj;\n      }\n    });\n    return found;\n  };\n\n  const findPrefixList = (prefix: string): THREE.Mesh[] => {\n    const key = prefix.toLowerCase().replace(/[^a-z0-9]/g, \'\');\n    const list: THREE.Mesh[] = [];\n    clonedRoot.traverse((obj) => {\n      if ((obj as THREE.Mesh).isMesh && obj.name) {\n        const k = obj.name.toLowerCase().replace(/[^a-z0-9]/g, \'\');\n        if (k.startsWith(key)) list.push(obj as THREE.Mesh);\n      }\n    });\n    return list;\n  };\n\n  const glbBody = findByName([\'Player_Body\', \'playerbody\']);\n  const glbTurret = findByName([\'Player_Turret\', \'playerturret\']);\n  const glbBarrel = findByName([\'Player_Barrel\', \'playerbarrel\']);\n  const glbTrackSeg = findByName([\'Player_Track\', \'playertrack\']) as THREE.Mesh | null;\n\n  let bodyCenterZ = 0;\n  if (glbBody) {\n    const box = new THREE.Box3().setFromObject(glbBody);\n    const center = box.getCenter(new THREE.Vector3());\n    clonedRoot.worldToLocal(center);\n    bodyCenterZ = center.z;\n  }\n\n  // Helper from B1Nq4Kq6.js:initMirroredGeometry (flips Z and triangle winding)\n  const createMirroredGeometry = (geo: THREE.BufferGeometry) => {\n    const g = geo.clone();\n    g.scale(1, 1, -1);\n    if (g.index) {\n      const arr = g.index.array;\n      for (let i = 0; i < arr.length; i += 3) {\n        const tmp = arr[i];\n        arr[i] = arr[i + 1];\n        arr[i + 1] = tmp;\n      }\n      g.index.needsUpdate = true;\n    }\n    g.computeVertexNormals();\n    return g;\n  };\n\n  const tint = isSuper ? \'#00d2ff\' : undefined;\n  const tankScale = 1.15;\n\n  // 1. Reparent Player_Turret and Player_Barrel into turretGroup and barrelGroup BEFORE upgrading materials\n  // so Object3D.clone() never serializes ShaderMaterial uniforms via JSON.stringify(userData)\n  if (glbBarrel) {\n    const barrelMesh = glbBarrel.clone(false);\n    barrelMesh.position.set(0, 0, 0);\n    barrelMesh.rotation.set(0, 0, 0);\n    barrelMesh.scale.setScalar(tankScale);\n    barrelGroup.add(barrelMesh);\n    glbBarrel.visible = false;\n  }\n\n  if (glbTurret) {\n    const turretMesh = glbTurret.clone(false);\n    turretMesh.position.set(0, 0.15, 0);\n    turretMesh.rotation.set(0, 0, 0);\n    turretMesh.scale.setScalar(tankScale);\n    turretGroup.add(turretMesh);\n    glbTurret.visible = false;\n  }\n\n  // 2. Mirror Left_Wheel_01..04 and TrackCover_Left_01..03 onto the right side (exact B1Nq4Kq6.js logic)\n  const leftWheels = findPrefixList(\'Left_Wheel\');\n  leftWheels.forEach((wheel, idx) => {\n    wheel.updateMatrix();\n    const mirroredGeo = createMirroredGeometry(wheel.geometry);\n    const rightWheel = new THREE.Mesh(mirroredGeo, wheel.material);\n    rightWheel.name = `Right_Wheel_0${idx + 1}`;\n    rightWheel.position.copy(wheel.position);\n    rightWheel.position.z = 2 * bodyCenterZ - wheel.position.z;\n    rightWheel.quaternion.copy(wheel.quaternion);\n    rightWheel.scale.copy(wheel.scale);\n    (wheel.parent || clonedRoot).add(rightWheel);\n  });\n\n  const leftCovers = findPrefixList(\'TrackCover_Left\');\n  leftCovers.forEach((cover, idx) => {\n    cover.updateMatrix();\n    const mirroredGeo = createMirroredGeometry(cover.geometry);\n    const rightCover = new THREE.Mesh(mirroredGeo, cover.material);\n    rightCover.name = `TrackCover_Right_0${idx + 1}`;\n    rightCover.position.copy(cover.position);\n    rightCover.position.z = -cover.position.z;\n    rightCover.quaternion.copy(cover.quaternion);\n    rightCover.scale.copy(cover.scale);\n    (cover.parent || clonedRoot).add(rightCover);\n  });\n\n  // 3. Upgrade all visual meshes in clonedRoot, turretGroup, and barrelGroup with Lyo\'s WorldMaterial + Stroke Outline\n  const upgradeHierarchy = (rootObj: THREE.Object3D) => {\n    rootObj.traverse((obj) => {\n      if ((obj as THREE.Mesh).isMesh) {\n        const m = obj as THREE.Mesh;\n        if (m.userData.isModelStroke || m === muzzleFlash) return;\n        if (isLyoColliderOrHelperNode(m)) {\n          m.visible = false;\n          return;\n        }\n        m.castShadow = !isSoftwareGl;\n        m.receiveShadow = !isSoftwareGl;\n        upgradeMeshToLyoWorldMaterial(m, windUniforms, tint);\n        const stroke = createLyoStrokeMesh(m.geometry, 0.026);\n        if (stroke) m.add(stroke);\n      }\n    });\n  };\n  upgradeHierarchy(clonedRoot);\n  upgradeHierarchy(turretGroup);\n  upgradeHierarchy(barrelGroup);\n\n  // 4. Instance Player_Track along player-track.json CatmullRomCurve3 (14 segments per side)\n  if (glbTrackSeg && glbTrackSeg.geometry && trackPoints && trackPoints.length > 4) {\n    glbTrackSeg.visible = false;\n    const uniquePts = trackPoints.filter((pt, i) => {\n      if (i === 0) return true;\n      const prev = trackPoints[i - 1];\n      return !(pt.x === prev.x && pt.y === prev.y && pt.z === prev.z);\n    });\n    const leftPts = uniquePts.map((p) => new THREE.Vector3(p.x, p.y, p.z - 0.02));\n    const rightPts = uniquePts.map((p) => new THREE.Vector3(p.x, p.y, 2 * bodyCenterZ - p.z - 0.02));\n    const leftCurve = new THREE.CatmullRomCurve3(leftPts, true, \'centripetal\');\n    const rightCurve = new THREE.CatmullRomCurve3(rightPts, true, \'centripetal\');\n    const numSegments = 14;\n\n    const buildTrackBelt = (curve: THREE.CatmullRomCurve3, isRight: boolean) => {\n      const geo = isRight ? createMirroredGeometry(glbTrackSeg.geometry) : glbTrackSeg.geometry.clone();\n      const inst = new THREE.InstancedMesh(geo, glbTrackSeg.material, numSegments);\n      const dummy = new THREE.Object3D();\n      const frames = curve.computeFrenetFrames(numSegments, true);\n      for (let i = 0; i < numSegments; i++) {\n        const pt = curve.getPointAt(i / numSegments);\n        dummy.position.copy(pt);\n        const tangent = frames.tangents[i];\n        const normal = frames.normals[i];\n        const binormal = frames.binormals[i];\n        const m = new THREE.Matrix4().makeBasis(tangent, normal, binormal);\n        dummy.quaternion.setFromRotationMatrix(m);\n        dummy.rotateX(-Math.PI / 2);\n        dummy.rotateY(Math.PI);\n        dummy.updateMatrix();\n        inst.setMatrixAt(i, dummy.matrix);\n      }\n      inst.instanceMatrix.needsUpdate = true;\n      clonedRoot.add(inst);\n    };\n\n    buildTrackBelt(leftCurve, false);\n    buildTrackBelt(rightCurve, true);\n  }\n\n  clonedRoot.scale.setScalar(tankScale);\n\n  // Align chassis to ground (y = 0)\n  const hullBox = new THREE.Box3().setFromObject(clonedRoot);\n  clonedRoot.position.y = -hullBox.min.y;\n  bodyGroup.add(clonedRoot);\n}\n\nexport interface LoadedLyoAssets {\n  playerGltf: GLTF;\n  bossGltf: GLTF;\n  fodderGltf: GLTF;\n  tree1aGltf: GLTF;\n  tree1bGltf: GLTF;\n  hydrantGltf: GLTF | null;\n  explosiveBarrelGltf: GLTF | null;\n  powerCoreGltf: GLTF | null;\n  turbineGltf: GLTF | null;\n  woodenBoxGltf: GLTF | null;\n  metalBoxGltf: GLTF | null;\n  playerTrackPoints: { x: number; y: number; z: number }[] | null;\n  treeFoliageTex: THREE.Texture;\n}\n\n/**\n * Loads the real extracted .glb models and .ktx2 textures using GLTFLoader + DRACOLoader + KTX2Loader\n */\nexport async function loadAllRealLyoAssets(renderer: THREE.WebGLRenderer): Promise<LoadedLyoAssets> {\n  const manager = new THREE.LoadingManager();\n  manager.setURLModifier((url) => {\n    if (url.endsWith(\'game-texture.ktx2\')) {\n      return \'/extracted_lyo_assets/textures/game-texture.ktx2\';\n    }\n    return url;\n  });\n\n  const dracoLoader = new DRACOLoader(manager);\n  dracoLoader.setDecoderPath(\'/draco/\');\n  dracoLoader.preload();\n\n  const ktx2Loader = new KTX2Loader(manager);\n  ktx2Loader.setTranscoderPath(\'/basis/\');\n  ktx2Loader.detectSupport(renderer);\n\n  const gltfLoader = new GLTFLoader(manager);\n  gltfLoader.setDRACOLoader(dracoLoader);\n  gltfLoader.setKTX2Loader(ktx2Loader);\n\n  const loadGltf = (url: string): Promise<GLTF> =>\n    new Promise((resolve, reject) => {\n      gltfLoader.load(url, resolve, undefined, reject);\n    });\n\n  const loadOptionalGltf = (url: string): Promise<GLTF | null> =>\n    loadGltf(url).catch(() => null);\n\n  const loadFoliageTex = (): Promise<THREE.Texture> =>\n    new Promise((resolve) => {\n      ktx2Loader.load(\n        \'/extracted_lyo_assets/textures/tree-foliage.ktx2\',\n        (tex) => {\n          tex.wrapS = THREE.ClampToEdgeWrapping;\n          tex.wrapT = THREE.ClampToEdgeWrapping;\n          tex.minFilter = THREE.LinearFilter;\n          tex.magFilter = THREE.LinearFilter;\n          tex.generateMipmaps = false;\n          tex.needsUpdate = true;\n          resolve(tex);\n        },\n        undefined,\n        () => resolve(createFallbackFoliageMaskTexture()),\n      );\n    });\n\n  const [\n    playerGltf,\n    bossGltf,\n    fodderGltf,\n    tree1aGltf,\n    tree1bGltf,\n    hydrantGltf,\n    explosiveBarrelGltf,\n    powerCoreGltf,\n    turbineGltf,\n    woodenBoxGltf,\n    metalBoxGltf,\n    playerTrackPoints,\n    treeFoliageTex,\n  ] = await Promise.all([\n    loadGltf(\'/extracted_lyo_assets/models/player.glb\'),\n    loadGltf(\'/extracted_lyo_assets/models/boss.glb\'),\n    loadGltf(\'/extracted_lyo_assets/models/fodder.glb\'),\n    loadGltf(\'/extracted_lyo_assets/models/tree-1a.glb\'),\n    loadGltf(\'/extracted_lyo_assets/models/tree-1b.glb\'),\n    loadOptionalGltf(\'/extracted_lyo_assets/models/hydrant.glb\'),\n    loadOptionalGltf(\'/extracted_lyo_assets/models/explosive-barrel.glb\'),\n    loadOptionalGltf(\'/extracted_lyo_assets/models/power-core.glb\'),\n    loadOptionalGltf(\'/extracted_lyo_assets/models/turbine.glb\'),\n    loadOptionalGltf(\'/extracted_lyo_assets/models/wooden-box.glb\'),\n    loadOptionalGltf(\'/extracted_lyo_assets/models/metal-box-1a.glb\'),\n    fetch(\'/extracted_lyo_assets/models/player-track.json\')\n      .then((r) => (r.ok ? r.json() : null))\n      .catch(() => null),\n    loadFoliageTex(),\n  ]);\n\n  return {\n    playerGltf,\n    bossGltf,\n    fodderGltf,\n    tree1aGltf,\n    tree1bGltf,\n    hydrantGltf,\n    explosiveBarrelGltf,\n    powerCoreGltf,\n    turbineGltf,\n    woodenBoxGltf,\n    metalBoxGltf,\n    playerTrackPoints,\n    treeFoliageTex,\n  };\n}"
        replacement_content: "export function populateRealLyoTreeFromGlb(\n  targetGroup: THREE.Group,\n  treeGltfScene: THREE.Group,\n  isPurpleTree: boolean,\n  leafMaskTexture: THREE.Texture,\n  windUniforms: LyoWindUniforms,\n  isSoftwareGl: boolean,\n  userScale = 1.0,\n) {\n  // Remove placeholder primitives inside targetGroup except the contact shadow disc\n  for (let i = targetGroup.children.length - 1; i >= 0; i--) {\n    const ch = targetGroup.children[i];\n    if (ch.name !== \'ContactShadowDisc\') {\n      targetGroup.remove(ch);\n    } else {\n      ch.scale.setScalar(2.35 * userScale);\n    }\n  }\n\n  treeGltfScene.updateMatrixWorld(true);\n\n  // Locate ONLY the single reference tree root (Tree_1B.REF / Tree_1B_REF or Tree_1A.REF / Tree_1A_REF)\n  let refRoot: THREE.Object3D | null = null;\n  treeGltfScene.traverse((obj) => {\n    const n = (obj.name || \'\').toLowerCase();\n    if (!refRoot && (n.endsWith(\'.ref\') || n.endsWith(\'_ref\'))) {\n      refRoot = obj;\n    }\n  });\n  const sourceRoot = (refRoot || treeGltfScene.children[0] || treeGltfScene) as THREE.Object3D;\n\n  const trunkGroup = new THREE.Group();\n  trunkGroup.name = \'RealGlbTreeTrunk\';\n  const baseRefScale = sourceRoot.scale.x > 0.01 ? sourceRoot.scale.x : 0.4362676;\n  // Scale default Lyo trees to ~9.0 units tall (8-10 units, towering over the 2-unit Buddy character)\n  const refScale = baseRefScale * 2.08 * userScale;\n\n  // 1. Clone ONLY the reference trunk mesh itself (sourceRoot is a Mesh in tree-1b.glb / tree-1a.glb)\n  if ((sourceRoot as THREE.Mesh).isMesh) {\n    const srcTrunk = sourceRoot as THREE.Mesh;\n    const trunkMesh = new THREE.Mesh(srcTrunk.geometry, srcTrunk.material);\n    trunkMesh.name = srcTrunk.name;\n    trunkMesh.scale.setScalar(refScale);\n    trunkMesh.castShadow = !isSoftwareGl;\n    trunkMesh.receiveShadow = !isSoftwareGl;\n    upgradeMeshToLyoWorldMaterial(trunkMesh, windUniforms);\n    const stroke = createLyoStrokeMesh(trunkMesh.geometry, 0.042);\n    if (stroke) trunkMesh.add(stroke);\n    trunkGroup.add(trunkMesh);\n  }\n\n  // 2. Collect the Tree_Foliage.* cluster marker transforms from sourceRoot\'s direct children\n  const foliageMarkerMatrices: THREE.Matrix4[] = [];\n  sourceRoot.children.forEach((child) => {\n    const lower = (child.name || \'\').toLowerCase();\n    if (lower.startsWith(\'tree_foliage\') || lower.includes(\'foliage\')) {\n      const m = new THREE.Matrix4();\n      const pos = child.position.clone().multiplyScalar(refScale);\n      const scl = child.scale.clone().multiplyScalar(refScale * 1.15);\n      m.compose(pos, child.quaternion, scl);\n      foliageMarkerMatrices.push(m);\n    }\n  });\n\n  // Ground trunk cleanly at y = 0\n  const box = new THREE.Box3().setFromObject(trunkGroup);\n  if (!box.isEmpty()) {\n    trunkGroup.position.y = -box.min.y;\n  }\n  targetGroup.add(trunkGroup);\n\n  // 3. Build exact Lyo TreeLeaves geometry (planesPerCluster = 80, planeSize = 0.85, normalLerp = 0.85)\n  const planesPerCluster = isSoftwareGl ? 64 : 84;\n  const planeSize = 0.86;\n  const normalLerp = 0.85;\n  let randomSeed = 1431691;\n  const getRandom = () => {\n    randomSeed = (randomSeed * 1664525 + 1013904223) >>> 0;\n    return randomSeed / 4294967296;\n  };\n\n  const clusterGeos: THREE.BufferGeometry[] = [];\n  const leafCenters = new Float32Array(planesPerCluster * 4 * 3);\n  const leafLocalPos = new Float32Array(planesPerCluster * 4 * 3);\n  const leafPlaneSeed = new Float32Array(planesPerCluster * 4);\n\n  for (let a = 0; a < planesPerCluster; a++) {\n    const plane = new THREE.PlaneGeometry(planeSize, planeSize);\n    const seed = getRandom();\n    const radius = 1 - Math.pow(getRandom(), 3);\n    const phi = Math.PI * 2 * getRandom();\n    const theta = Math.PI * getRandom();\n    const sph = new THREE.Spherical(radius, theta, phi);\n    const center = new THREE.Vector3().setFromSpherical(sph);\n    const radialNormal = center.clone().normalize();\n\n    const posAttr = plane.attributes.position;\n    const normAttr = plane.attributes.normal;\n    for (let v = 0; v < 4; v++) {\n      const vertIdx = a * 4 + v;\n      const s3 = v * 3;\n      const f3 = vertIdx * 3;\n      const p = new THREE.Vector3(posAttr.array[s3], posAttr.array[s3 + 1], posAttr.array[s3 + 2]);\n      leafCenters[f3] = center.x;\n      leafCenters[f3 + 1] = center.y;\n      leafCenters[f3 + 2] = center.z;\n      leafLocalPos[f3] = p.x;\n      leafLocalPos[f3 + 1] = p.y;\n      leafLocalPos[f3 + 2] = p.z;\n      leafPlaneSeed[vertIdx] = seed;\n\n      const blendedNormal = p.clone().lerp(radialNormal, normalLerp).normalize();\n      normAttr.array[s3] = blendedNormal.x;\n      normAttr.array[s3 + 1] = blendedNormal.y;\n      normAttr.array[s3 + 2] = blendedNormal.z;\n    }\n    clusterGeos.push(plane);\n  }\n\n  const mergedClusterGeo = mergeGeometries(clusterGeos, false);\n  clusterGeos.forEach((g) => g.dispose());\n  mergedClusterGeo.setAttribute(\'aLeafCenter\', new THREE.BufferAttribute(leafCenters, 3));\n  mergedClusterGeo.setAttribute(\'aLeafLocalPos\', new THREE.BufferAttribute(leafLocalPos, 3));\n  mergedClusterGeo.setAttribute(\'aLeafPlaneSeed\', new THREE.BufferAttribute(leafPlaneSeed, 1));\n\n  // Exact colors from Ri.prototype.instanceObjectOverrides (B1Nq4Kq6.js:442500):\n  // Tree_1B: colorA = \'#5e57a5\', colorB = \'#775cf6\', leafScale = 2.45\n  // Tree_1A: colorA = \'#eab308\', colorB = \'#facc15\', leafScale = 2.45\n  const colorA = new THREE.Color(isPurpleTree ? \'#5e57a5\' : \'#eab308\');\n  const colorB = new THREE.Color(isPurpleTree ? \'#775cf6\' : \'#facc15\');\n\n  const foliageMaterial = new THREE.ShaderMaterial({\n    uniforms: {\n      uLeafTex: { value: leafMaskTexture },\n      uColorA: { value: colorA },\n      uColorB: { value: colorB },\n      uLeafScale: { value: 2.45 },\n      uAlphaThreshold: { value: 0.28 },\n      uLightDirection: windUniforms.uLightDirection,\n      uWindPhase: windUniforms.uWindPhase,\n      uWindDirection: windUniforms.uWindDirection,\n      uWindStrength: windUniforms.uWindStrength,\n      uWindGust: windUniforms.uWindGust,\n    },\n    vertexShader: /* glsl */ `\n      attribute vec3 aLeafCenter;\n      attribute vec3 aLeafLocalPos;\n      attribute float aLeafPlaneSeed;\n\n      uniform float uLeafScale;\n      uniform float uWindPhase;\n      uniform vec2 uWindDirection;\n      uniform float uWindStrength;\n      uniform float uWindGust;\n\n      varying vec2 vUv;\n      varying vec3 vSphereNormal;\n\n      // Exact billboard + wind sway vertex node from Li.prototype.initPositionNode (B1Nq4Kq6.js:436500)\n      void main() {\n        vUv = uv;\n        float angle = aLeafPlaneSeed * 6.2831853;\n        float s = sin(angle);\n        float c = cos(angle);\n        vec3 scaledLocal = aLeafLocalPos * uLeafScale;\n        float rotX = scaledLocal.x * c - scaledLocal.y * s;\n        float rotY = scaledLocal.x * s + scaledLocal.y * c;\n\n        mat4 mv = viewMatrix * modelMatrix * instanceMatrix;\n        vec3 camRight = normalize(vec3(mv[0][0], mv[1][0], mv[2][0]));\n        vec3 camUp = normalize(vec3(mv[0][1], mv[1][1], mv[2][1]));\n        vec3 camFwd = normalize(vec3(mv[0][2], mv[1][2], mv[2][2]));\n\n        float swayFactor = smoothstep(-0.75, 1.0, aLeafCenter.y);\n        float phase = uWindPhase + aLeafPlaneSeed * 6.2831853;\n        float sway = (sin(phase) * 0.46 + uWindGust * 0.28) * uWindStrength * swayFactor;\n        vec3 windDisp = vec3(uWindDirection.x * sway, sin(phase * 0.73) * 0.1 * uWindStrength * swayFactor, uWindDirection.y * sway);\n\n        vec3 localPos = aLeafCenter + camRight * rotX + camUp * rotY + camFwd * ((aLeafPlaneSeed - 0.5) * 0.02) + windDisp;\n        vSphereNormal = normalize(mat3(modelMatrix * instanceMatrix) * normalize(aLeafCenter + vec3(0.0, 0.35, 0.0)));\n\n        gl_Position = projectionMatrix * viewMatrix * modelMatrix * instanceMatrix * vec4(localPos, 1.0);\n      }\n    `,\n    fragmentShader: /* glsl */ `\n      uniform sampler2D uLeafTex;\n      uniform vec3 uColorA;\n      uniform vec3 uColorB;\n      uniform float uAlphaThreshold;\n      uniform vec3 uLightDirection;\n\n      varying vec2 vUv;\n      varying vec3 vSphereNormal;\n\n      float lyoHalftone(vec2 coord, float scale, float radius) {\n        float c = cos(0.785398);\n        float s = sin(0.785398);\n        vec2 rot = vec2(coord.x * c - coord.y * s, coord.x * s + coord.y * c) * scale;\n        float dist = length(fract(rot) - 0.5);\n        float r = radius * 0.7071;\n        return smoothstep(r - 0.08, r + 0.08, dist);\n      }\n\n      void main() {\n        float mask = texture2D(uLeafTex, vUv).r;\n        if (mask < uAlphaThreshold) discard;\n\n        float ndl = smoothstep(0.0, 1.0, dot(normalize(vSphereNormal), normalize(uLightDirection)));\n        vec3 baseCol = mix(uColorA, uColorB, ndl);\n\n        // Subtle halftone in lower canopy shadow matching WorldMaterial (Yn)\n        float shadowAmt = clamp(1.0 - ndl, 0.0, 1.0);\n        float dots = lyoHalftone(gl_FragCoord.xy * 0.0045, 18.0, shadowAmt * 0.55);\n        vec3 darkCanopy = uColorA * 0.58;\n        vec3 finalCol = mix(baseCol, darkCanopy, shadowAmt * (1.0 - dots * 0.45) * 0.55);\n\n        gl_FragColor = vec4(finalCol, 1.0);\n        #include <tonemapping_fragment>\n        #include <colorspace_fragment>\n      }\n    `,\n    side: THREE.DoubleSide,\n  });\n\n  const markers =\n    foliageMarkerMatrices.length > 0\n      ? foliageMarkerMatrices\n      : [new THREE.Matrix4().makeTranslation(0, 6.0, 0)];\n\n  const foliageInstanced = new THREE.InstancedMesh(\n    mergedClusterGeo,\n    foliageMaterial,\n    markers.length,\n  );\n  foliageInstanced.name = \'RealGlbTreeLeaves\';\n  foliageInstanced.frustumCulled = false;\n  foliageInstanced.castShadow = !isSoftwareGl;\n  foliageInstanced.receiveShadow = !isSoftwareGl;\n\n  markers.forEach((m, idx) => {\n    foliageInstanced.setMatrixAt(idx, m);\n  });\n  foliageInstanced.instanceMatrix.needsUpdate = true;\n  trunkGroup.add(foliageInstanced);\n}\n\n/**\n * Exact port of Lyo\'s Robot Model Assembly (B1Nq4Kq6.js:100500-103500 & tr track curve):\n * Populates a TankVehicle\'s bodyGroup, turretGroup, and barrelGroup with the REAL meshes\n * from /extracted_lyo_assets/models/player.glb + player-track.json!\n */\nexport function populateRealLyoTankFromGlb(\n  bodyGroup: THREE.Group,\n  turretGroup: THREE.Group,\n  barrelGroup: THREE.Group,\n  riderGroup: THREE.Group,\n  muzzleFlash: THREE.Mesh,\n  playerGltfScene: THREE.Group,\n  trackPoints: { x: number; y: number; z: number }[] | null,\n  windUniforms: LyoWindUniforms,\n  isSuper: boolean,\n  isSoftwareGl: boolean,\n) {\n  // Clear procedural placeholder meshes from bodyGroup, turretGroup, barrelGroup\n  for (let i = bodyGroup.children.length - 1; i >= 0; i--) {\n    const ch = bodyGroup.children[i];\n    if (ch !== turretGroup) bodyGroup.remove(ch);\n  }\n  for (let i = turretGroup.children.length - 1; i >= 0; i--) {\n    const ch = turretGroup.children[i];\n    if (ch !== barrelGroup && ch !== riderGroup) turretGroup.remove(ch);\n  }\n  for (let i = barrelGroup.children.length - 1; i >= 0; i--) {\n    const ch = barrelGroup.children[i];\n    if (ch !== muzzleFlash) barrelGroup.remove(ch);\n  }\n\n  const clonedRoot = playerGltfScene.clone(true);\n  clonedRoot.updateMatrixWorld(true);\n\n  const findByName = (names: string[]): THREE.Object3D | null => {\n    const keys = names.map((s) => s.toLowerCase().replace(/[^a-z0-9]/g, \'\'));\n    let found: THREE.Object3D | null = null;\n    clonedRoot.traverse((obj) => {\n      if (found || !obj.name) return;\n      const k = obj.name.toLowerCase().replace(/[^a-z0-9]/g, \'\');\n      if (keys.some((target) => k === target || k.startsWith(target))) {\n        found = obj;\n      }\n    });\n    return found;\n  };\n\n  const findPrefixList = (prefix: string): THREE.Mesh[] => {\n    const key = prefix.toLowerCase().replace(/[^a-z0-9]/g, \'\');\n    const list: THREE.Mesh[] = [];\n    clonedRoot.traverse((obj) => {\n      if ((obj as THREE.Mesh).isMesh && obj.name) {\n        const k = obj.name.toLowerCase().replace(/[^a-z0-9]/g, \'\');\n        if (k.startsWith(key)) list.push(obj as THREE.Mesh);\n      }\n    });\n    return list;\n  };\n\n  const glbBody = findByName([\'Player_Body\', \'playerbody\']);\n  const glbTurret = findByName([\'Player_Turret\', \'playerturret\']);\n  const glbBarrel = findByName([\'Player_Barrel\', \'playerbarrel\']);\n  const glbTrackSeg = findByName([\'Player_Track\', \'playertrack\']) as THREE.Mesh | null;\n\n  let bodyCenterZ = 0;\n  if (glbBody) {\n    const box = new THREE.Box3().setFromObject(glbBody);\n    const center = box.getCenter(new THREE.Vector3());\n    clonedRoot.worldToLocal(center);\n    bodyCenterZ = center.z;\n  }\n\n  // Helper from B1Nq4Kq6.js:initMirroredGeometry (flips Z and triangle winding)\n  const createMirroredGeometry = (geo: THREE.BufferGeometry) => {\n    const g = geo.clone();\n    g.scale(1, 1, -1);\n    if (g.index) {\n      const arr = g.index.array;\n      for (let i = 0; i < arr.length; i += 3) {\n        const tmp = arr[i];\n        arr[i] = arr[i + 1];\n        arr[i + 1] = tmp;\n      }\n      g.index.needsUpdate = true;\n    }\n    g.computeVertexNormals();\n    return g;\n  };\n\n  const tint = isSuper ? \'#00d2ff\' : undefined;\n  const tankScale = 1.15;\n\n  // 1. Reparent Player_Turret and Player_Barrel into turretGroup and barrelGroup BEFORE upgrading materials\n  // so Object3D.clone() never serializes ShaderMaterial uniforms via JSON.stringify(userData)\n  if (glbBarrel) {\n    const barrelMesh = glbBarrel.clone(false);\n    barrelMesh.position.set(0, 0, 0);\n    barrelMesh.rotation.set(0, 0, 0);\n    barrelMesh.scale.setScalar(tankScale);\n    barrelGroup.add(barrelMesh);\n    glbBarrel.visible = false;\n  }\n\n  if (glbTurret) {\n    const turretMesh = glbTurret.clone(false);\n    turretMesh.position.set(0, 0.15, 0);\n    turretMesh.rotation.set(0, 0, 0);\n    turretMesh.scale.setScalar(tankScale);\n    turretGroup.add(turretMesh);\n    glbTurret.visible = false;\n  }\n\n  // 2. Mirror Left_Wheel_01..04 and TrackCover_Left_01..03 onto the right side (exact B1Nq4Kq6.js logic)\n  const leftWheels = findPrefixList(\'Left_Wheel\');\n  leftWheels.forEach((wheel, idx) => {\n    wheel.updateMatrix();\n    const mirroredGeo = createMirroredGeometry(wheel.geometry);\n    const rightWheel = new THREE.Mesh(mirroredGeo, wheel.material);\n    rightWheel.name = `Right_Wheel_0${idx + 1}`;\n    rightWheel.position.copy(wheel.position);\n    rightWheel.position.z = 2 * bodyCenterZ - wheel.position.z;\n    rightWheel.quaternion.copy(wheel.quaternion);\n    rightWheel.scale.copy(wheel.scale);\n    (wheel.parent || clonedRoot).add(rightWheel);\n  });\n\n  const leftCovers = findPrefixList(\'TrackCover_Left\');\n  leftCovers.forEach((cover, idx) => {\n    cover.updateMatrix();\n    const mirroredGeo = createMirroredGeometry(cover.geometry);\n    const rightCover = new THREE.Mesh(mirroredGeo, cover.material);\n    rightCover.name = `TrackCover_Right_0${idx + 1}`;\n    rightCover.position.copy(cover.position);\n    rightCover.position.z = -cover.position.z;\n    rightCover.quaternion.copy(cover.quaternion);\n    rightCover.scale.copy(cover.scale);\n    (cover.parent || clonedRoot).add(rightCover);\n  });\n\n  // 3. Upgrade all visual meshes in clonedRoot, turretGroup, and barrelGroup with Lyo\'s WorldMaterial + Stroke Outline\n  const upgradeHierarchy = (rootObj: THREE.Object3D) => {\n    rootObj.traverse((obj) => {\n      if ((obj as THREE.Mesh).isMesh) {\n        const m = obj as THREE.Mesh;\n        if (m.userData.isModelStroke || m === muzzleFlash) return;\n        if (isLyoColliderOrHelperNode(m)) {\n          m.visible = false;\n          return;\n        }\n        m.castShadow = !isSoftwareGl;\n        m.receiveShadow = !isSoftwareGl;\n        upgradeMeshToLyoWorldMaterial(m, windUniforms, tint);\n        const stroke = createLyoStrokeMesh(m.geometry, 0.026);\n        if (stroke) m.add(stroke);\n      }\n    });\n  };\n  upgradeHierarchy(clonedRoot);\n  upgradeHierarchy(turretGroup);\n  upgradeHierarchy(barrelGroup);\n\n  // 4. Instance Player_Track along player-track.json CatmullRomCurve3 (14 segments per side)\n  if (glbTrackSeg && glbTrackSeg.geometry && trackPoints && trackPoints.length > 4) {\n    glbTrackSeg.visible = false;\n    const uniquePts = trackPoints.filter((pt, i) => {\n      if (i === 0) return true;\n      const prev = trackPoints[i - 1];\n      return !(pt.x === prev.x && pt.y === prev.y && pt.z === prev.z);\n    });\n    const leftPts = uniquePts.map((p) => new THREE.Vector3(p.x, p.y, p.z - 0.02));\n    const rightPts = uniquePts.map((p) => new THREE.Vector3(p.x, p.y, 2 * bodyCenterZ - p.z - 0.02));\n    const leftCurve = new THREE.CatmullRomCurve3(leftPts, true, \'centripetal\');\n    const rightCurve = new THREE.CatmullRomCurve3(rightPts, true, \'centripetal\');\n    const numSegments = 14;\n\n    const buildTrackBelt = (curve: THREE.CatmullRomCurve3, isRight: boolean) => {\n      const geo = isRight ? createMirroredGeometry(glbTrackSeg.geometry) : glbTrackSeg.geometry.clone();\n      const inst = new THREE.InstancedMesh(geo, glbTrackSeg.material, numSegments);\n      const dummy = new THREE.Object3D();\n      const frames = curve.computeFrenetFrames(numSegments, true);\n      for (let i = 0; i < numSegments; i++) {\n        const pt = curve.getPointAt(i / numSegments);\n        dummy.position.copy(pt);\n        const tangent = frames.tangents[i];\n        const normal = frames.normals[i];\n        const binormal = frames.binormals[i];\n        const m = new THREE.Matrix4().makeBasis(tangent, normal, binormal);\n        dummy.quaternion.setFromRotationMatrix(m);\n        dummy.rotateX(-Math.PI / 2);\n        dummy.rotateY(Math.PI);\n        dummy.updateMatrix();\n        inst.setMatrixAt(i, dummy.matrix);\n      }\n      inst.instanceMatrix.needsUpdate = true;\n      clonedRoot.add(inst);\n    };\n\n    buildTrackBelt(leftCurve, false);\n    buildTrackBelt(rightCurve, true);\n  }\n\n  clonedRoot.scale.setScalar(tankScale);\n\n  // Align chassis to ground (y = 0)\n  const hullBox = new THREE.Box3().setFromObject(clonedRoot);\n  clonedRoot.position.y = -hullBox.min.y;\n  bodyGroup.add(clonedRoot);\n}\n\nexport interface LoadedLyoAssets {\n  playerGltf: GLTF;\n  bossGltf: GLTF;\n  fodderGltf: GLTF;\n  tree1aGltf: GLTF;\n  tree1bGltf: GLTF;\n  hydrantGltf: GLTF | null;\n  explosiveBarrelGltf: GLTF | null;\n  powerCoreGltf: GLTF | null;\n  turbineGltf: GLTF | null;\n  concreteFenceGltf: GLTF | null;\n  barricadeGltf: GLTF | null;\n  woodenBoxGltf: GLTF | null;\n  metalBoxGltf: GLTF | null;\n  playerTrackPoints: { x: number; y: number; z: number }[] | null;\n  treeFoliageTex: THREE.Texture;\n}\n\n/**\n * Loads the real extracted .glb models and .ktx2 textures using GLTFLoader + DRACOLoader + KTX2Loader\n */\nexport async function loadAllRealLyoAssets(renderer: THREE.WebGLRenderer): Promise<LoadedLyoAssets> {\n  const manager = new THREE.LoadingManager();\n  manager.setURLModifier((url) => {\n    if (url.endsWith(\'game-texture.ktx2\')) {\n      return \'/extracted_lyo_assets/textures/game-texture.ktx2\';\n    }\n    return url;\n  });\n\n  const dracoLoader = new DRACOLoader(manager);\n  dracoLoader.setDecoderPath(\'/draco/\');\n  dracoLoader.preload();\n\n  const ktx2Loader = new KTX2Loader(manager);\n  ktx2Loader.setTranscoderPath(\'/basis/\');\n  ktx2Loader.detectSupport(renderer);\n\n  const gltfLoader = new GLTFLoader(manager);\n  gltfLoader.setDRACOLoader(dracoLoader);\n  gltfLoader.setKTX2Loader(ktx2Loader);\n\n  const loadGltf = (url: string): Promise<GLTF> =>\n    new Promise((resolve, reject) => {\n      gltfLoader.load(url, resolve, undefined, reject);\n    });\n\n  const loadOptionalGltf = (url: string): Promise<GLTF | null> =>\n    loadGltf(url).catch(() => null);\n\n  const loadFoliageTex = (): Promise<THREE.Texture> =>\n    new Promise((resolve) => {\n      ktx2Loader.load(\n        \'/extracted_lyo_assets/textures/tree-foliage.ktx2\',\n        (tex) => {\n          tex.wrapS = THREE.ClampToEdgeWrapping;\n          tex.wrapT = THREE.ClampToEdgeWrapping;\n          tex.minFilter = THREE.LinearFilter;\n          tex.magFilter = THREE.LinearFilter;\n          tex.generateMipmaps = false;\n          tex.needsUpdate = true;\n          resolve(tex);\n        },\n        undefined,\n        () => resolve(createFallbackFoliageMaskTexture()),\n      );\n    });\n\n  const [\n    playerGltf,\n    bossGltf,\n    fodderGltf,\n    tree1aGltf,\n    tree1bGltf,\n    hydrantGltf,\n    explosiveBarrelGltf,\n    powerCoreGltf,\n    turbineGltf,\n    concreteFenceGltf,\n    barricadeGltf,\n    woodenBoxGltf,\n    metalBoxGltf,\n    playerTrackPoints,\n    treeFoliageTex,\n  ] = await Promise.all([\n    loadGltf(\'/extracted_lyo_assets/models/player.glb\'),\n    loadGltf(\'/extracted_lyo_assets/models/boss.glb\'),\n    loadGltf(\'/extracted_lyo_assets/models/fodder.glb\'),\n    loadGltf(\'/extracted_lyo_assets/models/tree-1a.glb\'),\n    loadGltf(\'/extracted_lyo_assets/models/tree-1b.glb\'),\n    loadOptionalGltf(\'/extracted_lyo_assets/models/hydrant.glb\'),\n    loadOptionalGltf(\'/extracted_lyo_assets/models/explosive-barrel.glb\'),\n    loadOptionalGltf(\'/extracted_lyo_assets/models/power-core.glb\'),\n    loadOptionalGltf(\'/extracted_lyo_assets/models/turbine.glb\'),\n    loadOptionalGltf(\'/extracted_lyo_assets/models/concrete-fence-1a.glb\'),\n    loadOptionalGltf(\'/extracted_lyo_assets/models/barricade-1a.glb\'),\n    loadOptionalGltf(\'/extracted_lyo_assets/models/wooden-box.glb\'),\n    loadOptionalGltf(\'/extracted_lyo_assets/models/metal-box-1a.glb\'),\n    fetch(\'/extracted_lyo_assets/models/player-track.json\')\n      .then((r) => (r.ok ? r.json() : null))\n      .catch(() => null),\n    loadFoliageTex(),\n  ]);\n\n  return {\n    playerGltf,\n    bossGltf,\n    fodderGltf,\n    tree1a