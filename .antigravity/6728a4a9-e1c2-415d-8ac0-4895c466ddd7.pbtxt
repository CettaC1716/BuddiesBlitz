            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local function spawnPowerUpDrop(pos: Vector3, forcedType: string?)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal pType = forcedType or POWERUP_TYPES[math.random(1, #POWERUP_TYPES)]"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal orb = Instance.new(\"Part\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\torb.Name = \"PowerUp_\" .. pType"
