            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "-- Terapkan Outline Hitam & Cincin Indikator Warna Tim pada Avatar Pemain"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "local function styleCharacter(char: Model)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal hum = char:WaitForChild(\"Humanoid\", 5) :: Humanoid?"
