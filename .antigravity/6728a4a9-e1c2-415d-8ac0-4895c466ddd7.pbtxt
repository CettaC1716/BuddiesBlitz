    content: "  if (totalCrates === 8) {\n    return {\n      totalCrates,\n      redCount,\n      superCount,\n      isMerged,\n      isSuper,\n      shapeKey: \'2x2x2\',\n      category: \'vehicle\',\n      outputName: isSuper ? \'Tyrant Tank\' : \'Lyo Tank\',\n      spawnType: \'tank\',\n    };\n  }\n\n  if (totalCrates >= 4) {\n    const isVerticalWall = topCount >= 2;\n    if (isVerticalWall) {\n      return {\n        totalCrates,\n        redCount,\n        superCount,\n        isMerged,\n        isSuper,\n        shapeKey: \'2x1x2\',\n        category: \'buddy_t2\',\n        outputName: isSuper ? \'Super Buddie\' : \'Commando / Cyborg\',\n        spawnType: \'buddy\',\n      };\n    }\n    return {\n      totalCrates,\n      redCount,\n      superCount,\n      isMerged,\n      isSuper,\n      shapeKey: \'2x2x1\',\n      category: \'heavy_weapon\',\n      outputName: isSuper ? \'Supazooka\' : \'Bazooka\',\n      spawnType: \'weapon\',\n    };\n  }\n\n  if (totalCrates >= 2) {\n    const isVerticalColumn = topCount >= 1;\n    if (isVerticalColumn) {\n      return {\n        totalCrates,\n        redCount,\n        superCount,\n        isMerged,\n        isSuper,\n        shapeKey: \'1x1x2\',\n        category: \'buddy_t1\',\n        outputName: isSuper ? \'Stealthy / Ninja\' : \'Infuntry / Ninja\',\n        spawnType: \'buddy\',\n      };\n    }\n    return {\n      totalCrates,\n      redCount,\n      superCount,\n      isMerged,\n      isSuper,\n      shapeKey: \'2x1x1\',\n      category: \'grenade\',\n      outputName: isSuper ? \'Cluster Bomb\' : \'Hand Grenade\',\n      spawnType: \'grenade\',\n    };\n  }\n\n  return {\n    totalCrates: 1,\n    redCount,\n    superCount,\n    isMerged: false,\n    isSuper,\n    shapeKey: \'1x1x1\',\n    category: \'lite_weapon\',\n    outputName: isSuper ? \'Laser Rifle\' : \'Ice Gun / Uzi\',\n    spawnType: \'weapon\',\n  };\n}\n\n"
