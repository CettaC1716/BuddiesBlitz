              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function stepCriticalDampedSpring3D("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  current: Vec3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  target: Vec3,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
