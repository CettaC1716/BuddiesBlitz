            lines {
              text: "\tlocal canopy = makePart(\"Canopy\", Vector3.new(9.5, 8.5, 9.5), PaletteLyo.TreeCanopy, tPos + Vector3.new(0, 10, 0), treeModel, true)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tcanopy.Shape = Enum.PartType.Ball"
