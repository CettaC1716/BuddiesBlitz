    command_line: "node -e \'\nconst fs = require(\"fs\");\nfor (const file of [\"tree-1b.glb\", \"tree-1a.glb\", \"turbine.glb\", \"power-core.glb\", \"hydrant.glb\", \"player.glb\"]) {\n  const buf = fs.readFileSync(\"extracted_lyo_assets/models/\" + file);\n  const jsonLen = buf.readUInt32LE(12);\n  const json = JSON.parse(buf.slice(20, 20 + jsonLen).toString(\"utf8\"));\n  console.log(\"=== \" + file + \" ===\");\n  (json.nodes || []).slice(0, 35).forEach((n, i) => {\n    console.log(i, n.name, \"mesh:\", n.mesh, \"children:\", n.children, \"trans:\", n.translation, \"scale:\", n.scale);\n  });\n}\n\'"
    proposed_command_line: "node -e \'\nconst fs = require(\"fs\");\nfor (const file of [\"tree-1b.glb\", \"tree-1a.glb\", \"turbine.glb\", \"power-core.glb\", \"hydrant.glb\", \"player.glb\"]) {\n  const buf = fs.readFileSync(\"extracted_lyo_assets/models/\" + file);\n  const jsonLen = buf.readUInt32LE(12);\n  const json = JSON.parse(buf.slice(20, 20 + jsonLen).toString(\"utf8\"));\n  console.log(\"=== \" + file + \" ===\");\n  (json.nodes || []).slice(0, 35).forEach((n, i) => {\n    console.log(i, n.name, \"mesh:\", n.mesh, \"children:\", n.children, \"trans:\", n.translation, \"scale:\", n.scale);\n  });\n}\n\'"
