            lines {
              text: "      val += noise2D(tx * 2, ty * 2) * 0.25;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      val += noise2D(tx * 4, ty * 4) * 0.125;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const byteVal = Math.floor((val / 0.875) * 255);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
