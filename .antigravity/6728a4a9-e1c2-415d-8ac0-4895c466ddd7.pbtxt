          replacement_content: "    // Part 8: Rotating Turret Group + Open-Top Tank Rider Chibi Avatar\n    const tankTurretGroup = new THREE.Group();\n    tankTurretGroup.position.set(-0.05, 1.15, 0);\n    tankBodyGroup.add(tankTurretGroup);\n\n    addOutlinedPart(tankTurretGroup, new THREE.BoxGeometry(1.32, 0.58, 1.24), matTankLime, [0, 0.25, 0]);\n    // Part 9: Open-Top Hatch Rim + Chibi Avatar Rider (protrudes & rotates 360\302\260 with turret)\n    addOutlinedPart(tankTurretGroup, new THREE.CylinderGeometry(0.38, 0.42, 0.16, 12), matDarkSteel, [-0.15, 0.58, 0]);\n    const matAvatarSkin = new THREE.MeshToonMaterial({\n      color: 0xffd19a,\n      gradientMap: toonGradientMap,\n    });\n    const matBlueTeam = new THREE.MeshToonMaterial({\n      color: 0x00d2ff,\n      gradientMap: toonGradientMap,\n    });\n    // Rider Upper Torso\n    addOutlinedPart(tankTurretGroup, new THREE.BoxGeometry(0.46, 0.36, 0.42), matBlueTeam, [-0.15, 0.78, 0]);\n    // Rider Chibi Head (1.2x scale) + Yellow Helmet/Visor\n    addOutlinedPart(tankTurretGroup, new THREE.SphereGeometry(0.28, 12, 10), matAvatarSkin, [-0.15, 1.14, 0]);\n    addOutlinedPart(tankTurretGroup, new THREE.CylinderGeometry(0.31, 0.31, 0.18, 12), matYellow, [-0.15, 1.28, 0]);\n\n    // Part 10 & 11: Recoiling Cannon Barrel + Yellow Muzzle Brake\n    const tankBarrelGroup = new THREE.Group();\n    tankBarrelGroup.position.set(0.65, 0.26, 0);\n    tankTurretGroup.add(tankBarrelGroup);\n\n    addOutlinedPart(\n      tankBarrelGroup,\n      new THREE.CylinderGeometry(0.14, 0.16, 1.45, 12),\n      matGunmetal,\n      [0.65, 0, 0],\n      [0, 0, -Math.PI / 2],\n    );\n    addOutlinedPart(\n      tankBarrelGroup,\n      new THREE.CylinderGeometry(0.22, 0.22, 0.28, 12),\n      matYellow,\n      [1.38, 0, 0],\n      [0, 0, -Math.PI / 2],\n    );\n\n    // Muzzle Flash Mesh & Light\n    const muzzleFlashMesh = new THREE.Mesh(\n      new THREE.SphereGeometry(0.42, 10, 10),\n      new THREE.MeshBasicMaterial({ color: 0xb8ff3c }),\n    );\n    muzzleFlashMesh.position.set(1.62, 0, 0);\n    muzzleFlashMesh.visible = false;\n    tankBarrelGroup.add(muzzleFlashMesh);\n\n    // Buddy Blitz 2x2x2 Stacking Pad (with Red Crates #ff3b30 + Blue Super Crate #00d2ff) & Stylized Lyo Trees\n    const padGroup = new THREE.Group();\n    padGroup.position.set(-5.8, 0.05, -4.5);\n    scene.add(padGroup);\n    addOutlinedPart(padGroup, new THREE.BoxGeometry(3.4, 0.18, 3.4), matDarkSteel, [0, 0.09, 0]);\n    addOutlinedPart(padGroup, new THREE.BoxGeometry(1.3, 1.3, 1.3), matRedBarrel, [-0.75, 0.82, -0.75]);\n    addOutlinedPart(padGroup, new THREE.BoxGeometry(1.3, 1.3, 1.3), matRedBarrel, [0.75, 0.82, -0.75]);\n    addOutlinedPart(padGroup, new THREE.BoxGeometry(1.3, 1.3, 1.3), matBlueTeam, [-0.75, 2.15, -0.75]);\n\n    const matLyoTrunk = new THREE.MeshToonMaterial({ color: 0x8c4a27, gradientMap: toonGradientMap });\n    const matLyoCanopy = new THREE.MeshToonMaterial({ color: 0x1d1f8c, gradientMap: toonGradientMap });\n    const lyoTreeCoords: [number, number][] = [\n      [-11, -11],\n      [11, -11],\n      [-12, 10],\n      [12, 10],\n    ];\n    lyoTreeCoords.forEach(([tx, tz]) => {\n      const treeGrp = new THREE.Group();\n      treeGrp.position.set(tx, 0, tz);\n      addOutlinedPart(treeGrp, new THREE.CylinderGeometry(0.42, 0.55, 2.4, 10), matLyoTrunk, [0, 1.2, 0]);\n      addOutlinedPart(treeGrp, new THREE.SphereGeometry(1.65, 14, 12), matLyoCanopy, [0, 3.1, 0]);\n      scene.add(treeGrp);\n    });"
