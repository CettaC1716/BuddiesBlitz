    combined_output {
      full: "<truncated 23 bytes>\nsorigin href=\"/assets/DrDnj3Lb.js\">    <link rel=\"modulepreload\" crossorigin href=\"/assets/BW6YWG0R.js\">    <link rel=\"modulepreload\" crossorigin href=\"/assets/Co_82n2H.js\">    <link rel=\"modulepreload\" crossorigin href=\"/assets/t1WzwXnd.js\">    <link rel=\"modulepreload\" crossorigin href=\"/assets/D9JAKPuk.js\">    <link rel=\"modulepreload\" crossorigin href=\"/assets/CozVMRND.js\">    <link rel=\"modulepreload\" crossorigin href=\"/assets/DADMk73e.js\">    <link rel=\"stylesheet\" crossorigin href=\"/assets/BcJjgNcx.css\">  </head>  <body>    <div class=\"js-fonts-loader fonts-loader\">      <div class=\"font crocante\" data-font=\"800 20px Crocante\">&nbsp;</div>      <div class=\"font barlow\" data-font=\"400 20px Barlow\">&nbsp;</div>    </div>    <div id=\"startup-intro\" class=\"startup-intro\" data-state=\"LOADING\">      <div class=\"startup-intro__title\" role=\"img\" aria-label=\"LYOOO PORTFOLIO\"></div>      <div class=\"startup-intro__stage startup-intro__stage--loading\">        <div class=\"startup-intro__loader-shell\">          <div class=\"startup-intro__label-row\">            <p id=\"startup-loader-label\" class=\"startup-intro__label\" aria-live=\"polite\">PREPARING RENDERER...</p>            <div class=\"startup-intro__spinner\">              <img class=\"startup-intro__spinner-icon startup-intro__spinner-icon--left\" src=\"/assets/elements/icons/secondary-settings.svg\" alt=\"\" aria-hidden=\"true\" width=\"24\" height=\"24\" />              <img class=\"startup-intro__spinner-icon startup-intro__spinner-icon--right\" src=\"/assets/elements/icons/secondary-settings.svg\" alt=\"\" aria-hidden=\"true\" width=\"24\" height=\"24\" />            </div>          </div>          <div class=\"startup-intro__progress\" role=\"progressbar\" aria-labelledby=\"startup-loader-label\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"0\">            <svg width=\"350\" height=\"31\" viewBox=\"0 0 350 31\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"startup-intro__progress-svg\">              <g id=\"progress_bar\">                <use href=\"/assets/elements/hud/progress-bar.svg#overlay\" />                <use id=\"bar_1\" href=\"/assets/elements/hud/progress-bar.svg#bar_1\" style=\"display: none;\" />                <use id=\"bar_2\" href=\"/assets/elements/hud/progress-bar.svg#bar_2\" style=\"display: none;\" />                <use id=\"bar_3\" href=\"/assets/elements/hud/progress-bar.svg#bar_3\" style=\"display: none;\" />                <use id=\"bar_4\" href=\"/assets/elements/hud/progress-bar.svg#bar_4\" style=\"display: none;\" />                <use id=\"bar_5\" href=\"/assets/elements/hud/progress-bar.svg#bar_5\" style=\"display: none;\" />              </g>            </svg>          </div>        </div>      </div>    </div>    <main id=\"app-root\" role=\"main\" aria-label=\"3D Interactive Portfolio Application\">      <h1 class=\"u-visually-hidden\">Long Hoang (Lyo) \342\200\223 Designer & Developer</h1>            <!-- Crawlable Static Semantic Outline for Search Engines -->      <section class=\"u-visually-hidden\" aria-label=\"Portfolio Summary and Index\">        <header>          <h2>Long Hoang (Lyo)</h2>          <p>Designer and Developer based in Hanoi, Vietnam. Specialized in 3D WebGL experiences, interactive game design, UI/UX architecture, and frontend engineering.</p>          <nav aria-label=\"Primary site navigation\">            <ul>              <li><a href=\"/\">Home</a></li>              <li><a href=\"/work\">Work</a></li>              <li><a href=\"/about\">About</a></li>              <li><a href=\"/contact\">Contact</a></li>            </ul>          </nav>        </header>        <section id=\"work\" aria-label=\"Work\">          <h2><a href=\"/work\">Work</a></h2>          <p>            Selected work, design systems, and digital product case studies            including Hanzii Dict, Mazii, Todaii, and Niubii.          </p>          <ul>            <li>              <article>                <h3><a href=\"/work/hanzii\">Hanzii Dict - Smart Chinese Learning Superapp</a></h3>                <p>Product Design and Gamified Learning Experience serving over 5,000,000 global language learners with AI HSK preparation and character recognition.</p>              </article>            </li>            <li>              <article>                <h3><a href=\"/work/mazii\">Mazii - Japanese Dictionary & Learning Ecosystem</a></h3>                <p>Design Systems and UX overhaul for the world\'s leading Japanese learning platform with 10M+ community members.</p>              </article>            </li>            <li>              <article>                <h3>                  <a href=\"/work/todaii\">                    Todaii - German Language Learning                  </a>                </h3>                <p>                  German language learning app with AI conversations,                  verb practice, and Goethe mock tests.                </p>              </article>            </li>            <li>              <article>                <h3>Todaii - Learn Japanese with News</h3>                <p>Learn Japanese through news, reading, and listening.</p>              </article>            </li>            <li>              <article>                <h3><a href=\"/work/niubii\">Niubii - Conversational Language Learning</a></h3>                <p>Interactive bite-sized situational language dialogue and pronunciation evaluation product.</p>              </article>            </li>          </ul>        </section>        <section id=\"about\" aria-label=\"About\">          <h2><a href=\"/about\">About</a></h2>          <p>Product designer and developer with nearly 5 years in EdTech and smart home, one failed startup alongside incredible people, and a fresh commitment to breaking out of my comfort zone to push interactive 3D WebGL experiences.</p>        </section>        <section id=\"contact\" aria-label=\"Contact\">          <h2><a href=\"/contact\">Contact</a></h2>          <p>Let\'s collaborate and make good things together. Available for creative development, 3D WebGL experiences, and product design inquiries.</p>          <p>Connect: <a href=\"/contact\">Send Message</a> or email <a href=\"mailto:longhoang.0816@gmail.com\">longhoang.0816@gmail.com</a>.</p>        </section>        <h2>Core Technology Stack & Principles</h2>        <p>Crafting high-performance digital experiences utilizing Three.js, WebGPU, Rapier physics, GSAP, TSL shaders, and semantic accessible web standards.</p>      </section>      <canvas        id=\"webgl\"        role=\"img\"        tabindex=\"0\"        aria-label=\"3D Interactive Portfolio World featuring interactive projects, characters, and environment\"      >        <p>Your browser does not support WebGL. Please enable WebGL or access the portfolio details in text mode.</p>      </canvas>    </main>    <noscript>      <div style=\"padding: 2rem; color: #11121a; background: #ffffff; font-family: sans-serif; max-width: 800px; margin: 0 auto;\">        <h1>Long Hoang (Lyo) \342\200\223 Designer & Developer</h1>        <p>Long Hoang (Lyo) is a designer and developer from Hanoi, Vietnam crafting interactive 3D WebGL experiences, game design experiments, and digital products from scratch.</p>        <h2>Featured Projects</h2>        <ul>          <li><strong>Hanzii:</strong> Chinese Dictionary & AI Exam Preparation Superapp (5M+ Users).</li>          <li><strong>Mazii:</strong> Comprehensive Japanese Language Learning Ecosystem (10M+ Users).</li>          <li>            <strong>Todaii:</strong> German language learning app with AI            conversations, verb practice, and Goethe mock tests.          </li>          <li>            <strong>Todaii:</strong> Learn Japanese through news, reading,            and listening.          </li>          <li><strong>Niubii:</strong> Interactive Conversational Language Product.</li>        </ul>        <h2>Contact & Socials</h2>        <p>Email: <!--email_off--><a href=\"mailto:longhoang.0816@gmail.com\">longhoang.0816@gmail.com</a><!--/email_off--></p>        <p>LinkedIn: <a href=\"https://www.linkedin.com/in/longhoang0816/\">longhoang0816</a> | X (Twitter): <a href=\"https://x.com/longhoang_lyo\">@longhoang_lyo</a> | Behance: <a href=\"https://www.behance.net/lyo0816\">lyo0816</a></p>      </div>    </noscript>  </body></html>"
    }
    command_line: "curl -sL -m 10 https://longhoang-lyo.com/ | tail -n +100"
    proposed_command_line: "curl -sL -m 10 https://longhoang-lyo.com/ | tail -n +100"
    shell_name: "bash"
  }
}
