            }
            lines {
              text: "      mesh.position.set(pos[0], pos[1], pos[2]);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      mesh.rotation.set(rot[0], rot[1], rot[2]);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      mesh.castShadow = castShadow && !isSoftwareGl;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      mesh.receiveShadow = !isSoftwareGl;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      mesh.userData.baseMaterial = mat;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const outline = new THREE.Mesh(geo, inkOutlineMat);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      outline.scale.setScalar(outlineScale);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      outline.name = \'InkStroke\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
