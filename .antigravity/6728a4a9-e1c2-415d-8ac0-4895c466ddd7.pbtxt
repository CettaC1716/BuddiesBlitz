            lines {
              text: "      vertexShader: /* glsl */ `"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        varying vec3 vLocalDir;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        void main() {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          vLocalDir = normalize(position);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
