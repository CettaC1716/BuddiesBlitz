            lines {
              text: "        { x: playerState.pos.x, y: 0, z: playerState.pos.z },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        cameraState.targetVelocity,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        playerState.currentSpeed,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        dt,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      cameraState.targetEased = springStep.position;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      cameraState.targetVelocity = springStep.velocity;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const angleCfg = REA_CONSTANTS.camera.defaultAngleOffset;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const distMult = cameraFovModeRef.current === \'roblox18\' ? 1.85 : 1.0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _camOffset"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        .set(angleCfg.x, angleCfg.y, angleCfg.z)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        .multiplyScalar(distMult / Math.max(0.6, cameraState.zoomScale));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Mouse Pan in Gameplay"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _forward.set(-angleCfg.x, 0, -angleCfg.z).normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      _right.set(-_forward.z, 0, _forward.x).normalize();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (state === \'playing\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        cameraState.targetMousePan"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          .copy(_right)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          .multiplyScalar(mouseNormalized.x * REA_CONSTANTS.camera.mousePan.sensitivity)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          .addScaledVector("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            _forward,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            mouseNormalized.y * REA_CONSTANTS.camera.mousePan.sensitivity,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        cameraState.targetMousePan.set(0, 0, 0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      cameraState.mousePanOffset.lerp("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        cameraState.targetMousePan,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        1 - Math.exp(-REA_CONSTANTS.camera.mousePan.dampSpeed * dt),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Decay Recoil & Trauma Shake"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      cameraState.recoilOffset.lerp(new THREE.Vector3(), 1 - Math.exp(-10 * dt));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      cameraState.trauma = Math.max(0, cameraState.trauma - dt * 2.4);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const shakeMag = cameraState.trauma * cameraState.trauma * 0.45;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const shakeX = Math.sin(now * 0.047) * shakeMag;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const shakeY = Math.cos(now * 0.053) * shakeMag * 0.6;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const shakeZ = Math.sin(now * 0.041) * shakeMag;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Intro Hexagon Offset (places Tank on the right half inside the Hexagon Cutout)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      let introShiftX = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      let introShiftZ = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
