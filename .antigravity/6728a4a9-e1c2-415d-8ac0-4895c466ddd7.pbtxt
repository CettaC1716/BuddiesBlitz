            }
            lines {
              text: "  const foliageMarkerMatrices: THREE.Matrix4[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  sourceRoot.traverse((child) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (child === sourceRoot) return;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
