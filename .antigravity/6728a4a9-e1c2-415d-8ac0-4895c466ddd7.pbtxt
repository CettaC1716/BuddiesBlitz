            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          gl_FragColor = vec4(col, 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
