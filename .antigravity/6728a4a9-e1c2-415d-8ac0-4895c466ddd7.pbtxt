            }
            lines {
              text: "      parent.add(mesh);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return mesh;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
