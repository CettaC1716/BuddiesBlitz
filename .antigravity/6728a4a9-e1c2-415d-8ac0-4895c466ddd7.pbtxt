        replacement_chunks {
          target_content: "export const MAP_STORAGE_KEY = \'lyo_arena_map_layout_v2\';\n\nexport const DEFAULT_ARENA_MAP_LAYOUT: ArenaMapLayout = {\n  blueHq: { x: 0, z: 22 },\n  bluePad: { x: -6.2, z: 16.5 },\n  redHq: { x: 0, z: -22 },\n  redPad: { x: 6.2, z: -16.5 },\n  centerDropZone: { x: 0, z: 0 },\n  props: [\n    // Lush 8-10 unit tall Lyo Trees right near Player Start (z = +10..+16) so they are immediately visible!\n    { id: 101, kind: \'tree_purple\', x: -7.2, z: 11.4, rotY: 0.2, scale: 1.0 },\n    { id: 102, kind: \'tree_gold\', x: 7.2, z: 11.4, rotY: -0.4, scale: 1.0 },\n    { id: 103, kind: \'tree_gold\', x: -12.4, z: 15.6, rotY: 1.1, scale: 1.05 },\n    { id: 104, kind: \'tree_purple\', x: 12.4, z: 15.6, rotY: -0.8, scale: 1.05 },\n    // Mid-arena & Northern Lyo Trees\n    { id: 105, kind: \'tree_purple\', x: -10.5, z: 3.5, rotY: 0.5, scale: 1.0 },\n    { id: 106, kind: \'tree_gold\', x: 10.5, z: 3.5, rotY: -0.6, scale: 1.0 },\n    { id: 107, kind: \'tree_gold\', x: -10.5, z: -9.5, rotY: 0.8, scale: 1.0 },\n    { id: 108, kind: \'tree_purple\', x: 10.5, z: -9.5, rotY: -0.3, scale: 1.0 },\n    { id: 109, kind: \'tree_purple\', x: -18.5, z: 8.5, rotY: 0.0, scale: 1.1 },\n    { id: 110, kind: \'tree_gold\', x: 18.5, z: 8.5, rotY: 1.5, scale: 1.1 },\n    { id: 111, kind: \'tree_gold\', x: -18.5, z: -8.5, rotY: -1.2, scale: 1.1 },\n    { id: 112, kind: \'tree_purple\', x: 18.5, z: -8.5, rotY: 0.7, scale: 1.1 },\n    // Default Factory Playground .glb Props\n    { id: 201, kind: \'power_core\', x: 6.8, z: 15.4, rotY: -Math.PI / 5, scale: 1.0 },\n    { id: 202, kind: \'turbine\', x: -15.5, z: 4.2, rotY: 0.3, scale: 1.0 },\n    { id: 203, kind: \'turbine\', x: 15.5, z: -4.2, rotY: -2.5, scale: 1.0 },\n    { id: 204, kind: \'concrete_fence\', x: -5.2, z: 7.2, rotY: 0, scale: 1.0 },\n    { id: 205, kind: \'barricade\', x: 5.2, z: 7.2, rotY: 0, scale: 1.0 },\n    { id: 206, kind: \'hydrant\', x: -4.2, z: 5.5, rotY: 0, scale: 1.0 },\n    { id: 207, kind: \'explosive_barrel\', x: 4.4, z: 5.5, rotY: 0.4, scale: 1.0 },\n  ],\n};"
          replacement_content: "export const MAP_STORAGE_KEY = \'lyo_arena_map_layout_v3\';\n\nexport const DEFAULT_ARENA_MAP_LAYOUT: ArenaMapLayout = {\n  // Positioned alongside the central road so the low-angle chase camera behind the player has an unobstructed horizon view\n  blueHq: { x: 7.8, z: 15.0 },\n  bluePad: { x: -6.2, z: 15.0 },\n  redHq: { x: -7.8, z: -16.5 },\n  redPad: { x: 6.2, z: -16.5 },\n  centerDropZone: { x: 0, z: 0 },\n  props: [\n    // Prominent 8-10 unit tall Purple & Gold Lyo Trees framing the road and rising into the top 25%-30% warm sky horizon\n    { id: 101, kind: \'tree_purple\', x: -6.4, z: 9.8, rotY: 0.2, scale: 1.08 },\n    { id: 102, kind: \'tree_purple\', x: 6.4, z: 9.8, rotY: -0.4, scale: 1.08 },\n    { id: 103, kind: \'tree_gold\', x: -12.2, z: 13.5, rotY: 1.1, scale: 1.05 },\n    { id: 104, kind: \'tree_purple\', x: 12.2, z: 13.5, rotY: -0.8, scale: 1.05 },\n    // Mid-arena & Horizon Purple/Gold Lyo Trees\n    { id: 105, kind: \'tree_purple\', x: -9.2, z: 2.5, rotY: 0.5, scale: 1.12 },\n    { id: 106, kind: \'tree_gold\', x: 9.2, z: 2.5, rotY: -0.6, scale: 1.08 },\n    { id: 107, kind: \'tree_purple\', x: -8.6, z: -8.8, rotY: 0.8, scale: 1.15 },\n    { id: 108, kind: \'tree_purple\', x: 8.6, z: -8.8, rotY: -0.3, scale: 1.15 },\n    { id: 109, kind: \'tree_purple\', x: -16.8, z: 5.5, rotY: 0.0, scale: 1.15 },\n    { id: 110, kind: \'tree_gold\', x: 16.8, z: 5.5, rotY: 1.5, scale: 1.12 },\n    { id: 111, kind: \'tree_purple\', x: -15.5, z: -14.5, rotY: -1.2, scale: 1.2 },\n    { id: 112, kind: \'tree_purple\', x: 15.5, z: -14.5, rotY: 0.7, scale: 1.2 },\n    { id: 113, kind: \'tree_purple\', x: -4.8, z: -22.5, rotY: 0.3, scale: 1.22 },\n    { id: 114, kind: \'tree_gold\', x: 4.8, z: -22.5, rotY: -0.5, scale: 1.18 },\n    // Default Factory Playground .glb Props\n    { id: 201, kind: \'power_core\', x: 5.2, z: 11.8, rotY: -Math.PI / 5, scale: 1.0 },\n    { id: 202, kind: \'turbine\', x: -14.5, z: -2.2, rotY: 0.3, scale: 1.05 },\n    { id: 203, kind: \'turbine\', x: 14.5, z: -2.2, rotY: -2.5, scale: 1.05 },\n    { id: 204, kind: \'concrete_fence\', x: -5.2, z: 6.8, rotY: 0, scale: 1.0 },\n    { id: 205, kind: \'barricade\', x: 5.2, z: 6.8, rotY: 0, scale: 1.0 },\n    { id: 206, kind: \'hydrant\', x: -4.2, z: 5.2, rotY: 0, scale: 1.0 },\n    { id: 207, kind: \'explosive_barrel\', x: 4.4, z: 5.2, rotY: 0.4, scale: 1.0 },\n  ],\n};"
