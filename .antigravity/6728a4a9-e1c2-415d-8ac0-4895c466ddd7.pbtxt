        overheadCrateGroup,\n        overheadCrateBox,\n        saluteSign,\n        teamRing,\n        x: spawnX,\n        y: 0,\n        z: spawnZ,\n        vx: 0,\n        vz: 0,\n        yaw: team === \'blue\' ? Math.PI : 0,\n        hp: 30,\n        maxHp: 30,\n        weaponName: classId === \'Ninja\' ? \'Katana\' : classId === \'SuperBuddie\' ? \'Laser Eyes\' : \'Uzi\',\n        ammo: 120,\n        carryingCrate: \'none\',\n        walkCycle: 0,\n        shootCooldown: 0,\n        hitFlashTimer: 0,\n        isFrozen: false,\n        frozenTimer: 0,\n        saluteTimer: 0,\n        aiTargetCrateId: null,\n        alive: true,\n        respawnTimer: 0,\n      };\n    };"
