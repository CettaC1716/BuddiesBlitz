            lines {
              text: "local function buildDirtRoad(fromPos: Vector3, toPos: Vector3, width: number)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal diff = toPos - fromPos"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal dist = diff.Magnitude"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal mid = (fromPos + toPos) * 0.5"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal cf = CFrame.lookAt(mid, toPos)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal border = makePart(\"DirtBorder\", Vector3.new(width + 2.4, 0.22, dist), PaletteLyo.DirtBorder, mid, ArenaFolder, true)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tborder.CFrame = cf * CFrame.new(0, 0.08, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal road = makePart(\"DirtRoad\", Vector3.new(width, 0.30, dist), PaletteLyo.DirtRoad, mid, ArenaFolder, true)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\troad.CFrame = cf * CFrame.new(0, 0.14, 0)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "end"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
