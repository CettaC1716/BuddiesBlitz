              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uBounceColor: { value: new THREE.Color(\'#75d424\') },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uLightDirection: windUniforms.uLightDirection,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uLightColor: windUniforms.uLightColor,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uShadowStep: { value: 0.15 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uHighlightStep: { value: 0.6 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uEmissive: { value: new THREE.Color(\'#000000\') },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    vertexShader: /* glsl */ `"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      varying vec2 vUv;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      varying vec3 vWorldNormal;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      varying vec3 vWorldPos;"
