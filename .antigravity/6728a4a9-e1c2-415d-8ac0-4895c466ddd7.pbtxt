              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\t\t\t\tpadModel:SetAttribute(\"PreviewSuper\", isSuper)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
