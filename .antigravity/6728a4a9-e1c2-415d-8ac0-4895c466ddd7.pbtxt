              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tVector3.new(1.85, 0.45, 1.45) * METER_TO_STUDS,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tCOLORS.TankHighlight,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tEnum.Material.SmoothPlastic,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
