            }
            lines {
              text: "getWindOffset(worldPos, randSeed) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const dir = normalize(uWindDirection + vec2(1e-4));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const perp = vec2(-dir.y, dir.x);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const uv1 = worldPos.xz * 0.01125 + dir * (uWindPhase * 0.0175);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const uv2 = worldPos.xz * 0.034375 - dir * (uWindPhase * 0.02975);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const n1 = clamp(texture(windNoiseTex, uv1).r, 0.0, 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const n2 = texture(windNoiseTex, uv2).r - 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const freq = mix(0.75, 1.35, randSeed);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const flutter = sin(uWindPhase * freq + randSeed * 6.2831853) * 0.08;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const gust = 1.0 + uWindGust * 1.15;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const forwardPush = (n1 * 0.42 + 0.24 + flutter) * uWindStrength * gust;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const sidePush = (n2 * 0.28 + flutter * 0.75) * uWindStrength * gust;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return dir * forwardPush + perp * sidePush;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
