              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "SwapBuddyRemote.OnServerEvent:Connect(function(player: Player)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tlocal char = player.Character"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tif not char or not char.PrimaryPart then"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
