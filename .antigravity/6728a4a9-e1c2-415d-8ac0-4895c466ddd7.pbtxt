              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Konversi TSL WorldMaterial & RobotStrokeMaterial ke Roblox: Highlight Ink Outline (#17110f), ShadowSoftness = 0 (hard cel-shaded shadows), Day/Dusk/Night cycle (Di=class), dan Cartoon Puff Smoke ParticleEmitter pada Manhole/Chimney.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
