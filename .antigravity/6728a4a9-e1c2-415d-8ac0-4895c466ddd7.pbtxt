            lines {
              text: "    // Helper: Add mesh + BackSide hard ink outline (replicates Nn StrokeMaterial)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const addOutlinedPart = ("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      parent: THREE.Object3D,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      geo: THREE.BufferGeometry,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      mat: THREE.Material,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      pos: [number, number, number],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      rot: [number, number, number] = [0, 0, 0],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      outlineScale = 1.06,"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      outlineScale = 1.075,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      castShadow = true,"
