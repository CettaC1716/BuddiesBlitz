            }
            lines {
              text: "      raycaster.ray.intersectPlane(groundPlane, aimWorldPoint);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // 3. Gameplay Simulation Step"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      let activeSpeed = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const isBoosting = Boolean(keys[\'ShiftLeft\'] || keys[\'ShiftRight\']);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (state === \'playing\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        runElapsedSec += dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Periodic Parachute Crate Drops in Central & Side Drop Zones"
