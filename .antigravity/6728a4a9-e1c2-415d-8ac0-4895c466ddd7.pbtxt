  planner_response {
    thinking: "**Defaulting State and App**\n\nI\'m currently focused on the `/src/App.tsx` file. The goal is to set the `gameState` to \'playing\' by default. However, a URL parameter, `?title=1`, should override this. The intention is to ensure the **Mode Default: `[\360\237\247\252 SANDBOX TEST (NO NPC)]` (Aktif Saat Pertama Buka)** is active upon the initial load of the application.\n\n\n**Implementing Initial Sandbox State**\n\nI\'ve established the default `playMode` as `\'sandbox\'`. The immediate focus is on rendering the 3-Mode Toggle Switch Bar prominently at the top center of the screen, followed by the Quick Sandbox Test Buttons below it. I will ensure that the \"SANDBOX TEST (NO NPC)\" option is selected as the default mode when the page opens.\n\n\n"
    tool_calls {
      id: "call_207381"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add 3-Mode Top Toggle Switch (Sandbox Test, Map Editor, Run Match With AI), Quick Sandbox Spawn Toolbar, and GLB Map Editor Palette to App.tsx\", \"EndLine\":840, \"Instruction\":\"Update App.tsx with playMode (\'sandbox\' | \'editor\' | \'match\'), editorTool palette, sandbox quick buttons, and top mode toggle bar\", \"ReplacementContent\":\"import React, { useState, useEffect, useCallback, useRef } from \'react\';\\nimport {\\n  FactoryPlaygroundCanvas,\\n  GameState,\\n  PlayMode,\\n  EditorToolId,\\n  HudSnapshot,\\n} from \'./game/FactoryPlaygroundCanvas\';\\nimport {\\n  REA_CONSTANTS,\\n  LIGHTING_PRESETS,\\n  LightingPresetKey,\\n  getBuildOrderAllowedSlots,\\n} from \'./game/rules\';\\nimport { soundEngine } from \'./game/audio\';\\nimport { ReaLuauModal } from \'./components/ReaLuauModal\';\\n\\nconst INITIAL_HUD: HudSnapshot = {\\n  hp: 30,\\n  maxHp: 30,\\n  score: 0,\\n  bestScore: 0,\\n  speedKmh: 0,\\n  isBoosting: false,\\n  isGrabMode: false,\\n  grabbedPropName: null,\\n  collectedItems: [],\\n  powerCoreActivated: false,\\n  enemiesDefeated: 0,\\n  totalEnemies: 4,\\n  lightingPreset: \'day\',\\n  cameraFovMode: \'webgl35\',\\n  outcome: null,\\n  clearTimeSec: 0,\\n  controlMode: \'buddy\',\\n  activeClass: \'Infuntry\',\\n  equippedWeapon: \'Uzi\',\\n  ammo: 120,\\n  carryingCrate: \'none\',\\n  tankStoredCrates: 0,\\n  padSlots: [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'],\\n  padShape: \'Empty\',\\n  padOutputName: \'Pad Kosong\',\\n  padIsMerged: false,\\n  padIsSuper: false,\\n  buildOrder: \'1x1x2\',\\n  buildOrderLabel: \'Buddy T1\',\\n  buildOrderTargetCrates: 2,\\n  teamCommand: \'HARVEST\',\\n  alliedBuddiesCount: 1,\\n  blueBaseHp: 2000,\\n  redBaseHp: 2000,\\n  contextHint: \'WASD Lari \302\267 [E] Ambil Peti \302\267 [Q] Pola 1x1x2 \302\267 [F] Rakit\',\\n  radarDots: [],\\n  editorObjectCount: 19,\\n  editorCursorX: 0,\\n  editorCursorZ: 0,\\n  editorRotDeg: 0,\\n  editorScale: 1.0,\\n};\\n\\nconst PRESET_ORDER: LightingPresetKey[] = [\'day\', \'dusk\', \'night\', \'dawn\'];\\n\\ninterface EditorToolOption {\\n  id: EditorToolId;\\n  label: string;\\n  sub: string;\\n  accentHex: string;\\n}\\n\\nconst EDITOR_PROP_TOOLS: EditorToolOption[] = [\\n  { id: \'tree_purple\', label: \'1. Pohon Ungu Lyo\', sub: \'tree-1b.glb\', accentHex: \'#775cf6\' },\\n  { id: \'tree_gold\', label: \'2. Pohon Emas Lyo\', sub: \'tree-1a.glb\', accentHex: \'#facc15\' },\\n  { id: \'turbine\', label: \'3. Kincir Angin\', sub: \'turbine.glb\', accentHex: \'#00d2ff\' },\\n  { id: \'power_core\', label: \'4. Power Core\', sub: \'power-core.glb\', accentHex: \'#b8ff3c\' },\\n  { id: \'concrete_fence\', label: \'5A. Pagar Beton\', sub: \'concrete-fence-1a.glb\', accentHex: \'#d89c60\' },\\n  { id: \'barricade\', label: \'5B. Barikade Jalan\', sub: \'barricade-1a.glb\', accentHex: \'#fec83e\' },\\n  { id: \'explosive_barrel\', label: \'6A. Tong Peledak\', sub: \'explosive-barrel.glb\', accentHex: \'#ff3b30\' },\\n  { id: \'hydrant\', label: \'6B. Hidran Kota\', sub: \'hydrant.glb\', accentHex: \'#ff554a\' },\\n];\\n\\nconst EDITOR_STRUCTURE_TOOLS: EditorToolOption[] = [\\n  { id: \'move_blue_hq\', label: \'7A. Pindah Blue HQ\', sub: \'Markas Biru\', accentHex: \'#00d2ff\' },\\n  { id: \'move_blue_pad\', label: \'7B. Pindah Blue Pad\', sub: \'Stacking Pad Biru\', accentHex: \'#2979ff\' },\\n  { id: \'move_red_hq\', label: \'7C. Pindah Red HQ\', sub: \'Markas Merah\', accentHex: \'#ff3b30\' },\\n  { id: \'move_red_pad\', label: \'7D. Pindah Red Pad\', sub: \'Stacking Pad Merah\', accentHex: \'#ff554a\' },\\n  { id: \'move_drop_zone\', label: \'7E. Pindah Drop Zone\', sub: \'Area Jatuh Peti\', accentHex: \'#fec83e\' },\\n];\\n\\nexport default function App() {\\n  // Default to \'playing\' in SANDBOX TEST (NO NPC) mode when first opened (unless ?title=1 is passed)\\n  const [gameState, setGameState] = useState<GameState>(() => {\\n    if (typeof window !== \'undefined\') {\\n      const params = new URLSearchParams(window.location.search);\\n      if (params.get(\'title\') === \'1\') {\\n        return \'title\';\\n      }\\n    }\\n    return \'playing\';\\n  });\\n\\n  const [playMode, setPlayMode] = useState<PlayMode>(\'sandbox\');\\n  const [editorTool, setEditorTool] = useState<EditorToolId>(\'tree_purple\');\\n  const [mapSaveStatus, setMapSaveStatus] = useState<string | null>(null);\\n\\n  const [hud, setHud] = useState<HudSnapshot>(INITIAL_HUD);\\n  const [finalRunStats, setFinalRunStats] = useState<HudSnapshot | null>(null);\\n  const [lightingPreset, setLightingPreset] = useState<LightingPresetKey>(\'day\');\\n  const [cameraFovMode, setCameraFovMode] = useState<\'webgl35\' | \'roblox18\'>(\'webgl35\');\\n  const [isMuted, setIsMuted] = useState<boolean>(false);\\n  const [isReaModalOpen, setIsReaModalOpen] = useState<boolean>(false);\\n  const [isDockCollapsed, setIsDockCollapsed] = useState<boolean>(false);\\n  const [resetTrigger, setResetTrigger] = useState<number>(0);\\n\\n  const hexContainerRef = useRef<HTMLDivElement | null>(null);\\n  const [hexRect, setHexRect] = useState<{ left: number; top: number; width: number; height: number }>({\\n    left: 720,\\n    top: 140,\\n    width: 480,\\n    height: 462,\\n  });\\n\\n  useEffect(() => {\\n    document.body.dataset.state = gameState;\\n    document.body.dataset.mode = playMode;\\n  }, [gameState, playMode]);\\n\\n  const handleMapSaved = useCallback((msg: string) => {\\n    setMapSaveStatus(msg);\\n    setTimeout(() => {\\n      setMapSaveStatus(null);\\n    }, 2800);\\n  }, []);\\n\\n  const syncHexBounds = useCallback(() => {\\n    if (!hexContainerRef.current) return;\\n    const r = hexContainerRef.current.getBoundingClientRect();\\n    if (r.width > 0 && r.height > 0) {\\n      setHexRect({\\n        left: r.left,\\n        top: r.top,\\n        width: r.width,\\n        height: r.height,\\n      });\\n    }\\n  }, []);\\n\\n  useEffect(() => {\\n    syncHexBounds();\\n    window.addEventListener(\'resize\', syncHexBounds);\\n    return () => window.removeEventListener(\'resize\', syncHexBounds);\\n  }, [syncHexBounds, gameState]);\\n\\n  const dispatchBuddyAction = useCallback((actionName: string) => {\\n    window.dispatchEvent(new CustomEvent(\'buddy-action\', { detail: actionName }));\\n  }, []);\\n\\n  const handleStartGame = useCallback((shouldReset = false) => {\\n    soundEngine.playUiClick();\\n    if (document.activeElement instanceof HTMLElement) {\\n      document.activeElement.blur();\\n    }\\n    if (shouldReset) {\\n      setResetTrigger((prev) => prev + 1);\\n      setFinalRunStats(null);\\n    }\\n    document.body.dataset.state = \'playing\';\\n    setGameState(\'playing\');\\n  }, []);\\n\\n  const handleSwitchPlayMode = useCallback((nextMode: PlayMode) => {\\n    soundEngine.playUiClick();\\n    if (document.activeElement instanceof HTMLElement) {\\n      document.activeElement.blur();\\n    }\\n    setPlayMode(nextMode);\\n    if (gameState !== \'playing\') {\\n      setGameState(\'playing\');\\n    }\\n  }, [gameState]);\\n\\n  const handleToggleAudio = useCallback(() => {\\n    const nextMuted = !soundEngine.muted;\\n    soundEngine.muted = nextMuted;\\n    setIsMuted(nextMuted);\\n    if (!nextMuted) {\\n      soundEngine.playUiClick();\\n    }\\n  }, []);\\n\\n  const handleCycleLighting = useCallback(() => {\\n    soundEngine.playUiClick();\\n    setLightingPreset((prev) => {\\n      const idx = PRESET_ORDER.indexOf(prev);\\n      return PRESET_ORDER[(idx + 1) % PRESET_ORDER.length];\\n    });\\n  }, []);\\n\\n  const handleToggleFovMode = useCallback(() => {\\n    soundEngine.playUiClick();\\n    setCameraFovMode((prev) => (prev === \'webgl35\' ? \'roblox18\' : \'webgl35\'));\\n  }, []);\\n\\n  const handleTogglePause = useCallback(() => {\\n    soundEngine.playUiClick();\\n    setGameState((prev) => {\\n      const next = prev === \'playing\' ? \'paused\' : prev === \'paused\' ? \'playing\' : prev;\\n      document.body.dataset.state = next;\\n      return next;\\n    });\\n  }, []);\\n\\n  const handleGameOver = useCallback(\\n    (_outcome: \'victory\' | \'defeat\', snapshot: HudSnapshot) => {\\n      setFinalRunStats(snapshot);\\n      document.body.dataset.state = \'gameover\';\\n      setGameState(\'gameover\');\\n    },\\n    [],\\n  );\\n\\n  useEffect(() => {\\n    const onKeyDown = (e: KeyboardEvent) => {\\n      if (isReaModalOpen) {\\n        if (e.code === \'Escape\') {\\n          setIsReaModalOpen(false);\\n        }\\n        return;\\n      }\\n\\n      if (gameState === \'title\' && (e.code === \'Enter\' || e.code === \'Space\')) {\\n        e.preventDefault();\\n        handleStartGame(false);\\n        return;\\n      }\\n\\n      if (e.code === \'KeyM\') {\\n        handleToggleAudio();\\n      } else if (e.code === \'KeyL\') {\\n        handleCycleLighting();\\n      } else if (e.code === \'KeyC\') {\\n        handleToggleFovMode();\\n      } else if (e.code === \'KeyH\') {\\n        setIsDockCollapsed((prev) => !prev);\\n      }\\n    };\\n\\n    window.addEventListener(\'keydown\', onKeyDown);\\n    return () => window.removeEventListener(\'keydown\', onKeyDown);\\n  }, [\\n    gameState,\\n    isReaModalOpen,\\n    handleStartGame,\\n    handleToggleAudio,\\n    handleCycleLighting,\\n    handleToggleFovMode,\\n  ]);\\n\\n  const currentPresetConfig = LIGHTING_PRESETS[lightingPreset];\\n  const scaleX = hexRect.width / 500;\\n  const scaleY = hexRect.height / 482;\\n\\n  return (\\n    <main className=\\\"relative w-screen h-screen overflow-hidden select-none\\\">\\n      {/* 1. 60FPS 3D Team Buddies x Lyo Grassland Arena */}\\n      <FactoryPlaygroundCanvas\\n        gameState={gameState}\\n        playMode={playMode}\\n        editorTool={editorTool}\\n        lightingPreset={lightingPreset}\\n        cameraFovMode={cameraFovMode}\\n        resetTrigger={resetTrigger}\\n        onHudUpdate={setHud}\\n        onGameOver={handleGameOver}\\n        onTogglePause={handleTogglePause}\\n        onMapSaved={handleMapSaved}\\n      />\\n\\n      {/* Atmospheric Viewport Color Tint Overlay */}\\n      <div\\n        aria-hidden=\\\"true\\\"\\n        className=\\\"fixed inset-0 pointer-events-none z-10 transition-colors duration-700\\\"\\n        style={{\\n          backgroundColor: currentPresetConfig.viewportFilterColor,\\n          opacity: currentPresetConfig.viewportFilterOpacity,\\n        }}\\n      />\\n\\n      {/* =====================================================================\\n          2. TITLE SCREEN: HEXAGON CUTOUT & COMIC STICKER LOCKUP (CJn-Xu8f.js)\\n         ===================================================================== */}\\n      {gameState === \'title\' && (\\n        <section\\n          aria-label=\\\"LYOOO Portfolio Title Screen\\\"\\n          className=\\\"fixed inset-0 z-20 flex flex-col justify-between pointer-events-none\\\"\\n        >\\n          <svg\\n            className=\\\"fixed inset-0 w-full h-full pointer-events-none\\\"\\n            width=\\\"100%\\\"\\n            height=\\\"100%\\\"\\n            preserveAspectRatio=\\\"none\\\"\\n          >\\n            <defs>\\n              <mask\\n                id=\\\"intro-mask-cutout\\\"\\n                maskUnits=\\\"userSpaceOnUse\\\"\\n                x=\\\"0\\\"\\n                y=\\\"0\\\"\\n                width=\\\"100%\\\"\\n                height=\\\"100%\\\"\\n              >\\n                <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"white\\\" />\\n                <g\\n                  transform={`translate(${hexRect.left}, ${hexRect.top}) scale(${scaleX}, ${scaleY})`}\\n                >\\n                  <path d={REA_CONSTANTS.introHexagonSvgPath} fill=\\\"black\\\" />\\n                </g>\\n              </mask>\\n              <linearGradient id=\\\"intro-overlay-gradient\\\" x1=\\\"0%\\\" y1=\\\"0%\\\" x2=\\\"100%\\\" y2=\\\"0%\\\">\\n                <stop offset=\\\"0%\\\" stopColor=\\\"#0b0c12\\\" stopOpacity=\\\"0.94\\\" />\\n                <stop offset=\\\"52%\\\" stopColor=\\\"#11121a\\\" stopOpacity=\\\"0.86\\\" />\\n                <stop offset=\\\"100%\\\" stopColor=\\\"#11121a\\\" stopOpacity=\\\"0.72\\\" />\\n              </linearGradient>\\n            </defs>\\n            <rect\\n              width=\\\"100%\\\"\\n              height=\\\"100%\\\"\\n              fill=\\\"url(#intro-overlay-gradient)\\\"\\n              mask=\\\"url(#intro-mask-cutout)\\\"\\n            />\\n          </svg>\\n\\n          <div className=\\\"relative z-10 flex-1 grid grid-cols-1 lg:grid-cols-12 items-center px-6 sm:px-12 lg:px-16 pt-8 pb-4 gap-6\\\">\\n            <div className=\\\"lg:col-span-6 flex flex-col items-start justify-end lg:justify-center space-y-5 pointer-events-auto\\\">\\n              <svg\\n                viewBox=\\\"0 0 560 225\\\"\\n                className=\\\"w-full max-w-[510px] drop-shadow-[6px_8px_0px_#11121a]\\\"\\n                role=\\\"img\\\"\\n                aria-label=\\\"LYOOO PORTFOLIO\\\"\\n              >\\n                <g transform=\\\"rotate(-3 260 85)\\\">\\n                  <rect\\n                    x=\\\"10\\\"\\n                    y=\\\"12\\\"\\n                    width=\\\"455\\\"\\n                    height=\\\"108\\\"\\n                    rx=\\\"18\\\"\\n                    fill=\\\"#ffffff\\\"\\n                    stroke=\\\"#11121a\\\"\\n                    strokeWidth=\\\"8\\\"\\n                  />\\n                  <text\\n                    x=\\\"32\\\"\\n                    y=\\\"94\\\"\\n                    fontFamily=\\\"\'Barlow\', sans-serif\\\"\\n                    fontWeight=\\\"900\\\"\\n                    fontStyle=\\\"italic\\\"\\n                    fontSize=\\\"94\\\"\\n                    letterSpacing=\\\"2\\\"\\n                    fill=\\\"#ffffff\\\"\\n                    stroke=\\\"#11121a\\\"\\n                    strokeWidth=\\\"16\\\"\\n                    paintOrder=\\\"stroke fill\\\"\\n                  >\\n                    LYOOO\\n                  </text>\\n                </g>\\n\\n                <g transform=\\\"translate(24, 108) rotate(-1.5 220 45)\\\">\\n                  <rect\\n                    x=\\\"0\\\"\\n                    y=\\\"0\\\"\\n                    width=\\\"430\\\"\\n                    height=\\\"84\\\"\\n                    rx=\\\"14\\\"\\n                    fill=\\\"#b4ff39\\\"\\n                    stroke=\\\"#ffffff\\\"\\n                    strokeWidth=\\\"10\\\"\\n                  />\\n                  <rect\\n                    x=\\\"4\\\"\\n                    y=\\\"4\\\"\\n                    width=\\\"422\\\"\\n                    height=\\\"76\\\"\\n                    rx=\\\"11\\\"\\n                    fill=\\\"#b4ff39\\\"\\n                    stroke=\\\"#11121a\\\"\\n                    strokeWidth=\\\"6\\\"\\n                  />\\n                  <text\\n                    x=\\\"26\\\"\\n                    y=\\\"61\\\"\\n                    fontFamily=\\\"\'Barlow\', sans-serif\\\"\\n                    fontWeight=\\\"900\\\"\\n                    fontSize=\\\"58\\\"\\n                    letterSpacing=\\\"4\\\"\\n                    fill=\\\"#11121a\\\"\\n                  >\\n                    PORTFOLIO\\n                  </text>\\n                </g>\\n              </svg>\\n\\n              <div className=\\\"flex flex-wrap items-center gap-3 pt-1\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    soundEngine.playUiClick();\\n                    setIsReaModalOpen(true);\\n                  }}\\n                  className=\\\"px-4 py-2.5 bg-[#272935] hover:bg-[#393b49] text-[#b8ff3c] font-black text-xs sm:text-sm rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow transition-transform hover:-translate-y-0.5 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  Kode Luau\\n                </button>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"lg:col-span-6 flex items-center justify-center\\\">\\n              <div\\n                ref={hexContainerRef}\\n                className=\\\"relative w-[330px] h-[318px] sm:w-[440px] sm:h-[424px] lg:w-[485px] lg:h-[468px] pointer-events-none\\\"\\n              >\\n                <svg\\n                  width=\\\"100%\\\"\\n                  height=\\\"100%\\\"\\n                  viewBox=\\\"0 0 500 482\\\"\\n                  fill=\\\"none\\\"\\n                  className=\\\"absolute inset-0 w-full h-full\\\"\\n                >\\n                  <path\\n                    d={REA_CONSTANTS.introHexagonSvgPath}\\n                    fill=\\\"none\\\"\\n                    stroke=\\\"rgba(255, 255, 255, 0.55)\\\"\\n                    strokeWidth=\\\"3.5\\\"\\n                  />\\n                  <path\\n                    d={REA_CONSTANTS.introHexagonSvgPath}\\n                    fill=\\\"none\\\"\\n                    stroke=\\\"#11121a\\\"\\n                    strokeWidth=\\\"2\\\"\\n                    strokeDasharray=\\\"10 6\\\"\\n                  />\\n                </svg>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    handleToggleAudio();\\n                  }}\\n                  aria-label={isMuted ? \'Suara Mati\' : \'Suara Aktif\'}\\n                  className=\\\"pointer-events-auto absolute top-3 right-6 w-14 h-14 flex items-center justify-center bg-white hover:bg-[#fec83e] text-[#11121a] font-black text-xs border-4 border-[#11121a] ring-2 ring-white rounded-2xl rotate-6 comic-sticker-shadow transition-transform hover:scale-105 active:scale-95 cursor-pointer\\\"\\n                >\\n                  {isMuted ? \'MUTE\' : \'SUARA\'}\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  data-start=\\\"true\\\"\\n                  onClick={() => handleStartGame(false)}\\n                  aria-label=\\\"LET\'S GO\\\"\\n                  className=\\\"pointer-events-auto absolute -bottom-3 left-1/2 -translate-x-1/2 -rotate-3 hover:-rotate-6 hover:scale-108 active:scale-95 px-9 py-4 bg-[#b4ff39] hover:bg-[#c7ff72] text-[#11121a] font-black text-2xl sm:text-3xl tracking-wider rounded-2xl border-4 border-[#11121a] ring-4 ring-white comic-sticker-shadow-lg transition-all duration-150 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  LET&apos;S GO\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"relative z-10 pb-5 px-6 text-center text-xs sm:text-sm font-bold tracking-wide text-[#dfdfe2]/85\\\">\\n            WASD Lari &nbsp;\302\267&nbsp; [E] Ambil/Lempar Peti &nbsp;\302\267&nbsp; [Q] Pola Ghost Pad &nbsp;\302\267&nbsp; [F] Rakit &nbsp;\302\267&nbsp; [V] Teropong AI\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* =====================================================================\\n          3. PLAYING HUD: 3-MODE TOP TOGGLE BAR + SANDBOX / MAP EDITOR / MATCH HUD\\n         ===================================================================== */}\\n      {gameState === \'playing\' && (\\n        <div className=\\\"fixed inset-0 z-20 pointer-events-none flex flex-col justify-between p-3 sm:p-5\\\">\\n          {/* Top Row: Status Cluster + 3-Mode Toggle Switch + Radar/Utility */}\\n          <div className=\\\"flex flex-col gap-2.5\\\">\\n            <div className=\\\"flex flex-wrap items-start justify-between gap-3\\\">\\n              {/* Top-Left Cluster: Buddy/Tank Status + 3D Stacking Pad 2x2x2 + Base HQ Bars */}\\n              <div className=\\\"pointer-events-auto flex flex-wrap items-center gap-3 bg-[#191b24]/95 border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl px-3.5 py-2 comic-sticker-shadow\\\">\\n                <div className=\\\"pr-3 border-r-2 border-[#393b49]\\\">\\n                  <div className=\\\"text-[10px] font-black uppercase tracking-wider text-[#b8ff3c]\\\">\\n                    {hud.controlMode === \'tank\'\\n                      ? `OPEN-TOP TANK (${hud.tankStoredCrates}/4 PETI)`\\n                      : `BUDDY: ${hud.activeClass.toUpperCase()}`}\\n                  </div>\\n                  <div className=\\\"flex items-center gap-1 mt-0.5\\\">\\n                    {Array.from({ length: 6 }).map((_, idx) => {\\n                      const threshold = (idx + 1) * (hud.maxHp / 6);\\n                      const full = hud.hp >= threshold;\\n                      return (\\n                        <span\\n                          key={idx}\\n                          className={`w-3 h-3 rounded-sm border-2 border-[#11121a] ${\\n                            full ? \'bg-[#b8ff3c]\' : \'bg-[#272935]\'\\n                          }`}\\n                        />\\n                      );\\n                    })}\\n                    <span className=\\\"ml-1.5 text-xs font-black font-mono-tabular text-white\\\">\\n                      {hud.equippedWeapon}\\n                    </span>\\n                  </div>\\n                </div>\\n\\n                {/* 3D Stacking Pad 2x2x2 Live Status + [Q] Ghost Wireframe Slots */}\\n                <div className=\\\"pr-3 border-r-2 border-[#393b49]\\\">\\n                  <div className=\\\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\\\">\\n                    PAD [Q] {hud.buildOrder}: {hud.buildOrderLabel.toUpperCase()}{\' \'}\\n                    {hud.padIsMerged ? \'\302\267 MERGED\' : \'\'}\\n                  </div>\\n                  <div className=\\\"flex items-center gap-1 mt-0.5\\\">\\n                    {hud.padSlots.map((slot, idx) => {\\n                      const isGhostAllowed = getBuildOrderAllowedSlots(hud.buildOrder).includes(idx);\\n                      return (\\n                        <span\\n                          key={idx}\\n                          className={`w-3 h-3 rounded-xs border ${\\n                            slot === \'super\'\\n                              ? \'bg-[#00d2ff] border-[#11121a]\'\\n                              : slot === \'red\'\\n                              ? \'bg-[#ff3b30] border-[#11121a]\'\\n                              : isGhostAllowed\\n                              ? \'bg-[#191b24] border-[#00d2ff] border-dashed\'\\n                              : \'bg-[#272935]/50 border-[#11121a]\'\\n                          }`}\\n                        />\\n                      );\\n                    })}\\n                    <span\\n                      className={`ml-1.5 text-xs font-black ${\\n                        hud.padIsSuper ? \'text-[#00d2ff]\' : \'text-[#fec83e]\'\\n                      }`}\\n                    >\\n                      {hud.padOutputName}\\n                    </span>\\n                  </div>\\n                </div>\\n\\n                {/* Blue HQ vs Red HQ HP */}\\n                <div>\\n                  <div className=\\\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\\\">\\n                    BLUE HQ vs RED HQ\\n                  </div>\\n                  <div className=\\\"flex items-center gap-2 mt-0.5 text-xs font-black font-mono-tabular\\\">\\n                    <span className=\\\"text-[#00d2ff]\\\">{hud.blueBaseHp}</span>\\n                    <span className=\\\"text-[#8f93a5]\\\">/</span>\\n                    <span className=\\\"text-[#ff3b30]\\\">{hud.redBaseHp}</span>\\n                    <span className=\\\"ml-1 px-1.5 py-0.5 bg-[#272935] text-[#b8ff3c] text-[10px] rounded border border-[#11121a]\\\">\\n                      TIM: {hud.alliedBuddiesCount}\\n                    </span>\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* TOP CENTER: 3-MODE TOGGLE SWITCH BAR */}\\n              <div\\n                role=\\\"tablist\\\"\\n                aria-label=\\\"Mode Permainan\\\"\\n                className=\\\"pointer-events-auto flex items-center gap-1.5 bg-[#191b24]/95 p-1.5 border-3 border-[#11121a] ring-2 ring-white/90 rounded-2xl comic-sticker-shadow\\\"\\n              >\\n                <button\\n                  type=\\\"button\\\"\\n                  role=\\\"tab\\\"\\n                  aria-selected={playMode === \'sandbox\'}\\n                  data-mode-btn=\\\"sandbox\\\"\\n                  onClick={() => handleSwitchPlayMode(\'sandbox\')}\\n                  className={`px-3 py-2 rounded-xl font-black text-xs border-2 transition-all cursor-pointer whitespace-nowrap ${\\n                    playMode === \'sandbox\'\\n                      ? \'bg-[#b8ff3c] text-[#11121a] border-[#11121a] shadow-[0_3px_0_#11121a]\'\\n                      : \'bg-[#272935] text-white/85 border-transparent hover:bg-[#393b49]\'\\n                  }`}\\n                >\\n                  SANDBOX TEST (NO NPC)\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  role=\\\"tab\\\"\\n                  aria-selected={playMode === \'editor\'}\\n                  data-mode-btn=\\\"editor\\\"\\n                  onClick={() => handleSwitchPlayMode(\'editor\')}\\n                  className={`px-3 py-2 rounded-xl font-black text-xs border-2 transition-all cursor-pointer whitespace-nowrap ${\\n                    playMode === \'editor\'\\n                      ? \'bg-[#00d2ff] text-[#11121a] border-[#11121a] shadow-[0_3px_0_#11121a]\'\\n                      : \'bg-[#272935] text-white/85 border-transparent hover:bg-[#393b49]\'\\n                  }`}\\n                >\\n                  MAP EDITOR\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  role=\\\"tab\\\"\\n                  aria-selected={playMode === \'match\'}\\n                  data-mode-btn=\\\"match\\\"\\n                  onClick={() => handleSwitchPlayMode(\'match\')}\\n                  className={`px-3 py-2 rounded-xl font-black text-xs border-2 transition-all cursor-pointer whitespace-nowrap ${\\n                    playMode === \'match\'\\n                      ? \'bg-[#ff3b30] text-white border-[#11121a] shadow-[0_3px_0_#11121a]\'\\n                      : \'bg-[#272935] text-white/85 border-transparent hover:bg-[#393b49]\'\\n                  }`}\\n                >\\n                  RUN MATCH (WITH AI)\\n                </button>\\n              </div>\\n\\n              {/* Top-Right Cluster: Team Buddies Mini-Radar + Compact Utility Buttons */}\\n              <div className=\\\"pointer-events-auto flex items-start gap-2\\\">\\n                <div\\n                  aria-label=\\\"Mini Radar Arena\\\"\\n                  className=\\\"relative w-22 h-22 sm:w-24 sm:h-24 bg-[#285918] border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl overflow-hidden comic-sticker-shadow shrink-0\\\"\\n                >\\n                  <div className=\\\"absolute inset-y-0 left-1/2 -translate-x-1/2 w-3 bg-[#c28348]/85\\\" />\\n                  <div className=\\\"absolute inset-x-0 top-1/2 -translate-y-1/2 h-2.5 bg-[#c28348]/85\\\" />\\n                  <div className=\\\"absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4 rounded-full border-2 border-[#ff3b30]/80\\\" />\\n                  <div className=\\\"absolute left-1/2 top-1.5 -translate-x-1/2 w-3 h-2 bg-[#ff3b30] border border-[#11121a] rounded-xs\\\" />\\n                  <div className=\\\"absolute left-1/2 bottom-1.5 -translate-x-1/2 w-3 h-2 bg-[#00d2ff] border border-[#11121a] rounded-xs\\\" />\\n\\n                  {hud.radarDots.map((dot) => {\\n                    const leftPct = Math.max(6, Math.min(94, ((dot.x + 42) / 84) * 100));\\n                    const topPct = Math.max(6, Math.min(94, ((dot.z + 42) / 84) * 100));\\n                    let dotStyle = \'w-2 h-2 bg-[#ff3b30] rounded-xs\';\\n                    if (dot.kind === \'player\') {\\n                      dotStyle = \'w-3 h-3 bg-[#b8ff3c] rounded-full ring-2 ring-[#11121a] z-10\';\\n                    } else if (dot.kind === \'ally\') {\\n                      dotStyle = \'w-2.5 h-2.5 bg-[#2979ff] rounded-full border border-white\';\\n                    } else if (dot.kind === \'enemy\') {\\n                      dotStyle = \'w-2.5 h-2.5 bg-[#ff3b30] rounded-full border border-[#11121a]\';\\n                    } else if (dot.kind === \'crate_super\') {\\n                      dotStyle = \'w-2 h-2 bg-[#00d2ff] border border-[#11121a]\';\\n                    } else if (dot.kind === \'crate_red\') {\\n                      dotStyle = \'w-1.5 h-1.5 bg-[#ff3b30] border border-[#11121a]\';\\n                    } else if (dot.kind === \'tank_blue\' || dot.kind === \'tank_red\') {\\n                      dotStyle = \'w-3 h-2.5 bg-[#fec83e] border border-[#11121a] rounded-xs\';\\n                    }\\n                    return (\\n                      <span\\n                        key={dot.id}\\n                        style={{ left: `${leftPct}%`, top: `${topPct}%` }}\\n                        className={`absolute -translate-x-1/2 -translate-y-1/2 ${dotStyle}`}\\n                      />\\n                    );\\n                  })}\\n                  <div className=\\\"absolute bottom-0.5 right-1.5 text-[8px] font-black tracking-wider text-white/90 drop-shadow\\\">\\n                    RADAR\\n                  </div>\\n                </div>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    soundEngine.playUiClick();\\n                    setIsReaModalOpen(true);\\n                  }}\\n                  aria-label=\\\"Kode Luau\\\"\\n                  className=\\\"px-3 h-10 flex items-center gap-1.5 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white comic-sticker-shadow cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  <span>Kode Luau</span>\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    handleToggleAudio();\\n                  }}\\n                  aria-label={isMuted ? \'Suara Mati\' : \'Suara Aktif\'}\\n                  className=\\\"w-13 h-10 flex items-center justify-center bg-[#191b24] hover:bg-[#272935] text-white font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow cursor-pointer\\\"\\n                >\\n                  {isMuted ? \'MUTE\' : \'SUARA\'}\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    handleTogglePause();\\n                  }}\\n                  aria-label=\\\"Jeda\\\"\\n                  className=\\\"w-13 h-10 flex items-center justify-center bg-[#191b24] hover:bg-[#272935] text-white font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow cursor-pointer\\\"\\n                >\\n                  JEDA\\n                </button>\\n              </div>\\n            </div>\\n\\n            {/* SANDBOX QUICK TEST BAR (Visible in SANDBOX TEST mode) */}\\n            {playMode === \'sandbox\' && (\\n              <div className=\\\"pointer-events-auto self-center flex flex-wrap items-center justify-center gap-2 bg-[#191b24]/95 px-3.5 py-2 border-3 border-[#11121a] ring-2 ring-[#b8ff3c] rounded-2xl comic-sticker-shadow\\\">\\n                <span className=\\\"text-[11px] font-black uppercase tracking-wider text-[#b8ff3c] mr-1\\\">\\n                  SANDBOX CEPAT:\\n                </span>\\n                <button\\n                  type=\\\"button\\\"\\n                  data-sandbox-btn=\\\"drop-red\\\"\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'sandboxDropRedCrate\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#ff3b30] hover:bg-[#ff554a] text-white font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  + Drop Peti Merah\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  data-sandbox-btn=\\\"drop-blue\\\"\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'sandboxDropSuperCrate\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#00d2ff] hover:bg-[#3be0ff] text-[#11121a] font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  + Drop Peti Biru\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  data-sandbox-btn=\\\"spawn-tank\\\"\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'sandboxSpawnTank\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  + Spawn Lyo Tank di Depanku\\n                </button>\\n              </div>\\n            )}\\n          </div>\\n\\n          {/* MIDDLE LEFT: MAP EDITOR PALETTE TOOLBAR (Visible when playMode === \'editor\') */}\\n          {playMode === \'editor\' && (\\n            <aside\\n              aria-label=\\\"Toolbar Aset Lyo GLB Map Editor\\\"\\n              className=\\\"pointer-events-auto self-start w-72 sm:w-80 max-h-[64vh] overflow-y-auto bg-[#191b24]/95 border-3 border-[#11121a] ring-2 ring-[#00d2ff] rounded-2xl p-3.5 comic-sticker-shadow space-y-3\\\"\\n            >\\n              <div className=\\\"flex items-center justify-between border-b-2 border-[#272935] pb-2\\\">\\n                <div>\\n                  <div className=\\\"text-xs font-black uppercase tracking-wider text-[#00d2ff]\\\">\\n                    PALET ASET LYO (.GLB)\\n                  </div>\\n                  <div className=\\\"text-[10px] font-bold text-[#8f93a5]\\\">\\n                    Klik tanah untuk pasang \302\267 Klik kanan hapus\\n                  </div>\\n                </div>\\n                <span className=\\\"px-2 py-0.5 bg-[#272935] text-[#b8ff3c] font-mono-tabular font-black text-xs rounded-lg border border-[#11121a]\\\">\\n                  {hud.editorObjectCount} Item\\n                </span>\\n              </div>\\n\\n              {/* 1-6: Real .glb Props & Trees */}\\n              <div className=\\\"grid grid-cols-2 gap-1.5\\\">\\n                {EDITOR_PROP_TOOLS.map((tool) => {\\n                  const active = editorTool === tool.id;\\n                  return (\\n                    <button\\n                      key={tool.id}\\n                      type=\\\"button\\\"\\n                      data-editor-tool={tool.id}\\n                      onClick={() => {\\n                        soundEngine.playUiClick();\\n                        setEditorTool(tool.id);\\n                      }}\\n                      className={`p-2 text-left rounded-xl border-2 transition-all cursor-pointer ${\\n                        active\\n                          ? \'bg-[#00d2ff] text-[#11121a] border-[#11121a] shadow-[0_2px_0_#11121a]\'\\n                          : \'bg-[#272935] text-white hover:bg-[#393b49] border-[#11121a]\'\\n                      }`}\\n                    >\\n                      <div className=\\\"text-[11px] font-black leading-tight\\\">{tool.label}</div>\\n                      <div\\n                        className={`text-[9px] font-mono-tabular font-bold mt-0.5 ${\\n                          active ? \'text-[#11121a]/80\' : \'text-[#8f93a5]\'\\n                        }`}\\n                      >\\n                        {tool.sub}\\n                      </div>\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n\\n              {/* 7: Move Core Arena Structures */}\\n              <div className=\\\"pt-1 border-t-2 border-[#272935]\\\">\\n                <div className=\\\"text-[10px] font-black uppercase tracking-wider text-[#fec83e] mb-1.5\\\">\\n                  7. PINDAH POSISI MARKAS / PAD / DROP ZONE\\n                </div>\\n                <div className=\\\"grid grid-cols-2 gap-1.5\\\">\\n                  {EDITOR_STRUCTURE_TOOLS.map((tool) => {\\n                    const active = editorTool === tool.id;\\n                    return (\\n                      <button\\n                        key={tool.id}\\n                        type=\\\"button\\\"\\n                        data-editor-tool={tool.id}\\n                        onClick={() => {\\n                          soundEngine.playUiClick();\\n                          setEditorTool(tool.id);\\n                        }}\\n                        className={`px-2 py-1.5 text-left rounded-xl border-2 transition-all cursor-pointer ${\\n                          active\\n                            ? \'bg-[#fec83e] text-[#11121a] border-[#11121a]\'\\n                            : \'bg-[#272935] text-white hover:bg-[#393b49] border-[#11121a]\'\\n                        }`}\\n                      >\\n                        <div className=\\\"text-[10px] font-black leading-tight\\\">{tool.label}</div>\\n                      </button>\\n                    );\\n                  })}\\n                </div>\\n              </div>\\n\\n              {/* Transform Controls: Rotate [R], Scale [ / ], Delete */}\\n              <div className=\\\"pt-1 border-t-2 border-[#272935] flex items-center justify-between gap-1.5\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => dispatchBuddyAction(\'editorRotate\')}\\n                  className=\\\"flex-1 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-black text-[11px] rounded-xl border-2 border-[#11121a] cursor-pointer\\\"\\n                >\\n                  [R] Putar ({hud.editorRotDeg}\302\260)\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => dispatchBuddyAction(\'editorScaleDown\')}\\n                  className=\\\"px-2.5 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-black text-[11px] rounded-xl border-2 border-[#11121a] cursor-pointer\\\"\\n                >\\n                  [ -\\n                </button>\\n                <span className=\\\"text-[11px] font-mono-tabular font-black text-[#b8ff3c]\\\">\\n                  {hud.editorScale.toFixed(2)}x\\n                </span>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => dispatchBuddyAction(\'editorScaleUp\')}\\n                  className=\\\"px-2.5 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-black text-[11px] rounded-xl border-2 border-[#11121a] cursor-pointer\\\"\\n                >\\n                  + ]\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => dispatchBuddyAction(\'editorDeleteLast\')}\\n                  className=\\\"px-2.5 py-1.5 bg-[#ff3b30] hover:bg-[#ff554a] text-white font-black text-[11px] rounded-xl border-2 border-[#11121a] cursor-pointer\\\"\\n                >\\n                  Hapus\\n                </button>\\n              </div>\\n\\n              {/* Save / Reset Map Layout Buttons */}\\n              <div className=\\\"pt-1 border-t-2 border-[#272935] grid grid-cols-2 gap-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  data-editor-action=\\\"save-map\\\"\\n                  onClick={() => dispatchBuddyAction(\'editorSaveMap\')}\\n                  className=\\\"py-2 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer\\\"\\n                >\\n                  Simpan Layout Map\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  data-editor-action=\\\"reset-map\\\"\\n                  onClick={() => dispatchBuddyAction(\'editorResetMap\')}\\n                  className=\\\"py-2 bg-[#272935] hover:bg-[#393b49] text-white font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer\\\"\\n                >\\n                  Reset Map Default\\n                </button>\\n              </div>\\n\\n              {mapSaveStatus && (\\n                <div className=\\\"px-2.5 py-1.5 bg-[#b8ff3c] text-[#11121a] font-black text-xs text-center rounded-xl border-2 border-[#11121a]\\\">\\n                  {mapSaveStatus}\\n                </div>\\n              )}\\n            </aside>\\n          )}\\n\\n          {/* Bottom Context Prompt + Action Dock */}\\n          <div className=\\\"flex flex-col items-center\\\">\\n            <div className=\\\"mb-1.5 px-3.5 py-1 bg-[#11121a]/90 text-[#b4ff39] font-black text-xs rounded-lg border-2 border-[#11121a]\\\">\\n              {hud.contextHint}\\n            </div>\\n\\n            {!isDockCollapsed && playMode !== \'editor\' && (\\n              <div className=\\\"pointer-events-auto flex flex-wrap items-center justify-center gap-2 px-4 py-2 bg-[#191b24]/95 border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl comic-sticker-shadow max-w-[96vw]\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'pickupOrThrow\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#ff3b30] hover:bg-[#ff554a] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  {hud.carryingCrate !== \'none\' ? \'[E] Lempar Peti\' : \'[E] Ambil Peti\'}\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'kickOrCraft\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  [F] Rakit Pad\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'mountOrDismount\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#fec83e] hover:bg-[#fee763] text-[#11121a] font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  {hud.controlMode === \'tank\' ? \'[G] Turun Tank\' : \'[G] Naik Tank\'}\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'cycleBuildOrder\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  [Q] Pola: <span className=\\\"text-[#00d2ff]\\\">{hud.buildOrder}</span>\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'cycleCommand\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  [V] AI: <span className=\\\"text-[#fec83e]\\\">{hud.teamCommand}</span>\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'swapBuddy\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  [Tab] Ganti Buddy\\n                </button>\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* =====================================================================\\n          4. PAUSE MODAL CARD (gameState === \'paused\')\\n         ===================================================================== */}\\n      {gameState === \'paused\' && (\\n        <div\\n          role=\\\"dialog\\\"\\n          aria-modal=\\\"true\\\"\\n          aria-labelledby=\\\"pause-modal-title\\\"\\n          className=\\\"fixed inset-0 z-30 flex items-center justify-center p-4 pointer-events-auto\\\"\\n          style={{ backgroundColor: \'rgba(17, 18, 26, 0.82)\' }}\\n        >\\n          <div className=\\\"w-full max-w-md bg-[#191b24] border-4 border-[#11121a] ring-4 ring-white rounded-2xl p-6 comic-sticker-shadow-lg text-center space-y-5\\\">\\n            <h2\\n              id=\\\"pause-modal-title\\\"\\n              className=\\\"text-3xl font-black tracking-wide text-[#b8ff3c]\\\"\\n            >\\n              Permainan Dijeda\\n            </h2>\\n\\n            <div className=\\\"grid grid-cols-3 gap-2.5 text-center\\\">\\n              <div className=\\\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\\\">\\n                <div className=\\\"text-[10px] font-black text-[#8f93a5]\\\">SKOR</div>\\n                <div className=\\\"text-lg font-black font-mono-tabular text-white\\\">{hud.score}</div>\\n              </div>\\n              <div className=\\\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\\\">\\n                <div className=\\\"text-[10px] font-black text-[#8f93a5]\\\">RED HQ</div>\\n                <div className=\\\"text-lg font-black font-mono-tabular text-[#ff3b30]\\\">\\n                  {hud.redBaseHp}\\n                </div>\\n              </div>\\n              <div className=\\\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\\\">\\n                <div className=\\\"text-[10px] font-black text-[#8f93a5]\\\">MUSUH KO</div>\\n                <div className=\\\"text-lg font-black font-mono-tabular text-[#b8ff3c]\\\">\\n                  {hud.enemiesDefeated}\\n                </div>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex flex-col gap-2.5\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleTogglePause}\\n                className=\\\"w-full py-3 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-base rounded-xl border-3 border-[#11121a] comic-sticker-shadow cursor-pointer\\\"\\n              >\\n                Lanjut Main\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  soundEngine.playUiClick();\\n                  setIsReaModalOpen(true);\\n                }}\\n                className=\\\"w-full py-3 bg-[#fec83e] hover:bg-[#fee763] text-[#11121a] font-black text-sm rounded-xl border-3 border-[#11121a] comic-sticker-shadow cursor-pointer\\\"\\n              >\\n                Kode Luau\\n              </button>\\n              <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => handleStartGame(true)}\\n                  className=\\\"py-2.5 bg-[#272935] hover:bg-[#393b49] text-white font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer\\\"\\n                >\\n                  Ulangi Arena\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    soundEngine.playUiClick();\\n                    document.body.dataset.state = \'title\';\\n                    setGameState(\'title\');\\n                  }}\\n                  className=\\\"py-2.5 bg-[#272935] hover:bg-[#393b49] text-white font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer\\\"\\n                >\\n                  Layar Utama\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* =====================================================================\\n          5. VICTORY / GAME OVER MODAL CARD (gameState === \'gameover\')\\n         ===================================================================== */}\\n      {gameState === \'gameover\' && (\\n        <div\\n          role=\\\"dialog\\\"\\n          aria-modal=\\\"true\\\"\\n          aria-labelledby=\\\"gameover-modal-title\\\"\\n          className=\\\"fixed inset-0 z-30 flex items-center justify-center p-4 pointer-events-auto\\\"\\n          style={{ backgroundColor: \'rgba(17, 18, 26, 0.85)\' }}\\n        >\\n          <div className=\\\"w-full max-w-md bg-[#191b24] border-4 border-[#11121a] ring-4 ring-white rounded-2xl p-6 comic-sticker-shadow-lg text-center space-y-5\\\">\\n            <h2\\n              id=\\\"gameover-modal-title\\\"\\n              className={`text-3xl font-black tracking-wide ${\\n                (finalRunStats?.outcome || hud.outcome) === \'victory\'\\n                  ? \'text-[#b8ff3c]\'\\n                  : \'text-[#f42f4c]\'\\n              }`}\\n            >\\n              {(finalRunStats?.outcome || hud.outcome) === \'victory\'\\n                ? \'Markas Merah Hancur\'\\n                : \'Markas Biru Hancur\'}\\n            </h2>\\n\\n            <div className=\\\"grid grid-cols-3 gap-2.5 text-center\\\">\\n              <div className=\\\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\\\">\\n                <div className=\\\"text-[10px] font-black text-[#8f93a5]\\\">SKOR</div>\\n                <div className=\\\"text-base font-black font-mono-tabular text-white\\\">\\n                  {finalRunStats?.score ?? hud.score}\\n                </div>\\n              </div>\\n              <div className=\\\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\\\">\\n                <div className=\\\"text-[10px] font-black text-[#8f93a5]\\\">WAKTU</div>\\n                <div className=\\\"text-base font-black font-mono-tabular text-[#fec83e]\\\">\\n                  {finalRunStats?.clearTimeSec ?? hud.clearTimeSec}s\\n                </div>\\n              </div>\\n              <div className=\\\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\\\">\\n                <div className=\\\"text-[10px] font-black text-[#8f93a5]\\\">MUSUH KO</div>\\n                <div className=\\\"text-base font-black font-mono-tabular text-[#b8ff3c]\\\">\\n                  {finalRunStats?.enemiesDefeated ?? hud.enemiesDefeated}\\n                </div>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex flex-col gap-2.5\\\">\\n              <button\\n                type=\\\"button\\\"\\n                data-start=\\\"true\\\"\\n                onClick={() => handleStartGame(true)}\\n                className=\\\"w-full py-3.5 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-lg rounded-xl border-3 border-[#11121a] comic-sticker-shadow cursor-pointer\\\"\\n              >\\n                Main Lagi\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  soundEngine.playUiClick();\\n                  setIsReaModalOpen(true);\\n                }}\\n                className=\\\"w-full py-2.5 bg-[#fec83e] hover:bg-[#fee763] text-[#11121a] font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer\\\"\\n              >\\n                Kode Luau\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* =====================================================================\\n          6. REA EXTRACTION REPORT & ROBLOX STUDIO (LUAU) CODE MODAL\\n         ===================================================================== */}\\n      <ReaLuauModal\\n        isOpen={isReaModalOpen}\\n        onClose={() => setIsReaModalOpen(false)}\\n      />\\n    </main>\\n  );\\n}\", \"StartLine\":1, \"TargetContent\":\"import React, { useState, useEffect, useCallback, useRef } from \'react\';\\nimport {\\n  FactoryPlaygroundCanvas,\\n  GameState,\\n  HudSnapshot,\\n} from \'./game/FactoryPlaygroundCanvas\';\\nimport {\\n  REA_CONSTANTS,\\n  LIGHTING_PRESETS,\\n  LightingPresetKey,\\n  getBuildOrderAllowedSlots,\\n} from \'./game/rules\';\\nimport { soundEngine } from \'./game/audio\';\\nimport { ReaLuauModal } from \'./components/ReaLuauModal\';\\n\\nconst INITIAL_HUD: HudSnapshot = {\\n  hp: 30,\\n  maxHp: 30,\\n  score: 0,\\n  bestScore: 0,\\n  speedKmh: 0,\\n  isBoosting: false,\\n  isGrabMode: false,\\n  grabbedPropName: null,\\n  collectedItems: [],\\n  powerCoreActivated: false,\\n  enemiesDefeated: 0,\\n  totalEnemies: 4,\\n  lightingPreset: \'day\',\\n  cameraFovMode: \'webgl35\',\\n  outcome: null,\\n  clearTimeSec: 0,\\n  controlMode: \'buddy\',\\n  activeClass: \'Infuntry\',\\n  equippedWeapon: \'Uzi\',\\n  ammo: 120,\\n  carryingCrate: \'none\',\\n  tankStoredCrates: 0,\\n  padSlots: [\'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\', \'empty\'],\\n  padShape: \'Empty\',\\n  padOutputName: \'Pad Kosong\',\\n  padIsMerged: false,\\n  padIsSuper: false,\\n  buildOrder: \'1x1x2\',\\n  buildOrderLabel: \'Buddy T1\',\\n  buildOrderTargetCrates: 2,\\n  teamCommand: \'HARVEST\',\\n  alliedBuddiesCount: 2,\\n  blueBaseHp: 2000,\\n  redBaseHp: 2000,\\n  contextHint: \'WASD Lari \302\267 [E] Ambil Peti \302\267 [Q] Pola 1x1x2 \302\267 [V] Teropong AI\',\\n  radarDots: [],\\n};\\n\\nconst PRESET_ORDER: LightingPresetKey[] = [\'day\', \'dusk\', \'night\', \'dawn\'];\\n\\nexport default function App() {\\n  const [gameState, setGameState] = useState<GameState>(() => {\\n    if (typeof window !== \'undefined\') {\\n      const params = new URLSearchParams(window.location.search);\\n      if (params.get(\'autostart\') === \'1\') {\\n        return \'playing\';\\n      }\\n    }\\n    return \'title\';\\n  });\\n\\n  const [hud, setHud] = useState<HudSnapshot>(INITIAL_HUD);\\n  const [finalRunStats, setFinalRunStats] = useState<HudSnapshot | null>(null);\\n  const [lightingPreset, setLightingPreset] = useState<LightingPresetKey>(\'day\');\\n  const [cameraFovMode, setCameraFovMode] = useState<\'webgl35\' | \'roblox18\'>(\'webgl35\');\\n  const [isMuted, setIsMuted] = useState<boolean>(false);\\n  const [isReaModalOpen, setIsReaModalOpen] = useState<boolean>(false);\\n  const [isDockCollapsed, setIsDockCollapsed] = useState<boolean>(false);\\n  const [resetTrigger, setResetTrigger] = useState<number>(0);\\n\\n  const hexContainerRef = useRef<HTMLDivElement | null>(null);\\n  const [hexRect, setHexRect] = useState<{ left: number; top: number; width: number; height: number }>({\\n    left: 720,\\n    top: 140,\\n    width: 480,\\n    height: 462,\\n  });\\n\\n  useEffect(() => {\\n    document.body.dataset.state = gameState;\\n  }, [gameState]);\\n\\n  const syncHexBounds = useCallback(() => {\\n    if (!hexContainerRef.current) return;\\n    const r = hexContainerRef.current.getBoundingClientRect();\\n    if (r.width > 0 && r.height > 0) {\\n      setHexRect({\\n        left: r.left,\\n        top: r.top,\\n        width: r.width,\\n        height: r.height,\\n      });\\n    }\\n  }, []);\\n\\n  useEffect(() => {\\n    syncHexBounds();\\n    window.addEventListener(\'resize\', syncHexBounds);\\n    return () => window.removeEventListener(\'resize\', syncHexBounds);\\n  }, [syncHexBounds, gameState]);\\n\\n  const dispatchBuddyAction = useCallback((actionName: string) => {\\n    window.dispatchEvent(new CustomEvent(\'buddy-action\', { detail: actionName }));\\n  }, []);\\n\\n  const handleStartGame = useCallback((shouldReset = false) => {\\n    soundEngine.playUiClick();\\n    if (document.activeElement instanceof HTMLElement) {\\n      document.activeElement.blur();\\n    }\\n    if (shouldReset) {\\n      setResetTrigger((prev) => prev + 1);\\n      setFinalRunStats(null);\\n    }\\n    document.body.dataset.state = \'playing\';\\n    setGameState(\'playing\');\\n  }, []);\\n\\n  const handleToggleAudio = useCallback(() => {\\n    const nextMuted = !soundEngine.muted;\\n    soundEngine.muted = nextMuted;\\n    setIsMuted(nextMuted);\\n    if (!nextMuted) {\\n      soundEngine.playUiClick();\\n    }\\n  }, []);\\n\\n  const handleCycleLighting = useCallback(() => {\\n    soundEngine.playUiClick();\\n    setLightingPreset((prev) => {\\n      const idx = PRESET_ORDER.indexOf(prev);\\n      return PRESET_ORDER[(idx + 1) % PRESET_ORDER.length];\\n    });\\n  }, []);\\n\\n  const handleToggleFovMode = useCallback(() => {\\n    soundEngine.playUiClick();\\n    setCameraFovMode((prev) => (prev === \'webgl35\' ? \'roblox18\' : \'webgl35\'));\\n  }, []);\\n\\n  const handleTogglePause = useCallback(() => {\\n    soundEngine.playUiClick();\\n    setGameState((prev) => {\\n      const next = prev === \'playing\' ? \'paused\' : prev === \'paused\' ? \'playing\' : prev;\\n      document.body.dataset.state = next;\\n      return next;\\n    });\\n  }, []);\\n\\n  const handleGameOver = useCallback(\\n    (_outcome: \'victory\' | \'defeat\', snapshot: HudSnapshot) => {\\n      setFinalRunStats(snapshot);\\n      document.body.dataset.state = \'gameover\';\\n      setGameState(\'gameover\');\\n    },\\n    [],\\n  );\\n\\n  useEffect(() => {\\n    const onKeyDown = (e: KeyboardEvent) => {\\n      if (isReaModalOpen) {\\n        if (e.code === \'Escape\') {\\n          setIsReaModalOpen(false);\\n        }\\n        return;\\n      }\\n\\n      if (gameState === \'title\' && (e.code === \'Enter\' || e.code === \'Space\')) {\\n        e.preventDefault();\\n        handleStartGame(false);\\n        return;\\n      }\\n\\n      if (e.code === \'KeyM\') {\\n        handleToggleAudio();\\n      } else if (e.code === \'KeyL\') {\\n        handleCycleLighting();\\n      } else if (e.code === \'KeyC\') {\\n        handleToggleFovMode();\\n      } else if (e.code === \'KeyH\') {\\n        setIsDockCollapsed((prev) => !prev);\\n      } else if (e.code === \'KeyR\' && gameState === \'playing\') {\\n        soundEngine.playUiClick();\\n        setIsReaModalOpen(true);\\n      }\\n    };\\n\\n    window.addEventListener(\'keydown\', onKeyDown);\\n    return () => window.removeEventListener(\'keydown\', onKeyDown);\\n  }, [\\n    gameState,\\n    isReaModalOpen,\\n    handleStartGame,\\n    handleToggleAudio,\\n    handleCycleLighting,\\n    handleToggleFovMode,\\n  ]);\\n\\n  const currentPresetConfig = LIGHTING_PRESETS[lightingPreset];\\n  const scaleX = hexRect.width / 500;\\n  const scaleY = hexRect.height / 482;\\n\\n  return (\\n    <main className=\\\"relative w-screen h-screen overflow-hidden select-none\\\">\\n      {/* 1. 60FPS 3D Team Buddies x Lyo Grassland Arena */}\\n      <FactoryPlaygroundCanvas\\n        gameState={gameState}\\n        lightingPreset={lightingPreset}\\n        cameraFovMode={cameraFovMode}\\n        resetTrigger={resetTrigger}\\n        onHudUpdate={setHud}\\n        onGameOver={handleGameOver}\\n        onTogglePause={handleTogglePause}\\n      />\\n\\n      {/* Atmospheric Viewport Color Tint Overlay */}\\n      <div\\n        aria-hidden=\\\"true\\\"\\n        className=\\\"fixed inset-0 pointer-events-none z-10 transition-colors duration-700\\\"\\n        style={{\\n          backgroundColor: currentPresetConfig.viewportFilterColor,\\n          opacity: currentPresetConfig.viewportFilterOpacity,\\n        }}\\n      />\\n\\n      {/* =====================================================================\\n          2. TITLE SCREEN: HEXAGON CUTOUT & COMIC STICKER LOCKUP (CJn-Xu8f.js)\\n         ===================================================================== */}\\n      {gameState === \'title\' && (\\n        <section\\n          aria-label=\\\"LYOOO Portfolio Title Screen\\\"\\n          className=\\\"fixed inset-0 z-20 flex flex-col justify-between pointer-events-none\\\"\\n        >\\n          <svg\\n            className=\\\"fixed inset-0 w-full h-full pointer-events-none\\\"\\n            width=\\\"100%\\\"\\n            height=\\\"100%\\\"\\n            preserveAspectRatio=\\\"none\\\"\\n          >\\n            <defs>\\n              <mask\\n                id=\\\"intro-mask-cutout\\\"\\n                maskUnits=\\\"userSpaceOnUse\\\"\\n                x=\\\"0\\\"\\n                y=\\\"0\\\"\\n                width=\\\"100%\\\"\\n                height=\\\"100%\\\"\\n              >\\n                <rect width=\\\"100%\\\" height=\\\"100%\\\" fill=\\\"white\\\" />\\n                <g\\n                  transform={`translate(${hexRect.left}, ${hexRect.top}) scale(${scaleX}, ${scaleY})`}\\n                >\\n                  <path d={REA_CONSTANTS.introHexagonSvgPath} fill=\\\"black\\\" />\\n                </g>\\n              </mask>\\n              <linearGradient id=\\\"intro-overlay-gradient\\\" x1=\\\"0%\\\" y1=\\\"0%\\\" x2=\\\"100%\\\" y2=\\\"0%\\\">\\n                <stop offset=\\\"0%\\\" stopColor=\\\"#0b0c12\\\" stopOpacity=\\\"0.94\\\" />\\n                <stop offset=\\\"52%\\\" stopColor=\\\"#11121a\\\" stopOpacity=\\\"0.86\\\" />\\n                <stop offset=\\\"100%\\\" stopColor=\\\"#11121a\\\" stopOpacity=\\\"0.72\\\" />\\n              </linearGradient>\\n            </defs>\\n            <rect\\n              width=\\\"100%\\\"\\n              height=\\\"100%\\\"\\n              fill=\\\"url(#intro-overlay-gradient)\\\"\\n              mask=\\\"url(#intro-mask-cutout)\\\"\\n            />\\n          </svg>\\n\\n          <div className=\\\"relative z-10 flex-1 grid grid-cols-1 lg:grid-cols-12 items-center px-6 sm:px-12 lg:px-16 pt-8 pb-4 gap-6\\\">\\n            <div className=\\\"lg:col-span-6 flex flex-col items-start justify-end lg:justify-center space-y-5 pointer-events-auto\\\">\\n              <svg\\n                viewBox=\\\"0 0 560 225\\\"\\n                className=\\\"w-full max-w-[510px] drop-shadow-[6px_8px_0px_#11121a]\\\"\\n                role=\\\"img\\\"\\n                aria-label=\\\"LYOOO PORTFOLIO\\\"\\n              >\\n                <g transform=\\\"rotate(-3 260 85)\\\">\\n                  <rect\\n                    x=\\\"10\\\"\\n                    y=\\\"12\\\"\\n                    width=\\\"455\\\"\\n                    height=\\\"108\\\"\\n                    rx=\\\"18\\\"\\n                    fill=\\\"#ffffff\\\"\\n                    stroke=\\\"#11121a\\\"\\n                    strokeWidth=\\\"8\\\"\\n                  />\\n                  <text\\n                    x=\\\"32\\\"\\n                    y=\\\"94\\\"\\n                    fontFamily=\\\"\'Barlow\', sans-serif\\\"\\n                    fontWeight=\\\"900\\\"\\n                    fontStyle=\\\"italic\\\"\\n                    fontSize=\\\"94\\\"\\n                    letterSpacing=\\\"2\\\"\\n                    fill=\\\"#ffffff\\\"\\n                    stroke=\\\"#11121a\\\"\\n                    strokeWidth=\\\"16\\\"\\n                    paintOrder=\\\"stroke fill\\\"\\n                  >\\n                    LYOOO\\n                  </text>\\n                </g>\\n\\n                <g transform=\\\"translate(24, 108) rotate(-1.5 220 45)\\\">\\n                  <rect\\n                    x=\\\"0\\\"\\n                    y=\\\"0\\\"\\n                    width=\\\"430\\\"\\n                    height=\\\"84\\\"\\n                    rx=\\\"14\\\"\\n                    fill=\\\"#b4ff39\\\"\\n                    stroke=\\\"#ffffff\\\"\\n                    strokeWidth=\\\"10\\\"\\n                  />\\n                  <rect\\n                    x=\\\"4\\\"\\n                    y=\\\"4\\\"\\n                    width=\\\"422\\\"\\n                    height=\\\"76\\\"\\n                    rx=\\\"11\\\"\\n                    fill=\\\"#b4ff39\\\"\\n                    stroke=\\\"#11121a\\\"\\n                    strokeWidth=\\\"6\\\"\\n                  />\\n                  <text\\n                    x=\\\"26\\\"\\n                    y=\\\"61\\\"\\n                    fontFamily=\\\"\'Barlow\', sans-serif\\\"\\n                    fontWeight=\\\"900\\\"\\n                    fontSize=\\\"58\\\"\\n                    letterSpacing=\\\"4\\\"\\n                    fill=\\\"#11121a\\\"\\n                  >\\n                    PORTFOLIO\\n                  </text>\\n                </g>\\n              </svg>\\n\\n              <div className=\\\"flex flex-wrap items-center gap-3 pt-1\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    soundEngine.playUiClick();\\n                    setIsReaModalOpen(true);\\n                  }}\\n                  className=\\\"px-4 py-2.5 bg-[#272935] hover:bg-[#393b49] text-[#b8ff3c] font-black text-xs sm:text-sm rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow transition-transform hover:-translate-y-0.5 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  Kode Luau\\n                </button>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"lg:col-span-6 flex items-center justify-center\\\">\\n              <div\\n                ref={hexContainerRef}\\n                className=\\\"relative w-[330px] h-[318px] sm:w-[440px] sm:h-[424px] lg:w-[485px] lg:h-[468px] pointer-events-none\\\"\\n              >\\n                <svg\\n                  width=\\\"100%\\\"\\n                  height=\\\"100%\\\"\\n                  viewBox=\\\"0 0 500 482\\\"\\n                  fill=\\\"none\\\"\\n                  className=\\\"absolute inset-0 w-full h-full\\\"\\n                >\\n                  <path\\n                    d={REA_CONSTANTS.introHexagonSvgPath}\\n                    fill=\\\"none\\\"\\n                    stroke=\\\"rgba(255, 255, 255, 0.55)\\\"\\n                    strokeWidth=\\\"3.5\\\"\\n                  />\\n                  <path\\n                    d={REA_CONSTANTS.introHexagonSvgPath}\\n                    fill=\\\"none\\\"\\n                    stroke=\\\"#11121a\\\"\\n                    strokeWidth=\\\"2\\\"\\n                    strokeDasharray=\\\"10 6\\\"\\n                  />\\n                </svg>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    handleToggleAudio();\\n                  }}\\n                  aria-label={isMuted ? \'Suara Mati\' : \'Suara Aktif\'}\\n                  className=\\\"pointer-events-auto absolute top-3 right-6 w-14 h-14 flex items-center justify-center bg-white hover:bg-[#fec83e] text-[#11121a] font-black text-xs border-4 border-[#11121a] ring-2 ring-white rounded-2xl rotate-6 comic-sticker-shadow transition-transform hover:scale-105 active:scale-95 cursor-pointer\\\"\\n                >\\n                  {isMuted ? \'MUTE\' : \'SUARA\'}\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  data-start=\\\"true\\\"\\n                  onClick={() => handleStartGame(false)}\\n                  aria-label=\\\"LET\'S GO\\\"\\n                  className=\\\"pointer-events-auto absolute -bottom-3 left-1/2 -translate-x-1/2 -rotate-3 hover:-rotate-6 hover:scale-108 active:scale-95 px-9 py-4 bg-[#b4ff39] hover:bg-[#c7ff72] text-[#11121a] font-black text-2xl sm:text-3xl tracking-wider rounded-2xl border-4 border-[#11121a] ring-4 ring-white comic-sticker-shadow-lg transition-all duration-150 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  LET&apos;S GO\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"relative z-10 pb-5 px-6 text-center text-xs sm:text-sm font-bold tracking-wide text-[#dfdfe2]/85\\\">\\n            WASD Lari &nbsp;\302\267&nbsp; [E] Ambil/Lempar Peti &nbsp;\302\267&nbsp; [Q] Pola Ghost Pad &nbsp;\302\267&nbsp; [F] Rakit &nbsp;\302\267&nbsp; [V] Teropong AI\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* =====================================================================\\n          3. PLAYING HUD: WORLD-MATCHED COMIC CLUSTERS + TEAM BUDDIES MINI-RADAR\\n         ===================================================================== */}\\n      {gameState === \'playing\' && (\\n        <div className=\\\"fixed inset-0 z-20 pointer-events-none flex flex-col justify-between p-4 sm:p-6\\\">\\n          {/* Top Row */}\\n          <div className=\\\"flex items-start justify-between gap-4\\\">\\n            {/* Top-Left Cluster: Buddy/Tank Status + 3D Stacking Pad 2x2x2 + Base HQ Bars */}\\n            <div className=\\\"pointer-events-auto flex flex-wrap items-center gap-3 bg-[#191b24]/95 border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl px-4 py-2.5 comic-sticker-shadow\\\">\\n              {/* Mode & HP */}\\n              <div className=\\\"pr-3 border-r-2 border-[#393b49]\\\">\\n                <div className=\\\"text-[10px] font-black uppercase tracking-wider text-[#b8ff3c]\\\">\\n                  {hud.controlMode === \'tank\'\\n                    ? `OPEN-TOP TANK (${hud.tankStoredCrates}/4 PETI)`\\n                    : `BUDDY: ${hud.activeClass.toUpperCase()}`}\\n                </div>\\n                <div className=\\\"flex items-center gap-1 mt-0.5\\\">\\n                  {Array.from({ length: 6 }).map((_, idx) => {\\n                    const threshold = (idx + 1) * (hud.maxHp / 6);\\n                    const full = hud.hp >= threshold;\\n                    return (\\n                      <span\\n                        key={idx}\\n                        className={`w-3.5 h-3.5 rounded-sm border-2 border-[#11121a] ${\\n                          full ? \'bg-[#b8ff3c]\' : \'bg-[#272935]\'\\n                        }`}\\n                      />\\n                    );\\n                  })}\\n                  <span className=\\\"ml-1.5 text-xs font-black font-mono-tabular text-white\\\">\\n                    {hud.equippedWeapon}\\n                  </span>\\n                </div>\\n              </div>\\n\\n              {/* 3D Stacking Pad 2x2x2 Live Status + [Q] Ghost Wireframe Slots */}\\n              <div className=\\\"pr-3 border-r-2 border-[#393b49]\\\">\\n                <div className=\\\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\\\">\\n                  PAD [Q] {hud.buildOrder}: {hud.buildOrderLabel.toUpperCase()}{\' \'}\\n                  {hud.padIsMerged ? \'\302\267 MERGED\' : \'\'}\\n                </div>\\n                <div className=\\\"flex items-center gap-1 mt-0.5\\\">\\n                  {hud.padSlots.map((slot, idx) => {\\n                    const isGhostAllowed = getBuildOrderAllowedSlots(hud.buildOrder).includes(idx);\\n                    return (\\n                      <span\\n                        key={idx}\\n                        className={`w-3 h-3 rounded-xs border ${\\n                          slot === \'super\'\\n                            ? \'bg-[#00d2ff] border-[#11121a]\'\\n                            : slot === \'red\'\\n                            ? \'bg-[#ff3b30] border-[#11121a]\'\\n                            : isGhostAllowed\\n                            ? \'bg-[#191b24] border-[#00d2ff] border-dashed\'\\n                            : \'bg-[#272935]/50 border-[#11121a]\'\\n                        }`}\\n                      />\\n                    );\\n                  })}\\n                  <span\\n                    className={`ml-1.5 text-xs font-black ${\\n                      hud.padIsSuper ? \'text-[#00d2ff]\' : \'text-[#fec83e]\'\\n                    }`}\\n                  >\\n                    {hud.padOutputName}\\n                  </span>\\n                </div>\\n              </div>\\n\\n              {/* Blue HQ vs Red HQ HP */}\\n              <div>\\n                <div className=\\\"text-[10px] font-black uppercase tracking-wider text-[#8f93a5]\\\">\\n                  BLUE HQ vs RED HQ\\n                </div>\\n                <div className=\\\"flex items-center gap-2 mt-0.5 text-xs font-black font-mono-tabular\\\">\\n                  <span className=\\\"text-[#00d2ff]\\\">{hud.blueBaseHp}</span>\\n                  <span className=\\\"text-[#8f93a5]\\\">/</span>\\n                  <span className=\\\"text-[#ff3b30]\\\">{hud.redBaseHp}</span>\\n                  <span className=\\\"ml-1 px-1.5 py-0.5 bg-[#272935] text-[#b8ff3c] text-[10px] rounded border border-[#11121a]\\\">\\n                    TIM: {hud.alliedBuddiesCount}\\n                  </span>\\n                </div>\\n              </div>\\n            </div>\\n\\n            {/* Top-Right Cluster: Team Buddies Mini-Radar + Compact Utility Buttons */}\\n            <div className=\\\"pointer-events-auto flex items-start gap-2.5\\\">\\n              {/* Team Buddies Tactical Mini-Radar */}\\n              <div\\n                aria-label=\\\"Mini Radar Arena\\\"\\n                className=\\\"relative w-24 h-24 sm:w-28 sm:h-28 bg-[#285918] border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl overflow-hidden comic-sticker-shadow shrink-0\\\"\\n              >\\n                {/* Dirt Crossroad Paths */}\\n                <div className=\\\"absolute inset-y-0 left-1/2 -translate-x-1/2 w-3.5 bg-[#c28348]/85\\\" />\\n                <div className=\\\"absolute inset-x-0 top-1/2 -translate-y-1/2 h-3 bg-[#c28348]/85\\\" />\\n                {/* Central Drop Zone Ring */}\\n                <div className=\\\"absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-5 h-5 rounded-full border-2 border-[#ff3b30]/80\\\" />\\n                {/* Red Base HQ (Top, z = -22) & Red Pad */}\\n                <div className=\\\"absolute left-1/2 top-1.5 -translate-x-1/2 w-3.5 h-2 bg-[#ff3b30] border border-[#11121a] rounded-xs\\\" />\\n                {/* Blue Base HQ (Bottom, z = +22) & Blue Pad */}\\n                <div className=\\\"absolute left-1/2 bottom-1.5 -translate-x-1/2 w-3.5 h-2 bg-[#00d2ff] border border-[#11121a] rounded-xs\\\" />\\n\\n                {/* Live 3D Entities (Player, Allies, Red Enemies, Crates, Tanks) */}\\n                {hud.radarDots.map((dot) => {\\n                  const leftPct = Math.max(6, Math.min(94, ((dot.x + 42) / 84) * 100));\\n                  const topPct = Math.max(6, Math.min(94, ((dot.z + 42) / 84) * 100));\\n                  let dotStyle = \'w-2 h-2 bg-[#ff3b30] rounded-xs\';\\n                  if (dot.kind === \'player\') {\\n                    dotStyle = \'w-3 h-3 bg-[#b8ff3c] rounded-full ring-2 ring-[#11121a] z-10\';\\n                  } else if (dot.kind === \'ally\') {\\n                    dotStyle = \'w-2.5 h-2.5 bg-[#2979ff] rounded-full border border-white\';\\n                  } else if (dot.kind === \'enemy\') {\\n                    dotStyle = \'w-2.5 h-2.5 bg-[#ff3b30] rounded-full border border-[#11121a]\';\\n                  } else if (dot.kind === \'crate_super\') {\\n                    dotStyle = \'w-2 h-2 bg-[#00d2ff] border border-[#11121a]\';\\n                  } else if (dot.kind === \'crate_red\') {\\n                    dotStyle = \'w-1.5 h-1.5 bg-[#ff3b30] border border-[#11121a]\';\\n                  } else if (dot.kind === \'tank_blue\' || dot.kind === \'tank_red\') {\\n                    dotStyle = \'w-3 h-2.5 bg-[#fec83e] border border-[#11121a] rounded-xs\';\\n                  }\\n                  return (\\n                    <span\\n                      key={dot.id}\\n                      style={{ left: `${leftPct}%`, top: `${topPct}%` }}\\n                      className={`absolute -translate-x-1/2 -translate-y-1/2 ${dotStyle}`}\\n                    />\\n                  );\\n                })}\\n                <div className=\\\"absolute bottom-0.5 right-1.5 text-[8px] font-black tracking-wider text-white/90 drop-shadow\\\">\\n                  RADAR\\n                </div>\\n              </div>\\n\\n              <button\\n                type=\\\"button\\\"\\n                tabIndex={-1}\\n                onClick={(e) => {\\n                  e.currentTarget.blur();\\n                  soundEngine.playUiClick();\\n                  setIsReaModalOpen(true);\\n                }}\\n                aria-label=\\\"Kode Luau\\\"\\n                className=\\\"px-3.5 h-11 flex items-center gap-2 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white comic-sticker-shadow cursor-pointer whitespace-nowrap\\\"\\n              >\\n                <span>Kode Luau</span>\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                tabIndex={-1}\\n                onClick={(e) => {\\n                  e.currentTarget.blur();\\n                  handleToggleAudio();\\n                }}\\n                aria-label={isMuted ? \'Suara Mati\' : \'Suara Aktif\'}\\n                className=\\\"w-14 h-11 flex items-center justify-center bg-[#191b24] hover:bg-[#272935] text-white font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow cursor-pointer\\\"\\n              >\\n                {isMuted ? \'MUTE\' : \'SUARA\'}\\n              </button>\\n\\n              <button\\n                type=\\\"button\\\"\\n                tabIndex={-1}\\n                onClick={(e) => {\\n                  e.currentTarget.blur();\\n                  handleTogglePause();\\n                }}\\n                aria-label=\\\"Jeda\\\"\\n                className=\\\"w-14 h-11 flex items-center justify-center bg-[#191b24] hover:bg-[#272935] text-white font-black text-xs rounded-xl border-3 border-[#11121a] ring-2 ring-white/80 comic-sticker-shadow cursor-pointer\\\"\\n              >\\n                JEDA\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Bottom Context Prompt + Action Dock */}\\n          <div className=\\\"flex flex-col items-center\\\">\\n            <div className=\\\"mb-1.5 px-3.5 py-1 bg-[#11121a]/90 text-[#b4ff39] font-black text-xs rounded-lg border-2 border-[#11121a]\\\">\\n              {hud.contextHint}\\n            </div>\\n\\n            {!isDockCollapsed && (\\n              <div className=\\\"pointer-events-auto flex flex-wrap items-center justify-center gap-2 px-4 py-2 bg-[#191b24]/95 border-3 border-[#11121a] ring-2 ring-white/85 rounded-2xl comic-sticker-shadow max-w-[96vw]\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'pickupOrThrow\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#ff3b30] hover:bg-[#ff554a] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  {hud.carryingCrate !== \'none\' ? \'[E] Lempar Peti\' : \'[E] Ambil Peti\'}\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'kickOrCraft\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  [F] Rakit Pad\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'mountOrDismount\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#fec83e] hover:bg-[#fee763] text-[#11121a] font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  {hud.controlMode === \'tank\' ? \'[G] Turun Tank\' : \'[G] Naik Tank\'}\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'cycleBuildOrder\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  [Q] Pola: <span className=\\\"text-[#00d2ff]\\\">{hud.buildOrder}</span>\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'cycleCommand\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  [V] AI: <span className=\\\"text-[#fec83e]\\\">{hud.teamCommand}</span>\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  tabIndex={-1}\\n                  onClick={(e) => {\\n                    e.currentTarget.blur();\\n                    dispatchBuddyAction(\'swapBuddy\');\\n                  }}\\n                  className=\\\"px-3 py-1.5 bg-[#272935] hover:bg-[#393b49] text-white font-extrabold text-xs rounded-lg border-2 border-[#11121a] cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  [Tab] Ganti Buddy\\n                </button>\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* =====================================================================\\n          4. PAUSE MODAL CARD (gameState === \'paused\')\\n         ===================================================================== */}\\n      {gameState === \'paused\' && (\\n        <div\\n          role=\\\"dialog\\\"\\n          aria-modal=\\\"true\\\"\\n          aria-labelledby=\\\"pause-modal-title\\\"\\n          className=\\\"fixed inset-0 z-30 flex items-center justify-center p-4 pointer-events-auto\\\"\\n          style={{ backgroundColor: \'rgba(17, 18, 26, 0.82)\' }}\\n        >\\n          <div className=\\\"w-full max-w-md bg-[#191b24] border-4 border-[#11121a] ring-4 ring-white rounded-2xl p-6 comic-sticker-shadow-lg text-center space-y-5\\\">\\n            <h2\\n              id=\\\"pause-modal-title\\\"\\n              className=\\\"text-3xl font-black tracking-wide text-[#b8ff3c]\\\"\\n            >\\n              Permainan Dijeda\\n            </h2>\\n\\n            <div className=\\\"grid grid-cols-3 gap-2.5 text-center\\\">\\n              <div className=\\\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\\\">\\n                <div className=\\\"text-[10px] font-black text-[#8f93a5]\\\">SKOR</div>\\n                <div className=\\\"text-lg font-black font-mono-tabular text-white\\\">{hud.score}</div>\\n              </div>\\n              <div className=\\\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\\\">\\n                <div className=\\\"text-[10px] font-black text-[#8f93a5]\\\">RED HQ</div>\\n                <div className=\\\"text-lg font-black font-mono-tabular text-[#ff3b30]\\\">\\n                  {hud.redBaseHp}\\n                </div>\\n              </div>\\n              <div className=\\\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\\\">\\n                <div className=\\\"text-[10px] font-black text-[#8f93a5]\\\">MUSUH KO</div>\\n                <div className=\\\"text-lg font-black font-mono-tabular text-[#b8ff3c]\\\">\\n                  {hud.enemiesDefeated}\\n                </div>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex flex-col gap-2.5\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleTogglePause}\\n                className=\\\"w-full py-3 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-base rounded-xl border-3 border-[#11121a] comic-sticker-shadow cursor-pointer\\\"\\n              >\\n                Lanjut Main\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  soundEngine.playUiClick();\\n                  setIsReaModalOpen(true);\\n                }}\\n                className=\\\"w-full py-3 bg-[#fec83e] hover:bg-[#fee763] text-[#11121a] font-black text-sm rounded-xl border-3 border-[#11121a] comic-sticker-shadow cursor-pointer\\\"\\n              >\\n                Kode Luau\\n              </button>\\n              <div className=\\\"grid grid-cols-2 gap-2.5\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => handleStartGame(true)}\\n                  className=\\\"py-2.5 bg-[#272935] hover:bg-[#393b49] text-white font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer\\\"\\n                >\\n                  Ulangi Arena\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    soundEngine.playUiClick();\\n                    document.body.dataset.state = \'title\';\\n                    setGameState(\'title\');\\n                  }}\\n                  className=\\\"py-2.5 bg-[#272935] hover:bg-[#393b49] text-white font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer\\\"\\n                >\\n                  Layar Utama\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* =====================================================================\\n          5. VICTORY / GAME OVER MODAL CARD (gameState === \'gameover\')\\n         ===================================================================== */}\\n      {gameState === \'gameover\' && (\\n        <div\\n          role=\\\"dialog\\\"\\n          aria-modal=\\\"true\\\"\\n          aria-labelledby=\\\"gameover-modal-title\\\"\\n          className=\\\"fixed inset-0 z-30 flex items-center justify-center p-4 pointer-events-auto\\\"\\n          style={{ backgroundColor: \'rgba(17, 18, 26, 0.85)\' }}\\n        >\\n          <div className=\\\"w-full max-w-md bg-[#191b24] border-4 border-[#11121a] ring-4 ring-white rounded-2xl p-6 comic-sticker-shadow-lg text-center space-y-5\\\">\\n            <h2\\n              id=\\\"gameover-modal-title\\\"\\n              className={`text-3xl font-black tracking-wide ${\\n                (finalRunStats?.outcome || hud.outcome) === \'victory\'\\n                  ? \'text-[#b8ff3c]\'\\n                  : \'text-[#f42f4c]\'\\n              }`}\\n            >\\n              {(finalRunStats?.outcome || hud.outcome) === \'victory\'\\n                ? \'Markas Merah Hancur\'\\n                : \'Markas Biru Hancur\'}\\n            </h2>\\n\\n            <div className=\\\"grid grid-cols-3 gap-2.5 text-center\\\">\\n              <div className=\\\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\\\">\\n                <div className=\\\"text-[10px] font-black text-[#8f93a5]\\\">SKOR</div>\\n                <div className=\\\"text-base font-black font-mono-tabular text-white\\\">\\n                  {finalRunStats?.score ?? hud.score}\\n                </div>\\n              </div>\\n              <div className=\\\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\\\">\\n                <div className=\\\"text-[10px] font-black text-[#8f93a5]\\\">WAKTU</div>\\n                <div className=\\\"text-base font-black font-mono-tabular text-[#fec83e]\\\">\\n                  {finalRunStats?.clearTimeSec ?? hud.clearTimeSec}s\\n                </div>\\n              </div>\\n              <div className=\\\"p-3 bg-[#272935] rounded-xl border-2 border-[#11121a]\\\">\\n                <div className=\\\"text-[10px] font-black text-[#8f93a5]\\\">MUSUH KO</div>\\n                <div className=\\\"text-base font-black font-mono-tabular text-[#b8ff3c]\\\">\\n                  {finalRunStats?.enemiesDefeated ?? hud.enemiesDefeated}\\n                </div>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex flex-col gap-2.5\\\">\\n              <button\\n                type=\\\"button\\\"\\n                data-start=\\\"true\\\"\\n                onClick={() => handleStartGame(true)}\\n                className=\\\"w-full py-3.5 bg-[#b8ff3c] hover:bg-[#c7ff72] text-[#11121a] font-black text-lg rounded-xl border-3 border-[#11121a] comic-sticker-shadow cursor-pointer\\\"\\n              >\\n                Main Lagi\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  soundEngine.playUiClick();\\n                  setIsReaModalOpen(true);\\n                }}\\n                className=\\\"w-full py-2.5 bg-[#fec83e] hover:bg-[#fee763] text-[#11121a] font-black text-xs rounded-xl border-2 border-[#11121a] cursor-pointer\\\"\\n              >\\n                Kode Luau\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* =====================================================================\\n          6. REA EXTRACTION REPORT & ROBLOX STUDIO (LUAU) CODE MODAL\\n         ===================================================================== */}\\n      <ReaLuauModal\\n        isOpen={isReaModalOpen}\\n        onClose={() => setIsReaModalOpen(false)}\\n      />\\n    </main>\\n  );\\n}\", \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating App.tsx with 3-Mode Top Toggle Bar, Sandbox Quick Buttons, and Map Editor Palette\", \"toolSummary\":\"Update App.tsx with 3 modes and Map Editor UI\"}"
