            }
            lines {
              text: "      uniform float uShadowStep;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uniform float uHighlightStep;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      uniform vec3 uEmissive;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      varying vec2 vUv;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      varying vec3 vWorldNormal;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      varying vec3 vWorldPos;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Port of Jn (45-deg halftone grid) from B1Nq4Kq6.js:12100"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      float lyoHalftone(vec2 coord, float scale, float radius) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float c = cos(0.785398);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float s = sin(0.785398);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        vec2 rot = vec2(coord.x * c - coord.y * s, coord.x * s + coord.y * c) * scale;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float dist = length(fract(rot) - 0.5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float r = radius * 0.7071;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        return smoothstep(r - 0.08, r + 0.08, dist);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      void main() {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        vec3 albedo = uBaseColor;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (uHasMap > 0.5) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          vec4 texCol = texture2D(uMap, vUv);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          albedo *= texCol.rgb;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        vec3 N = normalize(vWorldNormal);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        vec3 L = normalize(uLightDirection);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float ndl = dot(N, L);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Cel-shaded step (uShadowStep = 0.15, uHighlightStep = 0.60)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float litFactor = clamp((ndl - uShadowStep) / max(0.001, uHighlightStep - uShadowStep), 0.0, 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float shadowFactor = 1.0 - litFactor;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Ground bounce light from Lyo\'s Yn.initOutputNode (lightBounceDistance = 1.5, lightBounceMultiplier = 0.4)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float downFacing = smoothstep(-0.2, 0.85, -N.y);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float heightAtten = clamp(1.0 - max(vWorldPos.y, 0.0) / 1.8, 0.0, 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float bounceAmt = downFacing * heightAtten * heightAtten * 0.35;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        vec3 colorWithBounce = mix(albedo, uBounceColor, bounceAmt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Halftone shadow modulation"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        vec2 screenCoord = gl_FragCoord.xy * 0.0045;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float dots = lyoHalftone(screenCoord, 18.0, shadowFactor * 0.65);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float shadowBlend = clamp(shadowFactor * (1.0 - dots * 0.35), 0.0, 1.0) * 0.78;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        vec3 litColor = colorWithBounce * uLightColor * (0.94 + 0.14 * litFactor);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        vec3 shadedColor = colorWithBounce * uShadowColor * 1.35;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        vec3 finalRgb = mix(litColor, shadedColor, shadowBlend) + uEmissive;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        gl_FragColor = vec4(finalRgb, 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        #include <tonemapping_fragment>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        #include <colorspace_fragment>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    `,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    side: THREE.DoubleSide,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
