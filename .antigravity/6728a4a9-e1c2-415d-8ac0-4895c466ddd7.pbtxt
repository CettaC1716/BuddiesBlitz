            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // Locate ONLY the single reference tree root (Tree_1B.REF / Tree_1B_REF or Tree_1A.REF / Tree_1A_REF)"
