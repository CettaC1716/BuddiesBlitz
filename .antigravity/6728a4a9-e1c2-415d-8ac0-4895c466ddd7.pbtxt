            }
            lines {
              text: "\tend"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\tif not root:FindFirstChild(\"TeamRing\") then"
