            }
            lines {
              text: "\t\t},"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t[\"2x2x1\"] = {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tCount = 4,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tShape = \"2x2x1 (1 Layer)\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tRegular = { Name = \"Bazooka / Flamethrower / Gatling Gun\", Category = \"HeavyWeapon\", Tier = 1 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\tSuper = { Name = \"Supazooka / Multi Orb Gun\", Category = \"HeavyWeapon\", Tier = 2 },"
