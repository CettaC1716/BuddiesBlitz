            lines {
              text: "-- Builds the composite 11-part Player Tank Rig"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "local function buildTankModel(player: Player, spawnPos: Vector3): Model"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal model = Instance.new(\"Model\")"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tmodel.Name = \"PlayerTank_\" .. player.Name"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- 1. Physics Root Chassis (Rapier cuboid: friction = 0.3, restitution = 0.4)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal chassis = createPart("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\t\"ChassisRoot\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tVector3.new(2.2, 1.0, 1.8) * METER_TO_STUDS,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tCOLORS.TankNeonLime,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tEnum.Material.SmoothPlastic,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t\tmodel"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tchassis.CanCollide = true"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tchassis.Massless = false"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tchassis.CustomPhysicalProperties = PhysicalProperties.new(2.5, 0.3, 0.4, 1.0, 1.0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tchassis.CFrame = CFrame.new(spawnPos) * CFrame.Angles(0, math.rad(-180), 0)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tmodel.PrimaryPart = chassis"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\t-- 2. Upper Sloped Glacis Hull"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "\tlocal upperHull = createPart("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
