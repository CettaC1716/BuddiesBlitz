              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (!refRoot && obj.name && (obj.name.endsWith(\'.REF\') || obj.name.endsWith(\'_REF\'))) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      refRoot = obj;"
