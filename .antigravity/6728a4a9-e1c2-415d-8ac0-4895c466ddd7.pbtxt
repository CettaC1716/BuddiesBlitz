            }
            lines {
              text: "            if (c.y <= 0.65) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              c.y = 0.65;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              c.state = \'grounded\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              c.parachuteMesh.visible = false;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              c.squashTimer = 0.28;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              c.mesh.position.y = 0.65;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              c.mesh.rotation.y = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          } else if (c.state === \'grounded\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (c.squashTimer > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              c.squashTimer = Math.max(0, c.squashTimer - dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const s = Math.sin((c.squashTimer / 0.28) * Math.PI) * 0.28;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              c.mesh.scale.set(1 + s, 1 - s * 0.8, 1 + s);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              c.mesh.scale.set(1, 1, 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // Player Movement Input (WASD)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        let moveX = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        let moveZ = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (keys[\'KeyW\'] || keys[\'ArrowUp\']) moveZ -= 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (keys[\'KeyS\'] || keys[\'ArrowDown\']) moveZ += 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (keys[\'KeyA\'] || keys[\'ArrowLeft\']) moveX -= 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (keys[\'KeyD\'] || keys[\'ArrowRight\']) moveX += 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        if (mountedTank) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // ================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // A. DRIVING OPEN-TOP LYO TANK MODE"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // ================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          let throttle = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          let turn = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (keys[\'KeyW\'] || keys[\'ArrowUp\']) throttle += 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (keys[\'KeyS\'] || keys[\'ArrowDown\']) throttle -= 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (keys[\'KeyA\'] || keys[\'ArrowLeft\']) turn += 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (keys[\'KeyD\'] || keys[\'ArrowRight\']) turn -= 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          mountedTank.currentDriveSpeed = computeTankSpeedStep("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            mountedTank.currentDriveSpeed,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            isBoosting && throttle !== 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            dt,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (turn !== 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const rev = throttle < 0 ? -1 : 1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            mountedTank.hullYaw += turn * rev * REA_CONSTANTS.physics.drive.rotationSpeed * dt;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const fwdX = Math.cos(mountedTank.hullYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const fwdZ = -Math.sin(mountedTank.hullYaw);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const targetVx = fwdX * throttle * mountedTank.currentDriveSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const targetVz = fwdZ * throttle * mountedTank.currentDriveSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          mountedTank.vx += (targetVx - mountedTank.vx) * Math.min(1, 10 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          mountedTank.vz += (targetVz - mountedTank.vz) * Math.min(1, 10 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          mountedTank.x = clamp(mountedTank.x + mountedTank.vx * dt, -40, 40);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          mountedTank.z = clamp(mountedTank.z + mountedTank.vz * dt, -40, 40);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          mountedTank.root.position.set(mountedTank.x, 0, mountedTank.z);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          mountedTank.bodyGroup.rotation.y = mountedTank.hullYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          activeSpeed = Math.hypot(mountedTank.vx, mountedTank.vz);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Rotate Turret + Open-Top Rider 360\302\260 toward Mouse Crosshair"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const aimDx = aimWorldPoint.x - mountedTank.x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const aimDz = aimWorldPoint.z - mountedTank.z;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const desiredWorldYaw = Math.atan2(-aimDz, aimDx);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          mountedTank.turretYaw = stepTurretYaw("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            mountedTank.turretYaw,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            desiredWorldYaw - mountedTank.hullYaw,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            dt,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          mountedTank.turretGroup.rotation.y = mountedTank.turretYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Team Buddies Feature: Crate Run-Over (Carry up to 4 crates by driving over them!)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          for (let i = worldCrates.length - 1; i >= 0; i--) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const c = worldCrates[i];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (c.state === \'grounded\' && mountedTank.storedCrates.length < 4) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              if (Math.hypot(c.x - mountedTank.x, c.z - mountedTank.z) < 2.2) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                mountedTank.storedCrates.push(c.kind);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                scene.remove(c.mesh);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                worldCrates.splice(i, 1);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                soundEngine.playPickup();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Auto-unload Tank\'s stored crates when driving next to Blue Stacking Pad"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            mountedTank.storedCrates.length > 0 &&"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Math.hypot(mountedTank.x - blueBase.padX, mountedTank.z - blueBase.padZ) < 4.8"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          ) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            while (mountedTank.storedCrates.length > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              const kind = mountedTank.storedCrates.shift()!;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              if (!addCrateToPadSlots(\'blue\', kind)) break;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              score += 35;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            soundEngine.playPickup();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Keep playerUnit position synced to the Tank"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          playerUnit.x = mountedTank.x;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          playerUnit.z = mountedTank.z;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Tank Cannon Firing"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (mountedTank.recoilTimer > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            mountedTank.recoilTimer = Math.max(0, mountedTank.recoilTimer - dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            mountedTank.barrelGroup.position.x = 0.65 - mountedTank.recoilTimer * 1.1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            mountedTank.barrelGroup.position.x = 0.65;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if ((isPointerDown || keys[\'Space\']) && mountedTank.recoilTimer <= 0.02) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            mountedTank.recoilTimer = 0.22;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            soundEngine.playShoot();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const totalYaw = mountedTank.hullYaw + mountedTank.turretYaw;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const sDir = new THREE.Vector3(Math.cos(totalYaw), 0, -Math.sin(totalYaw));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const muzzleOrigin = new THREE.Vector3("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              mountedTank.x + sDir.x * 2.1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              1.35,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              mountedTank.z + sDir.z * 2.1,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            fireProjectile(true, \'TankCannon\', muzzleOrigin, sDir, 46, mountedTank.isSuper ? 26 : 18);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            recoilOffset.x -= sDir.x * 0.18;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            recoilOffset.z -= sDir.z * 0.18;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            shakeTrauma = Math.min(1, shakeTrauma + 0.25);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        } else if (playerUnit.alive) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // ================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // B. ON-FOOT CHIBI BUDDY CHARACTER MODE"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // ================================================================="
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const spec = BUDDY_CLASSES[playerUnit.classId];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const carryPenalty = playerUnit.carryingCrate !== \'none\' ? 0.85 : 1.0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const boostMult = isBoosting ? 1.38 : 1.0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const moveSpeed = 9.2 * spec.speedMultiplier * carryPenalty * boostMult;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const inputLen = Math.hypot(moveX, moveZ);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (inputLen > 0.01) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            playerUnit.vx = (moveX / inputLen) * moveSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            playerUnit.vz = (moveZ / inputLen) * moveSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            playerUnit.walkCycle += dt * moveSpeed * 1.65;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            playerUnit.vx *= Math.exp(-14 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            playerUnit.vz *= Math.exp(-14 * dt);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
