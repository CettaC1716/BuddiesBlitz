              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform float uBladeHalfW;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform float uBladeHeight;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform float uBladeFold;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform float uBladeTipWidth;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform float uRobotRadius;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform float uBendStrength;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform sampler2D uWindNoiseTex;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform float uWindPhase;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform vec2 uWindDirection;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform float uWindStrength;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform float uWindGust;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      varying float vHeightFrac;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      varying float vTrailIntensity;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      varying vec2 vBladeUV;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      varying float vNoise;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      varying float vRandom;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      // Exact getWindOffset from Ni.prototype.getWindOffset (B1Nq4Kq6.js:399200)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      vec2 getWindOffset(vec3 worldPos, float randSeed) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vec2 dir = normalize(uWindDirection + vec2(0.0001));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vec2 perp = vec2(-dir.y, dir.x);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vec2 uv1 = worldPos.xz * 0.01125 + dir * (uWindPhase * 0.0175);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vec2 uv2 = worldPos.xz * 0.034375 - dir * (uWindPhase * 0.02975);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float c = clamp(texture2D(uWindNoiseTex, uv1).r, 0.0, 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float l = texture2D(uWindNoiseTex, uv2).r - 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float d = mix(0.75, 1.35, randSeed);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float f = sin(uWindPhase * d + randSeed * 6.2831853) * 0.08;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float p = 1.0 + uWindGust * 1.15;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float m = (c * 0.42 + 0.24 + f) * uWindStrength * p;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float h = (l * 0.28 + f * 0.75) * uWindStrength * p;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        return dir * m + perp * h;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      void main() {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float halfField = uFieldSize * 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vec3 anchor = vec3(0.0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        anchor.x = mod(aLocalAnchor.x - uViewPos.x + halfField, uFieldSize) - halfField + uViewPos.x;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        anchor.z = mod(aLocalAnchor.y - uViewPos.z + halfField, uFieldSize) - halfField + uViewPos.z;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        anchor.y = 0.0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        // Road & Stacking Pad / Base HQ grass-mask cutout so dirt roads and pads stay clean"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float onNSRoad = (1.0 - smoothstep(3.0, 3.8, abs(anchor.x))) * (1.0 - smoothstep(25.0, 27.0, abs(anchor.z)));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        // while keeping z > 15.6 lush with tall foreground grass blades in front of the low-angle camera"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float onNSRoad = (1.0 - smoothstep(2.6, 3.3, abs(anchor.x))) * (1.0 - smoothstep(14.8, 16.0, abs(anchor.z)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float onEWRoad = (1.0 - smoothstep(20.0, 21.5, abs(anchor.x))) * (1.0 - smoothstep(2.5, 3.3, abs(anchor.z)));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float onCenterPad = 1.0 - smoothstep(3.6, 4.4, max(abs(anchor.x), abs(anchor.z)));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float onBluePad = 1.0 - smoothstep(2.4, 3.1, max(abs(anchor.x - (-6.2)), abs(anchor.z - 16.5)));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        float onRedPad = 1.0 - smoothstep(2.4, 3.1, max(abs(anchor.x - 6.2), abs(anchor.z - (-16.5))));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        float onBluePad = 1.0 - smoothstep(2.4, 3.1, max(abs(anchor.x - (-6.2)), abs(anchor.z - 15.0)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float onRedPad = 1.0 - smoothstep(2.4, 3.1, max(abs(anchor.x - 6.2), abs(anchor.z - (-15.0))));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        float density = clamp(1.0 - max(max(onNSRoad, onEWRoad), max(onCenterPad, max(onBluePad, onRedPad))), 0.0, 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float hScale = aBladeShape.x * density;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float wScale = aBladeShape.y * density;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float cosA = aBladeShape.z;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float sinA = aBladeShape.w;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float g = clamp(position.y, 0.0, 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float g2 = g * g;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        // Radial player/tank footprint bend"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vec2 toBlade = anchor.xz - uPlayerPos.xz;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float distToPlayer = length(toBlade);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vec2 pushDir = toBlade / (distToPlayer + 0.001);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float innerCrush = 1.0 - smoothstep(uRobotRadius * 0.2, uRobotRadius * 1.2, distToPlayer);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float outerPush = (1.0 - smoothstep(uRobotRadius, uRobotRadius * 3.0, distToPlayer)) * (1.0 - innerCrush);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vec2 windOffset = getWindOffset(anchor, aRandom.x);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        windOffset += pushDir * (outerPush * uBendStrength * 0.6);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float tipWidth = mix(1.0, uBladeTipWidth, g);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float centerFold = 1.0 - smoothstep(0.0, 0.01, abs(position.x));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float localX = (position.x * (uBladeHalfW * 2.0) * tipWidth + g2 * (aRandom.y - 0.5) * 0.4) * wScale;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float localY = position.y * uBladeHeight * hScale;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float localZ = (centerFold * (uBladeHalfW * 2.0) * uBladeFold * tipWidth + g2 * (aRandom.x - 0.5) * 0.8) * wScale;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float distToView = length(anchor.xz - uViewPos.xz);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        float fade = (1.0 - smoothstep(uFieldSize * 0.38, uFieldSize * 0.49, distToView)) * density;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        localX *= fade;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        localY *= fade;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        localZ *= fade;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vec3 worldPos = vec3(0.0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        worldPos.x = anchor.x + localX * cosA - localZ * sinA + windOffset.x * g2 * fade;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        worldPos.z = anchor.z + localX * sinA + localZ * cosA + windOffset.y * g2 * fade;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        worldPos.y = anchor.y + localY - length(windOffset) * 0.25 * g * fade;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vHeightFrac = g;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vTrailIntensity = clamp(innerCrush, 0.0, 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vBladeUV = vec2(position.x + 0.5, position.y);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        // Spatial colour patch noise matching Ln(l.xz * 0.18, 3)"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vec2 nUv = anchor.xz * 0.018;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vNoise = texture2D(uWindNoiseTex, nUv).r * 2.0 - 1.0;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        vRandom = aRandom.x;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        gl_Position = projectionMatrix * viewMatrix * vec4(worldPos, 1.0);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    `,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    fragmentShader: /* glsl */ `"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform vec3 uSunBottom;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform vec3 uSunMid;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform vec3 uSunTop;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform vec3 uShadowBottom;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform vec3 uShadowMid;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform vec3 uShadowTop;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform float uFloorBlend;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      uniform float uTrailDarkening;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
